<http://example.com/InlandRevenueModel#PositionBasedRole>
        rdf:type          <http://smartlogic.com/class#Party-classification> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#OneIdentityManager> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel-current-#AccessControlManagement> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/Snapshot/SitePages/Introduction-of-Position-Based-Roles-in-CCS.aspx?web=1"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A Positions Based Role (PBR) is a collection of access to IR systems, including delegations, required to allow our people to perform their duties. It will automatically provide core systems access for the role you hold in IR, e.g. a CSO level one PBR provides access to START, Genysys Cloud, etc. Different PBRs have been established to recognise different roles and the systems access they require. For example, in CCS there are separate PBRs for CSO level one and CSO level two. A new 'Position Based Roles Access’ field has been added to the Positions record in Ātea, containing a drop-down list of PBRs for that Business Group. One IM will use this PBR to automatically provide or remove access to IR systems."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Enterprise Services Korero July 2023"@en ;
        sem:guid          "1048ee32-4e94-4f1e-96b7-38a098e3c80a" ;
        skos:broader      <http://example.com/InlandRevenueModel#RoleType> ;
        skos:related      <http://example.com/InlandRevenueModel#Atea> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#PositionBasedRole/Position-basedRole_en> , <http://example.com/InlandRevenueModel#PositionBasedRole/PositionsBasedRole_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PositionBasedRole/PositionBasedRole_en> .

<http://example.com/InlandRevenueModel#PositionBasedRole/Position-basedRole_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
