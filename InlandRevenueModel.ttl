<http://example.com/InlandRevenueModel#PowerPlatformCommunity>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#O365> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<span style=\"color: rgb(55, 66, 74);font-size: 18px;background-color: rgb(240, 248, 249)\">A Power Platform Community is a dedicated group of individuals within an organization who are focused on the adoption and effective use of the Microsoft Power Platform. The group brings together a diverse set of individuals, such as business analysts, developers, IT professionals, and end-users, who share a common interest in the platform and come together to share knowledge, best practices, and expertise.</span>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p> </p><p><span style=\"font-size:12.0pt\"><a href=\"https://irnz.sharepoint.com/sites/kc-powerplatformcop/SitePages/Power-Platform-Community.aspx?web=1\">https://irnz.sharepoint.com/sites/kc-powerplatformcop/SitePages/Power-Platform-Community.aspx?web=1</a></span></p><p> </p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#PowerPlatformCommunity/PowerPlatformCommunityOfPractice_en> ;
        sem:guid          "8ab50cad-17f7-4e69-bc32-029d6ad98569" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skos:related      <http://example.com/InlandRevenueModel#PowerPlatformWorkingGroup> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PowerPlatformCommunity/PowerPlatformCommunity_en> .

<http://example.com/InlandRevenueModel#PowerPlatformCommunity/PowerPlatformCommunityOfPractice_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Power Platform Community of Practice"@en .

<http://example.com/InlandRevenueModel#PowerPlatformCommunity/PowerPlatformCommunity_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Power Platform Community"@en .

<http://example.com/InlandRevenueModel#PowerPlatformWorkingGroup>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p> </p><p><span style=\"font-size:12.0pt\"><a href=\"https://irnz.sharepoint.com/sites/kc-powerplatformcop/SitePages/Power-Platform-Working-Group.aspx?web=1\">https://irnz.sharepoint.com/sites/kc-powerplatformcop/SitePages/Power-Platform-Working-Group.aspx?web=1</a></span></p><p> </p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>​<span style=\"color: rgb(55, 66, 74);font-size: 18px\">The Power Platform Working Group monitors the use of Microsoft Power Platform at IR and provides guidance on its use. The group was established in May 2022 with the agreement of the Enterprise Priorities and Performance Committee (EPPC).<br></span><span style=\"color: rgb(55, 66, 74);font-size: 18px\">The group meets on the fourth Wednesday of each&nbsp;month.&nbsp;</span>​<br></p><div><p>Sponsor -&nbsp;<span style=\"color: rgb(0, 0, 0);font-size: medium\">Enterprise Leader - CCS Planning, Design &amp; Delivery: Joanne Taranaki.<br></span>The scope is the general business use of Microsoft Power Platform products at Inland Revenue. This includes the use of these products both in a standalone capacity and inside SharePoint. The scope excludes the Power BI connected to the DIP (Data Intelligence Platform) solution.</p></div>"@en ;
        sem:guid          "3c0ed065-d09a-4d7a-a23d-a5977ba35b06" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skos:related      <http://example.com/InlandRevenueModel#PowerPlatformCommunity> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#PowerPlatformWorkingGroup/PPWG_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PowerPlatformWorkingGroup/PowerPlatformWorkingGroup_en> .

<http://example.com/InlandRevenueModel#PowerPlatformWorkingGroup/PPWG_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "PPWG"@en .

<http://example.com/InlandRevenueModel#PowerPlatformWorkingGroup/PowerPlatformWorkingGroup_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Power Platform Working Group"@en .

<http://example.com/InlandRevenueModel#PowersManual>
        rdf:type          <http://smartlogic.com/class#IR-corporate-policy> ;
