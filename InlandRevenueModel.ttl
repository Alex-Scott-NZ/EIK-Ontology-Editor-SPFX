<http://example.com/InlandRevenueModel#LocalGovernmentAct2002>
        rdf:type          <http://smartlogic.com/class#Law> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://smartlogic.com/term#33966134547267219238703> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "The purpose of this Act is to provide for democratic and effective local government that recognises the diversity of New Zealand communities; and, to that end, this Act— (a) states the purpose of local government; and (b) provides a framework and powers for local authorities to decide which activities they undertake and the manner in which they will undertake them; and (c) promotes the accountability of local authorities to their communities; and (d) provides for local authorities to play a broad role in promoting the social, economic, environmental, and cultural well-being of their communities, taking a sustainable development approach."@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Local Government Act 2002"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#LocalGovernmentAct2002/LocalGovernmentAct_en> ;
        <http://example.com/NZ-IRD#Provides-definition-of>
                <http://smartlogic.com/term#33966134547267219238703> ;
        sem:guid          "2e5b9a5d-9fb1-4a29-9f02-145d984067f5" ;
        skos:broader      <http://smartlogic.com/term#492768876094676199672439963971808> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#LocalGovernmentAct2002/LocalGovernmentAct2002_en> .

