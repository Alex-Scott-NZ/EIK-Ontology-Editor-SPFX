        <http://example.com/InlandRevenueModel-current-#IsInvolvedIn>
                <http://example.com/InlandRevenueModel-current-#CustomerJourneyProject> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#CustomerJourneyMapping/CustomerJourneyMap_en> , <http://example.com/InlandRevenueModel#CustomerJourneyMapping/CustomerJourneyThinking_en> , <http://example.com/InlandRevenueModel#CustomerJourneyMapping/CustomerJourney_en> , <http://example.com/InlandRevenueModel#CustomerJourneyMapping/CustomerStories_en> , <http://example.com/InlandRevenueModel#CustomerJourneyMapping/UserStories_en> ;
