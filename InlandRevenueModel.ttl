<http://example.com/InlandRevenueModel#EffectiveMarginalTaxRate>
        rdf:type          <http://smartlogic.com/class#Rate> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/InlandRevenueModel#EffectiveMarginalTaxRate/EffectiveMTR_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#EffectiveMarginalTaxRate/EMTR_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-21"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A method of measuring the total impact of taxes and loss of benefits when an additional dollar of income is earned."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Revenue Forecasting content; PAS content"@en ;
        sem:guid          "6dac04c1-dab3-400f-af47-63ffd5cc25e7" ;
        skos:broader      <http://example.com/InlandRevenueModel#MarginalTaxRate> ;
        skos:definition   "<p>The effective marginal tax rate is the total proportion of an additional dollar of income that is lost due to the combined effect of tax, levies, and reductions in income‑tested payments or tax credits.&nbsp;In IR material, EMTRs are used to describe how much of a small increase in earnings (often $1):&nbsp;is paid as tax or levies, and<br>reduces entitlements through abatement.<br>This definition is explicitly used in IR knowledge content, which describes EMTRs as the amount “lost to a person from a marginal increase in earnings … due to taxes, levies and social assistance abatements.”<br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#AbatementRate> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EffectiveMarginalTaxRate/EffectiveMarginalTaxRate_en> .

<http://example.com/InlandRevenueModel#EffectiveMarginalTaxRate/EMTR_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "EMTR"@en .

<http://example.com/InlandRevenueModel#EffectiveMarginalTaxRate/EffectiveMTR_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Effective MTR"@en .

