<http://example.com/InlandRevenueModel#TransitionalTaxResident>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#TransitionalResidencyFlowchart> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsAttributeOf>
                <http://example.com/InlandRevenueModel-current-#Family> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-26"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Income Tax Act, IRD website."@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A transitional tax resident is a new or returning New Zealand tax resident who gets a temporary exemption from New Zealand tax on most overseas income for up to four years, when they first become tax resident again.</p><p><br></p><p>Under the Income Tax Act 2007, a person is a transitional resident if all of the following apply:<br>They are a natural person (an individual, not a company or trust).<br>They become a New Zealand tax resident (either by the 183‑day rule or by establishing a permanent place of abode).<br>They were not a New Zealand tax resident at any time in the previous 10 years.<br>They have not used the transitional resident rules before (it is a one‑off entitlement).<br>If these conditions are met, the person automatically becomes a transitional tax resident, unless they choose to opt out.<br></p><p>Although a transitional resident is a New Zealand tax resident, the law treats them as if they were non‑resident for many types of foreign‑sourced income during the transitional period. In practice&nbsp;New Zealand does not tax most overseas income during the transitional period but&nbsp;New Zealand income is still taxed normally.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "1d20c03e-7371-4fbb-8b0b-bdba17d55724" ;
        skos:broader      <http://smartlogic.com/term#144354077507207679107329112919122> ;
        skos:related      <http://example.com/InlandRevenueModel#ExceptedFinancialArrangement> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TransitionalTaxResident/TransitionalTaxResident_en> .

<http://example.com/InlandRevenueModel#TransitionalTaxResident/TransitionalTaxResident_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Transitional tax resident"@en .

