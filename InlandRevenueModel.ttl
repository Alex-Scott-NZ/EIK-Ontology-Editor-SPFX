        <http://example.com/NZ-IRD#Is-amended-by>
                <http://example.com/InlandRevenueModel#COVID-19Response-TaxationAndOtherRegulatoryUrgentMeasures-Act2020> , <http://example.com/InlandRevenueModel#PublicFinanceAmendmentAct2004> ;
        <http://example.com/NZ-IRD#Provides-definition-of>
                <http://example.com/InlandRevenueModel#Multi-yearAppropriation0> , <http://example.com/InlandRevenueModel#PermanentLegislativeAuthority> , <http://example.com/InlandRevenueModel#TrustMoney> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate Finance content"@en ;
        sem:guid          "e1b6e5b3-b50a-4572-8819-a471240a69ba" ;
        skos:broader      <http://smartlogic.com/term#492768876094676199672439963971808> ;
        skos:definition   "The Public Finance Act 1989 is a landmark New Zealand law that reformed government financial management by establishing accrual budgeting and reporting, defining how Parliament authorizes expenditure, and providing statutory control over public assets, including borrowing and investments. This legislation aimed to manage public finances prudently by linking spending to specific outputs rather than just inputs, requiring government departments to produce proper balance sheets and forecasts, and managing fiscal risks. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PublicFinanceAct1989/PublicFinanceAct1989_en> .

