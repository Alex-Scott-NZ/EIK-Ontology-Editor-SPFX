<http://example.com/InlandRevenueModel#Sustainability>
        rdf:type          <http://smartlogic.com/class#Topic> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#WorldAroundUs> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#BarterTransaction> , <http://example.com/InlandRevenueModel#EnvironmentCommittee> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2022-06-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Investopedia. https://www.investopedia.com/terms/s/sustainability.asp"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#Sustainability/SustainabilityPractices_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "P&C content."@en ;
        sem:guid          "1ebc7fdd-2db5-4cfe-84dc-70f36c3f3cc9" ;
        skos:broader      <http://example.com/InlandRevenueModel#BusinessCapability> ;
        skos:definition   "In the broadest sense, sustainability refers to the ability to maintain or support a process continuously over time. In business and policy contexts, sustainability seeks to prevent the depletion of natural or physical resources, so that they will remain available for the long term. Accordingly, sustainable policies emphasize the future effect of any given policy or business practice on humans, ecosystems, and the wider economy."@en ;
        skos:related      <http://example.com/InlandRevenueModel#EnergyEfficiencyAndConservationAuthority> , <http://example.com/InlandRevenueModel#SustainableManagement> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Sustainability/Sustainability_en> .

<http://example.com/InlandRevenueModel#Sustainability/SustainabilityPractices_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Sustainability practices"@en .

<http://example.com/InlandRevenueModel#Sustainability/Sustainability_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Sustainability"@en .

<http://example.com/InlandRevenueModel#SustainableManagement>
        rdf:type            <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/Cleaned-Inland-Revenue-model#Purchasing> , <http://example.com/Cleaned-Inland-Revenue-model#Transportation> , <http://example.com/Cleaned-Inland-Revenue-model#WasteManagement> , <http://example.com/InlandRevenueModel#BusinessTravel> , <http://example.com/InlandRevenueModel#EnergyEfficiency> , <http://example.com/InlandRevenueModel#FleetManagement> , <http://smartlogic.com/term#206221503767312345916907> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#Activity-BusinessAndCorporate> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2022-06-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Knowledge Management"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Wikipedia"@en ;
        <http://example.com/InlandRevenueModel#usedInME3ValueSet>
                true ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#SustainableManagement/EnvironmentalSustainabilityProgramme_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Requested by Knowledge Management"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.2.1_Corporate_Planning_and_Reporting> ;
        sem:guid            "8921ed97-0262-483a-a530-f118334cdc67" ;
        skos:broader        <http://example.com/InlandRevenueModel#BusinessDevelopment> ;
        skos:definition     "Sustainable management takes the concepts from sustainability and synthesizes them with the concepts of management. Sustainability has three branches: the environment, the needs of present and future generations, and the economy. Using these branches, it creates the ability of an organisation to thrive by maintaining economic viability and also nourishing the needs of the present and future generations by limiting resource depletion."@en ;
        skos:editorialNote  "A search at the time of entry did not reveal any items tagged as \"Environmental Sustainability Programme\" but if this does prove to exist then it can be removed from Evidence and added as a concept instead."@en ;
        skos:related        <http://example.com/InlandRevenueModel#KeepingItGreen> , <http://example.com/InlandRevenueModel#Sustainability> , <http://example.com/InlandRevenueModel-current-#ClimateChange> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#SustainableManagement/SustainableManagement_en> .

