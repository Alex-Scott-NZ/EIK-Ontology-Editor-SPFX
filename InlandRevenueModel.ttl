<http://example.com/InlandRevenueModel#InternationalTrade>
        rdf:type          <http://smartlogic.com/class#Topic> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-21"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling"@en ;
        sem:guid          "604a3a63-dab5-4ded-9674-ee31645fb5a0" ;
        skos:broader      <http://smartlogic.com/term#182365628939588612203668> ;
        skos:definition   "<p>The buying and selling of goods and services between New Zealand and other countries, including what New Zealand exports to earn income and what it imports to meet the needs of people and businesses.&nbsp;For New Zealand, international trade is how the country sells goods and services overseas to pay for the goods and services it imports from other countries.<br>This reflects how government agencies describe trade as encompassing both exports and imports of goods and services and as a core feature of NZ’s economy due to its small domestic market and reliance on overseas markets.<br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#FreeTradeAgreement> , <http://example.com/InlandRevenueModel#NewZealandEconomy> , <http://example.com/InlandRevenueModel#WorldTradeOrganisation> , <http://example.com/InlandRevenueModel-current-#MinistryOfForeignAffairsAndTrade> , <http://smartlogic.com/term#166381805076053894708048> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#InternationalTrade/InternationalTrade_en> .

