                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Inland Revenue is responsible for collecting student loan repayments after the loan is transferred from Studylink. Repayments are calculated at 12% of every dollar earned above the annual repayment threshold, which is reviewed and updated each year.<br>Additional repayments can also be made through the employer to help reduce the loan balance faster.</p><p><br></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel-current-#StudentLoanDeduction/STUDENT_LOANS_DEDUCTIONS_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "D117 Data sources High Level"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel-current-#StudentLoanDeduction/PR.T.021_en> ;
        sem:guid          "c79ac33a-da89-4ff7-8fe0-7ebcb6f9a528" ;
        skos:broader      <http://smartlogic.com/term#32367411335895523177952203629346> ;
        skos:definition   "Student Loan repayments deducted from an employee's salary or wages, and paid to us on their behalf by their employer."@en ;
        skos:related      <http://example.com/NZ-IRD#Student-loan-repayment> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel-current-#StudentLoanDeduction/PAYE-StudentLoan_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#StudentLoanDeduction/StudentLoanDeduction_en> .

