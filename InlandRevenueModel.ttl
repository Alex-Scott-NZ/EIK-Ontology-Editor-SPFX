<http://example.com/InlandRevenueModel#OperatingBalanceBeforeGainsAndLosses>
        rdf:type          <http://example.com/InlandRevenueModel#Measurement> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#OperatingBalanceBeforeGainsAndLosses/OBEGAL_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "PAS content"@en ;
        sem:guid          "a1371d02-84b9-4428-8366-4359732fe5dd" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Measurement> ;
        skos:definition   "The Operating Balance Before Gains and Losses (OBEGAL) measures a government's underlying financial performance by comparing its revenues to its expenses, excluding any volatile gains or losses from the changing value of its financial assets and liabilities. It is a key fiscal indicator, most notably in New Zealand, that provides a clearer view of the government's ongoing operational stewardship and ability to fund its core activities, rather than being influenced by fluctuating market values. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#OperatingBalanceBeforeGainsAndLosses/OperatingBalanceBeforeGainsAndLosses_en> .

