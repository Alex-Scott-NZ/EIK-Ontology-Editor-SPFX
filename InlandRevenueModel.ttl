<http://example.com/InlandRevenueModel#SPACertificate>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsAppliedTo>
                <http://example.com/InlandRevenueModel-current-#KiwiSaverSchemeProvider> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-05-20"^^xsd:date ;
        <http://example.com/InlandRevenueModel#ResultsFrom>
                <http://example.com/InlandRevenueModel#ProvideInformation> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/kc-kiwisaver/SitePages/becoming-a-kiwisaver-provider.aspx\">Becoming a KiwiSaver provider</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A SPA certificate is a formal document issued by Inland Revenue confirming that a KiwiSaver scheme provider has signed a Scheme Provider Agreement (SPA) and met the required system certification criteria to operate a KiwiSaver scheme.<br>It is given to a prospective KiwiSaver scheme provider after entering into an SPA with Inland Revenue.&nbsp;The provider must include this certificate when applying to the Financial Markets Authority (FMA) to be registered as a KiwiSaver scheme provider.&nbsp;It effectively demonstrates that Inland Revenue has assessed and approved the provider’s technical and operational readiness to participate in KiwiSaver administration.<br></p>"@en ;
        <http://example.com/NZ-IRD#Is-instantiation-of>
                <http://example.com/InlandRevenueModel#SchemeProviderAgreement> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling"@en ;
        sem:guid          "26bb6a54-3097-40a4-b2d3-bee9851a095a" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerIdentityInformation> ;
        skos:definition   "Evidence that Inland Revenue has entered into a Scheme Provider Agreement with an organisation and certified it as meeting required system and operational standards for KiwiSaver scheme provision."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SPACertificate/SPACertificate_en> .

