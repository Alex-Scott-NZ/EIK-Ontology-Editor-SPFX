<http://example.com/InlandRevenueModel#ForeignAccountTaxComplianceActDisclosures>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/Cleaned-Inland-Revenue-model#ForeignAccountTaxComplianceAct> ;
