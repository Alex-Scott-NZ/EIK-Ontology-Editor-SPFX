                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR). Name changed to align with the register as of 2024."@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>This business product group covers all employer deductions. PAYE (Pay As You Earn) is the core income tax amount that must be deducted from employees’ salaries and wages. It also includes the ACC earner’s levy.<br>In addition to PAYE, employers may need to deduct other amounts from employees’ pay, such as withholding tax for schedular income, KiwiSaver contributions, child support payments and student loan repayments. A credit can also be applied via payroll giving if the employee elects to  donate to charities or similar organisations directly from their wages.<br>Employer deductions are further categorised into sub-groups within the register.</p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Concept Model Glossary; Website glossary"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://smartlogic.com/term#32367411335895523177952203629346/PR.T.019_en> ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://smartlogic.com/term#32367411335895523177952203629346/PAYE_en> ;
        sem:guid          "7e2d18cf-eb62-4dea-a06b-26df673410a6" ;
        skos:broader      <http://example.com/InlandRevenueModel#Taxes0> ;
        skos:definition   "Pay as you earn. Tax and levies deducted from an employee's income by their employer before the income is paid to them."@en ;
