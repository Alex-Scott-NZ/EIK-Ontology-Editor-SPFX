        sem:guid          "4f109d4b-6563-4050-9df7-6ead8f82ee53" ;
        skos:broader      <http://smartlogic.com/term#188519164724691362719453> ;
        skos:definition   "The Land Transport Safety Authority (LTSA) was the New Zealand government's Crown entity responsible for promoting land transport safety before being disestablished on December 1, 2004. It managed driver and vehicle licensing, oversaw safety standards, and collected crash data through its Crash Analysis System (CAS) to identify and address safety issues. The LTSA was succeeded by Land Transport New Zealand, which later merged to become the current Waka Kotahi NZ Transport Agency in 2008"@en ;
        skos:historyNote  "No longer in existence (disestablished c2004). Responsibilities are now part of NZTA."@en ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#LandTransportSafetyAuthority/LandTransportSafetyAuthority_en> .

