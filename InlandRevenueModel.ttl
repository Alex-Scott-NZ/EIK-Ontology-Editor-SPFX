        rdf:type            <http://smartlogic.com/class#Role> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsPartyToAgreement>
                <http://example.com/InlandRevenueModel#HagueConventionOnInternationalRecoveryOfChildSupportAndOtherFormsOfFamilyMaintenance> ;
        <http://example.com/InlandRevenueModel#HasAttribute>
                <http://example.com/Cleaned-Inland-Revenue-model#Adjusted-taxable-income> , <http://example.com/InlandRevenueModel#FinancialStatus> , <http://example.com/InlandRevenueModel#LivesInAForeignCountry> , <http://example.com/InlandRevenueModel#LocationOfEntity> , <http://example.com/InlandRevenueModel#RelationshipStatus> , <http://smartlogic.com/term#144354077507207679107329112919122> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel#ApplicationForAnAdministrativeReview> , <http://example.com/InlandRevenueModel#ChildSupportReview-ResponseByOtherParty> , <http://example.com/InlandRevenueModel#Ground11-Re-establishmentCosts> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsAppliedTo>
                <http://example.com/Cleaned-Inland-Revenue-model#Qualifying-child> ;
        <http://example.com/InlandRevenueModel#IsFocusOf>
                <http://example.com/InlandRevenueModel#ChildSupportInternationalSupport> , <http://example.com/InlandRevenueModel#ChildSupportLiablePerson> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#ResultsFrom>
                <http://example.com/InlandRevenueModel#EstablishEligibility> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Child Support glossary"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>​​Child support can be sought from any parent who meets either of these conditions: They are a New Zealand citizen or ordinarily resident. They live in New Zealand or in a country with a reciprocal agreement with New Zealand to enforce child support.<br/>Citizenship by descent - A person is a citizen by descent if they were born overseas but either of these apply: They were born before 1 January 1970 and their father was a New Zealand citizen before birth; or they were born on or after 1 January 1970 and their father or mother was a New Zealand citizen before birth. Citizenship by descent does not apply if the parent themselves is a citizen by descent.<br/>New Zealand resident - A New Zealand resident is a person who ordinarily resides in New Zealand. A person who ordinarily resides in New Zealand has: A permanent place of abode in New Zealand or, No permanent place of abode in New Zealand and have been present in New Zealand for period(s) exceeding a combined total of 183 days in a 12 month period. The person is deemed to be a New Zealand resident from the beginning of the 12 month period.<br/>If a person is ordinarily resident but are absent from New Zealand for more than 325 days in a 12 month person, and no longer has a permanent place of abode, they are considered non-resident from the first of those 325 days. If a person is in New Zealand for only part of a day, this is counted as being a whole day. This means that the days on which a person departs or arrives are treated as days present in New Zealand.</p>"@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://example.com/InlandRevenueModel#PayingSpouseOrPartner> ;
        <http://example.com/InlandRevenueModel-current-#IsRoleRelatedTo>
                <http://example.com/InlandRevenueModel#ChildSupportExemption> , <http://example.com/InlandRevenueModel#ChildSupportLiability> , <http://example.com/InlandRevenueModel#DepartureOrder> , <http://example.com/InlandRevenueModel#LiableParentRefund> ;
        <http://example.com/NZ-IRD#Is-received-by>
                <http://smartlogic.com/term#46576892232815290578744> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet; child support glossary"@en ;
        sem:guid            "8708b001-541f-5c1f-8e03-a8fd4f30196a" ;
        skos:broader        <http://smartlogic.com/term#141061123820532081058670> ;
        skos:definition     "A parent of a qualifying child who is normally required to pay child support."@en ;
        skos:editorialNote  "Use this strictly for the role. The IR product aspects sit under IR Product > child support scheme from 2024."@en ;
        skos:related        <http://smartlogic.com/term#128677540435599099056482> ;
        skosxl:altLabel     <http://smartlogic.com/term#65946683017913937338444/ChildSupportLiableParent_en> , <http://smartlogic.com/term#65946683017913937338444/PayingParent_en> ;
