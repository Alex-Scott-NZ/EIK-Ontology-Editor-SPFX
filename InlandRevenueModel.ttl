<http://example.com/InlandRevenueModel#Enterprise-IntegrityServices>
        rdf:type            <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/Cleaned-Inland-Revenue-model#HasRole>
                <http://example.com/InlandRevenueModel#IntegrityChampion> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#Enterprise-IntegrityServices/RatongaHinongaMeTeNgakauTapatahi_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>​<span style=\"color: rgb(50, 49, 48);font-size: 18px;background-color: rgb(243, 242, 241)\">Enterprise &amp; Integrity Services (E&amp;IS) provides corporate and support services to the organisation and ensures the integrity of the organisation and the tax system is maintained. The group delivers advice, information and processes to enable Inland Revenue to operate effectively, efficiently and safely.<br></span>Official start date: 01-05-2025<br><br><br><br><br><br></p>"@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#AgencyCapabilityReview> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Featured News 26-03-2025<br>IR Intranet</p>"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#Enterprise-IntegrityServices/EnterpriseDesign-Integrity_en> , <http://example.com/InlandRevenueModel#Enterprise-IntegrityServices/EnterpriseServices_en> ;
        sem:guid            "8a6b2c50-aeeb-4fff-b316-040e430d9e76" ;
        skos:broader        <http://smartlogic.com/term#16463423238946451384634> ;
        skos:editorialNote  "<p>Announced by CIR 26-03-2025 this business group is a result of review of operating teams and move to decrease Deputy Commissioners at IR by one. Two business groups Enterprise Design &amp; Integrity and Enterprise Services merged together to form new group with one Deputy Commissioner.<br>Both previous business groups deprecated within ontology model.<br></p>"@en ;
        skos:related        <http://example.com/Cleaned-Inland-Revenue-model#RiskAndAssuranceCommittee> , <http://example.com/InlandRevenueModel-current-#PrivacyOfficer> ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#Enterprise-IntegrityServices/EnterpriseAndIntegrityServices_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#Enterprise-IntegrityServices/Enterprise-IntegrityServices_en> .

