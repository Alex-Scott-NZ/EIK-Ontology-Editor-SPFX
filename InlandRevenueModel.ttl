<http://example.com/Cleaned-Inland-Revenue-model#BouvetIsland>
        rdf:type          <http://smartlogic.com/class#Country> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/Cleaned-Inland-Revenue-model#Antarctica> ;
