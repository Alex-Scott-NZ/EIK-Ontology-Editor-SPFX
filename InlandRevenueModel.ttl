<http://example.com/InlandRevenueModel#MealBreak>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>https://medical-dictionary.thefreedictionary.com/meal+break<br/>https://www.business.govt.nz/hiring-and-managing/managing-people-day-to-day/breaks/<br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet"@en ;
        sem:guid          "123c8b13-4b1d-4b03-a43d-818a8b416d4e" ;
        skos:broader      <http://example.com/InlandRevenueModel#WorkShift> ;
        skos:definition   "Generally, one or more paid or unpaid breaks taken between the start and finish times of each rostered period at work, the primary purpose of which is to allow employees to have a main meal (breakfast, lunch or dinner), and which are normally longer than other standard breaks. In New Zealand all employees must have paid 10-minute rest breaks and unpaid meal breaks, based on the number of hours worked. This is set out in the Employment Relations Act."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MealBreak/MealBreak_en> .

<http://example.com/InlandRevenueModel#MealBreak/MealBreak_en>
        rdf:type               skosxl:Label ;
