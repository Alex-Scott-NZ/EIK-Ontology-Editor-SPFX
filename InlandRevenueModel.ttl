<http://example.com/InlandRevenueModel#StrategicAssetManagementPlan>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Isused-in-function>
                <http://example.com/InlandRevenueModel#BusinessDevelopment> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#StrategicAssetManagementPlan/SAMP_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://smartlogic.com/term#46214080963874890296187> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#InvestmentManagement> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/:p:/r/sites/SW-CCSPlanning/StrategicPlanning/Priority%20Groups/Government%20Work%20Programme/2025-26/Discovery/GWP%2025-26%20Discovery.pptx?d=w4e9c72d748c04f96bbd24f633ee110b6&amp;csf=1&amp;web=1&amp;e=zwqE0O\">GWP 25-26 Discovery.pptx</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "SAMP will give us a forward view of where and how we need to invest in our assts to keep them running well, then we can weave this into our multi-year business plans. Touchstone document for how we plan and invest across CCS and the wider organisation."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate planning and reporting content"@en ;
        sem:guid          "3a1d64c8-ea45-418d-9267-8aff7213d48b" ;
        skos:broader      <http://example.com/InlandRevenueModel#AssetManagementPlan> ;
        skos:definition   "The SAMP is a planning tool to clarify intentions, priorities and practices to be adopted. It takes a long-term view and considers the combination of organisation needs, stakeholder expectations and the realities of existing assets and asset management capabilities."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#StrategicAssetManagementPlan/StrategicAssetManagementPlan_en> .

<http://example.com/InlandRevenueModel#StrategicAssetManagementPlan/SAMP_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "SAMP"@en .

<http://example.com/InlandRevenueModel#StrategicAssetManagementPlan/StrategicAssetManagementPlan_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Strategic Asset Management Plan"@en .

<http://example.com/InlandRevenueModel#StrategicComplianceHub>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#StrategicComplianceHub/SCH_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-06-26"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Email for all D&I, 26 June 2026"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>IR is setting up a new Strategic Compliance Hub (SCH) inside CCS. The Strategic Compliance Hub will be a small, central enabling team that helps IR make shared, strategic compliance decisions.   <br>Over the last two years, IR has received additional funding for compliance.  The government have been clear they expect greater compliance, more revenue and reduced debt, with more pressure on our performance expected in the coming years. As an organisation we need to ensure we’re setup well to deliver on these expectations. The SCH is being set up as a permanent team to help IR respond to this in a more co-ordinated and enduring way.<br>What will the Strategic Compliance Hub do?<br>The SCH has 3 core functions:<br>1.\tGather &amp; make sense of insights<br>o\tPull together data, intelligence and activity across CCS to create a shared picture of compliance risks and opportunities. <br>2.\tBring the right people together to decide<br>o\tEnable leaders to make clear, collective decisions and trade-offs.<br>3.\tTrack, learn, and improve<br>o\tMonitor whether decisions are working and feed learning back into future decisions.<br>The SCH will also act as a ‘front door’ for partners like the broader E&amp;IS and more specifically Strategy &amp; Performance and us in Data &amp; Information.<br>It will not replace existing teams in CCS, the segment model, or replicate any services in areas like E&amp;IS. Those stay as they are. Instead, it connects everything together, insights, priorities, decisions and learning across the organisation.<br><br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Strategic Compliance Hub - 1 pager.pdf"@en ;
        sem:guid          "4f157993-701a-4169-a3d1-e54a81eb11c8" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerAndComplianceServices-Business> ;
        skos:related      <http://smartlogic.com/term#193851481966191147796317981803790> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#StrategicComplianceHub/StrategicComplianceHub_en> .

<http://example.com/InlandRevenueModel#StrategicComplianceHub/SCH_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "SCH"@en .

<http://example.com/InlandRevenueModel#StrategicComplianceHub/StrategicComplianceHub_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Strategic Compliance Hub"@en .

