<http://example.com/InlandRevenueModel#ServiceLevelManagement>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#ServiceLevelAgreement> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ServiceLevelManagement/SLMO_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#IRBusinessService0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ServiceLevelManagement/ServiceBehaviours_en> , <http://example.com/InlandRevenueModel#ServiceLevelManagement/ServiceTasks_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IT&C content"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.2.3_Administrative_Planning_and_Reporting> ;
        sem:guid          "8c8f3fe8-e2ff-4ef1-b30d-b8c551eb6f37" ;
        skos:broader      <http://example.com/InlandRevenueModel#ITServiceManagement> ;
        skos:definition   "Service Level Management (SLM) is an activity, often drawing on ITIL, that establishes and maintains agreed-upon service quality levels between service providers and their customers. It involves defining service requirements, documenting them in Service Level Agreements (SLAs), and continuously monitoring and reporting on performance to ensure that IT services consistently meet business needs and customer expectations. Key aspects include defining service metrics, clarifying roles and responsibilities, fostering communication, and facilitating continuous improvement to adapt to changing business demands. "@en ;
        skos:related      <http://example.com/InlandRevenueModel-current-#ITIL> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ServiceLevelManagement/ServiceLevelManagement_en> .

