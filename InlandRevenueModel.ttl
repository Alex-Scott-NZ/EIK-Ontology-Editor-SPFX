        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A limited partnership is an offshore RLWT person if: - more than 25% of the general partner(s) are offshore RLWT person(s), or - more than 25% of the partnership shares are held or controlled by offshore RLWT person(s)."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website glossary"@en ;
        sem:guid          "bca337b2-a8ea-40a7-9f41-c0c8c83fb908" ;
        skos:broader      <http://example.com/InlandRevenueModel#OffshoreRLWTPerson> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#OffshoreRLWT-LimitedPartnership/OffshoreRLWT-LimitedPartnership_en> .

