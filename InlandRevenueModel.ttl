<http://example.com/InlandRevenueModel#ServiceInnovationLab>
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-participant-in>
                <http://example.com/InlandRevenueModel#ServiceInnovationWorkProgramme> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel-current-#ProgrammeAndProjectManagement> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IKM-compiled definition taken from a number of Stax sources"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Lab is an experiment carried out under the leadership of the ICT Partnership Framework's Service Innovation group.  It's managed by the Service Innovation Team in DIA in partnership with Assurity Consulting. It's part of the cross-agency work being done to achieve Better Public Services Result 10 and to deliver the Service Innovation Work Programme outcome that \"People have easy access to public services, which are designed around them, when they need them\"."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Customer Insight content"@en ;
        sem:guid          "aa64b33f-f4ec-4dff-8673-493f9756ffa0" ;
        skos:broader      <http://example.com/InlandRevenueModel#Inter-agencyGroup> ;
        skos:related      <http://example.com/InlandRevenueModel#ServiceInnovationReferenceGroup> , <http://example.com/InlandRevenueModel#ServiceInnovationWorkingGroup> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ServiceInnovationLab/ServiceInnovationLab_en> .

