<http://example.com/InlandRevenueModel#InvestmentBoost>
        rdf:type          <http://smartlogic.com/class#Entitlement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/:u:/r/sites/News/SitePages/Budget-2025.aspx?csf=1&web=1&e=QmGcTx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The Government has proposed legislation introducing Investment Boost. Details about Investment Boost are:&nbsp;investment Boost will allow business to claim 20% deductions for the costs of new assets. Assets need to be previously unused in New Zealand (either brand new, or new to NZ). Examples of eligible assets include new commercial and industrial buildings, machinery, equipment and work vehicles. Assets not eligible include residential buildings and fixed-life intangible property (such as copyright, trademark or rights to use land). Businesses will be able to claim deductions for new assets acquired on or after 22 May 2025 in their income tax returns for the relevant income year.<br><br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Budget 2025 announcement.&nbsp;</p><p><a href=\"https://www.taxpolicy.ird.govt.nz/-/media/project/ir/tp/publications/2025/investment-boost-information-sheet.pdf?modified=20250521211149\">Investment Boost - information sheet</a></p><p><br></p>"@en ;
        sem:guid          "b129ffce-1005-450c-bcc8-fc0259845125" ;
        skos:broader      <http://example.com/NZ-IRD#Depreciation-deduction> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#InvestmentBoost/InvestmentBoost_en> .

<http://example.com/InlandRevenueModel#InvestmentBoost/InvestmentBoost_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Investment Boost"@en .

