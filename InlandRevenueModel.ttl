<http://example.com/InlandRevenueModel#Custodian>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://smartlogic.com/term#56119831397991336249604> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Viva Topics"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p> </p><p><span style=\"font-size:13.5pt;color:#242424\">A custodian is the role responsible for implementing stewardship practices on a day-to-day basis. They have multiple&nbsp;responsibilities&nbsp;which include ensuring the management of the content on a knowledge site is fit for purpose and sustainable, and that we understand the intrinsic value of our data,&nbsp;information&nbsp;and knowledge.</span></p><p>&nbsp;</p><div><p><span style=\"font-size:10.0pt;color:#333333\"><br></span></p></div><div><p><span style=\"font-size:10.0pt;color:#333333\"><br></span></p></div><div><p> </p><p><span style=\"font-size:10.0pt;color:#333333\">IKM&nbsp; context - managing knowledge content collections.</span></p><p> </p></div>"@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#Data-Information-AndKnowledgeStewardship> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR internal"@en ;
        sem:guid          "ac3584e8-f920-4340-afc9-562f702d9367" ;
        skos:broader      <http://smartlogic.com/term#188649781203397804479981> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Custodian/Custodian_en> .

<http://example.com/InlandRevenueModel#Custodian/Custodian_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Custodian"@en .

