<http://example.com/InlandRevenueModel#ComplianceOperatingModel>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://smartlogic.com/term#193851481966191147796317981803790> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/kc-compliance/SitePages/Compliance-Operating-Model.aspx?web=1"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "We are continuously improving how we operate and increasingly acknowledge compliance is as much about helping customers get things right, as it is about correcting them when they get it wrong. The model provides a foundation for guiding how IR approaches compliance activity. COM was established to implement an intelligence-led compliance approach. COM is a collection of tools, resources, and best-practice methodologies. The key aspects are: Intelligence-Led identification of risks (Intelligence Led Compliance Approach - ILCA), having clarity and accountability in our decision-making and prioritisation process, Intervention design process for determining targeted solutions to compliance risks, and then measuring how effective we have been through monitoring and evaluation of our activities."@en ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://example.com/InlandRevenueModel#OperationalPlan> ;
        sem:guid          "40423528-e692-42d9-a98a-17a12819c2ae" ;
        skos:broader      <http://smartlogic.com/term#30053661404961800155266> ;
        skos:related      <http://example.com/InlandRevenueModel#OperatingModel> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ComplianceOperatingModel/ComplianceOperatingModel_en> .

<http://example.com/InlandRevenueModel#ComplianceOperatingModel/ComplianceOperatingModel_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Compliance Operating Model"@en .

<http://example.com/InlandRevenueModel#ComplianceStatus>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-27"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling."@en ;
        sem:guid          "d1b1d715-c315-40d6-8f4c-8e1ea24c0922" ;
        skos:broader      <http://example.com/InlandRevenueModel#PartyAttribute> ;
        skos:definition   "<p>Compliance status is an IR customer attribute that indicates whether a customer is meeting their obligations under Inland Revenue‑administered legislation, including filing required returns, providing required information, and paying amounts due, as assessed at a point in time.<br></p><p>Compliance status reflects observed behaviour against statutory obligations, not intent or risk. It is used to identify whether a customer has filed all required returns, identify whether amounts due have been paid or are appropriately managed (for example, under an approved arrangement), and inform decisions about interventions, audits, debt action, or support.<br></p>"@en ;
        skos:related      <http://smartlogic.com/term#193851481966191147796317981803790> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ComplianceStatus/ComplianceStatus_en> .

<http://example.com/InlandRevenueModel#ComplianceStatus/ComplianceStatus_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Compliance status"@en .

