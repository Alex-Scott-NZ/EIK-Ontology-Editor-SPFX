<http://example.com/InlandRevenueModel#FormalStatement>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Litigation - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A formal statement is defined as a statement recorded in any medium (e.g. in writing or on a CD) by a person who is a potential witness in a criminal proceeding where the statement contains the evidence of that witness and is accompanied by a declaration by the witness that the statement is true and was made in the knowledge that it is to be used in court proceedings. (There are other formal requirements if the person cannot read or is younger than 18.)"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS-I content"@en ;
        sem:guid          "e8289df8-4286-4400-a57a-c8d04ed80e12" ;
        skos:broader      <http://example.com/InlandRevenueModel#ComplianceInformation> ;
        skos:related      <http://example.com/InlandRevenueModel#Statement> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#FormalStatement/FormalStatement_en> .

