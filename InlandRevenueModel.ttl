<http://example.com/InlandRevenueModel#AccommodationSupplement>
        rdf:type          <http://smartlogic.com/class#Entitlement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Work & Income website"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A weekly payment which helps people with their rent, board or the cost of owning a home."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#AccommodationSupplement/AccommodationCostsArrearsGrant_en> , <http://example.com/InlandRevenueModel#AccommodationSupplement/AccommodationCostsInAdvanceGrant_en> , <http://example.com/InlandRevenueModel#AccommodationSupplement/AccommodationSecurityCoverGrant_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "PAS content"@en ;
        sem:guid          "9d65d8c0-55e9-4bfd-89e8-d8a7b1d0dd40" ;
        skos:broader      <http://example.com/InlandRevenueModel#Government-mandatedBenefit> ;
        skos:note         "<p>If you're worried you'll lose your housing because you owe accommodation costs, you may be able to get an Accommodation Costs Arrears Grant.<br></p><p>If you need to pay accommodation costs before moving in and don't have enough money, we may be able to help pay for this as the Accommodation Costs in Advance Grant.<br></p><p>You may find accommodation where your supplier needs assurance that costs can be paid for if you leave. If so, we may be able to provide that assurance using the&nbsp;Accommodation Security Cover Grant.<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#AccommodationSupplement/AccommodationSupplement_en> .

<http://example.com/InlandRevenueModel#AccommodationSupplement/AccommodationCostsArrearsGrant_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Accommodation Costs Arrears Grant"@en .

