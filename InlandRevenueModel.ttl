<http://example.com/Cleaned-Inland-Revenue-model#Two-relatives-test>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#Test0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A test which determines if two people are associated by relationship for tax purposes. This includes individuals who are married in a civil union or de facto relationship. It also includes those within two degrees of blood relationship, such as a sibling, parent or offspring. "@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website glossary"@en ;
        sem:guid          "dc9212a9-f5ef-48ce-a107-ede7be604924" ;
