        skos:broader      <http://example.com/NZ-IRD#Business-requirements-document> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ChangeInitiativeRequirementsOutput/ChangeInitiativeRequirementsOutput_en> .

