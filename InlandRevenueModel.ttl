<http://example.com/InlandRevenueModel#ThirdPartyContact>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IKM Team"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Review of Haukāinga top 100 from 2022"@en ;
        sem:guid          "3de6d0f2-1d86-4cf6-8514-1c06d0f57bb5" ;
        skos:broader      <http://smartlogic.com/term#188649781203397804479981> ;
        skos:definition   "<p>This is a term used in Inland Revenue to describe an organisation that holds information about their customers or funds for those customers. The Commissioner of Inland Revenue has powers under the tax acts to collect that information or deduct from funds they are holding in repayment of debt a cusomer may owe to Inland Revenue. Legislation is under - Information requests under section 17B of the Tax Administration Act 1994 (the TAA)\n<br>Deduction requests under section 157 of the TAA\n<br>Deduction requests under section 154 of the Child Support Act 1991. Organisations exclude employers but includes Banks, Councils, Credit Card companies, Credit Unions, Financial Institutions, Government agencies, Insurance companies, various utility providers and some other organisations.<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ThirdPartyContact/ThirdPartyContact_en> .

