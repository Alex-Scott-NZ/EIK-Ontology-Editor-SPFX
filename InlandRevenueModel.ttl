        sem:guid          "f1c01d59-7755-4d66-89be-da4ff68c3762" ;
        skos:broader      <http://example.com/InlandRevenueModel#StatusReport> ;
        skos:definition   "A project status report is a document providing stakeholders and team members with a concise, high-level update on a project's progress at a specific point in time. It compares current performance against the original project plan, summarizing key aspects such as completed work, upcoming tasks, budget, schedule, risks, and issues. The primary purpose of these regular reports is to ensure transparent communication, maintain alignment, identify potential problems early, and facilitate informed decision-making for the project's success. "@en ;
        skos:related      <http://example.com/InlandRevenueModel#ChangeManagementInformation> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ProjectStatusReport/ProjectStatusReport_en> .

