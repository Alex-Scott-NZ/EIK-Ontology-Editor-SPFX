<http://example.com/InlandRevenueModel#Revenue-SocialPolicy>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#Revenue-SocialPolicy/R-SP_en> , <http://example.com/InlandRevenueModel#Revenue-SocialPolicy/RSP_en> ;
        <http://example.com/IRD-test-model#Manages>
                <http://example.com/InlandRevenueModel#Unisys> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#MainframeAsAService> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Intranet"@en ;
        <http://example.com/InlandRevenueModel#UsesSystem>
                <http://example.com/Cleaned-Inland-Revenue-model#FIRST> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The purpose of the Revenue and Social Policy team is to operate and manage Inland Revenue’s Heritage Core Tax System (aka FIRST) by maintaining the physical environment and the COBOL application that allows Inland Revenue to collect and process Tax and disperse Social Policy. We ensure that FIRST is operating in the way it was designed and that the processing schedules are maintained and executed on a daily basis. We are responsible for the management of Unisys who deliver physical and technical support for the FIRST environment via the Mainframe as a Service (MFaaS) contract."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#Revenue-SocialPolicy/Rev-SocialPolicy_en> , <http://example.com/InlandRevenueModel#Revenue-SocialPolicy/RevenueAndSocialPolicy_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet; IT&C content"@en ;
        sem:guid          "faddb1ec-494f-40b2-b8d4-19d1888a34b9" ;
        skos:broader      <http://example.com/InlandRevenueModel#DevelopmentTeam> ;
        skos:historyNote  "<p>No longer in existence<br><br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Revenue-SocialPolicy/Revenue-SocialPolicy_en> .

