                true ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#BusinessAndCorporate> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><a href=\"https://irnz.sharepoint.com/sites/CORP-planning-design-and-delivery/SitePages/Performance-Analysis-and-Reporting.aspx?web=1\">Performance Analysis and Reporting</a>&nbsp;</p><p><br></p><p>A</p><p>nnual report 2020</p>"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "We measure performance across CCS to track our progress against priority outcomes. Performance measurement is more than just numbers and data. We can provide subject matter expertise to assist you to: translate performance objectives into measurable outcomes, choose or develop appropriate measures, interpret and analyse performance data, and build a performance narrative by incorporating qualitative insights and stories."@en ;
        <http://example.com/InlandRevenueModel-current-#ProducesAuthority>
                <http://example.com/InlandRevenueModel#MultiYearModel> ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#CorporatePlanning> , <http://example.com/InlandRevenueModel#CostsForecasting> , <http://example.com/InlandRevenueModel#OECDReporting> , <http://example.com/InlandRevenueModel#PerformanceReporting> , <http://smartlogic.com/term#184149025169191612011423> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Annual Report 2016; Intranet<!--EndFragment--><br/><br/><br/></p>"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://smartlogic.com/term#72194765388424808199295/CorporatePlanning-Reporting_en> ;
        sem:guid          "d04842d5-877e-539c-9717-5f2e8c772969" ;
        skos:broader      <http://example.com/InlandRevenueModel#StrategicPortfolioStewardship> ;
        skos:historyNote  "A team within Finance Services that provides reporting across the whole of IR. Corporate Planning & Reporting came into existence in 2014. This team changed under the future operating model. Enterprise Services, Finance Services Design 2020 to Performance & Reporting. Later moved into CCS PD&D."@en ;
        skosxl:altLabel   <http://smartlogic.com/term#72194765388424808199295/CorproatePlanning-Reporting_en> , <http://smartlogic.com/term#72194765388424808199295/SPSPerformance-Reporting_en> ;
