<http://example.com/InlandRevenueModel#SafetyDataSheet>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Isused-in-function>
                <http://example.com/InlandRevenueModel#StaffSafetyManagement> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#SafetyDataSheet/SDS_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#SafetyDataSheet/ServiceDesignSpecification_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">P&amp;C: H&amp;S content</span><br/><br/></p>"@en ;
        sem:guid          "4eefe56f-1d8f-41bf-a246-64cc9306e0ad" ;
        skos:broader      <http://example.com/InlandRevenueModel#OperationalServicesInformation> ;
        skos:definition   "A Safety Data Sheet (SDS) is a standardized document that provides detailed information about the hazards of a chemical or substance and how to use, store, and dispose of it safely. SDSs follow a consistent 16-section format developed by the Globally Harmonized System of Classification and Labelling of Chemicals (GHS) and include information on chemical identity, health hazards, first aid, emergency procedures, and personal protective equipment (PPE). Chemical manufacturers, importers, and suppliers are responsible for creating and providing SDSs to ensure workers and emergency personnel have the necessary information to prevent accidents and protect health and the environment."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SafetyDataSheet/SafetyDataSheet_en> .

<http://example.com/InlandRevenueModel#SafetyDataSheet/SDS_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
