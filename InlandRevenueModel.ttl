        skosxl:altLabel   <http://example.com/InlandRevenueModel#PublicAdviceAndGuidance/PublicAdvice-Guidance_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PublicAdviceAndGuidance/PublicAdviceAndGuidance_en> .

