<http://example.com/InlandRevenueModel#MinisterForMaoriCrownRelations>
        rdf:type          <http://example.com/IRD-test-model#Job-title0> ;
        <http://example.com/IRD-test-model#Manages>
                <http://example.com/InlandRevenueModel#CabinetMaoriCrownRelations-TeArawhiti> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/Cleaned-Inland-Revenue-model#Office-of-Treaty-Settlements> , <http://example.com/InlandRevenueModel#MaoriCrownRelations> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>Government website<br/><span class=\"rangySelectionBoundary\" id=\"selectionBoundary_1664255048669_07199673060532613\">&#65279;</span></p><p><span lang=\"mi-NZ\"><a href=\"https://www.beehive.govt.nz/sites/default/files/2020-12/Maori%20Crown%20Relations.pdf\"><u><font color=\"#0563c1\" face=\"Calibri\" size=\"3\">https://www.beehive.govt.nz/sites/default/files/2020-12/Maori%20Crown%20Relations.pdf</font></u></a></span></p><p><font face=\"Times New Roman\" size=\"3\"><br/><br/></font></p>"@en ;
        sem:guid          "20fe1ff9-8b5f-41e2-bd2d-387924a8e985" ;
        skos:broader      <http://example.com/IRD-test-model#Job-title> ;
        skos:definition   "The Minister for Māori Crown Relations: Te Arawhiti, has a stewardship role as the leader for Māori Crown relations. They  have oversight across the Crown’s broad work on improving and developing relationships and partnerships with Māori. They provide strategic leadership and set priorities for Māori Crown relations, alongside leading the priorities of the portfolio and monitoring the health of Māori Crown relationships. They chair the Cabinet Māori Crown Relations: Te Arawhiti Committee (MCR)."@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#MinisterForMaoriCrownRelations/MinisterForMaoriCrownRelationsTeArawhiti_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MinisterForMaoriCrownRelations/MinisterForMaoriCrownRelations_en> .

<http://example.com/InlandRevenueModel#MinisterForMaoriCrownRelations/MinisterForMaoriCrownRelationsTeArawhiti_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Minister for Māori Crown Relations Te Arawhiti"@en .

<http://example.com/InlandRevenueModel#MinisterForMaoriCrownRelations/MinisterForMaoriCrownRelations_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Minister for Māori Crown Relations"@en .

<http://example.com/InlandRevenueModel#MinisterOfCorrections>
        rdf:type          <http://example.com/IRD-test-model#Job-title0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsMemberOf>
                <http://example.com/InlandRevenueModel#MinisterialOversightGroupOnGangs> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://dpmc.govt.nz/cabinet/portfolios/corrections"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Responsibilities include oversight of the management of remand, community, and custodial sentences and orders, and policy to assist the rehabilitation and reintegration of offenders.<br/><br/></p>"@en ;
        sem:guid          "86e04882-34a6-4522-bb6c-aa53646ec0a5" ;
        skos:broader      <http://example.com/IRD-test-model#Job-title> ;
        skos:related      <http://example.com/InlandRevenueModel-current-#DepartmentOfCorrections> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MinisterOfCorrections/MinisterOfCorrections_en> .

