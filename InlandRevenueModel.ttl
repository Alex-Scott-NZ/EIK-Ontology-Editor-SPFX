                <http://smartlogic.com/term#733873855465831453299914748155375> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate Finance content"@en ;
        sem:guid          "d8b4022a-48ca-46c7-9cd7-6cfab60c4f7e" ;
        skos:broader      <http://example.com/InlandRevenueModel#PartyStatus> ;
        skos:definition   "A public benefit entity (PBE) is a reporting entity whose main goal is to provide community or social services, rather than generating profit for its owners. Any financial contributions to a PBE are made to support these societal objectives, not for financial gain. PBEs include many public sector organizations, like government departments and public schools, and most not-for-profit entities, such as charities. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PublicBenefitEntity/PublicBenefitEntity_en> .

