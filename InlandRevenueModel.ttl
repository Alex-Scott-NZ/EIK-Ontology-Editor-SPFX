<http://example.com/InlandRevenueModel#Families>
        rdf:type          <http://smartlogic.com/class#Party-classification> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#FamiliesCustomerSegment> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-06-22"^^xsd:date , "2023-06-23"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-customer-and-compliance-services/SitePages/Families-customer-segment.aspx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Our Families customers are those families eligible for the Families products and services we deliver for the Government – both now and in the future. Our current Families products are:<br/>• Working for Families tax credits<br/>• Child Support<br/>• Paid Parental Leave<br/></p><div><p>The vast majority of our Families customers have complex, changing lives and experience material hardship. Understanding the needs and characteristics of our different types of Families customers will help us tailor our products and services and deliver better outcomes to customers and Government.<br/></p></div>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS-I content"@en ;
        sem:guid          "b276681f-f80f-473f-af3c-b1157239ff00" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerSegment> ;
        skos:related      <http://example.com/InlandRevenueModel#FamilyBoost> , <http://smartlogic.com/term#46576892232815290578744> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Families/Families_en> .

