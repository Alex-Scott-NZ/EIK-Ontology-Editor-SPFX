<http://example.com/InlandRevenueModel#COVID-19ResurgenceSupportPaymentsScheme>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> , <http://example.com/InlandRevenueModel#NotCurrent> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/InlandRevenueModel#COVID-19ResurgenceSupportPaymentsScheme/CRSPScheme_en> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#Taxation-COVID-19ResurgenceSupportPaymentsAndOtherMatters-Act2021> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "A payment to help support viable and ongoing businesses or organisations due to a COVID-19 alert level increase to level 2 or higher. It was open from 28 February 2021 until 13 January 2022."@en ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#COVID-19ResurgenceSupportPaymentsScheme/CRSP_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ProductsWeAdminister> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Resurgence Support Payment scheme account - grant for businesses whose revenue has declined because of an alert level escalation."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#COVID-19ResurgenceSupportPaymentsScheme/RSP_en> , <http://example.com/InlandRevenueModel#COVID-19ResurgenceSupportPaymentsScheme/resurgenceSupportPayment_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR business products register"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#COVID-19ResurgenceSupportPaymentsScheme/PR.CS.004_en> ;
        sem:guid          "1481e6a1-7b48-4bc5-aa24-1f993de4a862" ;
        skos:broader      <http://example.com/InlandRevenueModel#COVID-19Support> ;
        skos:historyNote  "<p>All legislative instruments that established the RSP (including the March 2021, July 2021, and August 2021 schemes) have been formally revoked.<br>Revocation took effect on 29 March 2024 under the Taxation (Annual Rates for 2023–24, Multinational Tax, and Remedial Matters) Act 2024.<br></p>"@en , "Available from February 2021"@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#SignificantEnterprise> , <http://example.com/IRD-test-model#Social-policy-progamme> , <http://example.com/InlandRevenueModel-current-#MicroEnterprise> , <http://smartlogic.com/term#112899296556002745439879> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#COVID-19ResurgenceSupportPaymentsScheme/COVID-19ResurgenceSupportPaymentsScheme_en> .

