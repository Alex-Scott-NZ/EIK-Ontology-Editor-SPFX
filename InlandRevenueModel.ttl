<http://example.com/InlandRevenueModel-current-#AssociatedPerson>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "Persons and companies, trusts or partnerships which are associated with each other under tax law. For example, two companies (or a company and a person) with common voting interests and common market value interests; two relatives; a trustee and a beneficiary; or the settlor of a trust and trust's beneficiary."@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerSegmentsAndRoles> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "https://www.taxtechnical.ird.govt.nz/new-legislation/act-articles/2009-34/taxation/new-definitions-of-associated-persons-"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "When two parties to a transaction are closely related, for tax purposes they are considered associated persons. This has impacts for income tax, for GST and for credit transfers between customers."@en ;
        <http://example.com/InlandRevenueModel-current-#IsRoleRelatedTo>
                <http://example.com/Cleaned-Inland-Revenue-model#AssociatedPersonsTest> , <http://example.com/InlandRevenueModel#AssociatedTransaction> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel-current-#AssociatedPerson/ASS_NAME_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website glossary; Data Science & Analytics content"@en ;
        sem:guid          "1cf0fd09-0c35-41de-8cdc-9212e8faf855" ;
        skos:broader      <http://example.com/InlandRevenueModel#Business-relatedRoles> ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#AssociationRules> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel-current-#AssociatedPerson/AssociatedEntity_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#AssociatedPerson/AssociatedPerson_en> .

