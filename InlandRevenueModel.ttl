        sem:guid          "f4f00392-047b-4f9d-a570-9656264e9800" ;
        skos:broader      <http://example.com/IRD-test-model#Events> ;
        skos:definition   "<p>Natural Event means an event in which human activity plays little or no direct causal role. That is, an event caused by natural processes of the earth (including but not limited to snow storms, floods, wild fires, cyclones/hurricanes, tornadoes, volcanic eruptions, earthquakes, and tsunamis). <br/></p><div><p>A natural event is a naturally occurring physical occurrence. A hazard is a natural event that has the possibility to cause loss of life or economic damage. A natural disaster is when a natural event does cause loss of life and damage to property.<br/></p></div>"@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#NaturalEvent/NaturalDisaster_en> , <http://example.com/InlandRevenueModel#NaturalEvent/NaturalHazard_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#NaturalEvent/NaturalEvent_en> .

