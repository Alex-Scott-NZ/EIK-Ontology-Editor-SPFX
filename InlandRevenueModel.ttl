<http://example.com/InlandRevenueModel#ContentCreator>
        rdf:type          <http://example.com/NZ-IRD#Profession> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IKM Team"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p> </p><p><span style=\"font-size: 12.0pt\">Content creators (also known as Digital content creators) are people who make money from creating content including: online gamers, streamers, bloggers, influencers, artists and other creators of online or other content.</span></p><div><p><span style=\"font-size: 12.0pt\"><a href=\"https://aus01.safelinks.protection.outlook.com/?url=https%3A%2F%2Fwww.ird.govt.nz%2Fdigital-content-creators&amp;data=05%7C01%7CSally.Chivers%40ird.govt.nz%7C3cedf86855044321e02b08dbe16a1eb2%7Cfb39e3e923a9404e93a2b42a87d94f35%7C1%7C0%7C638351618111987258%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C3000%7C%7C%7C&amp;sdata=PiHo%2BHRGapK6KPdsIKbxDRceE6K5qp46FlJawO6S05o%3D&amp;reserved=0\">Making money online - digital content creators (ird.govt.nz)</a></span></p></div><div><p><span style=\"font-size:12.0pt;color:#37424A\"><a href=\"https://www.ird.govt.nz/digital-content-creators/content-creation-interpretation-statement\"><strong><span style=\"color:#0D8390\">Content creation interpretation statement</span></strong></a><br></span><span style=\"font-size:12.0pt;color:black\"><a href=\"https://www.taxtechnical.ird.govt.nz/-/media/project/ir/tt/pdfs/fact-sheets/2021/is-21-08-fact-sheet.pdf?modified=20210927212700&amp;modified=20210927212700\" class=\"on\">Interpretation Statement for Content Creators</a></span></p><p> </p></div>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ContentCreator/DigitalContentCreator_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR Topics"@en ;
        sem:guid          "9175e2ec-3279-4208-a9a2-b4cfce2d1cd6" ;
        skos:broader      <http://example.com/NZ-IRD#Profession0> ;
        skos:related      <http://example.com/InlandRevenueModel#Blogger> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ContentCreator/ContentCreator_en> .

