        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Isused-in-function>
                <http://example.com/InlandRevenueModel-current-#MinisterialReporting> , <http://example.com/InlandRevenueModel-current-#OfficialCorrespondenceManagement> ;
