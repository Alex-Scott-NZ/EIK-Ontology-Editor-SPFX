        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Recognised seasonal worker"@en .

<http://example.com/Cleaned-Inland-Revenue-model#Recognised-seasonal-worker/SeasonalWorker_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Seasonal worker"@en .

<http://example.com/Cleaned-Inland-Revenue-model#Record>
        rdf:type          <http://example.com/InlandRevenueModel#InformationClassification> , <http://example.com/NZ-IRD#Legally-defined-term> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "<p>A record or a class of records, in any form, in whole or in part, created or received (whether before or after the commencement of this Act) by a public office in the conduct of its affairs; and includes—<br/>(i) a record or a class of records declared under section 5(1)&#65279;(a)&#65279;(ii) of the Public Records Act 2005 to be a public record for the purposes of this Act; and<br/>(ii) estray records;<br/>but does not include—<br/>(i) a special collection; or<br/>(ii) records created by the academic staff or students of a tertiary education institution, unless the records have become part of the records of that institution.<br/></p>"@en ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/Cleaned-Inland-Revenue-model#Record/PurangoKorero_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://smartlogic.com/term#122639831737308025226634> ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Public Records Act 2005"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Any recorded information created, received and maintained by an organisation or a person, irrespective of its form, medium or characteristics. The Public Records Act defines a record as created or received by a public office in the conduct of its affairs. "@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/Cleaned-Inland-Revenue-model#Record/PurangoKorero_en0> ;
        <http://example.com/NZ-IRD#Is-defined-by>
                <http://smartlogic.com/term#63028134026363112740203230589654> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Glossary of IM terms; IM content"@en ;
        sem:guid          "50c1d318-1988-48f2-ae68-9453ce60054b" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#InformatonType> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#Record/Record_en> .

