        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Enterprise Architecture content"@en ;
        sem:guid          "d82e1e73-f186-435c-bdb1-c3d169102db5" ;
        skos:broader      <http://smartlogic.com/term#188519164724691362719453> ;
        skos:definition   "<p>The New Zealand Payroll Practitioners' Association (NZPPA) is New Zealand's leading professional body for payroll, established in 2007 to develop and recognize the payroll profession. It offers technical training, certification, resources, and supports its members through a dedicated advice line, community forums, and events like the annual conference. NZPPA also acts as an independent voice, raising issues, concerns, and risks impacting payroll practitioners with government bodies and other organizations.<br><br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#NewZealandPayrollPractitioners-Association/NewZealandPayrollPractitioners-Association_en> .

