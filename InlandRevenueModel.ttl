<http://example.com/InlandRevenueModel#NationalDrugIntelligenceBureau>
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#NationalDrugIntelligenceBureau/NDIB_en> ;
