<http://example.com/InlandRevenueModel#TransnationalOrganisedCrime>
        rdf:type          <http://smartlogic.com/class#Offence> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#TransnationalOrganisedCrime/TNOC_en> ;
