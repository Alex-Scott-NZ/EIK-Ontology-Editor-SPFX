        skos:broader      <http://example.com/InlandRevenueModel#Qualification> ;
        skos:definition   "<p>An occupational qualification is official recognition that someone is allowed to work in a particular occupation, achieved through learning and demonstrating capability in the workplace.</p><p><br></p><p>An occupational qualification:&nbsp;applies at the occupation level, not just a single job or employer;&nbsp;confers recognised occupational standing or eligibility;&nbsp;may be gained wholly or partly through work‑based learning;&nbsp;is based on demonstrated outcomes, not time spent training; and&nbsp;is distinct from roles, competence, or experience unless formally recognised</p>"@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#WorkplaceQualification/WorkplaceQualification_en0> , <http://example.com/InlandRevenueModel#WorkplaceQualification/work-basedQualification_en> ;
