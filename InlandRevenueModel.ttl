                <http://example.com/InlandRevenueModel#VerintWFM> , <http://example.com/InlandRevenueModel#WorkforceManagement0> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Wikipedia"@en ;
        <http://example.com/InlandRevenueModel#usedInME3ValueSet>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>An institutional process that maximizes performance levels and competency for an organization. It is integrated and demand-oriented to optimize the scheduling of staff. Besides the two core aspects of demand-orientation and optimization, workforce management may also incorporate: <br/>- forecasting of workload and required staff<br/>- involvement of employees into the scheduling process<br/>- management of working times and accounts<br/>- analysis and monitoring of the entire process.<br/></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#WorkforceManagement/CurrentWorkforce_en> , <http://example.com/InlandRevenueModel#WorkforceManagement/PeopleMetrics_en> , <http://example.com/InlandRevenueModel#WorkforceManagement/PeoplePractices_en> , <http://example.com/InlandRevenueModel#WorkforceManagement/PersonnelProfile_en> , <http://example.com/InlandRevenueModel#WorkforceManagement/WorkforceNumbers_en> , <http://example.com/InlandRevenueModel#WorkforceManagement/Workload_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Our Corporate Strategy - People 2016"@en ;
        sem:guid          "b3f1969a-79c2-4450-a2be-635e305919a0" ;
        skos:broader      <http://smartlogic.com/term#144339026141687964061284> ;
