<http://example.com/InlandRevenueModel#PerformanceMeasurementFramework>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#PerformanceMeasurementFramework/PMF_en> ;
        <http://example.com/InlandRevenueModel#HasMeasure>
                <http://smartlogic.com/term#195231629517553071992823> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#PerformanceMeasurementFramework/ProjectManagementFramework_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-strategic-portfolio-stewardship/SitePages/Performance-Measurement-Framework.aspx?web=1"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Our Performance Measurement Framework shows how we use our resources to deliver our services, and how our services connect with the outcomes we want to achieve for our customers and Aotearoa New Zealand. We use our Performance Measurement Framework to monitor the progress we’re making towards the outcomes we want to achieve for New Zealanders. The PMF has four layers; the outcomes we'll achieve, the difference we'll make, the services we'll deliver for customers and how we work. We review the PMF and measures each year to ensure they are fit for purpose. "@en ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://example.com/IRD-test-model#Performance-measurement> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website; Intranet; Corporate Finance content"@en ;
        sem:guid          "45aa22e2-7f34-4f81-9bed-73bb6c59722c" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Enterprise-model> ;
        skos:definition   "A performance measurement framework (PMF) is a structured system for defining, tracking, and evaluating performance against set objectives and goals. It connects strategic goals with specific performance indicators, metrics, and data sources, providing a clear way to understand progress and make informed decisions. By establishing clear measures and evaluation processes, a PMF helps organizations, projects, or teams to achieve their targets, identify areas for improvement, and ensure alignment with overall strategy."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PerformanceMeasurementFramework/PerformanceMeasurementFramework_en> .

<http://example.com/InlandRevenueModel#PerformanceMeasurementFramework/PMF_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "PMF"@en .

<http://example.com/InlandRevenueModel#PerformanceMeasurementFramework/PerformanceMeasurementFramework_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
