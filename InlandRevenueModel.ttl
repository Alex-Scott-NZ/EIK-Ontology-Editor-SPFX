<http://example.com/InlandRevenueModel#IOTA>
        rdf:type          <http://example.com/InlandRevenueModel-current-#Currency> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#NotInNPT>
                <http://example.com/InlandRevenueModel#IOTA/IOTASecretariat_en> , <http://example.com/InlandRevenueModel#IOTA/iota-tax.org_en> ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#IOTA/Intra-EuropeanOrganisationOfTaxAdministrations_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://www.iota.org/"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Wikipedia"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "IOTA's Tangle is an open, feeless and scalable distributed ledger, designed to support frictionless data and value transfer. The IOTA network is built for the Internet of Things (IoT), with tamper-proof data, feeless micro transactions and low resource requirements. The Tangle is IOTA's network. It immutably records the exchange of data and value. It ensures that the information is trustworthy and cannot be tampered with nor destroyed. IOTA is intended to enable economic relationships between machines and in bridging the human and machine economies."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet"@en ;
        sem:guid          "ca13fb8c-3819-488a-bb2c-fda06e343631" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Cryptocurrency> ;
        skos:definition   "IOTA is an open-source distributed ledger and cryptocurrency designed for the Internet of things. It uses a directed acyclic graph to store transactions on its ledger, motivated by a potentially higher scalability over blockchain based distributed ledgers."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IOTA/IOTA_en> .

