        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Government speech. </p><!--StartFragment--><p><a href=\"https://www.beehive.govt.nz/speech/our-e-government-objectives\"></a></p><p><a href=\"https://www.beehive.govt.nz/speech/our-e-government-objectives\"></a><a href=\"https://www.beehive.govt.nz/speech/our-e-government-objectives\">Our e-government objectives | Beehive.govt.nz</a></p><!--EndFragment--><p><br/></p>"@en ;
        sem:guid          "72694d3a-e829-4154-aaf1-3d3890f572b4" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#StateServicesCommission> ;
        skos:definition   "Digital government is about putting people first. We’re focusing on what people need from government in these fast-changing times and how we can meet their needs using emerging technologies, data and changes to government culture, practices and processes. The Public Service Commissioner is taking overall accountability for the e-government programme, and an advisory board of public sector chief executives, local government and private sector representatives is being formed to support the Commissioner. The e-government programme officially started on 1 July 2000."@en ;
        skos:historyNote  "A unit within the State Services Commission established in 2000. Superseded by NZ Digital Government in 2018."@en ;
        skos:related      <http://example.com/InlandRevenueModel#All-of-governmentWork> , <http://example.com/InlandRevenueModel#AoGService> , <http://smartlogic.com/term#34015113214144524595531> ;
