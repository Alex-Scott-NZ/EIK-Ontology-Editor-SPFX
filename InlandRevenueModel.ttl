<http://example.com/InlandRevenueModel#DepartmentalAccounting>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#DepartmentalAccounting/KauteA-Tari_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-finance-services/SitePages/What-we-do.aspx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Our departmental team manages departmental financial statements and The Treasury fiscal updates, ensures IR meets its tax obligations, and provides an enterprise view on financial performance. The team helps IR to understand and meet their financial stewardship responsibilities in line with the Public Finance Act, and provides accounting and financial advice and support across IR. They also manage external baseline update and appropriation processes. The team also provides accounts receivable and accounts payable services."@en ;
        <http://example.com/NZ-IRD#Does-activity>
