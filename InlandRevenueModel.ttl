        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span lang=\"mi-NZ\"><font face=\"Calibri\" size=\"3\"><a href=\"https://irnz.sharepoint.com/sites/kc-tax-law-community/SitePages/TLC%20expertise.aspx\">https://irnz.sharepoint.com/sites/kc-tax-law-community/SitePages/TLC%20expertise.aspx</a></font></span></p><p><font face=\"Times New Roman\" size=\"3\"><br/><br/></font></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Technical Information Sharing Meeting forum enables technical and operational staff opportunity to network and build relationships and to raise awareness of issues arising throughout IR. "@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "TCO intranet"@en ;
        sem:guid          "4350a2e8-68da-4a07-8e3f-14c8e4b04443" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
