<http://example.com/InlandRevenueModel#TeMatawai>
        rdf:type          <http://example.com/IRD-test-model#System> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p> </p><p>https://irnz.sharepoint.com/sites/TeMatawai/SitePages/About-Te-M%C4%81t%C4%81wai.aspx</p><p> </p>"@en ;
        <http://example.com/InlandRevenueModel#SupportsActivity>
                <http://smartlogic.com/term#56119831397991336249604> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p style=\"text-align: left\"><span style=\"background-color: rgb(244, 244, 244);color: rgb(55, 66, 74) !important\">Te Mātāwai</span>&nbsp;is the primary source for&nbsp;<span style=\"background-color: rgb(244, 244, 244);color: rgb(55, 66, 74) !important\">Inland Revenue</span>'s internal knowledge content. This is material that provides us with instruction and guidance for making decisions and completing our work.<br></p><p style=\"text-align: left\"><br>Te Mātāwai connects to&nbsp;<span style=\"background-color: rgb(244, 244, 244);color: rgb(55, 66, 74) !important\">Haukāinga</span>, enabling us to search and easily find what we need from across all of Inland Revenue's core information and knowledge sources.</p>"@en ;
        sem:guid          "2df494cc-6594-4ac3-bf02-de0e1e481a0b" ;
        skos:broader      <http://smartlogic.com/term#47372529931203401780288> ;
        skos:related      <http://smartlogic.com/term#23614112459887975098408> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TeMatawai/TeMatawai_en> .

