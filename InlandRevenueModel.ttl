        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Work and Income A-Z of benefits"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The student allowance is for full-time students who are on an approved study course at a recognised institution. It is paid by Work and Income to help students with their living costs while they study full-time. It is paid weekly and the student doesn't have to pay back (unlike a student loan)."@en ;
        <http://example.com/NZ-IRD#Is-entitlement-of>
                <http://example.com/Cleaned-Inland-Revenue-model#Student> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS content"@en ;
        sem:guid          "b312cb42-e0e5-4b4b-822e-0ecc6f7ee210" ;
        skos:broader      <http://example.com/InlandRevenueModel#Government-mandatedBenefit> ;
        skos:definition   "A Student Allowance is a weekly payment paid by StudyLink, that can help with your living expenses while you’re studying."@en ;
        skos:related      <http://example.com/InlandRevenueModel#AccommodationBenefit> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#StudentAllowance/StudentAllowance_en> .

