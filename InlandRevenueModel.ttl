        sem:guid          "d6a3f487-06f6-407c-9986-98b52471ac8c" ;
        skos:broader      <http://smartlogic.com/term#130710328707508168484707> ;
        skos:definition   "The Falkland Islands (Spanish: Islas Malvinas), commonly referred to as The Falklands, is an archipelago in the South Atlantic Ocean on the Patagonian Shelf. The principal islands are about 300 mi (500 km) east of South America's southern Patagonian coast and 752 mi (1,210 km) from Cape Dubouzet at the northern tip of the Antarctic Peninsula, at a latitude of about 52°S. The archipelago, with an area of 4,700 sq mi (12,000 km2), comprises East Falkland, West Falkland, and 776 smaller islands."@en ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#FalklandIslands/Falklands_en> , <http://example.com/Cleaned-Inland-Revenue-model#FalklandIslands/IslasMalvinas_en> , <http://example.com/Cleaned-Inland-Revenue-model#FalklandIslands/Malvinas_en> , <http://example.com/Cleaned-Inland-Revenue-model#FalklandIslands/TheFalklands_en> ;
