<http://example.com/InlandRevenueModel#OrganisationDevelopmentCommittee>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#OrganisationDevelopmentCommittee/ODC_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IKM-compiled definition taken from a number of internal sources."@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The purpose of the ODC is to govern the development and implementation of IR's organisation development and ensure IR is well placed to achieve its transformation  agenda, the parameters of which are set by the Strategic Governance Board."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#OrganisationDevelopmentCommittee/OrganisationDevelopmentCommittee_en0> , <http://example.com/InlandRevenueModel#OrganisationDevelopmentCommittee/OrganisationalDesignCouncil_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Governance & Integrity content"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#OrganisationDevelopmentCommittee/OrganisationDesignCouncil_en> ;
        sem:guid          "a008fe46-6f25-4ebd-91da-fbfb0dc1bba0" ;
        skos:broader      <http://example.com/InlandRevenueModel#_PreviousBoards-CommitteesOrGroups-> ;
        skos:historyNote  "ODC was originally Organisation Design Council before it became Organisation Development Committee. In that latter incarnation, it ran from August 2017 to December 2019. Was approved to be place in hiatus in February 2020 by CIR with responsibilities passing to SBG at high level. In August 2020 was approved by CIR that this committee would not be restarted, alongside Customer Centric Committee and Performance and Investment Committee as IR would move forward with streamlined executive level governance model."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#OrganisationDevelopmentCommittee/OrganisationDevelopmentCommittee_en> .

