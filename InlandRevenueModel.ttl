<http://example.com/InlandRevenueModel#ICRAssessment>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://www.treasury.govt.nz/sites/default/files/2021-07/icr-results-analysis-jul21.pdf\" class=\"on\">Investor Confidence Rating Results Analysis: Round 1 and Round 2 (treasury.govt.nz)</a>​<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet"@en ;
        sem:guid          "4eac4de7-2bfb-4d18-8111-0b5e6240375d" ;
        skos:broader      <http://example.com/InlandRevenueModel#Audit> ;
        skos:definition   "<p> </p><p style=\"text-align: left\">The Investor Confidence Rating (ICR) was a 3-yearly assessment of the performance of investment-intensive agencies in managing investments and assets that are critical to the delivery of NZ government services.</p><p style=\"text-align: left\">The ICR provided an indication of the level of confidence that investors (such as Cabinet and Ministers) can have in an agency’s ability to realise a promised investment result if funding was committed.</p><p> The results were expressed in a range from A (high confidence) to E (very low confidence). Inland Revenue was one of the agencies that receives a rating. Inland Revenue received an A rating in both Round 1 over 2015 – 2017 (23 agencies), and; Round 2 over 2018 – 2020 (23 agencies).</p><p> </p>"@en ;
        skos:historyNote  "<p>​<span style=\"color: rgb(33, 37, 41);font-size: 18px\">In August 2023, Cabinet agreed to cease the ICR because the design and execution of the ICR was not meeting the government’s needs for an accurate assessment of agency capability. It was resulting in significant compliance and consultancy costs for agencies and was not delivering on its value proposition.</span>​<br></p>"@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#ICRAssessment/ICRReview_en> , <http://example.com/InlandRevenueModel#ICRAssessment/InvestorConfidenceRatingAssessment_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ICRAssessment/ICRAssessment_en> .

<http://example.com/InlandRevenueModel#ICRAssessment/ICRAssessment_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "ICR assessment"@en .

<http://example.com/InlandRevenueModel#ICRAssessment/ICRReview_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "ICR review"@en .

<http://example.com/InlandRevenueModel#ICRAssessment/InvestorConfidenceRatingAssessment_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Investor Confidence Rating assessment"@en .

