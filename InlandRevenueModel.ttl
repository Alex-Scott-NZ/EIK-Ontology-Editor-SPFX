        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p></p><p><font face=\"Calibri\" size=\"3\"><a href=\"https://irnz.sharepoint.com/sites/CORP-finance-services/SitePages/What-we-do.aspx\">https://irnz.sharepoint.com/sites/CORP-finance-services/SitePages/What-we-do.aspx</a></font></p><p><font face=\"Times New Roman\" size=\"3\"><br/><br/></font></p><p></p>"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A team in Finance Services part of Enterprise Services that: <br/>Facilitates the accounting, collection and disbursement of tax and social policy payments on behalf of the Crown and provides financial advice and support across IR and the broader sector in relation to tax and social policy.<br/>Also manages estimation processes for tax revenue and the valuation of key Crown financial assets.</p>"@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#CrownAccounting> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>From list of IR Business Units September 2022.<br/>Māori term from </p><p><font face=\"Calibri\" size=\"3\"><a href=\"https://irnz.sharepoint.com/sites/CORP-finance-services/SitePages/What-we-do.aspx\">https://irnz.sharepoint.com/sites/CORP-finance-services/SitePages/What-we-do.aspx</a></font></p><p><font face=\"Times New Roman\" size=\"3\"><br/><br/></font></p>"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#CrownAccounting0/CrownAccounting_en0> ;
        sem:guid          "9a101e5a-58db-48b7-b5bc-7a153685e009" ;
        skos:broader      <http://smartlogic.com/term#10443228204537226919348> ;
        skos:historyNote  "Crown Accounting change of name to Non-departmental Accounting under Finance Services as a result of IR's future operating model organisational change November 2020."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CrownAccounting0/CrownAccounting_en> .

