<http://example.com/InlandRevenueModel-current-#LicenceToOccupy>
        rdf:type          <http://smartlogic.com/class#Agreement> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel-current-#LicenceToOccupy/LTO_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "add543d4-2aaf-4246-bfcb-679b4ebf04e8" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#LandUseConsent> ;
        skos:definition   "In New Zealand, a Licence to Occupy (LTO) is a personal agreement that grants an individual the contractual right to use and occupy a specific area of property without giving them legal ownership of the land or dwelling. It creates a personal right rather than a legal interest over the property. LTOs are commonly used in retirement villages, where residents purchase the right to live in a unit, and for occupying land, such as Māori freehold land, or private property like a room in a house. "@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Personal-agreement> , <http://example.com/InlandRevenueModel#MaoriLand> , <http://smartlogic.com/term#626828363193787787922039407173040> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#LicenceToOccupy/LicenceToOccupy_en> .

<http://example.com/InlandRevenueModel-current-#LicenceToOccupy/LTO_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "LTO"@en .

