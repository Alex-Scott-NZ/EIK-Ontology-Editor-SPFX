        sem:guid          "f28a914d-0bd4-4a68-80e7-30ca701f8065" ;
        skos:broader      <http://smartlogic.com/term#41270193211275050540129> ;
        skos:definition   "A stated limit or boundary that, if stayed within, protects a person or business from additional tax, penalties, interest, or more complex rules. The threshold is usually an amount, percentage, or value. If you are at or below the threshold, simpler rules apply and extra charges or compliance obligations are avoided. If you exceed the threshold, stricter rules, adjustments, or penalties may apply."@en ;
