        skos:broader      <http://example.com/InlandRevenueModel#Ex-spouseOrPartner> ;
        skos:definition   "<p>A paying spouse or partner is the person who is required to pay money to their former spouse or partner to help support them after a relationship has ended.</p><p>The payment:</p><p><br></p><p>•\tIs made under a court order or a voluntary domestic maintenance agreement</p><p><br></p><p>•\tIs intended to support the former spouse or partner, not children</p><p><br></p><p>•\tIs usually paid regularly, but can also be a lump sum</p><p><br></p><p>For child support, the paying spouse or partner is known as the liable parent.</p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PayingSpouseOrPartner/PayingSpouseOrPartner_en> .

