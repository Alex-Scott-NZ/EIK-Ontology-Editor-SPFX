        skos:broader      <http://example.com/IRD-test-model#Tax-code> ;
        skos:definition   "Tailored tax codes help people pay the right amount of tax when they get paid, which means they'll avoid a large tax bill or refund at the end of the year."@en ;
        skos:historyNote  "Special tax codes were renamed to Tailored tax codes from April 2019."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#STC> , <http://example.com/Cleaned-Inland-Revenue-model#WT> ;
