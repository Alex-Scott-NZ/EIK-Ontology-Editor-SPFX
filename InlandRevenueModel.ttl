<http://example.com/InlandRevenueModel-current-#Non-activeTrust>
        rdf:type          <http://smartlogic.com/class#Taxpayer> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel#Non-activeTrustDeclaration> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>​Is a trust that throughout the tax year has: not derived or been deemed to have derived any income, and no deductions, and not been party to or perpetuated or continued with any transactions with assets of the trust which during the tax year: gave rise to income for any person, or gave rise to fringe benefits to any employee or former employee.<br/>Minor annual holding costs and small amounts of interest earned can be ignored such as: reasonable fees paid to professional trustees to administer the trust, or bank charges or other minimal administration costs totalling not more than $200 in the tax year, or interest earned on trust assets in any bank account during the tax year, to the extent to which the total interest does not exceed $200, or insurance, rates and other expenditure incidental to the occupation of a dwelling owned by the trust and incurred by the beneficiaries of the trust.<br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Search terms"@en ;
        sem:guid          "708863ff-70c0-44b3-affd-9d75ed210b9f" ;
        skos:broader      <http://smartlogic.com/term#256314115914621774342898064281208> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#Non-activeTrust/Non-activeTrust_en> .

<http://example.com/InlandRevenueModel-current-#Non-activeTrust/Non-activeTrust_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Non-active trust"@en .

<http://example.com/InlandRevenueModel-current-#Non-attributedBenefit>
        rdf:type          <http://smartlogic.com/class#Income> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IR website"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>​Some fringe benefits can be treated as non attributed benefits, so even if you're using the multi rate you don't have to calculate FBT on them individually for each employee. These are: Subsidised transport of less than $1,000 per employee per year; Employer superannuation/insurance contributions up to $1,000 per employee per year; Loans on life insurance policies; Benefits which you can't attribute to particular employees (for example, pooled vehicles); Benefits provided to ex-employees; Sick, accident or death fund contributions of less than $1,000 per employee per year; Any other benefit with a taxable value of less than $2,000 per employee per year.<br/>FBT applies to these benefits as follows: Pooled/shared benefits that can't be attributed to an individual employee - FBT is charged at the second-to-highest rate on benefits to regular employees, or the highest rate if any of the recipients are major shareholder employees (with 10% interest or control of the company). Benefits that can be attributed to individual employees - Benefits to major shareholder employees (with 10% interest or control of the company) have FBT charged at the highest rate. Benefits to other employees have FBT charged at the second-to-highest rate. Specific FBT rates change when the income tax rates change, refer to START Help: Calculate Fringe Benefit Tax.</p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "3b77d177-805b-4115-8bd8-f42ea6ac088f" ;
        skos:broader      <http://smartlogic.com/term#149875302260300491260325> ;
        skos:definition   "A pooled or shared fringe benefit that is not assigned to an individual employee. This option is useful when all employees have the same or similar rights to a particular benefit. For example, a work motor vehicle that everyone can use."@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel-current-#Non-attributedBenefit/Non-attributedFringeBenefit_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#Non-attributedBenefit/Non-attributedBenefit_en> .

<http://example.com/InlandRevenueModel-current-#Non-attributedBenefit/Non-attributedBenefit_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Non-attributed benefit"@en .

<http://example.com/InlandRevenueModel-current-#Non-attributedBenefit/Non-attributedFringeBenefit_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Non-attributed fringe benefit"@en .

