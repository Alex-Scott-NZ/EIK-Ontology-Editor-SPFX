<http://smartlogic.com/term#650811096916297130982251982071421>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> , <http://example.com/NZ-IRD#Legally-defined-term> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-26"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://www.taxtechnical.ird.govt.nz/-/media/project/ir/tt/pdfs/interpretation-statements/2021/is-21-07.pdf?modified=20210902215208\">is-21-07.pdf</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A person who is not resident in New Zealand for the purposes of GST."@en ;
        <http://example.com/NZ-IRD#Is-defined-by>
                <http://example.com/Cleaned-Inland-Revenue-model#GoodsAndServicesTaxAct1985-S2-1-> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Business Rules Modelling Analysis<!--EndFragment--><br/><br/><br/></p>"@en ;
        sem:guid          "d3a6fe5c-7a34-52c9-bca9-ba17c1ef2952" ;
        skos:broader      <http://smartlogic.com/term#720171291546130472949337736176450> ;
        skos:definition   "<p>A person is a GST non‑resident if they do not meet the definition of “resident” in section 2 of the Goods and Services Tax Act 1985.&nbsp;It depends on presence, activity, and place, not citizenship or visa.&nbsp;A person can be&nbsp;GST non‑resident but income‑tax resident;&nbsp;GST resident for one activity but non‑resident for another (“to the extent of” rule).</p><p><br></p><p>The GST definition of resident differs from the income tax definition - by extending it to include a person who is carrying on a taxable activity or other&nbsp;activity in New Zealand, if that person has a “fixed or permanent” place in New&nbsp;Zealand and that place relates to the activity in New Zealand. In this case the&nbsp;residency is “to the extent” of the New Zealand activity.&nbsp;For unincorporated bodies, it provides for a residence test based on its centre of&nbsp;administrative management.&nbsp;For individuals, the definition differs for the commencement and end dates of&nbsp;residency when applying the day-count test.<br></p><p><br></p><p>An entity is non-resident to the extent of any taxable or other activity carried on in New Zealand if they have no fixed or permanent place in New Zealand relating to that activity.&nbsp;An unincorporated body is non-resident if its centre of administrative management is not New Zealand.&nbsp;Individuals — day‑count test.&nbsp;An individual is GST non-resident if they are not present in New Zealand for more than 183 days in any 12‑month period.</p><p><br></p>"@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#GST-resident> , <http://example.com/Cleaned-Inland-Revenue-model#Non-resident-GST-business-claimant> ;
        skosxl:prefLabel  <http://smartlogic.com/label#650811096916297130982251982071421_English> .

<http://smartlogic.com/term#65142242106862688814301>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#IRAuthority> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel-current-#TaxAdministration-BindingRulings-Regulations1999> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsOutcomeOf>
                <http://smartlogic.com/term#79107715728436800124080> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://smartlogic.com/term#52626409703361480773803> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Decisions given by the Commissioner are binding and cannot be altered provided all the facts given are correct and do not change. "@en ;
        sem:guid          "d74a7f44-cf03-59aa-923b-48da3e182fc1" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Inland-Revenue-authority> ;
        skos:definition   "Inland Revenue's interpretation of how a tax law applies to a particular arrangement. An arrangement is any agreement, contract, plan or understanding (whether enforceable or not), including any steps and transactions that carry it into effect. If a binding ruling applies to a taxpayer, and they follow it, Inland Revenue is bound by it (provided that the taxpayer has entered into the arrangement exactly as described in the ruling, and that they satisfy any stated assumptions or conditions)."@en ;
        skos:related      <http://example.com/InlandRevenueModel#CustomerAdvice> ;
        skosxl:prefLabel  <http://smartlogic.com/label#65142242106862688814301_English> .

