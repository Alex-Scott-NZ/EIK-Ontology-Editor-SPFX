                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Business Transformation CIRO template."@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Change Initiative Requirements Output (CIRO) is used as the basis for change management in the Blueprint phase of Business Transformation. It consists of the following main components: Positioning - includes problem and vision statements, to provide an executive summary position of current and future states; and Requirements - contains the current and future state information relevant to business and stakeholder requirements (stakeholder profiles and impacts are included to provide context and focus)."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ChangeInitiativeRequirementsOutput/CIROs_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
