<http://example.com/InlandRevenueModel#BaseErosionProfitShiftingReporting>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> , <http://example.com/InlandRevenueModel#NotCurrent> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#Taxation-NeutralisingBaseErosionAndProfitShifting-Act2018> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/Cleaned-Inland-Revenue-model#BaseErosionAndProfitShifting> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The Taxation (Neutralising Base Erosion and Profit Shifting) Act 2018 made a series of changes to New Zealand's international tax rules in response to the OECD/G20's BEPS project.&nbsp;A BEPS disclosure must be completed if the hybrid and branch mismatch rules, or interest limitation rules, apply.<br>Note: From the 2025 income year onwards, the BEPS work paper IR1250 should be held alongside the work papers prepared to support your income tax return filing. The form does not need to be provided with the income tax return.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR products - international disclosures"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#BaseErosionProfitShiftingReporting/PR.ID.001_en> ;
        sem:guid          "4fd2ad57-08e7-4c1e-830e-39454d2530fb" ;
        skos:broader      <http://example.com/InlandRevenueModel#InternationalDisclosures> ;
        skos:historyNote  "Created in 2018. Expired from 2025. Now rolled into Country-by-country reporting."@en ;
        skos:related      <http://example.com/InlandRevenueModel#Country-by-countryReporting> , <http://example.com/InlandRevenueModel#FinancialReporting> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#BaseErosionProfitShiftingReporting/BEPSDisclosures_en> , <http://example.com/InlandRevenueModel#BaseErosionProfitShiftingReporting/BEPSReporting_en> , <http://example.com/InlandRevenueModel#BaseErosionProfitShiftingReporting/BaseErosionProfitShiftingReporting_en0> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#BaseErosionProfitShiftingReporting/BaseErosionProfitShiftingReporting_en> .

