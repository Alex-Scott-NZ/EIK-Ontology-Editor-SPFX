<http://example.com/InlandRevenueModel#QualifyingRecognisedOverseasPensionScheme>
        rdf:type          <http://example.com/InlandRevenueModel#FinancialProduct> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#QualifyingRecognisedOverseasPensionScheme/QROPS_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://www.qropsnz.com/nz-qrops/what-is-qrops/\">What is QROPS? – QROPS New Zealand</a>​<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "9ab43f50-80b2-413a-971b-000e64c29332" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Foreign-superannuation-scheme> ;
        skos:definition   "<p>If you’ve recently moved from overseas and are now calling New Zealand home, you might be asking, “What is a QROPS Pension?”. Simply put, a Qualifying Recognised Overseas Pension Scheme (QROPS) is an overseas pension scheme that mimics a UK pension scheme but often provides more significant benefits. In straightforward terms, a QROPS is a pension scheme set up outside the UK that mimics a UK pension scheme because it follows most of the same rules set in the UK. And because a QROPS mimics a UK pension scheme, the UK authorities will allow people to transfer their pensions into them, provided that the QROPS agrees to some conditions.<br><br></p>"@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Pension> , <http://example.com/Cleaned-Inland-Revenue-model#United-Kingdom> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#QualifyingRecognisedOverseasPensionScheme/QualifyingRecognisedOverseasPensionScheme_en> .

<http://example.com/InlandRevenueModel#QualifyingRecognisedOverseasPensionScheme/QROPS_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "QROPS"@en .

