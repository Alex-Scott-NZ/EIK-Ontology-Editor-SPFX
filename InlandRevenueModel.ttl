        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span>Glossary of terms from IR's Initiative Management Framework<br/>document. May 2022.<br/></span></p><p><span style=\"color: black;\"><a href=\"https://irnz.sharepoint.com/sites/CORP-strategic-portfolio-stewardship/SupInfo/Forms/AllItems.aspx?id=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo%2FInitiative%20Management%20Framework%2Epdf&amp;parent=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo\"><span style=\"color: #337ab7;\">Tiakitanga Kohinga<br/>Rautaki - Strategic Portfolio Stewardship - Initiative Management Framework.pdf<br/>- 1) All Documents (sharepoint.com)</span></a></span></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "At each of these points, work is reviewed to decide whether the initiative can move to the next stage of the initiative lifecycle."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS content"@en ;
        sem:guid          "1a6575b0-d93d-4c94-b44e-2bf62f00d0bd" ;
