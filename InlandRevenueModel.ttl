        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Oracle website"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Oracle Enterprise Manager (OEM or EM) is a set of web-based tools aimed at managing software and hardware produced by Oracle Corporation as well as by some non-Oracle entities. It is used in Ātea and for SAP/MIRI support."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#OracleEnterpriseManager/OracleManagementServer_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IT&C content"@en ;
        sem:guid          "07ae1510-0c87-4d3f-8373-dd415bf3f218" ;
        skos:broader      <http://smartlogic.com/term#47372529931203401780288> ;
        skos:definition   "Oracle Enterprise Manager (OEM) is an on-premises software suite for centralized monitoring, management, and automation of Oracle environments, including databases, applications, middleware, and hardware. It provides a single console to manage cloud and on-premises systems, offering features like lifecycle management, patching, performance tuning, and real-time integration with Oracle's knowledge base."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#OracleEnterpriseManager/OracleEnterpriseManager_en> .

