        sem:guid          "c6fa4b45-a65a-4a26-bec0-71ed0004ff62" ;
        skos:broader      <http://example.com/IRD-test-model#Job-title> ;
        skos:definition   "<p>Enterprise Leader is one of the IR broad based roles. It is an organization wide role that includes outcomes for specific riles across IR for example Financial Security, Information Security.<br><br>Role purpose from role description:<br>You will ensure future-focused and integrated decisions are driving IR’s choices about strategy, strategic architecture, prioritisation, investment, design and change management.  You will champion and facilitate the networked co-design and intelligence gathering across IR and with the wider eco-system required to achieve this. You will support achievement of maximum benefits for IR’s ongoing investment in systems, processes and capability.  <br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EnterpriseLeader/EnterpriseLeader_en> .

