<http://example.com/InlandRevenueModel#CustomerImpactAssessment>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#CustomerImpactAssessment/CIA_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInformationRelatedTo>
                <http://example.com/Cleaned-Inland-Revenue-model#IRCustomerResearch> ;
