                "START Help. \"Natural disaster or emergency event\""@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The recent (October 2022) severe spring frost in the Bay of Plenty and Waikato regions is causing financial issues for many kiwifruit and berry fruit orchards and is likely to affect their income for the 2023 income year.<br/>The late deposit provision for 2022 has been approved, with an extension for all customers until 31 May 2023.<br/>Applications for early refunds from the income equalisation scheme will be allowed.<br/>There may also be farmers/growers from other regions who experienced this severe frost, we will take a sympathetic approach to customers from other regions who have also been affected.<br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://example.com/Cleaned-Inland-Revenue-model#KiwifruitGrower> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#SevereSpringFrost2022/BayOfPlentyFrost2022_en> , <http://example.com/InlandRevenueModel#SevereSpringFrost2022/WaikatoFrost2022_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "START Help. \"Natural disaster or emergency event\""@en ;
        sem:guid            "a1a26931-4bbd-4a80-9217-3791a046bd9c" ;
        skos:broader        <http://example.com/InlandRevenueModel#Frost> ;
        skos:editorialNote  "Checked in Viva Topics but it wasn't there."@en ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#SevereSpringFrost2022/SevereSpringFrost2022_en> .

