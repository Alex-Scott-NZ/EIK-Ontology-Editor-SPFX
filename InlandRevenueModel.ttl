<http://example.com/InlandRevenueModel#InternationalCourtOrder>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#JudicialAuthority0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsAppliedTo>
                <http://smartlogic.com/term#205733277916899973098635> ;
        <http://example.com/InlandRevenueModel#IsValidFor>
                <http://smartlogic.com/term#205733277916899973098635> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#IAAuthorityProducedBy>
                <http://smartlogic.com/term#180435716853590549192692> ;
