<http://example.com/InlandRevenueModel#SeniorITConsultant>
        rdf:type          <http://example.com/IRD-test-model#Job-title0> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#SeniorITConsultant/SITC_en> ;
