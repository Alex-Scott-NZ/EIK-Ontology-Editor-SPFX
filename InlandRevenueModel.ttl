<http://example.com/InlandRevenueModel#Non-productionEnvironment>
        rdf:type          <http://smartlogic.com/class#System-type> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#Non-productionEnvironment/NPE_en> ;
