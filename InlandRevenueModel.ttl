<http://example.com/InlandRevenueModel#ChangeOfCircumstances0>
        rdf:type          <http://smartlogic.com/class#Life-event> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "VIVA Topics"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A change to a person's personal or family situation, which affects a tax or social policy entitlement or liability.<br/>     Income increasing or decreasing - may affect Working for Families entitlement and child support liability/entitlement<br/>     Income source changing - may affect entitlement to Independent earner tax credit and In-work tax credit<br/>     Children arriving in or leaving the family - may affect Working for Families Tax Credits entitlement and child support liability/entitlement<br/>     Partner arriving or leaving - may affect Working for Families Tax Credits<br/><br/>For specific tax and social policy entitlements affected see:<br/>    Working for Families change of circumstances<br/>    Child support - change of circumstance<br/></p>"@en ;
        sem:guid          "7c3aa50f-d178-4cbe-8756-5dc11888793c" ;
        skos:broader      <http://smartlogic.com/term#123881123686119992467770> ;
        skos:related      <http://example.com/InlandRevenueModel#BusinessRelationshipService> , <http://example.com/InlandRevenueModel#ChangeOfBusinessDetailsService> , <http://example.com/InlandRevenueModel#ChangeOfPersonalDetailsService> , <http://example.com/InlandRevenueModel#IndividualRelationshipService> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ChangeOfCircumstances0/ChangeOfCircumstances_en> .

