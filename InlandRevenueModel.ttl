<http://example.com/Cleaned-Inland-Revenue-model#PersonalTaxSummary>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/Cleaned-Inland-Revenue-model#PersonalTaxSummary/WhakarapopotoTakeWhaiaro_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/Cleaned-Inland-Revenue-model#PersonalTaxSummary/PTS_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInformationRelatedTo>
                <http://example.com/InlandRevenueModel#IndividualIncomeTaxAssessment> , <http://example.com/InlandRevenueModel#PersonalTaxSummaryCalculator> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Viva Topics. <!--StartFragment--><a href=\"https://irnz.sharepoint.com/sites/kc-income-tax/SitePages/personal-tax-summary.aspx?web=1\">Personal tax summary (sharepoint.com)</a><!--EndFragment--></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A PTS is for salary and wage earners and shows income and tax deduction details for the year. These details are based on the employment, pension or benefit information provided to us each month by an employer or payer. The PTS tells an Income Tax Payer if they have overpaid tax and are due a refund, or underpaid tax and have tax to pay. Once an Income Tax Payer has received a PTS they are required to confirm that the details are correct.</p><div><p><!--StartFragment--><span style=\"color: rgb(50, 49, 48);text-align: left;background-color: rgb(255, 255, 255);float: none;\">Personal tax summary's (PTS) were replaced by individual income tax assessments from 2019 onwards.</span><!--EndFragment--><br/></p></div>"@en ;
        <http://example.com/InlandRevenueModel-current-#TermInLegislation>
                <http://example.com/Cleaned-Inland-Revenue-model#PersonalTaxSummary/IncomeStatement_en> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/Cleaned-Inland-Revenue-model#PersonalTaxSummary/WhakarapopotoTakeWhaiaro_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "D117 Data Sources High Level Stage 2 - 4; IR website"@en ;
        sem:guid          "4b3e14d5-acf8-4ff8-9828-29676eda42d7" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerFinancialInformation> ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#PersonalTaxSummaryRequest> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#PersonalTaxSummary/PersonalTaxSummary_en> .

