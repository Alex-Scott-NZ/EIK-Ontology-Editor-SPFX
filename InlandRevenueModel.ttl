<http://example.com/InlandRevenueModel#AuditAssessedDebt>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#Debt> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#AuditAssessedDebt/AAD_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#Audit> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>​​Audit assessed debt means any debt arising from a reassessment of a customer’s tax position and consideration of shortfall penalties by investigating officers.<br></p><p>AAD arises in any instances where:&nbsp;risk based work is undertaken by Community Compliance, or&nbsp;a Notification of Audit is issued and a customer’s assessment is subsequently amended, or&nbsp;a default assessment is raised by the investigating officer in the absence of a tax return, or a customer has received an overpayment of tax credits, or where a customer makes a voluntary disclosure which is completed by investigating officers.<br></p>"@en ;
        <http://example.com/NZ-IRD#Is-financial-object-of>
                <http://example.com/InlandRevenueModel-current-#DebtRecoveryAction> ;
        <http://example.com/NZ-IRD#Is-offered-by-supplier>
                <http://example.com/InlandRevenueModel#CommunityCompliance> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR acronyms - marketing and communications"@en ;
        sem:guid          "56541a11-35f6-4d7d-a5bc-856b4b47813d" ;
        skos:broader      <http://example.com/NZ-IRD#Assessment-debt> ;
        skos:related      <http://smartlogic.com/term#198463689315270855790496> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#AuditAssessedDebt/AuditAssessedDebt_en> .

