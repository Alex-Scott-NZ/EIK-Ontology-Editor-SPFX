<http://example.com/InlandRevenueModel#ExternalDatasetFrameworkGovernanceGroup>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#DataCollection> , <http://example.com/InlandRevenueModel#ExternalDatasetsFramework> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#GovernanceAndCommunities> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-enterprise-information-knowledge-management/SitePages/External-Dataset-Overview.aspx"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "An external dataset is bulk data relating to individuals, entities, or groups of taxpayers and is obtained by Inland Revenue from businesses, organisations or individuals. The External Dataset Governance Group provides governance to ensure that our resources and the section 17B power are both used appropriately when obtaining a large volume of data from third parties."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ExternalDatasetFrameworkGovernanceGroup/EDSFGovernanceGroup_en> , <http://example.com/InlandRevenueModel#ExternalDatasetFrameworkGovernanceGroup/EDSGG_en> , <http://example.com/InlandRevenueModel#ExternalDatasetFrameworkGovernanceGroup/ExternalDataset-EDS-FrameworkGovernanceGroup_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Data Science & Analytics content"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#ExternalDatasetFrameworkGovernanceGroup/ExternalDatasetFrameworkGovernanceGroup_en0> ;
        sem:guid          "4198bc63-6d23-4c80-a6db-08e84208358c" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skos:historyNote  "<p>The intention is to include this in the Data Supply Working Group in 2022. &#34;There isn’t currently a specific EDS GG -&gt; SWG transition period. The transition is most likely to take place in 2022 Q1.&#34;</p><div><p>Changed name in 2020 from External Dataset Framework Governance Group.</p></div>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ExternalDatasetFrameworkGovernanceGroup/ExternalDatasetFrameworkGovernanceGroup_en> .

