<http://example.com/InlandRevenueModel#Taxes0>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>This business product group comprises tax-related products that obligate customers to make payments by designated due dates. The funds collected are subsequently transferred to the Crown. Inland Revenue (IR) is responsible for administering these transactions, which may involve the collection of payments or the issuance of refunds—although refunds are typically processed only in instances where overpayments have occurred.<br>The majority of income tax is collected at the source, primarily through employer deductions or withholding taxes applied at the time income is earned.<br>This group encompasses a broad range of tax products, including Income Tax, Goods and Services Tax (GST), Employer Deductions, and Fringe Benefit Tax. Within the register, Income Tax and Employer Deductions are further delineated into specific sub-categories.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR business products register"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#Taxes0/PR.T.000_en> ;
        sem:guid          "ebc48959-81e2-4695-b6c1-ceb1d95fa160" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRProduct0> ;
        skos:related      <http://smartlogic.com/term#175072654837555666229777> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Taxes0/Taxes_en> .

