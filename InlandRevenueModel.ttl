                "<p> </p><p><a href=\"https://irnz.sharepoint.com/sites/CORP-maori-customer-strategy/SitePages/Mauri-Ora-Te-Wh%C4%81nau.aspx?web=1\">https://irnz.sharepoint.com/sites/CORP-maori-customer-strategy/SitePages/Mauri-Ora-Te-Wh%C4%81nau.aspx?web=1</a></p><p> </p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p></p><p><span style=\"font-size:7.5pt;color:black\">2020 - 2040. The purpose of the strategy is to guide Inland Revenue’s direction and&nbsp;</span></p><p><span style=\"font-size:7.5pt;color:black\">approach to engaging with Māori as customers, responding to Māori </span><span style=\"color:transparent\">customer needs and improving outcomes for Māori through our services.</span></p><p> </p><p><span style=\"font-size:7.5pt;color:black\">&nbsp;</span><span style=\"color:transparent\">approach to engaging with Māori as customers, responding to Māori customer needs and improving outcomes for Māori through our services.</span></p><p> </p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#MauriOraTeWhanau-MaoriCustomerStrategy/MaoriCustomerStrategy_en> , <http://example.com/InlandRevenueModel#MauriOraTeWhanau-MaoriCustomerStrategy/MaoriCustomerStrategy_en0> , <http://example.com/InlandRevenueModel#MauriOraTeWhanau-MaoriCustomerStrategy/MauriOraTeWhanau_en> ;
        sem:guid          "f67a9175-2d5b-4e2d-8909-3f0b9c319534" ;
        skos:broader      <http://example.com/InlandRevenueModel#Strategy> ;
        skos:related      <http://example.com/InlandRevenueModel#MaoriResponsiveness> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MauriOraTeWhanau-MaoriCustomerStrategy/MauriOraTeWhanau-MaoriCustomerStrategy_en> .

<http://example.com/InlandRevenueModel#MauriOraTeWhanau-MaoriCustomerStrategy/MaoriCustomerStrategy_en>
