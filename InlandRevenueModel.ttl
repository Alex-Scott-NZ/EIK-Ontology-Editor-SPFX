        sem:guid          "224b98ed-845b-4680-8fc3-bae89f50ffef" ;
        skos:broader      <http://example.com/InlandRevenueModel#Inter-agencyGroup> ;
        skos:definition   "The Organised and Financial Crime Agency New Zealand (OFCANZ) was a government agency that existed from 2008 to 2017. It was established to combat serious and organised crime, including financial crime, and was created by merging some functions of the Serious Fraud Office (SFO) and other units within the police. In April 2017, OFCANZ was merged into the New Zealand Police and renamed the National Organised Crime Group (NOCG), which continues to target the highest levels of organised criminal activity in New Zealand. "@en ;
        skos:historyNote  "From 2017 renamed as the National Organised Crime Group (NOCG)."@en ;
        skos:related      <http://example.com/InlandRevenueModel#NationalOrganisedCrimeGroup> ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#OrganisedAndFinancialCrimeAgencyNewZealand/OrganisedCrimeAgency_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#OrganisedAndFinancialCrimeAgencyNewZealand/OrganisedAndFinancialCrimeAgencyNewZealand_en> .

