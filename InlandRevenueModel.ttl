<http://example.com/InlandRevenueModel#PublicAdviceAndGuidanceCommittee>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#PublicAdviceAndGuidanceCommittee/PAGC_en> ;
