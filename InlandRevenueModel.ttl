<http://example.com/InlandRevenueModel#TeArapiki>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#Turama> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#EngagementMaoriAndDiverseCommunities> , <http://example.com/InlandRevenueModel#MahutongaProgramme> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span lang=\"mi-NZ\"><a href=\"https://irnz.sharepoint.com/sites/News/SitePages/Foundation-Rongo-level-of-our-Te-Arapiki-Learning-Pathway-is-now-available.aspx?web=1\"><u><font color=\"#0563c1\" face=\"Calibri\" size=\"3\">https://irnz.sharepoint.com/sites/News/SitePages/Foundation-Rongo-level-of-our-Te-Arapiki-Learning-Pathway-is-now-available.aspx?web=1</font></u></a></span></p><p><font face=\"Times New Roman\" size=\"3\"><br/><br/></font></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Te Arapiki is a framework that provides a structured way to learn the basics of te reo, te ao and tikanga Māori, and te Tiriti o Waitangi. The programme takes a stepped approach to increasing our capability with four levels: Foundation, Comfortable, Confident and Capable. As at June 2022 the Foundation/Rongo level pathway was ready for people to use. The pathways for the other levels are still being developed."@en ;
        sem:guid          "21bce304-5c82-4331-a60b-08e281ea1558" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Enterprise-model> ;
        skos:related      <http://example.com/InlandRevenueModel#Maoritanga> , <http://smartlogic.com/term#24838370626904509442628> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TeArapiki/TeArapiki_en> .

<http://example.com/InlandRevenueModel#TeArapiki/TeArapiki_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Te Arapiki"@en .

