<http://example.com/InlandRevenueModel#InfrastructureProgramme>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-participant>
                <http://example.com/InlandRevenueModel#InfrastructureProgrammeExecutiveWorkingCommittee> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsEventObjectOfActivity>
                <http://example.com/InlandRevenueModel-current-#InformationSecurityManagement> , <http://smartlogic.com/term#135619583250639319885869> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The role of the IT Infrastructure programme is to run projects which; refresh infrastructure and business system assets, provision for capacity growth, secure Inland Revenues information and ICT landscape, and ensure software compliance.  The objective of these projects is to ensure Inland Revenue’s communication and technology services remain current against an agreed risk profile enabling the smooth operation of Inland Revenues business. Projects included in the programme are determined as part of TS&O investment planning process which takes into account critical dependencies such as business transformation (TMP) key milestones, our systems lifecycle roadmaps and heatmap, All of Government initiatives, and the Government ICT Strategy & Action Plan and related inputs."@en ;
        <http://example.com/InlandRevenueModel-current-#UsesModel>
                <http://example.com/InlandRevenueModel-current-#InfrastructureArchitecture> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#InfrastructureProgramme/InfrastructureInitiative_en> , <http://example.com/InlandRevenueModel#InfrastructureProgramme/InfrastructureRunProgramme_en> , <http://example.com/InlandRevenueModel#InfrastructureProgramme/InfrastructureWorkProgramme_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IT&C content; Intranet"@en ;
        sem:guid          "7ea74b5f-326b-4007-ab10-dcba596422a1" ;
        skos:broader      <http://example.com/IRD-test-model#Programe-or-project> ;
        skos:historyNote  "Pre-Business Transformation Programme. No longer in existence."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#InfrastructureProgramme/InfrastructureProgramme_en> .

