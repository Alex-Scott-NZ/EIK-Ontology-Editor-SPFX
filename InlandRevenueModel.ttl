        sem:guid          "55e32a52-8162-4223-8044-3e263bb247bb" ;
        skos:broader      <http://example.com/InlandRevenueModel#GovernancePrinciple> ;
        skos:definition   "Respect and uphold the mana and dignity of the people, whānau, communities or groups who share their data and information. Hospitality, kindness, generosity, support - the process of showing respect, generosity and care for others."@en ;
