                <http://example.com/InlandRevenueModel#CollectionEnforcementService> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "​Subject Matter experts."@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "http://intranet.ird.govt.nz/compliance/compliance"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel#usedInME3ValueSet>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>​Compliance management is the strategic and operational process of ensuring that individuals, teams, and organisations adhere to relevant laws, regulations, standards, and internal policies. It involves:&nbsp;Monitoring behaviour and performance;&nbsp;Assessing risk;&nbsp;Providing guidance; and Applying corrective actions when needed.<br>At IR, compliance management is especially critical for Significant Enterprises (SE) and other high-risk customer groups. It ensures that these entities meet their tax obligations and maintain transparent, ethical practices.<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#UsesModel>
                <http://example.com/InlandRevenueModel#Ayres-BraithwaiteModel> , <http://example.com/InlandRevenueModel#RightFromTheStart> , <http://smartlogic.com/term#30053661404961800155266> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://smartlogic.com/term#143992810712908508147987/ApproachForCompliance_en> , <http://smartlogic.com/term#143992810712908508147987/CMETeam_en> , <http://smartlogic.com/term#143992810712908508147987/Compliance-mapping_en> , <http://smartlogic.com/term#143992810712908508147987/ComplianceAndPenalties_en> , <http://smartlogic.com/term#143992810712908508147987/ComplianceApproach_en> , <http://smartlogic.com/term#143992810712908508147987/ComplianceAssessment_en> , <http://smartlogic.com/term#143992810712908508147987/ComplianceEffort_en> , <http://smartlogic.com/term#143992810712908508147987/ComplianceEnforcement_en> , <http://smartlogic.com/term#143992810712908508147987/ComplianceEnvironment_en> , <http://smartlogic.com/term#143992810712908508147987/EasyToComply_en> , <http://smartlogic.com/term#143992810712908508147987/TaxGap_en> ;
        <http://example.com/NZ-IRD#Is-done-by>
                <http://example.com/InlandRevenueModel#CommunityComplianceOfficer> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Master business process framework"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.1.1_Strategic_Corporate_Policy_and_Procedures> ;
        sem:guid          "fb48d95c-0c13-5833-86c2-83e7e6b18b03" ;
        skos:broader      <http://smartlogic.com/term#45770838521112907358998> ;
        skos:definition   "Managing compliance for IR is making sure that customers pay the taxes and get the entitlements they should."@en ;
