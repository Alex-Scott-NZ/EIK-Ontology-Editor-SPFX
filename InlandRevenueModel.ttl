<http://smartlogic.com/term#195867451054967333481936>
        rdf:type          <http://smartlogic.com/class#Obligation> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://smartlogic.com/term#195867451054967333481936/Provtax_en> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/Cleaned-Inland-Revenue-model#ProvisionalTaxMethod> , <http://smartlogic.com/term#738409897639196581385300971900698> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://smartlogic.com/term#195867451054967333481936/TakeTarewa_en> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel#ProvisionalTaxEstimation> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#ProvisionalTax> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://smartlogic.com/term#332232282734990593924592237114874> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ProductsWeAdminister> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#ProvisionalTaxAndGSTAlignmentProject> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Business Rules Glossary"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "​Provisional tax isn't a separate tax but a way of paying income tax as the customer receives income throughout the year. With provisional tax, customers pay instalments of income tax throughout the year. The amount of provisional tax paid is deducted from their tax bill at the end of the year. Provisional tax is payable by any customer whose residual income tax exceeds $5,000 ($2,500 in the 2020 year or earlier) in the previous year. There are four ways of calculating provisional tax: standard option (based on the previous year's residual income tax plus an adjustment); estimation option (where the customer estimates what their residual income tax will be for the year); ratio option (based on the customer's GST turnover); accounting income method (AIM) - pay-as-you-go method based on current year profit/loss."@en ;
        <http://example.com/InlandRevenueModel-current-#UsesModel>
                <http://example.com/InlandRevenueModel-current-#AccountingIncomeMethod> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://smartlogic.com/term#195867451054967333481936/ProvTax_en> , <http://smartlogic.com/term#195867451054967333481936/TakeTarewa_en0> ;
        <http://example.com/NZ-IRD#Is-financial-object-of>
                <http://example.com/InlandRevenueModel#CalculatingProvisionalTax> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Business Rules Glossary; Website glossary; </p><p>Revenue Forecasting content</p>"@en ;
        sem:guid          "83e919cc-00d3-5a37-a3ae-612507589f56" ;
        skos:broader      <http://smartlogic.com/term#175072654838674267587392> ;
        skos:definition   "Tax paid in instalments during the year based on what you expect your income to be, or what it was last year."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#ResidualIncomeTax> , <http://example.com/InlandRevenueModel#SafeHarbourThreshold> ;
        skosxl:prefLabel  <http://smartlogic.com/label#195867451054967333481936_English> .

