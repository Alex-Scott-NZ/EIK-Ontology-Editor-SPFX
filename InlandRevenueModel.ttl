<http://example.com/InlandRevenueModel#NationalIntelligenceCentre>
        rdf:type          <http://smartlogic.com/class#Commercial-organisation> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#NationalIntelligenceCentre/NIC_en> ;
