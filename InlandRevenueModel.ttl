<http://smartlogic.com/term#10061517095528789211734>
        rdf:type          <http://smartlogic.com/class#Income> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Website glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Sometimes payments are made for a service, where the usual custom is that a price is not set. These payments are called honoraria. These include payments made to mayors, chairpersons and/or members of local bodies, clubs, societies and organisations. All these payments are subject to withholding tax. If paid to employees, use the PAYE tables to work out the amount of tax. "@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>OCTC content; Website glossary; Revenue Forecasting content; </p><p>Corporate Finance content</p>"@en ;
        sem:guid          "6e1febad-4a30-56cc-932d-bc005a456105" ;
        skos:broader      <http://smartlogic.com/term#460716479585426992918781858541954> ;
        skos:definition   "A payment made for services provided where no fixed payment would normally be made. Treated as a schedular payment for tax purposes."@en ;
        skosxl:altLabel   <http://smartlogic.com/term#10061517095528789211734/honoraria_en> ;
        skosxl:prefLabel  <http://smartlogic.com/label#10061517095528789211734_English> .

