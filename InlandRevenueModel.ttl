<http://example.com/Cleaned-Inland-Revenue-model#Non-residentContractorShortfallPenalty>
        rdf:type          <http://smartlogic.com/class#Penalty> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A shortfall penalty imposed on a person who fails to withhold tax from a contract payment made to a non-resident contractor where all of the following are true:  · the contract payment is made as a schedular payment · the non-resident is not liable to pay income tax on the contract payment whether or not a double tax agreement has effect."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Business Rules business terms"@en ;
        sem:guid          "fe473b89-1fc4-45a0-81ba-5af5c8ad8761" ;
