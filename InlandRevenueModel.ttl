        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "4524b61d-b9ec-4689-9202-5d830a8395f6" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRDRegistration> ;
        skos:definition   "<p>A non‑registered customer is a temporary or transitional state, not an alternative customer type. Where ongoing interaction, obligations, or entitlements are required, registration with IR is necessary.&nbsp;</p><p><br></p><p>Inland Revenue needs to recognise non‑registered individuals because they represent a real but incomplete relationship between IR and a person. Tracking this state allows IR to manage risk, integrity, and transitions into formal registration.&nbsp;</p><p>IR often needs to interact with customers before they are registered (for example, during enquiries, applications, or preliminary compliance activity). Recognising someone as non‑registered allows IR to handle these interactions without prematurely creating a full customer record or assigning obligations.</p>"@en ;
        skosxl:altLabel   <http://smartlogic.com/label#156906087460363221463098_English_2748> , <http://smartlogic.com/term#99012315103165300885233654012402/Non-registeredIndividual_en> ;
        skosxl:prefLabel  <http://smartlogic.com/label#99012315103165300885233654012402_English> .

