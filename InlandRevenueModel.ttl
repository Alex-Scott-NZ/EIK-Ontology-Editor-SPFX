<http://example.com/Cleaned-Inland-Revenue-model#RepublicOfKorea>
        rdf:type          <http://smartlogic.com/class#Country> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/Cleaned-Inland-Revenue-model#RepublicOfKorea/ROK_en> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#Asia> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-16"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Wikipedia"@en ;
        <http://example.com/NZ-IRD#Is-location-of>
                <http://example.com/InlandRevenueModel#NationalTaxServiceOfTheRepublicOfKorea> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "ISO 3166; OCTC content"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/Cleaned-Inland-Revenue-model#RepublicOfKorea/KOR_en> , <http://example.com/Cleaned-Inland-Revenue-model#RepublicOfKorea/KR_en> ;
        sem:guid          "49b4a7ee-0558-422f-8e9c-59b67c869097" ;
        skos:broader      <http://smartlogic.com/term#130710328707508168484707> ;
        skos:definition   "South Korea, officially the Republic of Korea (ROK), is a country in East Asia. It constitutes the southern half of the Korean Peninsula and borders North Korea along the Korean Demilitarized Zone. In the west the Yellow Sea separates the Korean Peninsula from China. the East China Sea is located off the southern coast, the Sea of Japan (which South Korea calls the East Sea) separates the country from Japan. The narrowest body of water between South Korea and Japan is the Korea Strait. Russia is also a close neighbour, bordering North Korea on the far northeast coast, near the Tumen River. "@en ;
        skos:related      <http://example.com/InlandRevenueModel#DoubleTaxationRelief-RepublicOfKorea-Order1983> ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#RepublicOfKorea/RepublicOfKorea_en0> , <http://example.com/Cleaned-Inland-Revenue-model#RepublicOfKorea/SouthKorea_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#RepublicOfKorea/RepublicOfKorea_en> .

