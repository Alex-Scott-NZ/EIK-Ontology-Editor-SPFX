<http://example.com/InlandRevenueModel#CabinetForeignPolicyAndNationalSecurityCommittee>
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://www.dpmc.govt.nz/cabinet-committees/fps-cabinet-foreign-policy-and-national-security-committee\">(FPS) Cabinet Foreign Policy and National Security Committee | Department of the Prime Minister and Cabinet (DPMC)</a>​<br></p>"@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#ParliamentaryCommitteeWork> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "https://www.dpmc.govt.nz/our-business-units/cabinet-office/supporting-work-cabinet/cabinet-committees"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#CabinetForeignPolicyAndNationalSecurityCommittee/FPS_en> ;
        sem:guid          "1e16550e-1d13-4bd6-ab1d-b83343cd25e0" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#CabinetCommittee> ;
        skos:definition   "Terms of reference. To consider matters relating to foreign policy and external relations; To provide oversight of the national security and intelligence sector, and to consider policy and legislative proposals relating to the sector, to significant hazards, and to defence (excluding defence procurement); and to co-ordinate and direct national responses to major crises or circumstances affecting national security (either domestic or international). FPS, or a subcommittee as determined by the Prime Minister, will have Power to Act where the need for urgent action and/or operational or security considerations require it."@en ;
        skos:historyNote  "Discovered in 2025. May continue the Cabinet External Relations and Security Committee."@en ;
        skos:related      <http://example.com/InlandRevenueModel#ExternalRelationships> , <http://example.com/InlandRevenueModel#GovernmentPolicy> , <http://example.com/InlandRevenueModel#NationalSecurityAgency> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CabinetForeignPolicyAndNationalSecurityCommittee/CabinetForeignPolicyAndNationalSecurityCommittee_en> .

<http://example.com/InlandRevenueModel#CabinetForeignPolicyAndNationalSecurityCommittee/CabinetForeignPolicyAndNationalSecurityCommittee_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Cabinet Foreign Policy and National Security Committee"@en .

<http://example.com/InlandRevenueModel#CabinetForeignPolicyAndNationalSecurityCommittee/FPS_en>
        rdf:type             skosxl:Label ;
        <http://smartlogic.com/relationship#Is-code-of_14_None_None>
                <http://example.com/InlandRevenueModel#CabinetForeignPolicyAndNationalSecurityCommittee> ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "FPS"@en .

<http://example.com/InlandRevenueModel#CabinetLegislationCommittee>
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://smartlogic.com/term#176082916076376969475055> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://www.dpmc.govt.nz/cabinet-committees/leg-cabinet-legislation-committee\">(LEG) Cabinet Legislation Committee | Department of the Prime Minister and Cabinet (DPMC)</a>​<br></p>"@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#ParliamentaryCommitteeWork> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "GES content; PAS content"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#CabinetLegislationCommittee/LEG_en> ;
        sem:guid          "4e11b8e9-24c3-48cb-8e94-13010249cd8b" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#CabinetCommittee> ;
        skos:definition   "Terms of reference: To consider the legislation programme, draft Bills and secondary legislation, and government responses to petitions, select committee reports, and Law Commission reports. LEG may also consider minor policy issues relating to these matters. Government responses to significant select committee reports and Law Commission reports should be dealt with at a policy committee if they involve significant new policy or amendments to existing policy."@en ;
        skos:historyNote  "Reviewed in 2025 and still exists."@en ;
        skos:related      <http://example.com/InlandRevenueModel#GovernmentPolicy> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#CabinetLegislationCommittee/LEGCommittee_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CabinetLegislationCommittee/CabinetLegislationCommittee_en> .

