<http://example.com/InlandRevenueModel#Household>
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/InlandRevenueModel#HasAttribute>
                <http://example.com/Cleaned-Inland-Revenue-model#Adjusted-taxable-income> ;
        <http://example.com/InlandRevenueModel#HasMember>
                <http://example.com/InlandRevenueModel#SpouseOrPartner> , <http://example.com/InlandRevenueModel-current-#PrincipleCareGiver> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsValidFor>
                <http://example.com/InlandRevenueModel#EstablishEligibility> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-09"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "2020 Household Expenditure Guide"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling"@en ;
        sem:guid          "c8d72623-bf6c-43d6-9ee8-938c5ecb764d" ;
        skos:broader      <http://example.com/IRD-test-model#Group> ;
        skos:definition   "<p>A person, or a group of people, who live together in a private dwelling and share living costs, such as food, accommodation, and other essentials of daily living.</p><p><br></p><p>This approach aligns with the definition used in the Household Economic Survey, which Inland Revenue explicitly relies on when assessing household living costs and financial capacity. Under this definition, a household:&nbsp;Lives in a private dwelling, Normally spends four or more nights a week there,&nbsp;Shares food consumption or contributes jointly to essential living costs (such as rent, power, groceries).<br></p><p>The entitlement definition may vary across different IR products.&nbsp;IRD deliberately separates:<br>Household → shared living and costs<br>Family → relationships (partners, parents, children)<br>Couple/relationship status → emotional and financial partnership<br>You can be in the same household without being a family, and in some cases in a relationship but temporarily in separate households (for example, due to work).</p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel-current-#Family> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Household/Household_en> .

<http://example.com/InlandRevenueModel#Household/Household_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Household"@en .

