<http://example.com/InlandRevenueModel#SingleSignOn>
        rdf:type          <http://smartlogic.com/class#Function> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#SingleSignOn/SSO_en> ;
        <http://example.com/InlandRevenueModel#HasRelatedActivity>
                <http://example.com/InlandRevenueModel-current-#AccessControlManagement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "GES content"@en ;
        sem:guid          "190e017d-8be0-4f19-bff1-f6813ec413f9" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#SystemFunctionality> ;
        skos:definition   "Single Sign-On (SSO) is an authentication method that allows users to access multiple applications and services with a single set of login credentials. After a user logs in to one application, their identity is authenticated, and they are automatically signed in to other connected applications without needing to enter their username and password again. SSO streamlines user experience, reduces password fatigue, and enhances security by enabling centralized management of user access and authentication across various systems."@en ;
        skos:related      <http://example.com/InlandRevenueModel#IdentityManagementFunctionality> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SingleSignOn/SingleSignOn_en> .

