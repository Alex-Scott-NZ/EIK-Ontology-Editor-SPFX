<http://smartlogic.com/term#56119831397991336249604>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://smartlogic.com/term#56119831397991336249604/KM_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#Activity-Data-Information-AndTechnology> , <http://example.com/InlandRevenueModel#Intelligence> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#Custodian> ;
        <http://example.com/InlandRevenueModel#IsSupportedBy>
                <http://example.com/InlandRevenueModel#TeMatawai> ;
        <http://example.com/InlandRevenueModel#NotInNPT>
                <http://smartlogic.com/term#56119831397991336249604/KM_C-_en> ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://smartlogic.com/term#56119831397991336249604/KahuMataroa_en> , <http://smartlogic.com/term#56119831397991336249604/KahuMataroa_en0> , <http://smartlogic.com/term#56119831397991336249604/TeKAHUMATAROA_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Process Integrity, Viva Topics team."@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "ITIL Service Transition"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel#usedInME3ValueSet>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Knowledge management (KM) is the process of creating, sharing, using and managing the knowledge and information of an organisation. It refers to a multidisciplinary approach to achieve organisational objectives by making the best use of tacit and explicit knowledge.</p><div><p>Knowledge is information that a party is acquainted with, and that party can be a person or an organisation. When the party is a person we refer to the information as tacit knowledge. When the party is an organisation we refer to the information as explicit knowledge. From a business perspective, explicit knowledge (what an organisation knows) is an asset that is drawn on by people (as tacit knowledge) to realise business value through action.<br/></p></div>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://smartlogic.com/term#56119831397991336249604/CaptureKnowledge_en> , <http://smartlogic.com/term#56119831397991336249604/ExplicitKnowledge_en> , <http://smartlogic.com/term#56119831397991336249604/Know-how_en> , <http://smartlogic.com/term#56119831397991336249604/KnowledgeResource_en> , <http://smartlogic.com/term#56119831397991336249604/TacitKnowledge_en> ;
        <http://example.com/NZ-IRD#Is-done-by>
                <http://example.com/InlandRevenueModel#InFUSENetwork> , <http://example.com/InlandRevenueModel#KnowledgeBaseManagement> , <http://smartlogic.com/term#23614112459887975098408> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Master business process framework; IM team content"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-8.1.2_Routine_Operations_&_Administration_of_Records_&_Information_Systems> ;
        sem:guid          "ca539e20-0fb8-5db1-be9f-c5d0852f2456" ;
        skos:broader      <http://smartlogic.com/term#50630129976520997376777> ;
        skos:definition   "The process responsible for sharing perspectives, ideas, experience and information, and for ensuring that these are available in the right place and at the right time. The knowledge management process enables informed decisions, and improves efficiency by reducing the need to rediscover knowledge."@en ;
        skos:related      <http://example.com/InlandRevenueModel#Curator> , <http://example.com/InlandRevenueModel#KnowledgeContent> , <http://example.com/InlandRevenueModel#Schema> , <http://example.com/InlandRevenueModel#VivaTopics> , <http://smartlogic.com/term#161917071062092766688046> ;
        skosxl:prefLabel  <http://smartlogic.com/label#56119831397991336249604_English> .

