<http://example.com/InlandRevenueModel#HardshipRelief>
        rdf:type          <http://smartlogic.com/class#Tax-event> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR internal - Haukāinga"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "There are 2 types of hardship relief provided for by the Student Loan Scheme Act 2011 (SLS Act 2011):  Financial hardship under s147(1)(a) SLS Act 2011 The definition of financial hardship is the same as the definition for Hardship for other tax types. Special reasons under s147(1)(b) SLS Act 2011 This is defined as circumstances that are out of the ordinary and are causing a borrower significant non-financial hardship, including, but not restricted to. No ability to shift money from their country of residence. On-going and severe mental or medical incapacity. Employer error that the borrower could not be reasonably expected to recognise and correct. Borrower has been adversely affected by a nationally recognised adverse event or, in the case of an Overseas Based Customer, a declared state of emergency. Borrower has a small amount of savings, but is able to prove there is a reason why using these savings would cause serious hardship."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Review of Haukāinga top 100 from 2022"@en ;
        sem:guid          "fce5bf75-0830-401d-adea-7757095bc717" ;
        skos:broader      <http://smartlogic.com/term#39629125075286344336852> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#HardshipRelief/HardshipRelief_en> .

<http://example.com/InlandRevenueModel#HardshipRelief/HardshipRelief_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Student Loan hardship relief"@en .

