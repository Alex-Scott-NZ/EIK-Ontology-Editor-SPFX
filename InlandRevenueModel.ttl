<http://example.com/InlandRevenueModel#MaoriHealthAuthority>
        rdf:type          <http://smartlogic.com/class#Commercial-organisation> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-party-classification>
                <http://smartlogic.com/term#211585864388640209217176878631622> ;
