<http://example.com/NZ-IRD#Dependent-child>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/Cleaned-Inland-Revenue-model#HasRole>
                <http://example.com/Cleaned-Inland-Revenue-model#Student> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsPartyObjectOf>
                <http://example.com/InlandRevenueModel#CaringForAChild> ;
        <http://example.com/InlandRevenueModel#HasAttribute>
                <http://example.com/InlandRevenueModel#Age> , <http://example.com/InlandRevenueModel#Citizenship> , <http://example.com/InlandRevenueModel#LivesInNewZealand> , <http://example.com/InlandRevenueModel#RelationshipStatus> , <http://smartlogic.com/term#144354077507207679107329112919122> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsFocusOf>
                <http://example.com/InlandRevenueModel#WorkingForFamiliesTaxCredit> ;
        <http://example.com/InlandRevenueModel#ResultsFrom>
                <http://example.com/InlandRevenueModel#EstablishEligibility> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IR website"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A dependent child is any child for whom all of the following apply: The parent is the legal parent of the child; The parent provides at least 28% (103 nights a year) of on-going care for the child; No person is a liable parent or receiving carer for the child; No person is required to make child support or equivalent payments for the child in any country; The child is under 18 years of age, OR is aged 18 and enrolled AND attending a school; The child is not financially independent; The child isn't living with another person in a marriage, civil union or de facto relationship. See the Child Support Act 1991 <br/>Section 7 - Meaning of &#34;parent&#34;.<br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://example.com/InlandRevenueModel-current-#PrincipleCareGiver> ;
        <http://example.com/InlandRevenueModel-current-#HasSub-event>
                <http://example.com/InlandRevenueModel#BeginningCareOfAChild> ;
        <http://example.com/InlandRevenueModel-current-#IsRoleRelatedTo>
                <http://example.com/InlandRevenueModel#Taxation-DefinitionsOfDependentChild-Act2010> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/NZ-IRD#Dependent-child/DependentChild_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Income Tax Act 2007; IR website"@en ;
        sem:guid          "62633313-4e93-4ea0-bf19-7bc6b7876ba5" ;
        skos:broader      <http://example.com/IRD-test-model#Child> ;
        skos:definition   "A child in a parent's care and for whom the parent doesn't pay or receive child support."@en ;
        skos:related      <http://example.com/IRD-test-model#Family-tax-credit> ;
        skosxl:prefLabel  <http://example.com/NZ-IRD#Dependent-child/Dependent-child_en> .

