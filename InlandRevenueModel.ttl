<http://example.com/Cleaned-Inland-Revenue-model#FilmHireTaxAct1930>
        rdf:type          <http://smartlogic.com/class#Law> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-replaced-by>
                <http://example.com/InlandRevenueModel#_TaxationActsRepealAct1986-> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#LegislationAdministeredByInlandRevenue> , <http://example.com/InlandRevenueModel#PrincipalAct> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel-current-#IsAdministeredBy>
                <http://smartlogic.com/term#733873855465831453299914748155375> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/Cleaned-Inland-Revenue-model#FilmHireTaxAct1930/FilmHireTaxAct1930_en0> , <http://example.com/Cleaned-Inland-Revenue-model#FilmHireTaxAct1930/FilmHireTaxAct_en> ;
        <http://example.com/NZ-IRD#Is-amended-by>
                <http://example.com/InlandRevenueModel#FilmHireTaxAmendmentAct1988> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "2f9eaf9f-dd75-49c6-88c9-16c79cc8ccca" ;
        skos:broader      <http://example.com/InlandRevenueModel#_SupersededActsOfParliament-> ;
        skos:historyNote  "<p>1892 to 1929 No film hire tax.<br/>1930 Film hire tax replaced Customs duties on cinematograph films. Levied on the net monthly<br/>receipts from the hire of films as from 1 July 1930. The rates were:<br/>(i) On the net receipts from British films: 10 percent.<br/>(ii) On the net receipts from foreign films: 25 percent.<br/>1931 to 1967 No alteration.<br/></p><div><p>Repealed by the Taxation Acts Repeal Act 1986</p></div>"@en ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#FilmHireTaxAct1930/FilmHireTaxAct1930_en> .

<http://example.com/Cleaned-Inland-Revenue-model#FilmHireTaxAct1930/FilmHireTaxAct1930_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "[Film Hire Tax Act 1930]"@en .

