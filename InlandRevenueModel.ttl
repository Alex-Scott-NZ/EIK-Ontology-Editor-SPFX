        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Enterprise portfolio"@en .

<http://example.com/InlandRevenueModel#EnterpriseLeader>
        rdf:type          <http://example.com/IRD-test-model#Job-title0> ;
