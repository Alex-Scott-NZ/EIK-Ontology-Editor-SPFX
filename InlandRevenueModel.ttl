<http://example.com/InlandRevenueModel#HighRiskJurisdiction>
        rdf:type          <http://smartlogic.com/class#Place-classification> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#HighRiskJurisdiction/HRJ_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel-current-#TaxRegime> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#Anti-moneyLaunderingWork> , <http://example.com/InlandRevenueModel#FinancialActionTaskForce> ;
        <http://example.com/InlandRevenueModel#IsTypeOf>
                <http://smartlogic.com/term#130710328707508168484707> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "FATF"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intelligence Hub content"@en ;
        sem:guid          "cf26949a-4065-4cc4-ab89-631979c50ae3" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Jurisdiction> ;
        skos:definition   "<p>High risk jurisdictions are those jurisdictions (countries and territories) with significant weaknesses in their anti money laundering and control of terrorist financing (AML/CFT) regimes.&nbsp;</p><p><br></p><p>The Financial Action Task Force (FATF)’s process helps protect the integrity of the international financial system by issuing a public warning about the risks emanating from the identified jurisdictions. These public warnings also put pressure on the identified jurisdictions to address their deficiencies in order to maintain their position in the global economy. Public identification, and the prospect of public identification, encourages countries to swiftly make significant improvements.<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#HighRiskJurisdiction/HighRiskJurisdiction_en> .

