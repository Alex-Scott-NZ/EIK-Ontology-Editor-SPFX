        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p> </p><p><a href=\"https://irnz.sharepoint.com/sites/govcentre/Documents/Forms/AllItems.aspx?id=%2Fsites%2Fgovcentre%2FDocuments%2FData%20and%20Information%20Governance%20Standard%2Epdf&amp;parent=%2Fsites%2Fgovcentre%2FDocuments\">irnz.sharepoint.com/sites/govcentre/Documents/Forms/AllItems.aspx?id=%2Fsites%2Fgovcentre%2FDocuments%2FData and Information Governance Standard%2Epdf&amp;parent=%2Fsites%2Fgovcentre%2FDocuments</a></p><p> </p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p> </p><p>Curators support Custodians by coordinating activities that include the responsibilities of Custodians, other Curators, Business Process Owners, Channel Owners, Subject Matter Experts, and Producers.<br><br>IKM&nbsp; context - managing knowledge content collections.</p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR internal"@en ;
        sem:guid          "cb857aa6-fec3-4aa1-9506-7047d733cbd4" ;
        skos:broader      <http://smartlogic.com/term#188649781203397804479981> ;
        skos:related      <http://smartlogic.com/term#56119831397991336249604> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Curator/Curator_en> .

<http://example.com/InlandRevenueModel#Curator/Curator_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Curator"@en .

