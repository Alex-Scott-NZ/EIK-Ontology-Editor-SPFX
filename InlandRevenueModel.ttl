<http://example.com/IRD-test-model#Registered-customer>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-26"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Any individual or entity that is recorded in Inland Revenue’s systems as having an IRD number and a tax relationship with Inland Revenue.&nbsp;This includes customers registered with IR whether or not they are currently active, and regardless of whether they are registered for GST, PAYE, or any other specific tax.<br>IR explicitly states in its tax statistics definitions that registered customers include all customers registered with Inland Revenue, either individuals or legal entities.&nbsp;This covers individuals and a wide range of entity types (companies, trusts, partnerships, non‑profits, etc.).&nbsp;Customers remain “registered” until IR is notified of a change in status (for example, leaving New Zealand, cessation, or deregistration).</p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet"@en ;
        sem:guid          "82c52b5c-fbbf-4036-9d7d-4d080a8b9ee1" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRDRegistration> ;
        skosxl:prefLabel  <http://example.com/IRD-test-model#Registered-customer/Registered-customer_en> .

