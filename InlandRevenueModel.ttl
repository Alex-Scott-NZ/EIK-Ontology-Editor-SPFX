<http://example.com/InlandRevenueModel#Deduction>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#Debt> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#DeductionAtSourceService> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ProductAdministration> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/kc-debt/SitePages/managing-deduction-notices.aspx"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A deduction is a legal means of procuring funds from a customer’s wages, bank accounts or other third party to satisfy unpaid debt. In the event a customer has not paid money owed to Inland Revenue, the Department may be able to deduct money from the customer’s wages or bank account. When the necessary deduction data is gathered and prepared, legal notice of the deduction is delivered to the employer or bank. From that point, until the release of the deduction notice, the employer, bank or third party is required to send a portion of funds to Inland Revenue according to the terms set in the deduction notice."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#Deduction/DeductionNotice_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Knowledge Centre"@en ;
        sem:guid          "8589a39b-353f-4631-ada3-cb7d8a8cd7d6" ;
        skos:broader      <http://smartlogic.com/term#77793849175289009165474> ;
        skos:related      <http://example.com/InlandRevenueModel#FullAndFinalService> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Deduction/Deduction_en> .

