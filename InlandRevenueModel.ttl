<http://example.com/Cleaned-Inland-Revenue-model#TaxableSupplies>
        rdf:type          <http://example.com/InlandRevenueModel#ProductClassification> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerActionsAndInteractions> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IKM-compiled definition taken from a number of internal sources"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Any supply of goods or services made after 1 October 1986, by a registered person in a taxable activity in NZ. It is subject to GST at the standard rate or 0% (zero rated supplies)."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website glossary"@en ;
        sem:guid          "751b0fda-6076-4200-8f76-bf9eae7b9143" ;
        skos:broader      <http://example.com/InlandRevenueModel#ProductType> ;
        skos:definition   "Goods and services supplied in New Zealand in the course of conducting a taxable activity. Suppliers charge GST by adding it to the price of their goods and services."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Arm-sLengthTransaction> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#TaxableSupplies/TaxableSupplies_en> .

