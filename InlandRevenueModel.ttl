<http://example.com/InlandRevenueModel#AffectedEmployee>
        rdf:type          <http://smartlogic.com/class#Party-classification> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Future Operating Model glossary 2020. http://intranet.ird.govt.nz/our-new-organisation/glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "This is an employee whose position is not the same or very nearly the same or where a reduction in the number of staff is required as a result of change."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Future Operating Model glossary 2020."@en ;
        sem:guid          "4ca8ac5c-1586-4e05-af0e-627ac8c79b2a" ;
        skos:broader      <http://example.com/InlandRevenueModel#EmployeeChangeStatus> ;
        skos:scopeNote    "<p>What this means in IR - Each of Inland Revenue’s employment agreements has a different definition of this term. In general, this is an employee whose position is not the same or very nearly the same or where a reduction in the number of staff is required as a result of change. Potentially affected employees will be consulted on proposed changes prior to any decisions being made which would make them “affected”.  Determining whether an employee is affected will require the consideration of that employee’s terms and conditions.<br/>A person affected by the current change process has preference over a person who remains affected following an earlier change process (the latter has second preference).<br/></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#AffectedEmployee/AffectedEmployee_en> .

<http://example.com/InlandRevenueModel#AffectedEmployee/AffectedEmployee_en>
        rdf:type               skosxl:Label ;
        sem:caseSensitivity    sem:CaseSensitive ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Affected employee"@en .

