<http://example.com/InlandRevenueModel#PrivilegedAccessManagement>
        rdf:type          <http://example.com/InlandRevenueModel-current-#SystemFunctionality> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#PrivilegedAccessManagement/PAM_en> ;
        <http://example.com/InlandRevenueModel#HasRelatedActivity>
                <http://example.com/InlandRevenueModel-current-#InformationSecurityManagement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel-current-#IsInvolvedIn>
                <http://example.com/IRD-test-model#Programe-or-project> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Portfolio Finance content"@en ;
        sem:guid          "87424a34-eab4-42a6-9b45-7a6c656202bb" ;
        skos:broader      <http://example.com/InlandRevenueModel#IdentityManagementFunctionality> ;
        skos:definition   "Privileged Access Management (PAM) is an identity security solution that protects organizations from cyber threats by controlling and monitoring access to critical systems and data. PAM solutions provide visibility into who is using privileged accounts and what they are doing by combining people, processes, and technology to enforce \"least privilege\" and \"just-in-time\" access. Key functions include managing privileged credentials, controlling access through strong authentication and authorization, and auditing all privileged activities to prevent data breaches and unauthorized modifications."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PrivilegedAccessManagement/PrivilegedAccessManagement_en> .

