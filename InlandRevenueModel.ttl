<http://example.com/InlandRevenueModel#NationalFoundationForTheDeaf>
        rdf:type          <http://smartlogic.com/class#Commercial-organisation> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#NationalFoundationForTheDeaf/NFD_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#Disability> , <http://smartlogic.com/term#72781818800075044437385> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS-I C&O content"@en ;
