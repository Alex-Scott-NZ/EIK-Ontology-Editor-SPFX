<http://example.com/InlandRevenueModel#SeniorLeadershipTeam>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-participant-in>
                <http://example.com/InlandRevenueModel#TePungaOTeWakaHui> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#SeniorLeadershipTeam/SLT_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#NotInNPT>
                <http://example.com/InlandRevenueModel#SeniorLeadershipTeam/CCSLT_en> , <http://example.com/InlandRevenueModel#SeniorLeadershipTeam/NEWZEALANDLTAUCKLAND_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://www.teamacademy.co.uk/news-views/what-is-a-senior-leadership-team/\">What exactly is a Senior Leadership Team? - Team Academy</a>​<br></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#SeniorLeadershipTeam/LT_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CTO Office content; IT&C content"@en ;
        sem:guid          "a1199488-057b-4828-938a-458f68a5ed81" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skos:definition   "A senior leadership team is a group of top executives responsible for setting an organization's strategic direction, overseeing critical operations, and making high-level decisions to achieve its goals. Senior leadership are dealing with the business in the upper echelons. While team leaders and managers are managing workers, helping with customers, and performing all the other roles that keeps the company running smoothly on the ground, senior leadership teams are thinking about the business as a whole. This could be talking about how operations are running, whether new tech or processes could make things run more profitably and efficiently, or strategising about the future."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SeniorLeadershipTeam/SeniorLeadershipTeam_en> .

