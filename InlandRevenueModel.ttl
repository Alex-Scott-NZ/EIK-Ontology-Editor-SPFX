<http://example.com/InlandRevenueModel#Project>
        rdf:type          <http://example.com/IRD-test-model#Event-classification> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Intranet - Portfolio 360 site (Glossary and terms)"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A temporary structure that is created to deliver products, objectives, solutions and/or outputs according to an agreed business case. A project is closed once the products, objectives, solutions and/or outputs are delivered. Projects can operate as discreet temporary structures (with no common objectives and inter-related dependencies with other projects), or be grouped with related projects as a programme. A project will have a Senior Responsible Owner and Project Manager, and depending on size, may have other support roles assigned to the project management team."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Portfolio Office content"@en ;
        sem:guid          "153088c8-ec01-4682-8d6a-2e0a5a37d5a5" ;
        skos:broader      <http://example.com/NZ-IRD#Event-classification> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Project/Project_en> .

