        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span style=\"float: none;background-color: transparent;color: rgb(0, 0, 0);text-align: left;\">http://intranet.ird.govt.nz/sdi/our-unit</span><!--EndFragment--><br/></p>"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>SD&amp;I work with business partners to design and build innovative systems, products and services for Inland Revenue that ensure targeted compliance outcomes are delivered, and the effective uptake of entitlements by Inland Revenue's customers.<br/><br/>They also play a major role in ensuring the policy outcomes of Government can be delivered and in supporting the implementation of organisational strategy through our project management services. They achieve these by:<br/> - anticipating and understanding the needs of the business<br/> - understanding and advocating for the voice of the customer<br/> - using our people’s expert knowledge and skills<br/> - designing and helping to deliver quality solutions.<br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://example.com/InlandRevenueModel#DesignLead> , <http://example.com/InlandRevenueModel#DesignPortfolioLead> , <http://example.com/InlandRevenueModel#ServiceDesignPractitioner> ;
