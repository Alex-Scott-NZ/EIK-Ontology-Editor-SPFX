        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#AdverseEventIncomeEqualisationScheme/AdvancedEncryptionStandard_en> , <http://example.com/InlandRevenueModel#AdverseEventIncomeEqualisationScheme/AustralianEvaluationSocietyLtd_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR website"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A scheme which allows farmers who experience adverse events to carry income from forced livestock sales over to the next income year. A self-assessed adverse event is an event which materially affects the business of the taxpayer. These are: fire, flood, drought or other natural event, or sickness or disease among livestock."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#AdverseEventIncomeEqualisationScheme/AEIER_en> , <http://example.com/InlandRevenueModel#AdverseEventIncomeEqualisationScheme/AERDeposit_en> , <http://example.com/InlandRevenueModel#AdverseEventIncomeEqualisationScheme/AES_en> , <http://example.com/InlandRevenueModel#AdverseEventIncomeEqualisationScheme/AdverseEventIncomeEqualisationReserve_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website; Revenue Forecasting content"@en ;
        sem:guid          "66ab08f1-3848-4f11-917d-06bb52f62d4d" ;
        skos:broader      <http://smartlogic.com/term#889308461551267286441058317569518> ;
        skos:historyNote  "Repealed in 2019 and rolled into the Income Equalisation Scheme."@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#AdverseEventIncomeEqualisationScheme/AdverseEventScheme_en> ;
