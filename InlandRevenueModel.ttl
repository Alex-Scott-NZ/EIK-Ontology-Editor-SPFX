        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Natural_disaster_or_emergency_event_2016-.docx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Drought in Southland and Otago regions. The drought in the Southland Region and Clutha and Queenstown Lakes districts is causing financial issues for many farmers and growers and is likely to affect their income for the 2022 income year. <br/>The late deposit provision for 2021 has been approved, with an extension for all customers until 31 May 2022. No late deposit discretion has been made in relation to the 2022 tax year.<br/>Applications for early refunds from the income equalisation scheme will be allowed.<br/><br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "START Help. List of adverse events."@en ;
        sem:guid            "4ded6d04-64d1-40db-b2a9-a3af2d231d7c" ;
        skos:broader        <http://smartlogic.com/term#134942778228015166252651> ;
        skos:editorialNote  "Checked in Viva Topics but it wasn't there."@en ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#SouthlandDroughtMarch2022/DroughtInSouthlandAndOtagoRegions_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#SouthlandDroughtMarch2022/SouthlandDroughtMarch2022_en> .

