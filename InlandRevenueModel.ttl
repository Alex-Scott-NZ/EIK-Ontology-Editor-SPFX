        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#ResidentialLandWithholdingTax-RLWT-Declaration> , <http://example.com/InlandRevenueModel#ResidentialLandWithholdingTax-RLWT-Exemption> , <http://example.com/InlandRevenueModel#ResidentialLandWithholdingTax-RLWT-Return> , <http://example.com/InlandRevenueModel#WithholderObligationsForDeductingRLWT> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#ResidentialLandWithholdingTaxCalculator> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Residential land withholding tax (RLWT) is a withholding tax on certain residential property sales. The tax type for RLWT is RLT.<br>RLWT will apply if the sale meets specific conditions.<br> * A sale amount is paid or payable on or after 1 July 2016.<br> * The property sold is in New Zealand and is defined as residential land.</p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://smartlogic.com/term#46778107336044277748146/TakeHookKainga_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR business products register"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://smartlogic.com/term#46778107336044277748146/PR.T.013_en> ;
        sem:guid          "17666d81-2e86-5223-b664-f5c7ca7a2a79" ;
        skos:broader      <http://smartlogic.com/term#39540492458666896042871634590083> ;
        skos:definition   "Residential land withholding tax is a tax deducted from some residential property sales. It's paid by offshore people who sell their residential property. Withholders deduct and pay the tax to us for the offshore people."@en ;
        skos:historyNote  "RLWT will generally apply when the sale amount is paid or payable on or after 1 July 2016."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#ResidentialLand> , <http://example.com/InlandRevenueModel#RLWTRepayment> , <http://smartlogic.com/term#716311899949028386928466293214695> ;
        skosxl:altLabel   <http://smartlogic.com/term#46778107336044277748146/ResidentialLandWithholdingTax_en> ;
        skosxl:prefLabel  <http://smartlogic.com/label#46778107336044277748146_English> .

