                "Adapted from W3C WAI"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Digital Accessibility is the practice of ensuring that everyone - including those with disabilities and those using assistive technologies - can access and interact with our digital information and services."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Knowledge Collection administrators"@en ;
