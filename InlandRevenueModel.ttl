<http://example.com/InlandRevenueModel#ComprehensiveAndProgressiveAgreementForTrans-PacificPartnership>
        rdf:type          <http://smartlogic.com/class#Agreement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#HasParticipatingCountry>
                <http://example.com/Cleaned-Inland-Revenue-model#BruneiDarussalam> , <http://example.com/Cleaned-Inland-Revenue-model#Canada> , <http://example.com/Cleaned-Inland-Revenue-model#Chile> , <http://example.com/Cleaned-Inland-Revenue-model#Japan> , <http://example.com/Cleaned-Inland-Revenue-model#Malaysia> , <http://example.com/Cleaned-Inland-Revenue-model#Mexico> , <http://example.com/Cleaned-Inland-Revenue-model#Peru> , <http://example.com/Cleaned-Inland-Revenue-model#Singapore> , <http://example.com/Cleaned-Inland-Revenue-model#Vietnam> , <http://smartlogic.com/term#189374230129126350999034> , <http://smartlogic.com/term#84951202648081637135914> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ComprehensiveAndProgressiveAgreementForTrans-PacificPartnership/CPTPP_en> , <http://example.com/InlandRevenueModel#ComprehensiveAndProgressiveAgreementForTrans-PacificPartnership/TPP11_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        sem:guid          "7a6e447e-42a2-4f22-9c82-3024c976f618" ;
        skos:broader      <http://smartlogic.com/term#198788318597836492471216> ;
        skos:definition   "<p>The Comprehensive and Progressive Agreement for Trans-Pacific Partnership (CPTPP) is a free trade agreement among 11 countries in the Asia-Pacific region, including New Zealand, Australia, Brunei, Canada, Chile, Japan, Malaysia, Mexico, Peru, Singapore, and Vietnam. It aims to reduce trade barriers, encourage regulatory cooperation, and facilitate economic integration. The agreement also includes commitments to high labour and environmental standards and preserves the right of member countries to make laws to protect their people and environment.</p><p><br></p><p> The previous attempt was named the Trans-Pacific Partnership (TPP).<br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#TransPacificPartnership> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ComprehensiveAndProgressiveAgreementForTrans-PacificPartnership/ComprehensiveAndProgressiveAgreementForTrans-PacificPartnership_en> .

