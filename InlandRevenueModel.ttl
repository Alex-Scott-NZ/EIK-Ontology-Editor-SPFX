<http://example.com/InlandRevenueModel#SpouseOrPartner>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/InlandRevenueModel#HasAttribute>
                <http://example.com/Cleaned-Inland-Revenue-model#Adjusted-taxable-income> , <http://example.com/InlandRevenueModel#IRDRegistration> , <http://example.com/InlandRevenueModel#PersonalRelationships> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsMemberOf>
                <http://example.com/InlandRevenueModel#Household> , <http://example.com/InlandRevenueModel-current-#Family> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-25"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#IsRoleRelatedTo>
                <http://example.com/InlandRevenueModel#Partnered> , <http://example.com/InlandRevenueModel-current-#PrincipleCareGiver> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling."@en ;
        sem:guid          "1a8946ad-e431-4b05-9249-63c9395d7d40" ;
        skos:broader      <http://example.com/InlandRevenueModel#FamilyRoles> ;
        skos:definition   "<p>A spouse or partner is the person someone is in a committed adult relationship with, whether they are married, in a civil union, or living together as a couple.<br>This includes:<br>•\tA husband or wife<br>•\tA civil union partner<br>•\tA de facto partner (someone they are in a couple relationship with, even if not married)<br>It does not depend on gender, sexual orientation, or whether the relationship is formally registered.<br>A person is usually considered a spouse or partner if they are in an ongoing relationship similar to a married couple, even if they live apart for practical reasons.<br><br></p>"@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#SpouseOrPartner/PartnerOrSpouse_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SpouseOrPartner/SpouseOrPartner_en> .

<http://example.com/InlandRevenueModel#SpouseOrPartner/PartnerOrSpouse_en>
        rdf:type               skosxl:Label ;
