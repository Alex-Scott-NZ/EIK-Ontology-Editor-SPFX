<http://example.com/InlandRevenueModel#AccommodationAllowance>
        rdf:type          <http://smartlogic.com/class#Entitlement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#AccommodationAllowance/NgaUtuTapuiNoho_en> , <http://example.com/InlandRevenueModel#AccommodationAllowance/NgaUtuTapuiNoho_en0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#BenefitsAdministration> , <http://example.com/InlandRevenueModel#RemunerationAdministration> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>IR Glossary (General - START Help)</p><div><p>https://irnz.sharepoint.com/sites/kc-common-vocabulary/Lists/irglossary/AllItems.aspx<br/></p></div>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>When an employer pays for accommodation on behalf of an employee, or pays an accommodation allowance to an employee, it is an accommodation allowance. Additionally employers may provide accommodation for their employee.<br/>Certain accommodation or accommodation payments may be tax exempt, if provided:<br/>For out-of-town secondments or capital projects.<br/>In connection with Canterbury earthquake reconstruction projects.<br/>When an employee is required to work in work in multiple locations on an ongoing basis.<br/>When required to stay overnight to attend a meeting, training course or conference.<br/>There are four specific types of employer-provided accommodation that are excluded from being a taxable allowance, and are therefore non-taxable. They are.<br/>A berth, room or other lodging provided on a mobile workplace i.e. a ship, truck or oil rig.<br/>A station in Antarctica.<br/>Lodging provided for shift workers i.e. fire fighters, ambulance staff and caregivers when:<br/>They're periodically required to sleep at their workplace, and<br/>It's provided only for the duration of the performance of their duties.<br/>At remote locations outside New Zealand i.e. mines in Australia where an employee is expected to &#34;fly in and fly out&#34;.<br/>If not tax exempt, accommodation allowances are treated as taxable benefit allowances.<br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Payroll content</p><div><p>Māori term from Te Taura Whiri Maori Language Commission</p></div>"@en ;
        sem:guid          "18bd8dad-1dd3-43f8-9c3f-b127ae469364" ;
        skos:broader      <http://smartlogic.com/term#123808201598278620251950> , <http://smartlogic.com/term#209836142683206283258693> ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#PayrollManagement> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#AccommodationAllowance/AccommodationAllowance_en> .

<http://example.com/InlandRevenueModel#AccommodationAllowance/AccommodationAllowance_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Accommodation allowance"@en .

