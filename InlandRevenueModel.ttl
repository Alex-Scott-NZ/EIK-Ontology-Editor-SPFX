<http://smartlogic.com/term#33972488389743070613663>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Uses-template>
                <http://example.com/InlandRevenueModel#BusinessContinuityCo-ordinationPlan> , <http://example.com/InlandRevenueModel#EmergencyResponsePlan> , <http://example.com/InlandRevenueModel#SiteEmergencyPlan> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://smartlogic.com/term#33972488389743070613663/BCEM_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#BusinessAndCorporate> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><!--StartFragment--><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">Business Continuity and Emergency Management intranet page</span><!--EndFragment--><br/></p>"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Business Continuity and Emergency Management is an IR team responsible for ensuring Inland Revenue has effective business continuity and emergency responses in place. We do this by providing tools, support and advice to IR business units to ensure they are well prepared in the event of any business disruption or emergency."@en ;
        <http://example.com/InlandRevenueModel-current-#ProducesAuthority>
                <http://example.com/InlandRevenueModel#ContinuityAndRecoveryPolicy> ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#BusinessIncidentManagement> , <http://example.com/InlandRevenueModel#CrisisManagement> , <http://example.com/InlandRevenueModel#EmergencyManagement> , <http://smartlogic.com/term#81122857346488413646253> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://smartlogic.com/term#33972488389743070613663/BusinessContinuityAndEmergencyManagement_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Org_headcount.xlsx"@en ;
        sem:guid          "fcfb9ee0-484c-537c-83cf-2fcade0eac01" ;
        skos:broader      <http://example.com/InlandRevenueModel#OrganisationalResilience> ;
        skos:definition   "Business continuity and emergency management are related but distinct concepts. Business continuity focuses on maintaining critical business operations during and after a disruption, while emergency management focuses on the immediate response to a crisis to protect people and property. Essentially, emergency management is a subset of the broader business continuity strategy. "@en ;
        skosxl:prefLabel  <http://smartlogic.com/label#33972488389743070613663_English> .

