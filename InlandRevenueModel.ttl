<http://example.com/Cleaned-Inland-Revenue-model#Imputation>
        rdf:type          <http://example.com/NZ-IRD#Financial-method> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://smartlogic.com/term#406655357987148568919744288258712> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel#ImputationGroupMaintenance> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#ImputationGroupMaintenance> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IR website"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "​A system that allows companies to pass on to their shareholders the benefit of the New Zealand income tax they have already paid. A company generates imputation credits when it pays income tax. It records these credits in its imputation credit account (ICA). When it distributes dividends of its profits to its shareholders, it can also distribute a certain amount of the imputation credits by attaching them to the dividend payment. The imputation credit amount can be used to offset the same amount of tax that the shareholder is liable to pay on that dividend income."@en ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://example.com/InlandRevenueModel-current-#ImputationTax> , <http://smartlogic.com/term#677364316680445905612454563157866> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "OCTC content; IR website"@en ;
        sem:guid          "6768e791-4030-4ad8-b0ca-a09a93f0d19b" ;
        skos:broader      <http://smartlogic.com/term#172989254134847250795521> ;
        skos:definition   "A mechanism that a company can use to pass on credits for tax it has paid on its profits to its shareholders when it pays them dividends. These imputation credits offset the amount of tax that the resident shareholders would otherwise be liable to pay on those dividends, so they don't have to pay \"double tax\"."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#ImputationGroup> ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#Imputation/Franking_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#Imputation/Imputation_en> .

<http://example.com/Cleaned-Inland-Revenue-model#Imputation/Franking_en>
        rdf:type            skosxl:Label ;
        sem:stemming        sem:StemmingOff ;
        skosxl:literalForm  "Franking"@en .

<http://example.com/Cleaned-Inland-Revenue-model#Imputation/Imputation_en>
        rdf:type            skosxl:Label ;
        sem:stemming        sem:StemmingOff ;
        skosxl:literalForm  "Imputation"@en .

<http://example.com/Cleaned-Inland-Revenue-model#ImputationCreditAccount>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#MoneyHeld> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/Cleaned-Inland-Revenue-model#ImputationCreditAccount/NgaPuteaTawereHikaroUara_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/Cleaned-Inland-Revenue-model#ImputationCreditAccount/ICA_en> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel#Trans-TasmanImputationElectionForm> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IR website"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A memorandum account that a New Zealand (or Australian) company maintains, in which it records its imputation credits (mainly generated by paying income tax) and debits (mainly generated by attaching credits to dividends it distributes). Primarily, its ICA is the mechanism a company uses to record the information it needs, to complete its annual IR4J imputation return, from which we assess whether the company has managed to keep its balance of credits and debits at $0."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/Cleaned-Inland-Revenue-model#ImputationCreditAccount/NgaPuteaTawereHikaroUara_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>IR website; </p><p>Data Science &amp; Analytics content. Māori term from Te Taura Whiri Māori Language Commission</p>"@en ;
        sem:guid          "bd414418-a718-4aef-9f8a-d5baf978da75" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerFinancialInformation> ;
        skos:definition   "The ICA is a memorandum (record-keeping) account, which records the balance of imputation credits available for allocation with dividends. It has an opening balance, credit and debit entries, and a closing balance."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#MemoradumAccount> , <http://example.com/InlandRevenueModel#DividendWitholdingTax> , <http://smartlogic.com/term#677364316680445905612454563157866> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#ImputationCreditAccount/ImputationCreditAccount_en> .

<http://example.com/Cleaned-Inland-Revenue-model#ImputationCreditAccount/ICA_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "ICA"@en .

