<http://example.com/InlandRevenueModel#Data-IntelligenceGovernanceAuthority>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#Data-IntelligenceGovernanceAuthority/DIGA_en> ;
