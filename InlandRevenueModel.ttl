<http://example.com/InlandRevenueModel#DigitalAccessibility>
        rdf:type          <http://example.com/InlandRevenueModel#Measurement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#WebAccessibilityStandard> ;
