                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerSegmentsAndRoles> ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A person who is any of the following:  · a person that is accredited by the Commissioner and has entered into agreements to be responsible for satisfying employer’s payroll and PAYE obligations with not less than 10 employers;  </p><p>· a person that has stopped being a PAYE intermediary but still has the rights and obligations under the PAYE rules and ESCT rules of a PAYE intermediary in relation to funds an employer paid to them which they hold at the time they stop being an intermediary.</p>"@en ;
        <http://example.com/InlandRevenueModel-current-#IsRoleRelatedTo>
                <http://example.com/Cleaned-Inland-Revenue-model#IntermediaryCessationForm> , <http://example.com/Cleaned-Inland-Revenue-model#PAYESubsidy> , <http://example.com/InlandRevenueModel#IntermediaryRelationshipService> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Business Rules business terms; IR website"@en ;
        sem:guid          "68f529c3-69d1-4d9a-8b6c-cd79a81cb034" ;
        skos:broader      <http://example.com/InlandRevenueModel#Agent> ;
        skos:related      <http://example.com/InlandRevenueModel#RegisteredIntermediary> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#PAYEIntermediary/PAYEIntermediary_en> .

