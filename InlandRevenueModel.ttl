                "Definition derived from IR's website content combined with some external definitions."@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "OECD"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The structured framework of policies, processes, and controls that ensures an organisation meets its tax obligations accurately, consistently, and ethically, while managing tax risks and maintaining transparent engagement with tax authorities."@en ;
        <http://example.com/InlandRevenueModel-current-#IsInvolvedIn>
                <http://example.com/InlandRevenueModel#Audit> ;
        <http://example.com/NZ-IRD#Source-of-term>
