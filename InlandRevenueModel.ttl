        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#FATCAU.S.ReportableAccountsGuidanceNotes> , <http://example.com/InlandRevenueModel#ForeignAccountTaxComplianceAct-FATCA-ApplicationOfFATCAToCollectiveInvestmentVehiclesGuidanceNotes> , <http://example.com/InlandRevenueModel#ForeignAccountTaxComplianceAct-FATCA-ProvisionOfUSTINs> , <http://example.com/InlandRevenueModel#ForeignAccountTaxComplianceAct-FATCA-TrustsGuidanceNotes> ;
