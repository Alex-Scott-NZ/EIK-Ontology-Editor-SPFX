                <http://example.com/InlandRevenueModel#RegulationsReviewCommittee> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A type of Legislative Instrument that is made by the Executive Council presided over by the Governor-General."@en ;
        <http://example.com/InlandRevenueModel-current-#IsExampleOf>
                <http://smartlogic.com/term#115713012307933578620132> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "6a1abe8e-8980-5530-906a-d29b5bd94f53" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#AuthorityType> ;
        skos:definition   "In New Zealand, an Order in Council is a form of secondary legislation made by the Governor-General on the advice of the Executive Council, allowing the government to make and implement legal decisions outside of Parliament's direct role. This mechanism enables quick regulatory changes and is used to create regulations, rules, orders, and commencement orders that require legal force but don't need to go through the full parliamentary process of an Act. Examples include implementing recovery measures after natural disasters or setting a future date for an Act to take effect. "@en ;
        skosxl:prefLabel  <http://smartlogic.com/label#82016005258704165488529_English> .

