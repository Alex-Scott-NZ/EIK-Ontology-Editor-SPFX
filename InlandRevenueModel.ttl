<http://example.com/Cleaned-Inland-Revenue-model#ExtraPay>
        rdf:type          <http://example.com/NZ-IRD#Legally-defined-term> , <http://smartlogic.com/class#Income> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "A payment made in one lump sum or in 2 or more instalments that is made to a person in connection with their employment but is not a payment regularly included in the person’s salary or wages or overtime pay."@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/CORP-people-and-workplace-services/Shared%20Documents/Forms/AllItems.aspx?id=%2Fsites%2FCORP%2Dpeople%2Dand%2Dworkplace%2Dservices%2FShared%20Documents%2FPay%20and%20benefits%2FExtra%2Dpay%2Dor%2Dlump%2Dsum%2Dtax%2Dguide%2Epdf&amp;parent=%2Fsites%2FCORP%2Dpeople%2Dand%2Dworkplace%2Dservices%2FShared%20Documents%2FPay%20and%20benefits\">irnz.sharepoint.com/sites/CORP-people-and-workplace-services/Shared Documents/Forms/AllItems.aspx?id=%2Fsites%2FCORP-people-and-workplace-services%2FShared Documents%2FPay and benefits%2FExtra-pay-or-lump-sum-tax-guide%2Epdf&amp;parent=%2Fsites%2FCORP-people-and-workplace-services%2FShared Documents%2FPay and benefits</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Income Tax Act 2007, s RD 7(1)  (Reprint as at 1 July 2016)"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Lump sum payments (also known as Extra pays) include:</p><p><br></p><p>Back pay or<br>Lump sum holiday pay<br>Annual or special bonuses<br>Cashed-in Annual leave<br>Retiring or redundancy payments<br>Payments for accepting restrictive covenants<br>Gratuities<br><br>Overtime or any regular payments are not lump sum payments.<br></p>"@en ;
        <http://example.com/NZ-IRD#Is-defined-by>
                <http://smartlogic.com/term#153321368926185107673047370395105> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Business Rules business terms"@en ;
        sem:guid          "beab31e4-2ba5-43b6-b51d-fbc9b2d139e6" ;
        skos:broader      <http://example.com/NZ-IRD#Employment-income> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#ExtraPay/ExtraPay_en> .

<http://example.com/Cleaned-Inland-Revenue-model#ExtraPay/ExtraPay_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Extra pay"@en .

