        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Unacceptable-tax-position> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#ShortfallPenaltyForTakingAnUnacceptableTaxPosition/ShortfallPenaltyForTakingAnUnacceptableTaxPosition_en> .

