<http://example.com/InlandRevenueModel-current-#CommonReportingStandard>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#Taxation-BusinessTax-ExchangeOfInformation-AndRemedialMatters-Act2017> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsOutcomeOf>
                <http://smartlogic.com/term#173173219655321100475642> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel-current-#CommonReportingStandard/TePaerewaPurongoNoa_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel-current-#CommonReportingStandard/CRS_en> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#AccountantsAndTheCRS> , <http://example.com/InlandRevenueModel#CRS-DueDiligenceAndReportingObligations> , <http://example.com/InlandRevenueModel#FamilyTrustObligationsUnderTheCRS> , <http://example.com/InlandRevenueModel#GuidanceOnTheCommonReportingStandardForAutomaticExchangeOfInformation> , <http://example.com/InlandRevenueModel#IsTheTrustAReportingNZFIUnderCRS-> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#Intelligence> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>New Zealand, along with many other jurisdictions, has adopted the Common Reporting Standard (CRS) for the Automatic Exchange of Financial Account Information (AEOI) in line with the Organisation for Economic Co-operation and Development (OECD). This global framework facilitates the collection, reporting, and exchange of financial account information about individuals who invest outside their tax residence. <br>Financial institutions in New Zealand, as well as worldwide, are legally required to gather this information and report it to tax authorities. These authorities then exchange the information to ensure everyone pays the correct amount of tax, helping to detect and prevent offshore tax evasion.</p>"@en ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://example.com/InlandRevenueModel-current-#AutomaticExchangeOfInformation0> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel-current-#CommonReportingStandard/CRSAvoidance_en> , <http://example.com/InlandRevenueModel-current-#CommonReportingStandard/CRSSchema_en> , <http://example.com/InlandRevenueModel-current-#CommonReportingStandard/CRSStandard_en> , <http://example.com/InlandRevenueModel-current-#CommonReportingStandard/GATCA_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Making Tax Simpler, pub June 2017; PAS content</p><div><p>Māori term from Te Taura Whiri Maori Language Commission</p></div>"@en ;
        sem:guid          "532342a2-83ac-4f25-a396-60efa07a35eb" ;
        skos:broader      <http://smartlogic.com/term#179971457599096168225700491349283> ;
        skos:definition   "An information standard for the automatic exchange of tax and financial information on a global level, which the OECD developed in 2014. Its purpose is to combat tax evasion."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Non-financialForeignEntity> , <http://example.com/InlandRevenueModel#CommonReportingStandardDisclosure> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel-current-#CommonReportingStandard/CRSAppliedStandard_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#CommonReportingStandard/CommonReportingStandard_en> .

