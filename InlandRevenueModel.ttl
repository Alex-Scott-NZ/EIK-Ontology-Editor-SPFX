                true ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2025-08-08"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://www.parliament.nz/en/pb/sc/scl/regulations-review/"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "This is a specialist committee. To keep New Zealand running efficiently, law making powers are often given to bodies that are not Parliament. These bodies make rules about common things like ACC fees, industry standards and civil defence responses that can have a nationwide impact. The Regulations Review Committee makes sure that all these rules have been made fairly and are used consistently."@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#ParliamentaryCommitteeWork> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Parliament website"@en ;
        sem:guid          "371d7c29-0078-405d-a43d-05b782060e47" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#SelectCommittee> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#RegulationsReviewCommittee/RegulationsReviewSelectCommittee_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#RegulationsReviewCommittee/RegulationsReviewCommittee_en> .

