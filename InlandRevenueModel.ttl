<http://example.com/InlandRevenueModel#PublicFinanceAct1989>
        rdf:type          <http://smartlogic.com/class#Law> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://example.com/InlandRevenueModel#Appropriation> , <http://example.com/InlandRevenueModel#Multi-yearAppropriation> ;
