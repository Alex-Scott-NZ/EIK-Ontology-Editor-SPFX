<http://example.com/InlandRevenueModel#SleepoverPayment>
        rdf:type          <http://smartlogic.com/class#Income> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        sem:guid          "d70d9c55-fd01-4746-ac51-1834bcced3b3" ;
        skos:broader      <http://smartlogic.com/term#149403043187561556930337> ;
        skos:definition   "<p>Under the Sleepover Wages (Settlement) Act 2011, a sleepover is defined as: A period of time spent by an employee overnight during which the employee, under the terms of their contract of service, is:<br>Required to be at the employee’s workplace;<br>Allowed to sleep at the workplace while on duty; and<br>Required to be available to attend to duties during the night as necessary. [legislation.govt.nz]<br><br>Sleepover wages are:<br>Wages payable under the Minimum Wage Act 1983 for each hour of a sleepover shift. Historically, these were often paid as a lump sum, but legal rulings confirmed they must meet minimum wage requirements for all hours rostered, including sleeping time.<br><br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SleepoverPayment/SleepoverPayment_en> .

<http://example.com/InlandRevenueModel#SleepoverPayment/SleepoverPayment_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Sleepover payment"@en .

