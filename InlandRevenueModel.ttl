<http://example.com/InlandRevenueModel#NewZealandPayrollPractitioners-Association>
        rdf:type          <http://smartlogic.com/class#Commercial-organisation> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/InlandRevenueModel#NewZealandPayrollPractitioners-Association/NZPayrollPractitioners_en> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-party-classification>
