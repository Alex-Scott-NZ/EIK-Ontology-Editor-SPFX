<http://example.com/NZ-IRD#Hidden-Economy-Programme>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/NZ-IRD#Hidden-Economy-Programme/HEProgramme_en> ;
