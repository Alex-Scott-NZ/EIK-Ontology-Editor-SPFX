<http://example.com/Cleaned-Inland-Revenue-model#Testamentary-trust>
        rdf:type          <http://smartlogic.com/class#Taxpayer> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A testamentary trust is a legal entity created as specified in a person's will, and is occasioned by the death of that person. It is created to address any estate accumulated during that person's lifetime or generated as a result of the death itself, such as a settlement in a wrongful-death suit, or the proceeds from a life insurance policy held on the settlor. A trust can be created to oversee such assets."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website"@en ;
        sem:guid          "5090f2b8-0548-45b6-a396-f6dd5b94d8d3" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#EligibleTrust> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#Testamentary-trust/Testamentary-trust_en> .

