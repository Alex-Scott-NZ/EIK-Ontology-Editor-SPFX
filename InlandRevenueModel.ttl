<http://example.com/InlandRevenueModel#AdministrativeAndOperationalKnowledge>
        rdf:type          <http://smartlogic.com/class#Tax-payer-attribute> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#FinanceAndAdministration> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#TechnicalDevelopment> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Technical knowledge framework"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Topics in this category are largely those about administering and operationalising the Revenue Acts. They are legislatively based (predominantly in the Tax Administration Act) and are tax and social policy specific. An exception to this is the administration of the Unclaimed Money Act 1971. Although this legislation is not a Revenue Act nor tax and social policy related, Inland Revenue administers the Act on behalf of Treasury and the knowledge required to do so fits best within the Administrative and Operational category. The topics in this category generally apply across customer groups."@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://example.com/Cleaned-Inland-Revenue-model#Personal-Assistant> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Technical knowledge framework."@en ;
        sem:guid          "86069472-d8d7-4bea-a9eb-086d5ed87b07" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#PersonalSkills> ;
        skos:related      <http://example.com/InlandRevenueModel#SkillsSupply> , <http://smartlogic.com/term#95330720266127017159376> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#AdministrativeAndOperationalKnowledge/AdministrativeAndOperationalKnowledge_en> .

