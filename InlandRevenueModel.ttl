        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IR website"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "In a group of companies a subvention payment is an offset against the net income of the profit company and reduces the amount of available losses to the loss company."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "3d13ebb5-22f1-45ff-b3bb-a080812d5934" ;
        skos:broader      <http://smartlogic.com/term#133464950737212625130954948425202> ;
        skos:definition   "A payment by the profit company to the loss company. A subvention payment reduces the profit company's net income and the loss company's available net losses for tax purposes by the amount of the payment."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SubventionPayment/SubventionPayment_en> .

