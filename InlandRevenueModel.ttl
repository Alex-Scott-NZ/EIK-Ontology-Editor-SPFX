        skos:definition     "<p><!--StartFragment-->The Hague Convention, on the International Recovery of Child Support and Other Forms of Family Maintenance, is a multilateral treaty which provides for the recovery of Child Support and other forms of maintenance when the liable person resides in a different country to where the Child Support or Maintenance assessment was raised.<!--EndFragment--><br/></p>"@en ;
        skos:editorialNote  "<p>List of contracting countries can be found here:&nbsp;<a href=\"https://www.hcch.net/en/instruments/conventions/status-table/?cid=131\">HCCH | #38 - Status table</a>​</p>"@en ;
        skos:related        <http://example.com/InlandRevenueModel#InternationalCourtOrder> ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#HagueConventionOnInternationalRecoveryOfChildSupportAndOtherFormsOfFamilyMaintenance/2007ChildSupportConvention_en> , <http://example.com/InlandRevenueModel#HagueConventionOnInternationalRecoveryOfChildSupportAndOtherFormsOfFamilyMaintenance/ConventionOnTheInternationalRecoveryOfChildSupportAndOtherFormsOfFamilyMaintenance_en> , <http://example.com/InlandRevenueModel#HagueConventionOnInternationalRecoveryOfChildSupportAndOtherFormsOfFamilyMaintenance/HagueChildSupportConvention_en> , <http://example.com/InlandRevenueModel#HagueConventionOnInternationalRecoveryOfChildSupportAndOtherFormsOfFamilyMaintenance/HagueMaintenanceConvention_en> ;
