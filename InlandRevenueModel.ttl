<http://example.com/InlandRevenueModel#MahutongaProgramme>
        rdf:type          <http://smartlogic.com/class#IR-corporate-policy> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsOutcomeOf>
                <http://example.com/InlandRevenueModel#MaoriResponsiveness> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#TeArapiki> , <http://example.com/InlandRevenueModel#Turama> ;
