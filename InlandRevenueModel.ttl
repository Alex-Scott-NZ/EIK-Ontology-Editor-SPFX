<http://example.com/InlandRevenueModel#HowWeWorkAtIR>
        rdf:type            <http://smartlogic.com/class#Business-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#HowWeWorkAtIR/TePouOTeTangata_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Corporate Space<br/></p><p><span lang=\"mi-NZ\"><font face=\"Calibri\" size=\"3\"><a href=\"https://irnz.sharepoint.com/sites/News/SitePages/Have-your-say-on-how-we-do-things-at-IR.aspx\">https://irnz.sharepoint.com/sites/News/SitePages/Have-your-say-on-how-we-do-things-at-IR.aspx</a></font></span></p><p><font face=\"Times New Roman\" size=\"3\"><br/><br/></font></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Te Pou o te Tangata is an initiative to provide more clarity on how we do things at IR - and we’re working with our entire IR whānau to do this. Currently we talk about how we work as our cultural anchors, values and behaviours - and more! But now what these are is up to us. We want to create a single set of descriptors considered essential for us to continue the momentum following our 6-year transformation and continue to deliver its ongoing benefits. The aim is for the outcomes of this work to better reflect who we are as an organisation. They should connect us more closely to our vision of becoming a world class revenue organisation and reflect the importance Māori Crown relations."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Haukāinga Featured News. Māori term from IR Māhutonga team"@en ;
        sem:guid            "471ba827-648c-4052-8238-2217f1b90a16" ;
        skos:broader        <http://example.com/IRD-test-model#Programe-or-project> ;
        skos:editorialNote  "Outcomes of Te Pou o te Tangata released by Peter Mersi (Commissioner of Inland Revenue) 28-11-2022. Whanaungatanga, Manaakitanga and Mahi Tika."@en ;
        skos:related        <http://example.com/InlandRevenueModel#MahiTika> , <http://example.com/InlandRevenueModel#Manaakitanga0> , <http://example.com/InlandRevenueModel#Whanaukitanga> ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#HowWeWorkAtIR/HowWeWorkAtIR_en0> , <http://example.com/InlandRevenueModel#HowWeWorkAtIR/OrganisationalBehaviour_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#HowWeWorkAtIR/HowWeWorkAtIR_en> .

<http://example.com/InlandRevenueModel#HowWeWorkAtIR/HowWeDoThingsAtIR_en>
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase .

