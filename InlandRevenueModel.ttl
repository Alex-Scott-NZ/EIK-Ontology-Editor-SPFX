<http://example.com/InlandRevenueModel#BusinessSystemImpertives>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-participant>
                <http://example.com/InlandRevenueModel#BSISteeringCommittee> , <http://example.com/InlandRevenueModel#COBOLTeam> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#BusinessSystemImpertives/PunahaWaiwaiTaake_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#BusinessSystemImpertives/BSI_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Business System Imperatives (BSI) is a programme of work and has two streams:<br/>- Business Imperatives<br/>- Annual Returns<br/>BSI is funded by the Investment Board to implement and deliver imperatives which include:<br/>- Small Legislative Changes — Delivering on Ministerial commitments<br/>- System / process fixes (Run)<br/>- External Imperative - 'Must do' by an external driver other than Legislation.<br/>- Agreed BT Initiatives - Initiatives on the Heritage side, for BT (e.g. data cleansing).<br/></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#BusinessSystemImpertives/AR-BSI_en> , <http://example.com/InlandRevenueModel#BusinessSystemImpertives/BSI-AR_en> , <http://example.com/InlandRevenueModel#BusinessSystemImpertives/BSI-_en> , <http://example.com/InlandRevenueModel#BusinessSystemImpertives/BSIFast-cycle_en> , <http://example.com/InlandRevenueModel#BusinessSystemImpertives/BSIImperatives_en> , <http://example.com/InlandRevenueModel#BusinessSystemImpertives/BusinessSystemImprovement_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Portfolio Office content; Intranet"@en ;
        sem:guid          "c3d78970-fcf8-48bd-943d-a6e0ece2d156" ;
        skos:broader      <http://example.com/IRD-test-model#Programe-or-project> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#BusinessSystemImpertives/BusinessSystemImpertives_en> .

