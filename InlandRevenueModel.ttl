<http://example.com/InlandRevenueModel#CabinetExpenditureAndRegulatoryReviewCommittee>
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://www.dpmc.govt.nz/cabinet-committees/exp-cabinet-expenditure-and-regulatory-review-committee\">(EXP) Cabinet Expenditure and Regulatory Review Committee | Department of the Prime Minister and Cabinet (DPMC)</a>​<br></p>"@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#ParliamentaryCommitteeWork> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "https://www.dpmc.govt.nz/our-business-units/cabinet-office/supporting-work-cabinet/cabinet-committees"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#CabinetExpenditureAndRegulatoryReviewCommittee/EXP_en> ;
        sem:guid          "cdc9b0de-0207-4cd2-bc58-be3d0b1e9880" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#CabinetCommittee> ;
        skos:definition   "Terms of reference. To: review significant expenditure, investment, and procurement proposals, including those with implications for the Budget; to consider significant regulatory processes, systems, and proposals; and to consider strategic and policy matters relating to the public sector and government administration. EXP will consider the outcomes of significant expenditure review and regulatory review programmes. Business as usual expenditure and regulatory issues will be considered at other relevant Cabinet committees."@en ;
        skos:historyNote  "New committee - discovered in 2025."@en ;
        skos:related      <http://example.com/InlandRevenueModel#RegulatoryImpactAssessment> , <http://example.com/InlandRevenueModel#ReviewPhase> , <http://smartlogic.com/term#12883035458117739081370> , <http://smartlogic.com/term#133464950737212625130954948425202> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CabinetExpenditureAndRegulatoryReviewCommittee/CabinetExpenditureAndRegulatoryReviewCommittee_en> .

