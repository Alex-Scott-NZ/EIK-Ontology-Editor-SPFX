        sem:guid          "cb5ffd9f-99fe-4e6a-a092-41e3d56b5e42" ;
        skos:broader      <http://smartlogic.com/term#147891654668390767194534> ;
        skos:definition   "A Non-Disclosure Agreement (NDA), also called a confidentiality agreement, is a legally binding contract that prohibits parties from sharing specific confidential information with third parties. NDAs protect sensitive information, like trade secrets and proprietary data, by creating a legal obligation of secrecy between the involved parties, with defined consequences for breaking the agreement. They are commonly used in business to safeguard intellectual property and business strategies when sharing information with potential partners, investors, or employees."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Intellectual-property> , <http://example.com/InlandRevenueModel#ConfidentialityAgreement> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Non-disclosureAgreement/Non-disclosureAgreement_en> .

