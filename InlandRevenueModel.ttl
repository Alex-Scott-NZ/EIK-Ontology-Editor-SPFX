                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A tax credit for individuals on low incomes to increase take-home pay when working."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>IR website; Business Rules business terms; PAS content</p><div><p>Māori term from Te Taura Whiri Maori Language Commission</p></div>"@en ;
