<http://example.com/InlandRevenueModel-current-#BusinessOwnersForum>
        rdf:type            <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel-current-#BusinessOwnersForum/BOF_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#GovernanceAndCommunities> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IKM-compiled definition taken from BT sources."@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A Business Transformation governance group, also known as a BOF. <br/>Business Owners Forums will own the business processes that will ultimately form part of our future business solutions. They will be responsible for refining and approving changes to existing business processes to ensure they are workable in practice and align to IR’s strategic vision, subject to final approval by the respective Design Council.<br/>There will be a Business Owners Forum for each of the following areas of focus: Service Delivery, Data, Metrics, Analytics and Information Management, and Knowledge Management and Documentation.<br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IKM project content"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel-current-#BusinessOwnersForum/businessOwnersTeam_en> ;
        sem:guid            "cbbf1739-3a59-4e55-b87e-44efb550c50c" ;
        skos:broader        <http://example.com/InlandRevenueModel#_PreviousBoards-CommitteesOrGroups-> ;
        skos:editorialNote  "Initially five BOFs were set up in 2014. These replaced the Business Owners Team. The last of them was migrated to another governance group in 2019."@en ;
        skos:related        <http://example.com/InlandRevenueModel#BusinessOwnersTeam> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel-current-#BusinessOwnersForum/BusinessOwnersForum_en> .

