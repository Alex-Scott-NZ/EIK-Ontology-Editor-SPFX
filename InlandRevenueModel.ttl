        sem:guid          "f57096e3-437c-47d1-a9ae-843e44f8a221" ;
        skos:broader      <http://example.com/InlandRevenueModel#GovernmentPolicy> ;
        skos:definition   "The Strategy for a Digital Public Service sets the direction to modernise and transform the public service, putting citizens and businesses at the centre of government services. The public service is modern at its heart and all New Zealanders are thriving in a digital age."@en ;
        skos:related      <http://example.com/InlandRevenueModel#GovernmentICTStrategy> ;
