<http://example.com/NZ-IRD#Depreciation>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#Taxation-Depreciation-PaymentDatesAlignment-FBT-AndMiscellaneousProvisions-Act2006> , <http://smartlogic.com/term#142192802452955013992940> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/NZ-IRD#Depreciation/WhakaritengaTake_en> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel#ApplicationForAHigherMaximumPoolingValue> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerAttributes> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Website glossary"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "​Depreciation allows a deduction for capital expenditure, where a deduction wouldn't normally apply and acknowledges that the asset will eventually wear out or become outdated. For tax purposes, the reduced value of an asset is recognised by allowing a deduction against income for the depreciation of that asset from the time it is used in a business until it is sold, disposed of or discarded. This means the cost of the asset will be written off over its useful life. Once the whole cost price of the asset has been written off, no further deduction is allowed."@en ;
        <http://example.com/InlandRevenueModel-current-#UsesModel>
                <http://example.com/Cleaned-Inland-Revenue-model#DepreciationFormula> , <http://example.com/NZ-IRD#Depreciation-method> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/NZ-IRD#Depreciation/DEPN_en> , <http://example.com/NZ-IRD#Depreciation/DEPRN_en> , <http://example.com/NZ-IRD#Depreciation/Depr_en> , <http://example.com/NZ-IRD#Depreciation/DepreciationForecast_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website glossary; Corporate Finance content"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.2.1_Corporate_Planning_and_Reporting> ;
        sem:guid          "e14eb5d5-e576-4875-bb49-2c51aeaae64b" ;
        skos:broader      <http://example.com/InlandRevenueModel#AccountsManagement> ;
        skos:definition   "The systematic allocation of the cost of an asset, less its residual value, over its useful life."@en ;
        skos:related      <http://example.com/NZ-IRD#Straight-line-method> ;
        skosxl:altLabel   <http://example.com/NZ-IRD#Depreciation/AdjustedTaxValue_en> ;
        skosxl:prefLabel  <http://example.com/NZ-IRD#Depreciation/Depreciation_en> .

