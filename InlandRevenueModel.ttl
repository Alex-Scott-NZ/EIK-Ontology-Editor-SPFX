        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "LGFA website"@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#Fundraising> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "OCTC content"@en ;
        sem:guid          "78355786-0c5a-43ee-9dd8-bc4ca0133dac" ;
        skos:broader      <http://smartlogic.com/term#188519164724691362719453> ;
        skos:definition   "The New Zealand Local Government Funding Agency (LGFA) is a Council-Controlled Organisation (CCO) operating under the Local Government Act 2002. LGFA specialises in financing the New Zealand local government sector, the primary purpose being to provide more efficient financing costs and diversified financing sources for New Zealand local authorities and council-controlled organisations. LGFA was established to raise debt on behalf of local authorities on terms that are more favourable to them than if they raised the debt directly."@en ;
        skos:related      <http://example.com/InlandRevenueModel#FundingModel> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#NewZealandLocalGovernmentFundingAgencyLimited/NewZealandLocalGovernmentFundingAgencyLimited_en> .

