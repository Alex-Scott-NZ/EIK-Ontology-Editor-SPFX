<http://example.com/InlandRevenueModel#ResourceManagementAct1991>
        rdf:type          <http://smartlogic.com/class#Law> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ResourceManagementAct1991/RMA_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ResourceManagementAct1991/ResourceManagementAct_en> ;
        sem:guid          "e0e671ca-fb54-41b7-9c96-8a865c3e738b" ;
        skos:broader      <http://smartlogic.com/term#492768876094676199672439963971808> ;
        skos:definition   "The Resource Management Act 1991 (RMA) is New Zealand's main environmental law, establishing a framework for the sustainable management of natural and physical resources like land, air, and water to ensure they are available for future generations. It requires local authorities to develop district and regional plans with objectives, policies, and rules for activities that could affect the environment, and it sets out the process for applying for resource consents to carry out activities that are not permitted. The RMA regulates various activities, from building a house to clearing vegetation, with the goal of preventing harm to neighbours, communities, and ecosystems. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ResourceManagementAct1991/ResourceManagementAct1991_en> .

<http://example.com/InlandRevenueModel#ResourceManagementAct1991/RMA_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "RMA"@en .

