<http://example.com/InlandRevenueModel-current-#CloseCompany>
        rdf:type          <http://example.com/NZ-IRD#Legally-defined-term> , <http://smartlogic.com/class#Taxpayer> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "<p>(a) ... at any time, a company to which 1 of the following applies:<br/>(i) at the time there are 5 or fewer natural persons or trustees the total of whose voting interests in the company is more than 50% (treating all natural persons associated at the time as 1 person); or<br/>(ii) at the time a market value circumstance exists for the company and there are 5 or fewer natural persons or trustees the total of whose market value interests in the company is more than 50% (treating all natural persons associated at the time as 1 person); and<br/>(b)[Repealed]<br/>(c) does not include a special corporate entity<br/></p>"@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Income Tax Act 2007, Section YA1 (definitions)."@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A company in which five or fewer ultimate natural person shareholders hold either the following: 50% of the total voting interests, 50% of the total market value interest, if a market circumstance exists. For the purpose of the close company definition, associated persons of an individual all count as one person. This means if five members of one family each own 10% of a company, and someone else owns the other 50% it's a close company, as the five members of the same family count as one person."@en ;
        <http://example.com/NZ-IRD#Is-defined-by>
                <http://smartlogic.com/term#153321368926185107673047370395105> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>START; IR website; </p><p>Data Science &amp; Analytics content; PAS content</p>"@en ;
        sem:guid          "78f527fe-741e-4240-914f-621a1e841064" ;
        skos:broader      <http://smartlogic.com/term#531442512418953950816056224858867> ;
        skos:related      <http://example.com/InlandRevenueModel#Closely-heldCompany> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#CloseCompany/CloseCompany_en> .

<http://example.com/InlandRevenueModel-current-#CloseCompany/CloseCompany_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Close company"@en .

