                <http://example.com/InlandRevenueModel#IntegrityOfTheTaxSystem/IntegrityOfTheIncomeTaxSystem_en> ;
        <http://example.com/NZ-IRD#Is-defined-by>
                <http://smartlogic.com/term#11769840510976632981956266406159> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CI&A content"@en ;
        sem:guid          "fbf965d7-ce0d-4a71-a60f-3affac923452" ;
        skos:broader      <http://example.com/InlandRevenueModel#Ethics> ;
        skos:related      <http://example.com/InlandRevenueModel#DeclarationOfFidelityAndSecrecy> , <http://example.com/InlandRevenueModel-current-#TaxSystem> , <http://smartlogic.com/term#137744752454863129712908> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IntegrityOfTheTaxSystem/IntegrityOfTheTaxSystem_en> .

