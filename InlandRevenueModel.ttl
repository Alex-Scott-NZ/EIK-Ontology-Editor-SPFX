<http://example.com/InlandRevenueModel#Customer-centric>
        rdf:type          <http://smartlogic.com/class#Topic> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "http://infoweb.ird.govt.nz/iftf/ourCulture.html"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Together we understand the many influences on each customer, and decide how we will work with them to get the best outcomes for New Zealand."@en ;
