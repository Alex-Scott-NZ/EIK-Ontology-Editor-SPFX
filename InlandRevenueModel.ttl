<http://example.com/InlandRevenueModel-current-#CasualEmployee>
        rdf:type          <http://example.com/InlandRevenueModel-current-#PersonType> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Future Operating Model glossary 2020. http://intranet.ird.govt.nz/our-new-organisation/glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "An individual engaged on an “as needed basis”.  An employee who is a casual employee may be employed on an hourly, daily or weekly basis without any commitment from either party to an ongoing employment relation. These individuals have no entitlement to redundancy compensation and are not deemed affected by change."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
