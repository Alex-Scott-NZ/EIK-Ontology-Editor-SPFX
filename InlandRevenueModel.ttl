<http://example.com/InlandRevenueModel-current-#Overseas-bornResident>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-26"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR Regional Profile"@en ;
        sem:guid          "296f6322-e9c9-4781-bb38-138ebe6fdafa" ;
        skos:broader      <http://example.com/InlandRevenueModel#Citizenship> ;
        skos:definition   "<p>An overseas-born resident is a person residing in a country (such as New Zealand) who was born in a different country. This category includes both voluntary migrants and refugees, spanning individuals who have adopted a new country as their home regardless of their current citizenship status.&nbsp;Stats NZ defines this based on \"country of birth,\" identifying individuals who usually live in the country but were born elsewhere.</p><p><br></p><p>T</p><p>he Realm of New Zealand includes New Zealand, Tokelau, the Ross Dependency, and the self-governing states of the Cook Islands and Niue.</p><p><br></p><p>Citizenship:&nbsp;People born in Cook Islands, Niue, and Tokelau are New Zealand citizens by birth, which supports their inclusion as \"internal\" rather than \"overseas\" born.</p>"@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel-current-#Overseas-bornResident/ResidentBornOverseas_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#Overseas-bornResident/Overseas-bornResident_en> .

<http://example.com/InlandRevenueModel-current-#Overseas-bornResident/Overseas-bornResident_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Overseas-born resident"@en .

