<http://example.com/InlandRevenueModel#RegulatoryImpactAssessment>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Isused-in-function>
                <http://example.com/InlandRevenueModel#PolicyImpactAssessment> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#RegulatoryImpactAssessment/RIA_en> , <http://example.com/InlandRevenueModel#RegulatoryImpactAssessment/RIS_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#TaxPolicyInformationType> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Ministry for Regulation"@en ;
        <http://example.com/InlandRevenueModel#usedInInME2ValueSet>
                true ;
        <http://example.com/InlandRevenueModel-current-#IsExampleOf>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-6.1.2_External_Communications_Received_by_Agency> , <http://smartlogic.com/term#115713012307933578620132> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#RegulatoryImpactAssessment/Author-TheTreasury_en> , <http://example.com/InlandRevenueModel#RegulatoryImpactAssessment/Multi-criteriaAnalysis_en> , <http://example.com/InlandRevenueModel#RegulatoryImpactAssessment/RegulatoryImpactStatement_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "GES, Policy communications; PAS content"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#RegulatoryImpactAssessment/RegulatoryImpactStatement_en> ;
        sem:guid          "32c4848a-9f1c-47cb-97e5-73a5e465439e" ;
        skos:broader      <http://example.com/InlandRevenueModel#TaxPolicyInformation> ;
        skos:definition   "<p>When a Minister wants to create or change legislation, their agency must first provide Cabinet with an analysis of the likely impact of the regulatory changes being proposed. This is known as regulatory impact analysis (RIA). The level of analysis should be in proportion to the significance of the change, and in some cases an exemption will apply.&nbsp;Completing regulatory impact analysis before making a proposal to Cabinet ensures Ministers have information on: 1)&nbsp;the scope of the regulatory issue that’s being addressed, the rationale for government intervention, and the options for addressing it (including non-regulatory options); 2)&nbsp;the costs and benefits of each option; 3)&nbsp;the views of the people who have been consulted on the proposal; 4)&nbsp;how the regulatory changes could be implemented, and monitored and reviewed in the future.&nbsp;</p><p><br></p><p>Cabinet’s requirements for impact analysis are designed to encourage systematic and evidence-informed policy development, which helps support high quality regulation. They also help ensure Cabinet can make well-informed decisions about the regulatory changes being proposed.<br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#Assessment> , <http://example.com/InlandRevenueModel#CabinetExpenditureAndRegulatoryReviewCommittee> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#RegulatoryImpactAssessment/RegulatoryImpactAnalysis_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#RegulatoryImpactAssessment/RegulatoryImpactAssessment_en> .

