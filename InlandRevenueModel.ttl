<http://example.com/InlandRevenueModel#StateSectorReform>
        rdf:type          <http://smartlogic.com/class#Function> , <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#Activity-WorkingWithGovernment> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#StateSectorReformLeadershipGroup> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>State Services Commission.<br/>https://ssc.govt.nz/our-work/reforms/<br/></p>"@en ;
        <http://example.com/InlandRevenueModel#usedInME3ValueSet>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Public Service Reforms will help us find new ways to deliver the joined up services New Zealanders have told us they want from agencies using public money to deliver public services for public good. As part of the regulatory change process, Cabinet requires agencies to undertake an analysis of the impact of the proposed changes and provide the impact statement for Cabinet consideration. This helps ensure that the proposed reforms are as effective as possible."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-6.2.1_Decisions_that_Impact_on_the_Organisation> ;
        sem:guid          "27e51185-6caf-49d7-9d57-d865ff400869" ;
        skos:broader      <http://example.com/InlandRevenueModel#All-of-governmentWork> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#StateSectorReform/StateSectorReform_en> .

<http://example.com/InlandRevenueModel#StateSectorReform/StateSectorReform_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "State sector reform"@en .

<http://example.com/InlandRevenueModel#StateSectorReformLeadershipGroup>
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#StateSectorReformLeadershipGroup/SSRLG_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#StateSectorReform> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">PAS Cross Agency SME</span><!--EndFragment--><br/><br/><br/></p>"@en ;
        sem:guid          "1a9f6055-70c0-437b-9053-3ed6359a195b" ;
        skos:broader      <http://example.com/InlandRevenueModel#Inter-agencyGroup> ;
        skos:definition   "The \"State Sector Reform Leadership Group\" refers to a group of chief executives of public sector agencies that collectively leads and stewards public sector reform in New Zealand, working to improve services for New Zealanders. Headed by the Public Service Commissioner, the PSLT focuses on creating a unified approach to major issues, fostering collaboration, and ensuring the public service is agile, diverse, and equipped to meet future challenges through initiatives like the State Sector Act 2020. "@en ;
        skos:historyNote  "<p>Created in 1987 but now disestablished.<br><br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#StateSectorReformLeadershipGroup/StateSectorReformLeadershipGroup_en> .

