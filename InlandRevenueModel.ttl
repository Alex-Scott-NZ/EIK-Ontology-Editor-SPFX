        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://example.com/InlandRevenueModel#InternalAuditing> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#InternationalStandardsForTheProfessionalPracticeOfInternalAuditing/InternationalInternalAuditStandards_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CI&A content"@en ;
        sem:guid          "ab6258c7-f021-480e-8a17-1483dce22d73" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#Standard> ;
        skos:definition   "<p><span>The International Standards for the Professional Practice of Internal Auditing are </span>developed by the Global IIA (Institute of Internal Auditors) and followed by all IIA members throughout the world<span style=\"float: none;\">. They include principles and requirements for undertaking professional internal auditing and for evaluating internal audit performance.</span></p>"@en ;
