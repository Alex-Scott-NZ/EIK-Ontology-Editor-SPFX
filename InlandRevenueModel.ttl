<http://example.com/InlandRevenueModel#BaselineUpdate>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsPublishedBy>
                <http://smartlogic.com/term#10443228204537226919348> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Isused-in-function>
                <http://example.com/InlandRevenueModel#FinancialReporting> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Twice a year, in March and October, departments ask their own Minister and the Minister of Finance to approve changes to their baselines for the current and coming years. This involves making changes to the baseline because, for example, money that is no longer needed for a particular programme is being given back to the Crown; money is being given to IR for a new programme; or money given to IR for use on a programme in one year will instead be used in another year."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate Finance content"@en ;
        sem:guid          "5d3f9320-be36-4379-9bdc-f0c8829ec84c" ;
