<http://smartlogic.com/term#175072654837555666229777>
        rdf:type          <http://smartlogic.com/class#Obligation> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A legal requirement to pay money imposed upon a taxpayer (an individual or other <a title=\"Legal person\" href=\"https://en.wikipedia.org/wiki/Legal_person\"><u><font color=\"#0066cc\">legal entity</font></u></a>) by a governmental organization in order to fund various public expenditures</p>"@en , "A legal requirement to pay money imposed upon a taxpayer (an individual or other legal entity) by a governmental organization in order to fund various public expenditures."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "SME (Business Rules)"@en ;
        sem:guid          "c8d9b253-19d6-5404-be19-cfaf48913f2c" ;
        skos:broader      <http://example.com/IRD-test-model#Money> ;
        skos:related      <http://example.com/InlandRevenueModel#Taxes0> ;
        skosxl:prefLabel  <http://smartlogic.com/label#175072654837555666229777_English> .

<http://smartlogic.com/term#175072654838674267587392>
        rdf:type          <http://example.com/NZ-IRD#Legally-defined-term> , <http://smartlogic.com/class#Obligation> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ProductsWeAdminister> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Wikipedia"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/NZ-IRD#Is-defined-by>
                <http://example.com/InlandRevenueModel-current-#TaxAdministreationAct1994-S3> ;
        <http://example.com/NZ-IRD#Is-financial-object-of>
                <http://example.com/InlandRevenueModel#PayingTax> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "4a8aad8c-9654-5580-b79f-8483bd433983" ;
        skos:broader      <http://smartlogic.com/term#175072654837555666229777> ;
        skos:definition   "A tax is a compulsory financial charge or some other type of levy imposed on a taxpayer (an individual or legal entity) by a governmental organization in order to fund government spending and various public expenditures. A failure to pay, along with evasion of or resistance to taxation, is punishable by law. Taxes consist of direct or indirect taxes and may be paid in money or as its labour equivalent."@en ;
        skos:related      <http://smartlogic.com/term#39540492458666896042871634590083> , <http://smartlogic.com/term#89590199481890290360157> ;
        skosxl:prefLabel  <http://smartlogic.com/label#175072654838674267587392_English> .

