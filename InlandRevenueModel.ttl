<http://example.com/InlandRevenueModel#Reverse-chargeRules>
        rdf:type          <http://smartlogic.com/class#Rules> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://cleartax.in/s/reverse-charge-gst"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Reverse charge is a mechanism where the recipient of the goods and/or services is liable to pay GST instead of the supplier."@en ;
