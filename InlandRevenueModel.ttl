<http://example.com/InlandRevenueModel#WidespreadDroughtApril2021>
        rdf:type            <http://smartlogic.com/class#Adverse-event> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#AdverseEvent> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#ChathamIslands> , <http://example.com/Cleaned-Inland-Revenue-model#Kaikoura> , <http://example.com/InlandRevenueModel#Tararua> , <http://example.com/InlandRevenueModel#Wairarapa> , <http://example.com/InlandRevenueModel-current-#AucklandRegion> , <http://example.com/InlandRevenueModel-current-#BayOfPlenty> , <http://example.com/InlandRevenueModel-current-#Canterbury> , <http://example.com/InlandRevenueModel-current-#GisborneRegion> , <http://example.com/InlandRevenueModel-current-#Hawke-sBay> , <http://example.com/InlandRevenueModel-current-#Northland> , <http://example.com/InlandRevenueModel-current-#Otago> , <http://example.com/InlandRevenueModel-current-#Tasman-Nelson-Marlborough> , <http://example.com/InlandRevenueModel-current-#Waikato> , <http://example.com/InlandRevenueModel-current-#WellingtonRegion> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-03-17"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Natural_disaster_or_emergency_event_2016-.docx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Drought in the entire North Island (excluding Taranaki, Ruapehu and Whanganui), Tasman, Marlborough, Kaikoura, North Canterbury, the Chatham Islands, Mid Canterbury, South Canterbury and Otago. The drought which is causing financial issues for many farmers and growers and is likely to affect their income for the 2020 and future years has been extended and now includes all of the North Island (excluding the Taranaki, Ruapehu and Whanganui districts) as well as Tasman, Marlborough, Kaikoura, North, Mid and South Canterbury, Otago and the Chatham Islands. We are exercising discretion to allow late deposits to the income equalisation scheme. Late deposits for the 2020 income tax year can be made up to 30 June 2021, regardless of the due date for the 2020 tax return or when that return is filed. Applications for early refunds from the income equalisation scheme will also be allowed. <br/>Customers can request relief from penalties if they have missed filing returns or making payments and may consider re-estimating their provisional tax.<br/><br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "START Help. List of adverse events."@en ;
        sem:guid            "91d8e36a-73c7-42e5-be3c-b08ea4538499" ;
        skos:broader        <http://smartlogic.com/term#134942778228015166252651> ;
        skos:editorialNote  "Checked in Viva Topics but it wasn't there."@en ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#WidespreadDroughtApril2021/DroughtInTheEntireNorthIsland-excludingTaranaki-RuapehuAndWhanganui-Tasman-Marlborough-Kaikoura-NorthCanterbury-TheChathamIslands-MidCanterbury-SouthCanterburyAndOtago_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#WidespreadDroughtApril2021/WidespreadDroughtApril2021_en> .

<http://example.com/InlandRevenueModel#WidespreadDroughtApril2021/DroughtInTheEntireNorthIsland-excludingTaranaki-RuapehuAndWhanganui-Tasman-Marlborough-Kaikoura-NorthCanterbury-TheChathamIslands-MidCanterbury-SouthCanterburyAndOtago_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Drought in the entire North Island (excluding Taranaki, Ruapehu and Whanganui), Tasman, Marlborough, Kaikoura, North Canterbury, the Chatham Islands, Mid Canterbury, South Canterbury and Otago"@en .

<http://example.com/InlandRevenueModel#WidespreadDroughtApril2021/WidespreadDroughtApril2021_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Widespread drought April 2021"@en .

