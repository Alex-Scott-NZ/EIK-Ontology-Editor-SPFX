<http://smartlogic.com/term#10384426891295066766175>
        rdf:type            <http://smartlogic.com/class#Income> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://smartlogic.com/term#10384426891295066766175/NgaMoniWhiwhiNoTawahi_en> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#OverseasIncomeQuestionnaire> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsAppliedTo>
                <http://example.com/InlandRevenueModel#PaidWork> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://smartlogic.com/term#775640563399637355574406610519136> ;
        <http://example.com/InlandRevenueModel#IsValidFor>
                <http://example.com/Cleaned-Inland-Revenue-model#Adjusted-taxable-income> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-09"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Tax & Social Policy Glossary"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Income that does not originate or is not derived in New Zealand."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website; IR concept model. Māori term from Te Taura Whiri Maori Language Commission"@en ;
        sem:guid            "d274ccda-024a-542b-a028-ce034285b430" ;
        skos:broader        <http://smartlogic.com/term#460716479585426992918781858541954> ;
        skos:definition     "<p>Overseas income is money you earn from outside New Zealand, even if the money never comes into New Zealand. This applies to New Zealand tax residents.&nbsp;It is a subset of your worldwide income — not a separate set of money.</p><p><br></p><p>If you are a NZ tax resident, you are generally taxed on your worldwide income.&nbsp;Inland Revenue asks you to separately identify overseas income so it can: apply foreign tax credit rules correctly, apply double tax agreements if relevant, and track income earned in different countries.&nbsp;That’s why overseas income is often discussed on its own — not because it’s different income, but because it needs extra rules and disclosures.</p>"@en ;
        skos:editorialNote  "The term used in legislation is Foreign-sourced income, but the more user-friendly term (used in our website) is preferred."@en ;
        skos:related        <http://example.com/InlandRevenueModel#NewZealandForeignTrustDisclosure> , <http://example.com/InlandRevenueModel#WorldwideIncome> ;
        skosxl:altLabel     <http://smartlogic.com/term#10384426891295066766175/Foreign-sourcedIncome_en> ;
        skosxl:prefLabel    <http://smartlogic.com/label#10384426891295066766175_English> .

<http://smartlogic.com/term#10384426891295066766175/Foreign-sourcedIncome_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
