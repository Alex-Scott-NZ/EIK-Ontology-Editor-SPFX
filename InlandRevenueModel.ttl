<http://example.com/InlandRevenueModel#RegulationsReviewCommittee>
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Uses-template>
                <http://example.com/InlandRevenueModel#RegulationsRegister> ;
