<http://smartlogic.com/term#75420159540835943508606>
        rdf:type          <http://example.com/IRD-test-model#System> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-people-and-workplace-services/Shared%20Documents/MIRI%20-%20Quick%20Reference%20Guide.pdf?web=1"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "MIRI is Inland Revenue’s system for managing leave, capturing time worked, and accessing information related to your pay. All Inland Revenue employees and leaders get access to MIRI. ​MIRI is a web-based interface which provides an integrated system that supports HR, Finance, Payroll, Travel and expense claim process."@en ;
