<http://example.com/InlandRevenueModel#Obligation-Entitlement>
        rdf:type          <http://example.com/InlandRevenueModel#MetadataValue> , <http://example.com/InlandRevenueModel-current-#ANOClass> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Data Domains and Sub-Domains, 2020"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Actions that should be taken by IR and customers that are specified in the legislation governing an account.  E.g. a GST registered customer must file their return completely and honestly by the due date each return period.  IR must make WfFtC payments according to customers family circumstances and preferred payment frequency.​"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">IR Data Domains and Sub-domains, 2020</span><br/></p>"@en ;
        sem:guid          "f8771bfa-333e-4157-a22f-8848fe02abd9" ;
        skos:broader      <http://example.com/InlandRevenueModel#_PreviousDomainsAndSub-Domains-> ;
