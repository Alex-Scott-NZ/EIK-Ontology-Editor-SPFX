<http://example.com/InlandRevenueModel#DataDomain>
        rdf:type          <http://example.com/NZ-IRD#Metadata0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2021-12-02"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Data Domains and Sub-Domains, v2.5 2021"@en ;
        <http://example.com/InlandRevenueModel#hasMetadataValueSet>
                <http://example.com/InlandRevenueModel#DataDomainCategory> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>This contains a Data Domain/Subdomain model for Inland Revenue for use in the Data Intelligence Platform (DIP).  The domain model is intended to be used to:​<br/>- Classify all data objects within DIP via one or more data subdomains allowing users to search for content (data and artefacts).  E.g. Show me all tables that belong to the “Core Accounts” subdomain.​<br/>- The subdomains allow analysts to classify their data needs by the data subdomains that are required, rather than going down to a table level.  This promotes a more rapid understanding of the data required by different analyst teams and helps with prioritisation of the Refined Layer work​<br/>- The concepts can be helpful for new analysts in understanding how IR operates and the high level relationships between the data subject areas​<br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#Owner>
                "<p>Owned by the Platform Team in DIP.</p><div><span>Custodian of Initial version (2019) is Ally Rutherford.</span><br/></div><div><p>Custodian of version 2.5 (2021) is Satish Rajkumar.</p></div>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>IR Data Domains and Sub-domains v0.8 2019</p><div><p>https://stax.ird.govt.nz/wcc/faces/wccdoc?dID=40413216&amp;dDocName=IRDOC40398230<br/></p></div>"@en ;
        sem:guid          "71288f9e-b8be-4eca-8b06-664711a974f7" ;
        skos:broader      <http://example.com/InlandRevenueModel#DescriptiveMetadata> ;
        skos:historyNote  "<p>Initially included here and in the Microsoft TermStore, using version 0.8 of the data domains.</p><div><p>Reviewed 2 years later in 2021 and updated.</p></div>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DataDomain/DataDomain_en> .

