<http://example.com/InlandRevenueModel#ChargingDocument>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Litigation - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A criminal proceeding is commenced by filing a charging document in the District Court generally nearest to where the offence was allegedly committed. A charging document contains the charge, the content of the charge, particulars of the defendant, particulars of the person commencing the proceeding and their statement that they have good cause to suspect that the defendant has committed the offence. A charging document is not sworn. Before 1 July 2013 a criminal proceeding was commenced by laying an information, which had to be sworn."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ChargingDocument/s14CriminalProcedureAct2011_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS Investigations content"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#ChargingDocument/MOJ9001_en> ;
