<http://example.com/InlandRevenueModel#DigitalAudit>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#DigitalAudit/DAF_en> , <http://example.com/InlandRevenueModel#DigitalAudit/DFU_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><!--StartFragment--><a href=\"https://irnz.sharepoint.com/sites/CORP-enterprise-data-and-analytics/\">Pokapū mō ngā Raraunga Hinonga me ngā Tātaritanga - Centre for Enterprise Data and Analytics - Mātai raraunga me te tātari - Data Science and Analytics (sharepoint.com)</a></p><p><a href=\"https://irnz.sharepoint.com/sites/CORP-enterprise-data-and-analytics/\"></a><!--EndFragment--></p><p><br></p><p>​<a href=\"https://irnz.sharepoint.com/sites/CORP-enterprise-data-and-analytics/SitePages/What-we-do.aspx#our-delivery-teams\">What we do</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel#UsesSystem>
                <http://example.com/Cleaned-Inland-Revenue-model#Nuix> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>DAF provides specialist services that support compliance and tax system integrity. A key focus for both teams is understanding emerging technology and its impact on customers and compliance.</p><p><br></p><p>Digital Audit is responsible for improving IR's ability to respond to the rapidly changing digital environment by providing specialist advice and solutions. We also provide advice to our external customers to help them get it right from the start. <br><span style=\"color: rgb(0, 0, 0)\">Digital Forensics is a branch of the forensic sciences that deals specifically with computing devices in a forensically sound manner, with the end goal of producing evidence in court. At Inland Revenue, digital forensic evidence is mainly used in support of customer compliance cases.</span><!--EndFragment--><br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#UsesModel>
                <http://example.com/InlandRevenueModel#ComputerAssistedAuditTechniques> ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/Cleaned-Inland-Revenue-model#DigitalForensics> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#DigitalAudit/DigitalForensicsTeam_en> , <http://example.com/InlandRevenueModel#DigitalAudit/DigitalForensicsUnit_en> ;
        <http://example.com/NZ-IRD#Offers-product-service>
                <http://example.com/InlandRevenueModel#SystemsAudit> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "https://irnz.sharepoint.com/sites/CORP-enterprise-data-and-analytics/SitePages/What-we-do.aspx"@en ;
        sem:guid          "8d405794-1ff9-4a61-bc79-707c0d1a94d0" ;
        skos:broader      <http://smartlogic.com/term#178953839036513121843655> ;
        skos:historyNote  "Created in November 2021 as part of the CEDA creation. Still in existence in June 2025."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DigitalAudit/DigitalAudit_en> .

