<http://example.com/InlandRevenueModel#TechnicalDesignAuthority>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#TechnicalDesignAuthority/TDA_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><!--StartFragment--><a href=\"https://www.ird.govt.nz/-/media/project/ir/home/documents/about-us/bt-guide/delivering-the-transformation/getting-going/enterprise-architecture/technical-design-authority-terms-of-reference.pdf?modified=20220805033309&amp;modified=20220805033309#:~:text=The%20The%20Technical%20Design%20Authority,advise%20this%20to%20the%20TADC.\">IR BT Technical Design Authority Terms of Reference (ird.govt.nz)</a><!--EndFragment--></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The scope of the Technical Design Authority (TDA) is all aspects of Technology design across the primary services, including (but not limited to): CCSPDD (START, eServices, GWS, Analytics, Contact Centre), ES (Atea), IIS (DIP, STAX, Haukainga, www).\n</p><p>TDA will provide a forum at which all technical aspects of Technology design will be presented, discussed, endorsed and/or approved. In addition the TDA will consider the ongoing cost impact of the decisions made and advise this to Technology Services as required. The TDA does not have authority to make any commercial or cost decisions.\n</p><p>The TDA will provide key recommendations and escalate design decisions to the EPPC in cases of significant operational or service impact or deviations from the agreed Strategy and/or Enterprise Architecture principles.</p><p><br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "BT Glossary"@en ;
        sem:guid          "3e455d82-49a2-497a-97e1-0a5acda6eefb" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skos:related      <http://example.com/InlandRevenueModel#EnterprisePrioritiesAndPerformanceCommittee> , <http://example.com/InlandRevenueModel-current-#TechnicalArchitecture> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TechnicalDesignAuthority/TechnicalDesignAuthority_en> .

<http://example.com/InlandRevenueModel#TechnicalDesignAuthority/TDA_en>
        rdf:type               skosxl:Label ;
        sem:caseSensitivity    sem:CaseSensitive ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "TDA"@en .

<http://example.com/InlandRevenueModel#TechnicalDesignAuthority/TechnicalDesignAuthority_en>
        rdf:type               skosxl:Label ;
