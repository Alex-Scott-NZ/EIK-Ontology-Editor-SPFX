<http://example.com/InlandRevenueModel#UpperNorthIslandRainAndFlooding>
        rdf:type            <http://smartlogic.com/class#Adverse-event> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/Cleaned-Inland-Revenue-model#AucklandCBD> , <http://example.com/InlandRevenueModel-current-#BayOfPlenty> , <http://example.com/InlandRevenueModel-current-#Coromandel> , <http://example.com/InlandRevenueModel-current-#Northland> , <http://example.com/InlandRevenueModel-current-#Waikato> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#AdverseEvent> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-03-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/kc-adverse-events/Shared%20Documents/Natural_disaster_or_emergency_event_2016.docx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>January 2023. Heavy and persistent affected regions across the North Island, with the Northland, Auckland, Waikato and Bay of Plenty regions in particular affected, and is likely to affect their income for the 2023 income year. <br/>The late deposit provision for 2022 has been approved, with an extension for all customers until 31 May 2023. <br/>Applications for early refunds from the income equalisation scheme will be allowed. <br/>Cabinet has also declared the adverse weather as an emergency event for the purposes of section 183ABA of the TAA which allows Inland Revenue to remit interest payable on late payments following the emergency event.  The emergency event declaration covers the Northland, Auckland, Waikato and Bay of Plenty regions up until 30 April 2023. <br/>There may also be farmers/growers from other regions who were affected by the heavy rainfall, we will take a sympathetic approach to customers from other regions who have also been affected. <br/><br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "https://irnz.sharepoint.com/sites/kc-adverse-events/SitePages/natural-disaster-or-emergency-event-tax-impacts.aspx?web=1"@en ;
        sem:guid            "dcdeb8c6-a2db-43c5-bcc5-a011624ef722" ;
        skos:broader        <http://smartlogic.com/term#47138497716934256857234> ;
        skos:editorialNote  "<p>Checked in Viva Topics but it wasn't there.<br/><br/></p>"@en ;
        skos:related        <http://example.com/InlandRevenueModel#CycloneGabrielle> , <http://example.com/InlandRevenueModel#CycloneHale> ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#UpperNorthIslandRainAndFlooding/AucklandAnniversaryWeekendFlooding_en> , <http://example.com/InlandRevenueModel#UpperNorthIslandRainAndFlooding/UpperNorthIslandFlooding_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#UpperNorthIslandRainAndFlooding/UpperNorthIslandRainAndFlooding_en> .

<http://example.com/InlandRevenueModel#UpperNorthIslandRainAndFlooding/AucklandAnniversaryWeekendFlooding_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Auckland Anniversary Weekend flooding"@en .

<http://example.com/InlandRevenueModel#UpperNorthIslandRainAndFlooding/UpperNorthIslandFlooding_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Upper North Island flooding"@en .

