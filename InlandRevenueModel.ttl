        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Natural_disaster_or_emergency_event_2016-.docx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The flooding in the West Coast, Tasman and Marlborough regions is causing financial issues for many farmers and growers and is likely to affect their income for the 2022 income year.<br/>The late deposit provision has not been approved, as returns are not due until March 2023, therefore customers have ample time to make deposits to the income equalisation scheme.<br/>Applications for early refunds from the income equalisation scheme will be allowed.<br/><br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "START Help. List of adverse events."@en ;
        sem:guid            "d4e7717e-4963-415c-b3d8-8611dce7ff06" ;
        skos:broader        <http://smartlogic.com/term#47138497716934256857234> ;
        skos:editorialNote  "Checked in Viva Topics but it wasn't there."@en ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#WestCoastAndTasmanFloodsJuly2021/FloodingInTheWestCoast-Tasman-AndMarlboroughRegions_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#WestCoastAndTasmanFloodsJuly2021/WestCoastAndTasmanFloodsJuly2021_en> .

<http://example.com/InlandRevenueModel#WestCoastAndTasmanFloodsJuly2021/FloodingInTheWestCoast-Tasman-AndMarlboroughRegions_en>
        rdf:type               skosxl:Label ;
