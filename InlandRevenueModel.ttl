<http://example.com/InlandRevenueModel#GoodsSoldInSatisfactionOfDebt>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> , <http://example.com/NZ-IRD#Legally-defined-term> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#GoodsSoldInSatisfactionOfDebt/GSD_en> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel#GoodsAndServicesTaxReturnForGoodsSoldInSatisfactionOfDebt> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Register of Business Products (IR)<br><br></p>"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "START Help"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Separate account type for goods sold in satisfaction of a debt&nbsp;where GST is owed. Taxpayer may not be registered for GST.<br>Have treated as a sub-product for GST.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR business products register"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#GoodsSoldInSatisfactionOfDebt/PR.T.003_en> ;
        sem:guid          "037bba8b-6bb0-4920-8545-27dbca9f8218" ;
        skos:broader      <http://smartlogic.com/term#89590199481890290360157> ;
        skos:definition   "A special GST return (IR373) is filed when a creditor sells goods in satisfaction of a debt. In hire purchase arrangements the purchaser can claim the full value of the input when they take possession of the goods. If the purchaser does not keep up the payments goods are usually repossessed and resold. The original buyer (not the repossessor) is considered to supply the goods to the new purchaser if there is a forced sale. If goods are repossessed and then re-sold that were used in a taxable activity, GST must be accounted for on the sale. An IR373 must be filed unless either of the following applies: 1) The purchaser (debtor) advises the seller (creditor) in writing that the sale would not be taxable if they had made it themselves, and the reasons why such a sale would not be taxable or 2) Enough reasonable information is held to conclude that a sale by the debtor would not have been taxable."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#GoodsSoldInSatisfactionOfDebt/GoodsSoldInSatisfactionOfDebt_en> .

<http://example.com/InlandRevenueModel#GoodsSoldInSatisfactionOfDebt/GSD_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "GSD"@en .

