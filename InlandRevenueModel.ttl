<http://example.com/InlandRevenueModel#PolicyCommissioningDocument>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsPublishedBy>
                <http://smartlogic.com/term#65676355394865533899241> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Isused-in-function>
                <http://example.com/InlandRevenueModel#PolicyWork> , <http://smartlogic.com/term#97783351948796139392048> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#PolicyCommissioningDocument/PCP_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#PolicyCommissioningDocument/Phencyclidine_en> , <http://example.com/InlandRevenueModel#PolicyCommissioningDocument/PropertyComplianceProgramme_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/kc-policy-toolkit/Shared%20Documents/Templates/Policy%20Projects/Project%20management%20planning%20templates/Policy%20Commissioning%20-%20Full.dotx?web=1"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A policy commissioning document is a record of a series of commissioning conversations. It will be used to decide whether a project should proceed and how it should be prioritised. Commissioning is a crucial first step in any policy project. Good project commissioning can mean the difference between a good and a bad policy outcome. This document performs four key functions: 1) It prompts and records the commissioning conversations necessary to ensure the policy project starts on the right track, 2) It sets out the information Policy needs to decide whether the project can or should proceed (in light of Inland Revenue’s available resources) and how it should be prioritised against other projects, 3) It introduces the project to our delivery partners, so they can start considering its impact on them and how they can deliver their part of it, and 4) It helps populate the information needed to load into Jira to begin the ongoing monitoring of the project, and ultimate project delivery."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#PolicyCommissioningDocument/DescriptionOfPolicyIssue_en> , <http://example.com/InlandRevenueModel#PolicyCommissioningDocument/PolicyImpactAndQuality_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "PAS content"@en ;
        sem:guid          "b785ca52-2c27-42e8-83e2-7e8ec38d3402" ;
        skos:broader      <http://example.com/InlandRevenueModel#TaxPolicyInformation> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#PolicyCommissioningDocument/PolicyCommissioningPaper_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PolicyCommissioningDocument/PolicyCommissioningDocument_en> .

