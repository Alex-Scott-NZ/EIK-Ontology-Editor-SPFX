<http://example.com/InlandRevenueModel#InitiativeProposal>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInformationRelatedTo>
                <http://example.com/InlandRevenueModel#InitiativeManagement> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<!--StartFragment--><p style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);\">Glossary of terms from IR's Initiative Management Framework document. May 2022.</p><div style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);\"><p><a href=\"https://irnz.sharepoint.com/sites/CORP-strategic-portfolio-stewardship/SupInfo/Forms/AllItems.aspx?id=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo%2FInitiative%20Management%20Framework%2Epdf&amp;parent=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo\" style=\"background-color: transparent;color: rgb(51, 122, 183);text-decoration: underline;\">Tiakitanga Kohinga Rautaki - Strategic Portfolio Stewardship - Initiative Management Framework.pdf - 1) All Documents (sharepoint.com)</a></p></div><!--EndFragment-->"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The initiative proposal is required if investment funding is being sought to allow the Executive Sponsor and Strategic Governance Board to answer the following questions: <br/>• Does the recommended option align to Eke Tangaroa – IR’s enterprise plan – and there is a valid problem or opportunity that justifies the initiative? <br/>• Are there sufficient benefits to be gained that justify making this investment?<br/>• Are we satisfied that implementation of the recommended option will solve the underlying problem or best maximise the opportunity?<br/>• Are we satisfied that we now know enough about the recommended option to proceed to the detailed design of a solution?<br/><br/></p>"@en ;
        sem:guid          "9b6791ab-5a34-46a6-9b65-a09a5273d1b7" ;
        skos:broader      <http://example.com/InlandRevenueModel#ChangeManagementInformation> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#InitiativeProposal/InitiativeProposal_en> .

<http://example.com/InlandRevenueModel#InitiativeProposal/InitiativeProposal_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Initiative proposal"@en .

