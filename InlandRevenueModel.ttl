<http://example.com/InlandRevenueModel#PublicLimitedCompany>
        rdf:type          <http://smartlogic.com/class#Taxpayer> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#PublicLimitedCompany/PLC_en> ;
