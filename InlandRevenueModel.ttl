        skos:broader      <http://example.com/InlandRevenueModel#ResourceManagement> ;
        skos:related      <http://example.com/InlandRevenueModel#MaximumPedictedCapacity> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ResourceProfiling/ResourceProfiling_en> .

