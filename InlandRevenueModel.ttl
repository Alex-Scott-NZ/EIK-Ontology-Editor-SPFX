<http://example.com/InlandRevenueModel#OnlineAnalyticalProcessing>
        rdf:type          <http://smartlogic.com/class#Function> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#OnlineAnalyticalProcessing/OLAP_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/NZ-IRD#Source-of-term>
                "SD&I content"@en ;
        sem:guid          "7ee887cb-0a66-4552-9f14-47d747057ab6" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#SystemFunctionality> ;
        skos:definition   "Online Analytical Processing (OLAP) is a technology that enables fast, complex, multidimensional analysis of large volumes of data, often stored in a data warehouse. By organizing data into multidimensional structures called \"cubes\" and supporting operations like drilling down and pivoting, OLAP facilitates complex queries and calculations to derive business intelligence, support decision-making, and perform trend analysis. It contrasts with Online Transaction Processing (OLTP) systems, which are designed for high-speed, individual record updates, by optimizing for read-heavy analytical workloads."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#OnlineAnalyticalProcessing/OnlineAnalyticalProcessing_en> .

