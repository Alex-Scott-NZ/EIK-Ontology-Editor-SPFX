        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://nzba.org.nz/about-us/\">About Us - New Zealand Banking Association</a>​<br></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/Cleaned-Inland-Revenue-model#New-Zealand-Bankers-Assoication/NZBankers-Association_en> , <http://example.com/Cleaned-Inland-Revenue-model#New-Zealand-Bankers-Assoication/NZBankersAssociation_en> ;
