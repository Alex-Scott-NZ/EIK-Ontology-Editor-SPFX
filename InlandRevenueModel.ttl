<http://example.com/InlandRevenueModel#FinancialHardship>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel#DisclosureOfFinancialPosition> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsAttributeOf>
                <http://example.com/InlandRevenueModel#Ex-spouseOrPartner> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-27"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "For the purposes of determining a customer's eligibility for a write off of outstanding tax, financial hardship is defined in section 177A of the Tax Administration Act 1994 as significant financial difficulties that arise because of: the customer's inability to meet minimum living expenses according to normal community standards; the cost of medical treatment for an illness or injury of the customer or the customer's dependant; a serious illness suffered by the customer or the customer's dependant; the cost of education for the customer's dependant.  Serious hardship does not include significant financial difficulties that arise because: the customer is obligated to pay tax; the customer may become bankrupt; the customer's, or the customer's dependants', social activities and entertainment may be limited; the customer is unable to afford goods or services that are expensive or of a high quality or standard according to normal community standards. Serious hardship generally applies only to individuals, but in some cases a company's tax debts may be written off. This applies if recovery of the company's debts would place: A shareholder who owns, or 2 shareholders who jointly own, 50% or more of the shares in a company in serious hardship; or A shareholder-employee of a close company in serious hardship."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#FinancialHardship/SeriousHardship_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS-B content"@en ;
        sem:guid          "93b5ea65-642d-43e0-9499-b359e9cf7682" ;
        skos:broader      <http://example.com/InlandRevenueModel#FinancialStatus> ;
        skos:related      <http://example.com/InlandRevenueModel#AssessmentWriteOff> , <http://example.com/InlandRevenueModel#CustomerFinancialInformation> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#FinancialHardship/InFinancialHardship_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#FinancialHardship/FinancialHardship_en> .

<http://example.com/InlandRevenueModel#FinancialHardship/FinancialHardship_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Financial hardship"@en .

<http://example.com/InlandRevenueModel#FinancialHardship/InFinancialHardship_en>
        rdf:type               skosxl:Label ;
