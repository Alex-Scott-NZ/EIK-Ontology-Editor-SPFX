        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2025-08-28"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span lang=\"mi-NZ\"><font face=\"Calibri\" size=\"3\"><a href=\"https://irnz.sharepoint.com/sites/kc-tax-law-community/SitePages/TLC%20expertise.aspx\">https://irnz.sharepoint.com/sites/kc-tax-law-community/SitePages/TLC%20expertise.aspx</a></font></span></p><p><font face=\"Times New Roman\" size=\"3\"><br/><br/></font></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Public Advice & Guidance Committee is made up of representatives from across Inland Revenue with an interest in the provision of public technical advice and guidance to assist customers to meet their obligations and receive their entitlements - or to get it “right from the start”. The members are from CCS-I and B, II&S, PaRS and TCO. The Committee is not designed to resolve individual technical issues, but rather look at the broader “system”."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "TCO intranet"@en ;
        sem:guid          "5e32ab02-034b-470e-b740-c104837f6f58" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skos:historyNote  "Checked in 2022, and again in 2025. Still seems to exist."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PublicAdviceAndGuidanceCommittee/PublicAdviceAndGuidanceCommittee_en> .

