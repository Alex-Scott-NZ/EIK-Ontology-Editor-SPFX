<http://example.com/InlandRevenueModel#VerintWFM>
        rdf:type          <http://example.com/IRD-test-model#System> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#eWFM> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#ITServiceManagement> , <http://example.com/InlandRevenueModel#IntegratedOperationalPlanning> , <http://example.com/InlandRevenueModel-current-#CloudComputing> ;
        <http://example.com/InlandRevenueModel#IsSystemUsedBy>
                <http://example.com/InlandRevenueModel#CustomerAndComplianceServices> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/News/SitePages/Big-steps-towards-more-efficient-work-planning-and-scheduling-in-CCS.aspx?web=1"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel#SupportsActivity>
                <http://example.com/InlandRevenueModel#RosterScheduling> , <http://example.com/InlandRevenueModel#WorkforceManagement> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The change from Alvaria to Verint is part of our Integrated Operational Planning work, enabling us to align planning processes, technology and data, meaning we’ll be better placed to focus on priority work, improve our focus on meeting service level expectations, and match our people up with work that aligns with their skills.<br>up to now only ‘voice’ work (customer phone interactions) was planned in a centralised way.&nbsp;We often didn’t have a clear view of ‘non-voice’ plans and getting that visibility usually took a lot of manual effort. Now the new Verint workforce management tool gives us a better view of how much work we have on hand across both our ‘voice’ and ‘non-voice’ customer channels. One of the popular features of the Verint tool has been the mobile app giving people who want to use it, access to their schedules without needing to log on to their work device.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Commissioner's news 2025-08-28"@en ;
        sem:guid          "61562641-ac30-4070-a164-607e9334b006" ;
        skos:broader      <http://smartlogic.com/term#47372529931203401780288> ;
        skos:definition   "Verint WFM is a cloud-based solution for workforce management that uses AI-powered forecasting and scheduling to help organizations optimize staff across various engagement channels. It enables businesses to forecast demand, create optimal staff schedules for employees and bots, manage time-off requests, and track real-time performance, improving operational efficiency and employee satisfaction. The platform offers employee self-service features, allowing staff to manage their schedules from mobile devices, and provides real-time analytics for supervisors to monitor and adjust operations."@en ;
        skos:historyNote  "<p>Implemented and go-live in September 2025.&nbsp; Supersedes the use of Alvaria WFM and prior to that Aspect WFM. </p><p><br></p><p>\"Alvaria WFM will no longer be used at IR once IOP is implemented. For a few weeks after go-live, both Verint WFM and Alvaria WEM will be used, and Verint will gradually fully replace Alvaria.\"</p><p><br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#WorkforceManagement0> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#VerintWFM/VerintWorkforceManagement_en> , <http://example.com/InlandRevenueModel#VerintWFM/WFM_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#VerintWFM/VerintWFM_en> .

<http://example.com/InlandRevenueModel#VerintWFM/VerintWFM_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Verint WFM"@en .

