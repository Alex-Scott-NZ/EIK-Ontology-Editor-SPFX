<http://example.com/InlandRevenueModel#AgencyCapabilityReview>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Intranet"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p> </p><p><span style=\"font-size:13.5pt;color:#323130\" \"=\"\">Reporting to Te Kawa Mataaho Public Service Commission.</span></p><p> </p><p><span style=\"font-size:13.5pt;color:#323130\" \"=\"\">A future focused way of assessing an agency’s capability to respond to future opportunities and challenges. The review is carried out in two parts. A Self-Review, by a networked team within IR, and an independent review completed by external reviewers. The findings are incorporated into IR’s business planning process, so we make progress on the areas identified.</span></p><p> </p>"@en ;
        <http://example.com/NZ-IRD#Is-done-by>
                <http://example.com/InlandRevenueModel#Enterprise-IntegrityServices> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.2.1_Corporate_Planning_and_Reporting> ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#AgencyCapabilityReview/AgenceyCapabilityReview_en> ;
        sem:guid          "057138cd-aff4-4cbc-a011-320684dff988" ;
        skos:broader      <http://example.com/IRD-test-model#Performance-measurement> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#AgencyCapabilityReview/AgencyCapabilityReview_en> .

