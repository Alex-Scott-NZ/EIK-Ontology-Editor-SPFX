<http://example.com/InlandRevenueModel-current-#ShareholderEmployeeSalary>
        rdf:type          <http://smartlogic.com/class#Income> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A shareholder-employee is a person who is both an employee and a shareholder of a company. If their employment income has not been paid via the PAYE system, it is called a shareholder-employee salary. Those shareholder-employees who receive this type of income are required to declare this income on an individual income tax return. If the shareholder-employee receives their shareholder salary through the PAYE system they are not required to file an individual income tax return. Refer START Help: Return filing requirements."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Making Tax Simpler, pub June 2017"@en ;
        sem:guid          "5252d8cc-886b-422e-9bd3-380df3f5e4c8" ;
        skos:broader      <http://smartlogic.com/term#149403043187561556930337> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#ShareholderEmployeeSalary/ShareholderEmployeeSalary_en> .

