        skosxl:literalForm     "Maori Crown relations"@en .

<http://example.com/InlandRevenueModel#MaoriCustomerLandscape>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInformationRelatedTo>
                <http://example.com/InlandRevenueModel#MahutongaProgramme> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#CustomerInsight> , <http://example.com/InlandRevenueModel#MauriOraTeWhanau-MaoriCustomerStrategy> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Māori Customer Landscape document.<br></p><div>​<a href=\"https://irnz.sharepoint.com/sites/SW-CCSPlanning/StrategicPlanning/Forms/AllItems.aspx?id=%2Fsites%2FSW%2DCCSPlanning%2FStrategicPlanning%2FCustomer%20Segments%2FSmall%20%26%20Medium%20Enterprises%20Customer%20Segment%2FCustomer%20Strategy%2FCustomer%20Segment%20Insights%2FMaori%20customer%20landscape%2Epdf&amp;parent=%2Fsites%2FSW%2DCCSPlanning%2FStrategicPlanning%2FCustomer%20Segments%2FSmall%20%26%20Medium%20Enterprises%20Customer%20Segment%2FCustomer%20Strategy%2FCustomer%20Segment%20Insights\" style=\"background-color: rgb(255, 255, 255);\">irnz.sharepoint.com/sites/SW-CCSPlanning/StrategicPlanning/Forms/AllItems.aspx?id=%2Fsites%2FSW-CCSPlanning%2FStrategicPlanning%2FCustomer Segments%2FSmall %26 Medium Enterprises Customer Segment%2FCustomer Strategy%2FCustomer Segment Insights%2FMaori customer landscape%2Epdf&amp;parent=%2Fsites%2FSW-CCSPlanning%2FStrategicPlanning%2FCustomer Segments%2FSmall %26 Medium Enterprises Customer Segment%2FCustomer Strategy%2FCustomer Segment Insights</a>​​<br></div>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Released in July 2020,&nbsp;</p><p> </p><p><span style=\"font-size:15.0pt;color:#242424\">The&nbsp;Māori customer landscape provides the views of whānau, hapū and iwi on how IR can improve the way we support Māori, and work towards becoming a better Treaty partner.&nbsp;The landscape is currently informing important initiatives that will provide direction and support for IR and improving the way that we work with and support Māori.</span></p><p> </p><p>​</p>"@en ;
        sem:guid          "a405fc9d-5b0d-4219-874b-7407326ac613" ;
        skos:broader      <http://example.com/InlandRevenueModel#StrategyAndGovernanceInformation> ;
        skos:related      <http://example.com/InlandRevenueModel#MaoriResponsiveness> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MaoriCustomerLandscape/MaoriCustomerLandscape_en> .

<http://example.com/InlandRevenueModel#MaoriCustomerLandscape/MaoriCustomerLandscape_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Māori Customer Landscape"@en .

<http://example.com/InlandRevenueModel#MaoriData>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#MaoriDataGovernance> , <http://example.com/InlandRevenueModel#MaoriDataSovereignty> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p> </p><p>Te Mana Raraunga Brief <a href=\"https://stax.ird.govt.nz/cwxv4/wcc/faces/wccdoc?dDocName=IRDOC18379217\">Principles of Māori Data Sovereignty</a></p><p> </p>"@en ;
        sem:guid          "35ebbfcd-b0e1-4078-948d-d364b2e4afec" ;
        skos:broader      <http://example.com/InlandRevenueModel#PrinciplesOfMaoriDataSovereignty> ;
        skos:definition   "<p> </p><p>Māori data refers to digital or digitisable information or knowledge that is about or from Māori people, our language, culture, resources or environments. </p><p> </p><div><p><br></p></div><div>​<p> </p>​</div><p>Māori rights and interests in data derive from our inherent rights as Indigenous peoples, and unique relationships with land, water and the natural world. These rights are recognised in Te Tiriti o Waitangi and the United Nations Declaration on the Rights of Indigenous Peoples (UNDRIP)</p><p> </p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MaoriData/MaoriData_en> .

<http://example.com/InlandRevenueModel#MaoriData/MaoriData_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Māori data"@en .

<http://example.com/InlandRevenueModel#MaoriDataGovernance>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#MaoriData> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        sem:guid          "fb752e0d-e153-47aa-a841-8ef2966097b0" ;
        skos:broader      <http://example.com/InlandRevenueModel#PrinciplesOfMaoriDataSovereignty> ;
        skos:definition   "<p> </p><p>Māori Data Governance refers to the principles, structures, accountability mechanisms, legal instruments and policies through which Māori exercise control over Māori data. </p><p> </p><div><p><br></p></div><div>​<p> </p>​</div><p>Māori rights and interests in data derive from our inherent rights as Indigenous peoples, and unique relationships with land, water and the natural world. These rights are recognised in Te Tiriti o Waitangi and the United Nations Declaration on the Rights of Indigenous Peoples (UNDRIP)</p><p> </p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#MaoriDataSovereignty> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MaoriDataGovernance/MaoriDataGovernance_en> .

<http://example.com/InlandRevenueModel#MaoriDataGovernance/MaoriDataGovernance_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Māori Data Governance"@en .

<http://example.com/InlandRevenueModel#MaoriDataSovereignty>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#MaoriData> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        sem:guid          "3cc500f5-ba34-4b99-9191-5ce3320afa21" ;
        skos:broader      <http://example.com/InlandRevenueModel#PrinciplesOfMaoriDataSovereignty> ;
        skos:definition   "<p> </p><p>Māori Data Sovereignty refers to the inherent rights and interests that Māori have in relation to the collection, ownership, and application of Māori data. </p><p> </p><div><p><br></p></div><div>​<p> </p>​</div><p>Māori rights and interests in data derive from our inherent rights as Indigenous peoples, and unique relationships with land, water and the natural world. These rights are recognised in Te Tiriti o Waitangi and the United Nations Declaration on the Rights of Indigenous Peoples (UNDRIP)</p><p> </p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#MaoriDataGovernance> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MaoriDataSovereignty/MaoriDataSovereignty_en> .

<http://example.com/InlandRevenueModel#MaoriDataSovereignty/MaoriDataSovereignty_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Māori Data Sovereignty"@en .

