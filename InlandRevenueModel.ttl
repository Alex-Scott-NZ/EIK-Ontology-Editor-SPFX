<http://example.com/InlandRevenueModel#OffshoreRLWTPerson>
        rdf:type          <http://smartlogic.com/class#Party-classification> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#OffshoreRLWTPerson/NgaTangataKeiTawahiEUtuAnaITeRLWT_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/kc-residential-land-withholding-tax/SitePages/offshore-rlwt-person.aspx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "​This definition is applicable to Residential land withholding tax (RLWT) only. A separate definition of offshore person applies for IRD number applications. Individual - An individual is an offshore RLWT person when any of the following apply: They are a New Zealand citizen and have been overseas for the last three or more years continuously (and aren't currently in New Zealand); or They have a New Zealand residence class visa granted by Immigration New Zealand and have been overseas for the last twelve or more months continuously (and aren't currently in New Zealand); or They are not a New Zealand citizen and do not have a New Zealand residence class visa granted by Immigration New Zealand (can be in or out of New Zealand). Non-individual - A non-individual is an offshore RLWT person if that non-individual is: Incorporated or registered outside of New Zealand; or Constituted under foreign law."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#OffshoreRLWTPerson/NgaTangataKeiTawahiEUtuAnaITeRLWT_en0> , <http://example.com/InlandRevenueModel#OffshoreRLWTPerson/OffshorePeopleWhoPayRLWT_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "PAS content. Māori term from Te Taura Whiri Māori Language Commission"@en ;
        sem:guid          "2f7063c9-c633-4ba0-ac28-f55c8181c9a3" ;
        skos:broader      <http://example.com/InlandRevenueModel#OffshoreStatus> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#OffshoreRLWTPerson/OffshoreRLWTPerson_en> .

