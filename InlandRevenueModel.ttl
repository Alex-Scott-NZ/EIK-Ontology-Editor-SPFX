                "Intelligence Hub content"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#MinisterialOversightGroupOnGangs/MinisterialOversightGroupOnGangs_en0> ;
        sem:guid          "5a456c91-41c4-467e-bb17-2de56f575b7a" ;
        skos:broader      <http://example.com/InlandRevenueModel#MinisterialGroup> ;
        skos:definition   "The Ministerial Oversight Group on Gangs in New Zealand has been replaced by the Ministerial Advisory Group on Transnational, Serious and Organised Crime (TSOC), appointed by the Minister of Customs and Associate Minister of Police, Hon Casey Costello. This new advisory group provides independent, expert advice to improve the government's response to organised crime, with a focus on identifying and addressing gaps in current strategies. It is working to enhance information sharing between agencies, strengthen financial measures against crime, and address underlying societal issues that contribute to organised crime. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MinisterialOversightGroupOnGangs/MinisterialOversightGroupOnGangs_en> .

