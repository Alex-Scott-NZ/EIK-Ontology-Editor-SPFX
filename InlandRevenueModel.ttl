<http://example.com/IRD-test-model#Government-Legal-Network->
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/IRD-test-model#Government-Legal-Network-/GLN_en> ;
