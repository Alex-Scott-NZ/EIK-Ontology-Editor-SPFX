<http://example.com/InlandRevenueModel#Third-PartyProviders>
        rdf:type          <http://example.com/InlandRevenueModel#MetadataValue> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Data Domains and Sub-Domains, v2.5 2021"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Relationships between third-party providers (e.g. tax agents) and their clients (by client list), including measures to analyse tax filing performance by tax period. Categorise a table as being in one of the Third-Party Providers subdomains if the relationship between a third-party provider is held at the account level or party level.​"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR Data Domains and Sub-Domains, v2.5 2021"@en ;
        sem:guid          "f6eb40be-9868-4bbe-88be-af968e6b9e58" ;
        skos:broader      <http://example.com/InlandRevenueModel#DataDomainCategory> ;
        skos:historyNote  "Did not exist in the original version. Updated in December 2021 from version 2.5"@en ;
