<http://example.com/InlandRevenueModel#Kaitiakitanga>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://example.com/InlandRevenueModel#Data-Information-AndKnowledgeStewardship> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel-current-#DataSteward> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2022-06-21"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Data and Information Governance Standard"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p><a href=\"https://www.digital.govt.nz/standards-and-guidance/privacy-security-and-risk/privacy/data-protection-and-use-policy-dpup/read-the-dpup-principles/\">https://www.digital.govt.nz/standards-and-guidance/privacy-security-and-risk/privacy/data-protection-and-use-policy-dpup/read-the-dpup-principles/</a>   Te Aka Māori dictionary. <a href=\"https://maoridictionary.co.nz/\">https://maoridictionary.co.nz/</a> <br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "This is about everyone who works for Inland Revenue being Kaitiaki, stewards of the data and information we hold and have access to.  It is also about recognising that other organisations, communities, and people, present and future, depend on our Kaitiakitanga of this data and information."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><a href=\"https://irnz.sharepoint.com/:b:/r/sites/govcentre/Documents/Data%20and%20Information%20Governance%20Standard.pdf?csf=1&amp;web=1&amp;e=2tZYGj\">https://irnz.sharepoint.com/:b:/r/sites/govcentre/Documents/Data%20and%20Information%20Governance%20Standard.pdf?csf=1&amp;web=1&amp;e=2tZYGj</a> <br/></p>"@en ;
        sem:guid          "975be415-36dc-4d0d-bb23-e61ec2d74d54" ;
        skos:broader      <http://example.com/InlandRevenueModel#GovernancePrinciple> ;
        skos:definition   "Act as a steward in a way that people understand and trust. Guardianship, stewardship, trusteeship, trustee. "@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Data-governance> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Kaitiakitanga/Kaitiakitanga_en> .

<http://example.com/InlandRevenueModel#Kaitiakitanga/Kaitiakitanga_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Kaitiakitanga data principle"@en .

