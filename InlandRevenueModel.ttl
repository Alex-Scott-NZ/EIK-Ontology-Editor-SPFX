        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Crypto-asset reporting framework"@en .

<http://example.com/InlandRevenueModel#Crypto-assetReportingFramework/PR.ID.008_en>
        rdf:type            skosxl:Label ;
        <http://smartlogic.com/relationship#Is-code-of_14_None_None>
