<http://example.com/Cleaned-Inland-Revenue-model#OffshoreRLWTPerson>
        rdf:type          <http://smartlogic.com/class#Party-classification> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A non-individual is an offshore RLWT person if that non-individual is incorporated or registered outside New Zealand, or constituted under foreign law.<br/><br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website glossary"@en ;
        sem:guid          "4c9a2822-eff7-40dd-b7f6-70c6a3ba5895" ;
        skos:broader      <http://example.com/InlandRevenueModel#OffshoreRLWTPerson> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#OffshoreRLWTPerson/OffshoreRLWTPerson_en> .

<http://example.com/Cleaned-Inland-Revenue-model#OffshoreRLWTPerson-LookThroughCompany>
        rdf:type          <http://smartlogic.com/class#Party-classification> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "An LTC is an offshore RLWT person if more than 25% of the effective interest(s) in the LTC are held or controlled by offshore RLWT person(s)."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website glossary"@en ;
        sem:guid          "45f15878-74b1-4e6f-aeee-34e67c434c05" ;
