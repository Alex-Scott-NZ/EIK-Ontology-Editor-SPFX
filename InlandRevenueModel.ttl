        sem:guid          "2c662352-0e72-42a6-956c-0a25ee97f9a7" ;
        skos:broader      <http://example.com/InlandRevenueModel#Government-mandatedBenefit> ;
        skos:definition   "<p>A payment made to a person caring for a child in foster care to help cover the child’s everyday living costs, such as food, clothing, personal items, and other reasonable expenses. It is intended to support the child’s needs, not to pay the caregiver as income. <br>IR material also describes it as a payment used to meet the usual costs of caring for the child in the household.<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#FosterCareAllowance0/FosterCareAllowance_en> .

