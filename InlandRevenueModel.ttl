<http://example.com/InlandRevenueModel#ExceptedFinancialArrangement>
        rdf:type          <http://smartlogic.com/class#Rules> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://smartlogic.com/term#185397716530282738530987> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "<p>EW5 (1). An excepted financial arrangement means an arrangement described in any of subsections (2) to (25). However, (a) an arrangement described in any of subsections (18) to (20) may cease to be an excepted financial arrangement through the operation of Section EW7. (b) an arrangement described in any of subsections (21) to (25) may cease to be an excepted financial arrangement for a party who makes an election under section EW8.<br/>These exceptions are summarised below (this is not the full legal definitions of each) and include:<br/>(2) Annuity<br/>(3) Bet, Emissions unit; Non-Kyoto greenhouse gas unit; Research and development agreement.<br/>(4) Employment contract<br/>(5) Farm-out arrangement<br/>(6) Group investment fund<br/>(7) Hire-purchase: livestock or bloodstock<br/>(8) Insurance contract (not life financial reinsurance)<br/>(9) Lease that is not a finance lease<br/>(10) Loan in New Zealand currency<br/>(11) Partnership or joint venture; Look-through companies; Assignment and return or emissions units as part of loan<br/>(12) Share-lending arrangement<br/>(13) Share or option<br/>(14) Specified preference share<br/>(15) Superannuation<br/>(16) Warranty for goods or services<br/>(17) Certain arrangements to which a transitional resident is party<br/>(18) Loan in foreign currency for a private or domestic purpose<br/>(19) An option for a private or domestic purpose<br/>(20) Private or domestic agreement for the sale and purchase of property or services<br/>(21) Agreement for the sale and purchase of property or services<br/>(22) Short-term agreement for sale and purchase<br/>(23) Short-term option<br/>(24) Travellers' cheques<br/>(25) Variable principal debt instrument.<br/></p>"@en ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://smartlogic.com/term#792664888766916161723784865183314> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Income Tax Act"@en ;
        sem:guid          "514b89be-3a87-493a-bd60-6c99a4a4c255" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#TaxRegime> ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Annuity> , <http://example.com/Cleaned-Inland-Revenue-model#CollectiveInvestmentVehicle> , <http://example.com/Cleaned-Inland-Revenue-model#Private-agreement> , <http://example.com/Cleaned-Inland-Revenue-model#Share> , <http://example.com/Cleaned-Inland-Revenue-model#Warranty> , <http://example.com/InlandRevenueModel#FinancialArrangement> , <http://example.com/InlandRevenueModel#LeaseArrangement> , <http://example.com/InlandRevenueModel#LoanArrangement> , <http://example.com/InlandRevenueModel#ResearchAndDevelopment> , <http://example.com/InlandRevenueModel#Share-lendingArrangement> , <http://example.com/InlandRevenueModel#TransitionalTaxResident> , <http://example.com/InlandRevenueModel-current-#DebtInstrument> , <http://smartlogic.com/term#107374592907302851326810578255385> , <http://smartlogic.com/term#114081935619535690805810> , <http://smartlogic.com/term#296881431826283161282256602304034> , <http://smartlogic.com/term#33802824363205078840340401450944> , <http://smartlogic.com/term#428221857096879289537211917990797> , <http://smartlogic.com/term#542859443224004684641758134263108> , <http://smartlogic.com/term#910136176095059809163723361485888> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ExceptedFinancialArrangement/ExceptedFinancialArrangement_en> .

