<http://example.com/InlandRevenueModel#EastCoastFloodsMarch2022>
        rdf:type            <http://smartlogic.com/class#Adverse-event> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#AdverseEvent> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel-current-#GisborneRegion> , <http://example.com/InlandRevenueModel-current-#Hawke-sBay> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-03-17"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Natural_disaster_or_emergency_event_2016-.docx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The flooding caused by recent heavy rainfall in the Tairāwhiti Gisborne and Hawkes Bay regions is causing financial issues for many farmers and growers and is likely to affect their income for the 2022 income year. <br/>The late deposit provision for 2021 has been approved, with an extension for all customers until 31 May 2022.  No late deposit discretion has been made in relation to the 2022 tax year.<br/>Applications for early refunds from the income equalisation scheme will be allowed.<br/>There is also localised flooding across other regions.<br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "START Help. List of adverse events."@en ;
        sem:guid            "02bc88ce-83c2-4ac1-acca-834a6eab3fd2" ;
        skos:broader        <http://smartlogic.com/term#47138497716934256857234> ;
        skos:editorialNote  "Checked in Viva Topics but it wasn't there."@en ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#EastCoastFloodsMarch2022/FloodingInTairawhitiGisborneAndHawkesBayRegions_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#EastCoastFloodsMarch2022/EastCoastFloodsMarch2022_en> .

