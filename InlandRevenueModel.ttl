<http://example.com/InlandRevenueModel#CyberSecurityAward>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-participant>
                <http://smartlogic.com/term#70070906622337504512376> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsEventObjectOfActivity>
                <http://example.com/InlandRevenueModel#StaffRecognition> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#CyberSecurityAward/Kaitiaki-a-ipurangi_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#CyberSecurityManagement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2022-06-28"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><a href=\"https://irnz.sharepoint.com/sites/News/SitePages/Introducing-IR%E2%80%99s-Kaitiaki-%C4%81-ipurangi---Cyber-Security-Awards!.aspx\"><u><font color=\"#0066cc\">Introducing IR’s Kaitiaki-ā-ipurangi - Cyber Security Awards! (sharepoint.com)</font></u></a><br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The award celebrates a person who is being vigilant and helping keep our systems secure. Here are a few things you might nominate someone for: Reminding people to lock their computer screen when they leave their desks, even if only for a few seconds; Reporting a phishing email; Reminding people to keep sensitive hard copied documents or materials in a safe place; Calling out on people who are not wearing their ID; Reminding people to remove lanyards when outside of IR offices; Championing the importance of security hygiene to their team and other IR people; Reminding other people to tag and not tailgate when entering the premises; And more! "@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><a href=\"https://irnz.sharepoint.com/sites/News/SitePages/Introducing-IR%E2%80%99s-Kaitiaki-%C4%81-ipurangi---Cyber-Security-Awards!.aspx\"><u><font color=\"#0066cc\">Introducing IR’s Kaitiaki-ā-ipurangi - Cyber Security Awards! (sharepoint.com)</font></u></a><br/></p>"@en ;
        sem:guid          "98b9a523-8157-4b2d-9a77-e52ebdc14fce" ;
        skos:broader      <http://example.com/InlandRevenueModel#StaffRecognitionAward> ;
        skos:historyNote  "Set up in 2022 by the by the Cyber Security Operations team."@en ;
        skos:scopeNote    "The award has been gifted the te reo Māori name of Kaitiaki-ā-ipurangi by the Māhutonga team. Kaitiaki means guardian, and the process and practices of protecting and looking after the environment, and Haumaru-ā-ipurangi means cyber safety. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CyberSecurityAward/CyberSecurityAward_en> .

<http://example.com/InlandRevenueModel#CyberSecurityAward/CyberSecurityAward_en>
        rdf:type               skosxl:Label ;
