<http://example.com/InlandRevenueModel#ProvisionalTaxUsingStandardEstimationMethod>
        rdf:type          <http://smartlogic.com/class#Obligation> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Provisional tax helps you pay your income tax in instalments during the year not in a lump sum at the end of the year.&nbsp;</p><p>This covers three of the ways of calculating provisional tax: standard option (based on the previous year's residual income tax plus an adjustment); estimation option (where the customer estimates what their residual income tax will be for the year); and atio option (based on the customer's GST turnover).<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#UsesModel>
                <http://example.com/Cleaned-Inland-Revenue-model#GSTRatioMethod> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR Products"@en ;
        sem:guid          "08d5b53e-a0ec-41ec-98a8-70f212153a16" ;
        skos:broader      <http://smartlogic.com/term#195867451054967333481936> ;
        skos:related      <http://example.com/InlandRevenueModel#ProvisionalTax-standardAndEstimateAndRatio-> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#ProvisionalTaxUsingStandardEstimationMethod/ProvisionalTax-StandardAndEstimateAndRatio-_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ProvisionalTaxUsingStandardEstimationMethod/ProvisionalTaxUsingStandardEstimationMethod_en> .

