<http://example.com/InlandRevenueModel#ExtensionOfTime>
        rdf:type          <http://smartlogic.com/class#Tax-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsEventObjectOfActivity>
                <http://example.com/InlandRevenueModel#FilingCompliance> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#ExtensionOfTime/TeWhakaroaINgaWhakaritengaWa_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ExtensionOfTime/EoT_en> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://smartlogic.com/term#63371402988779285059628> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Tax & Social Policy Glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "An EOT allows additional time to file a tax return - beyond the normal due date. Returns are generally due by 7 July (for customers with a 31 March balance date) but an EOT can be granted up to 31 March the following year. An extension of time arrangement can be granted in two situations: A customer linked to a tax agent: the tax agent can have an extension of time for all their clients. A customer without a tax agent can apply to Inland Revenue for an individual extension of time."@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://smartlogic.com/term#197328649962691294233513> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ExtensionOfTime/TeWhakaroaINgaWhakaritengaWa_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>CCS-B content</p><div><p>Māori term from Te Taura Whiri Maori Language Commission</p></div>"@en ;
        sem:guid          "e830dec2-17e3-4da5-8854-78e52c0c55a2" ;
        skos:broader      <http://smartlogic.com/term#39629125075286344336852> ;
        skos:definition   "A customer may request an extension of time to file their tax return. Any return policing actions are suppressed until the extension of time due date has passed. A tax preparer, except for a bookkeeper, may also request this on behalf of their client."@en ;
        skos:related      <http://example.com/InlandRevenueModel#Time> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ExtensionOfTime/ExtensionOfTime_en> .

<http://example.com/InlandRevenueModel#ExtensionOfTime/EoT_en>
        rdf:type            skosxl:Label ;
        sem:stemming        sem:StemmingOff ;
        skosxl:literalForm  "EOT"@en .

<http://example.com/InlandRevenueModel#ExtensionOfTime/ExtensionOfTime_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Extension of time"@en .

