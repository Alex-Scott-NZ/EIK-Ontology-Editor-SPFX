<http://example.com/InlandRevenueModel#AnnualLoanStatement>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-template-used-by>
                <http://example.com/Cleaned-Inland-Revenue-model#StudentLoanBorrower> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#AnnualLoanStatement/ALS_en> ;
