<http://smartlogic.com/term#82016005258704165488529>
        rdf:type          <http://example.com/InlandRevenueModel#AuthorityClassification> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://smartlogic.com/term#82016005258704165488529/OIC_en> ;
