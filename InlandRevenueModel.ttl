                <http://smartlogic.com/term#81421232302518545413232> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#BusinessCapability> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://smartlogic.com/term#733873855465831453299914748155375> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Future Operating Model glossary 2020. http://intranet.ird.govt.nz/our-new-organisation/glossary "@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A future operating model is a high-level view or vision of how functions might look in the future. It covers things like the key features and the shifts required, along with things like the business capabilities that might be required. It's the stage of thinking that happens before you get to more detailed design around things like structure and roles."@en ;
        sem:guid          "b080eb35-7d3f-4ca6-baca-ea3fb252fc8b" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Enterprise-model> ;
