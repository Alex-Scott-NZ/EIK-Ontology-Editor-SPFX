<http://example.com/InlandRevenueModel#EmployedInMoreThanOneJob>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-27"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling"@en ;
        sem:guid          "483d978e-bc84-4672-b960-37eacb15001a" ;
        skos:broader      <http://example.com/InlandRevenueModel#Employed> ;
        skos:definition   "<p>A person is employed in more than one job if they are currently working for two or more employers at the same time, or have more than one paid job.<br>The jobs can be part‑time or full‑time.<br>The hours and employers can be different.<br>What matters is that the person has multiple paid work roles concurrently.<br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel-current-#SecondaryTax> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EmployedInMoreThanOneJob/EmployedInMoreThanOneJob_en> .

<http://example.com/InlandRevenueModel#EmployedInMoreThanOneJob/EmployedInMoreThanOneJob_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Employed in more than one job"@en .

<http://example.com/InlandRevenueModel#EmployedPartTime>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-27"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling."@en ;
        sem:guid          "c470477c-f99d-46f3-9784-942eab0b6001" ;
        skos:broader      <http://example.com/InlandRevenueModel#Employed> ;
        skos:definition   "<p>A person is employed part time if they are working for an employer but for fewer hours than a standard full‑time role. You are employed, but you work fewer hours than a full‑time worker.<br>Part‑time work usually involves regular paid hours, but less than full‑time hours.<br>The exact number of hours can vary by organisation or context.<br>It does not depend on how many jobs the person has — only the hours worked in a job.<br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#Part-timeEmployee> , <http://example.com/InlandRevenueModel-current-#CasualEmployee> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#EmployedPartTime/EmployedPartTime_en0> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EmployedPartTime/EmployedPartTime_en> .

