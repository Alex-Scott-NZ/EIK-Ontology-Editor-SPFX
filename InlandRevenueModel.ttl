<http://example.com/InlandRevenueModel-current-#DetailedBusinessCase>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Isused-in-function>
                <http://example.com/InlandRevenueModel-current-#ProgrammeAndProjectManagement> ;
