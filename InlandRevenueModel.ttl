<http://example.com/InlandRevenueModel#RevenueDelegation>
        rdf:type          <http://smartlogic.com/class#IR-corporate-policy> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsOutcomeOf>
                <http://example.com/InlandRevenueModel#DelegationsManagement> , <http://example.com/InlandRevenueModel-current-#Governance> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Revenue delegations provide the legal authority to make tax technical decisions relevant to the specific role and under the appropriate Inland Revenue Acts. When Parliament enacts new or amending legislation that provides the Commissioner of Inland Revenue with a discretion to make a decision then, generally, a delegation is required to authorise the Commissioner's officers to make that decision. Without that authority the Commissioner would have to make all those decisions and that would not be practicable."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#RevenueDelegation/RevenueDelegations_en> ;
        <http://example.com/NZ-IRD#Has-instantiation>
                <http://example.com/InlandRevenueModel#DelegationLetter> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>LMU content; CCS-I content; </p><p>Data Science &amp; Analytics content</p>"@en ;
        sem:guid          "de37b7cf-6eb6-497d-821a-edb2a4b8758e" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#Delegation> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#RevenueDelegation/TaxTechnicalDelegations_en> , <http://example.com/InlandRevenueModel#RevenueDelegation/TechnicalDelegation_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#RevenueDelegation/RevenueDelegation_en> .

