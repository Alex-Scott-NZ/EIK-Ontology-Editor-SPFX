<http://example.com/InlandRevenueModel-current-#CourtOfAppealOfNewZealand>
        rdf:type            <http://smartlogic.com/class#Commercial-organisation> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-party-classification>
                <http://smartlogic.com/term#100209852265501839102603> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-participant-in>
                <http://example.com/InlandRevenueModel#Appeal> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel-current-#CourtOfAppealOfNewZealand/TeKotiPira_en> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Uses-template>
                <http://example.com/InlandRevenueModel#ApplicationForAllocationOfAHearingDate> , <http://example.com/InlandRevenueModel#ApplicationForCosts> , <http://example.com/InlandRevenueModel#CaseOnAppeal> , <http://example.com/InlandRevenueModel#IssuesList> , <http://example.com/InlandRevenueModel#JudgmentForSealing> , <http://example.com/InlandRevenueModel#NoticeOfAbandonment> , <http://example.com/InlandRevenueModel#NoticeOfAppeal> , <http://example.com/InlandRevenueModel#NoticeOfCross-appeal> , <http://example.com/InlandRevenueModel#NoticeOfDateOfHearing> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2025-04-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Definition taken from Structure of court system update April 2025."@en ;
        <http://example.com/NZ-IRD#Has-location>
                <http://example.com/InlandRevenueModel-current-#WellingtonRegion> , <http://smartlogic.com/term#30772423816878265862510> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "MoJ website; P&C: Business Group Support content"@en ;
        sem:guid            "89c616cf-8f00-4555-8557-f5fa075f7ae7" ;
        skos:broader        <http://smartlogic.com/term#188519164724691362719453> ;
        skos:definition     "<p>Te Kōti Pīra, the Court of Appeal is one of two top courts. T</p><p>he Court of Appeal has a key role in developing legal principle, correcting errors, and ensuring that the law is applied consistently. It hears civil and criminal appeals from cases in the High Court and, criminal appeals from jury trials in the District Court. If leave is granted the Court of Appeal can also hear criminal appeals against pre-trial rulings; appeals on questions of law from the Employment Court; and second appeals from decisions of other courts and tribunals.<br></p><p><br></p><p>A decision of a higher court is binding on lower courts and decisions of the Supreme Court, the final court of appeal, are binding on all other courts.</p><p>Cases that are legally similar will generally be decided in the same way, conforming with the decisions of a higher court. This is called the rule of precedent. It ensures consistency and certainty in how the law is applied.</p>"@en ;
        skos:editorialNote  "Updated as a result of Structure of court system update April 2025"@en ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel-current-#CourtOfAppealOfNewZealand/CourtOfAppealWellington_en> , <http://example.com/InlandRevenueModel-current-#CourtOfAppealOfNewZealand/NZAppealsCourt_en> , <http://example.com/InlandRevenueModel-current-#CourtOfAppealOfNewZealand/NZCourtOfAppeal_en> , <http://example.com/InlandRevenueModel-current-#CourtOfAppealOfNewZealand/NewZealandCourtOfAppeal_en> , <http://example.com/InlandRevenueModel-current-#CourtOfAppealOfNewZealand/Wellington-CourtOfAppeal_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel-current-#CourtOfAppealOfNewZealand/CourtOfAppealOfNewZealand_en> .

<http://example.com/InlandRevenueModel-current-#CourtOfAppealOfNewZealand/CourtOfAppealOfNewZealand_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Court of Appeal of New Zealand"@en .

