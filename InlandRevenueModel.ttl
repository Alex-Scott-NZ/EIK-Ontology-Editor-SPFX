<http://example.com/InlandRevenueModel#TaxWorkingGroup>
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#TaxWorkingGroup/TWG_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#FutureOfWork> , <http://smartlogic.com/term#64266327842219876259770> , <http://smartlogic.com/term#97783351948796139392048> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A government working group set up in 2017 with a broad mandate to look at New Zealand’s tax system. The Working Group will be required to report general to the Government on: Whether the tax system operates fairly in relation to taxpayers, income, assets and wealth; Whether the tax system promotes the right balance between supporting the productive economy and the speculative economy; Whether there are changes to the tax system which would make it more fair, balanced and efficient, and Whether there are other changes which would support the integrity of the income tax system, having regard to the interaction of the systems for taxing companies, trusts, and individuals."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#TaxWorkingGroup/TWGChapter_en> , <http://example.com/InlandRevenueModel#TaxWorkingGroup/TWGSubmissions_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "GES content; Intranet; PAS content"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://smartlogic.com/term#132034173310816237815769> ;
        sem:guid          "dc448456-5951-4d17-873e-b587ad517305" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#WorkingGroup> ;
        skos:historyNote  "<p>Recommendations made, this group has disbanded.<br><br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TaxWorkingGroup/TaxWorkingGroup_en> .

