        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate Finance content"@en ;
        sem:guid          "f6880869-93e0-4e8a-b66e-04e3d52a2ccc" ;
        skos:broader      <http://example.com/InlandRevenueModel#StatementOfFinancialPosition> ;
        skos:definition   "A trial balance is an internal accounting worksheet listing a company's general ledger accounts with their debit or credit balances at a specific point in time, used to verify that the sum of all debits equals the sum of all credits. This mathematical check confirms the accuracy of the double-entry bookkeeping system, helping to identify errors and serving as a crucial step before preparing formal financial statements like the income statement and balance sheet.  "@en ;
        skos:related      <http://example.com/InlandRevenueModel#QualityAssurance> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TrialBalance/TrialBalance_en> .

