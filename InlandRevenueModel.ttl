<http://example.com/Cleaned-Inland-Revenue-model#FullyFunctionalBankAccount>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#MoneyHeld> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A fully functional bank account is one that is held with a New Zealand bank account or financial institution able to accept deposits, and they have: obtained identifying information from you, and completed verification of your identity. In accordance with Anti-Money Laundering and Countering Financing of Terrorism Act 2009. This can be a joint account provided the account clearly shows the name of the customer applying e.g. Jo & Bob Smith would be acceptable but J&B Smith would not be."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website glossary"@en ;
        sem:guid          "f6ea4d29-9ee0-4360-935d-2a52c64bf7ad" ;
        skos:broader      <http://example.com/IRD-test-model#Account> ;
        skos:definition   "A bank account is held with a New Zealand bank or licensed deposit taker and they have obtained identity information from the customer, and completed verification of his or her identity in accordance with the Anti-Money Laundering and Countering Financing of Terrorism Act 2009."@en ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#FullyFunctionalBankAccount/FullyFunctionalBankAccount_en> .

