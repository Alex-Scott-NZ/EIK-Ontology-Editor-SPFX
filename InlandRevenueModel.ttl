<http://example.com/InlandRevenueModel#ServiceTransformationUnit>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ServiceTransformationUnit/STU_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><a href=\"https://irnz.sharepoint.com/sites/News/SitePages/The-Service-Transformation-Unit-%E2%80%93-leveraging-Inland-Revenue%E2%80%99s-transformation-experience.aspx?web=1\"><u><font color=\"#0066cc\">The Service Transformation Unit – leveraging Inland Revenue’s transformation experience (sharepoint.com)</font></u></a><br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Introducing the Service Transformation Unit (STU), whose role is to take what we learnt from our business transformation and use it to help improve service for customers across the wider public sector. The team will work independently of Inland Revenue but under the leadership of our new Commissioner. It will be made up of former BT programme leaders, including Greg James, DC Transformation. The STU has initially been tasked with preparing a report to Cabinet by the end of this calendar year. The report will provide Ministers with a view on whether setting up a function of this type is viable long-term."@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#All-of-governmentWork> , <http://example.com/InlandRevenueModel#DigitalServiceDesign> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ServiceTransformationUnit/ServiceTransformation_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Business Unit spreadsheet 2022-09."@en ;
        sem:guid          "a0a7e174-3a79-4131-8ae4-69349490670a" ;
        skos:broader      <http://smartlogic.com/term#16463423238946451384634> ;
        skos:historyNote  "<p>This unit was created in June 2022.</p><div>CIR advised in online conversation 1 November 2022 that programme closed in IR. Whole team loaned to Ministry of Social Development and it will be for them to decide if this team is kept active within MSD.</div>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ServiceTransformationUnit/ServiceTransformationUnit_en> .

<http://example.com/InlandRevenueModel#ServiceTransformationUnit/STU_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "STU"@en .

