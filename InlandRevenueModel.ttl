<http://example.com/InlandRevenueModel#EnterpriseRiskManagementFramework>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#EnterpriseRiskManagementFramework/ERMF_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>IR Enterprise Risk Management Framework. https://irnz.sharepoint.com/sites/govcentre/Documents/Forms/AllItems.aspx?id=%2Fsites%2Fgovcentre%2FDocuments%2FEnterprise%20Risk%20Management%20Framework%2Epdf&amp;parent=%2Fsites%2Fgovcentre%2FDocuments<span class=\"rangySelectionBoundary\" id=\"selectionBoundary_1661808741503_5024308544387324\">&#65279;</span><br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Inland Revenue is committed to ensuring effective risk management is embedded across the whole organisation. Our Enterprise Risk Management Framework (ERMF) is consistent with the International Risk Management Standard (ISO 31000:2018) and is designed to integrate with our business processes. It is also aligned to The Committee of Sponsoring Organisations of Treadway Commission (COSO) Enterprise Risk Management Framework 2017 which prescribes that risk is integrated in the following five areas: Governance and culture; Strategy and objective setting; Performance; Review and revision; Information, communication and reporting. COSO also is used as the basis for the internal control information in this framework, including the five integrated components of an internal control: Control environment; Risk assessment; Control activities; Information and communication; and Monitoring activities (assurance)."@en ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://smartlogic.com/term#47765963176520709341237> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>CI&amp;A content; P&amp;C: H&amp;S content<br/><!--EndFragment--><br/><br/><br/></p>"@en ;
        sem:guid          "c275263a-d0c4-4134-9c50-7f63171ecc22" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Enterprise-model> ;
        skos:related      <http://example.com/InlandRevenueModel#RiskMethodology> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EnterpriseRiskManagementFramework/EnterpriseRiskManagementFramework_en> .

<http://example.com/InlandRevenueModel#EnterpriseRiskManagementFramework/ERMF_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "ERMF"@en .

