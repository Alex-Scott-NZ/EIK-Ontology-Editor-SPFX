<http://example.com/InlandRevenueModel#PrivateDomesticWorker>
        rdf:type          <http://example.com/NZ-IRD#Profession> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "​​Private domestic workers are people whose work meets all of these conditions: they work in someone else's home; the work they do for their employer is not related to the employer's business; they are paid directly by their employer (or receive a Carer Support payment direct from Ministry of Health); they don't regularly work full-time (up to 30 hours a week per employer)."@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Income Tax Act 2007 Definitions s YA 1"@en ;
