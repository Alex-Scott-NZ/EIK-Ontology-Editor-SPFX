<http://example.com/InlandRevenueModel#NewZealandProductivityCommission>
        rdf:type          <http://smartlogic.com/class#Commercial-organisation> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/InlandRevenueModel#NewZealandProductivityCommission/NZProductivityCommission_en> ;
