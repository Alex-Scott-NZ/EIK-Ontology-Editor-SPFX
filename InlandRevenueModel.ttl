<http://example.com/InlandRevenueModel#ListOfDocumentsReliedOn>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#DistrictCourtRules2014> ;
