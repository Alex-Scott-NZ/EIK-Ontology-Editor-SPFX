<http://example.com/Cleaned-Inland-Revenue-model#Guardian>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#IsRoleRelatedTo>
                <http://example.com/InlandRevenueModel-current-#CareOfChildrenAct2004> ;
        sem:guid          "4e87d1f5-be8a-441f-b137-991f714dea6e" ;
        skos:broader      <http://example.com/InlandRevenueModel#FamilyRoles> ;
        skos:definition   "<p>Guardian (in relation to caring for children)<br>A guardian is an adult who has the responsibility and authority to look after a child’s wellbeing and to make important decisions for them.<br>This usually includes decisions about the child’s:<br>•\tCare and living arrangements<br>•\tHealth and medical treatment<br>•\tEducation and upbringing<br>•\tSafety and general welfare<br>A guardian may be a&nbsp;parent or another adult appointed by law or the court, or recognised through an agreed care arrangement.<br>A guardian does not have to provide day to day care themselves, but they remain responsible for major decisions about the child. i.e. a guardian is about decision‑making responsibility; a&nbsp;carer is about day‑to‑day care.&nbsp;One person may be both, but they are not always the same.<br><br></p>"@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Carer> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#Guardian/Guardian_en> .

<http://example.com/Cleaned-Inland-Revenue-model#Guardian/Guardian_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Guardian"@en .

