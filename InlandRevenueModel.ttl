<http://example.com/Cleaned-Inland-Revenue-model#PAYEIntermediary>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Publishes>
                <http://example.com/InlandRevenueModel-current-#ElectronicAmendmentSchedule> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#EmployerLinkingToPAYEIntermediary> , <http://example.com/InlandRevenueModel#PAYEIntermediaryEmployeeAccess> , <http://example.com/InlandRevenueModel#PAYEIntermediaryRegistration> ;
