<http://example.com/InlandRevenueModel#DigitalPlatform>
        rdf:type          <http://smartlogic.com/class#Topic> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#Airbnb> , <http://example.com/InlandRevenueModel#Uber> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://online.hbs.edu/blog/post/platform-based-business-models\">Traditional vs. Platform-Based Business Models: 4 Key Differences</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Harvard Business School"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A platform business model leverages digital infrastructure to facilitate interactions between user groups. It generates value and revenue through transaction fees, advertising, and data monetisation.Fees charged for assets or services offered for through a digital platform such as a website or app, are considered income in the sharing economy. Key Characteristics: Transactions are peer-to-peer, facilitated by an online marketplace (apps or websites), Providers are often independent contractors, not employees, Services range from transportation, accommodation, and delivery to personal tasks."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR Products"@en ;
        sem:guid          "29eb1162-dd90-4ca0-9a6f-5bd92dc7b940" ;
        skos:broader      <http://example.com/InlandRevenueModel#SharingEconomy> ;
        skos:definition   "Digital platforms are business models that use online infrastructure to facilitate interactions between groups. Examples include: Social media channels. Online marketplaces."@en ;
        skos:related      <http://example.com/InlandRevenueModel#DigitalPlatformInformationReporting> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#DigitalPlatform/OnlineMarketplace_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DigitalPlatform/DigitalPlatform_en> .

<http://example.com/InlandRevenueModel#DigitalPlatform/DigitalPlatform_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Digital platform"@en .

<http://example.com/InlandRevenueModel#DigitalPlatform/OnlineMarketplace_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Online marketplace"@en .

<http://example.com/InlandRevenueModel#DigitalPlatformInformationReporting>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/Cleaned-Inland-Revenue-model#ElectronicMarketplace> , <http://example.com/InlandRevenueModel-current-#OnlineService> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#OECD> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Online marketplaces often operate across multiple jurisdictions, creating visibility challenges for tax authorities. To address this, the Organisation for Economic Co-operation and Development (OECD) has established international reporting and exchange rules to standardise requirements and enhance compliance. New Zealand has given legislative effect to these rules. <br>The reporting rules require online marketplaces to provide information about sellers and the income they earn from certain activities on their platform to their tax authority. This information will then be exchanged between tax authorities who have implemented the rules. New Zealand based online marketplaces must report income from activities such as: <br>-\tRental of immovable property (e.g., commercial, short-stay, visitor accommodation) <br>-\tPersonal services (e.g., ride-sharing, food delivery, graphic design) <br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR Products"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#DigitalPlatformInformationReporting/PR.ID.007_en> ;
        sem:guid          "bed83417-36d2-49b6-951a-dca4e192519d" ;
        skos:broader      <http://example.com/InlandRevenueModel#InternationalDisclosures> ;
        skos:related      <http://example.com/InlandRevenueModel#DigitalPlatform> , <http://example.com/InlandRevenueModel#FinancialReporting> , <http://example.com/InlandRevenueModel#SharingEconomy> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DigitalPlatformInformationReporting/DigitalPlatformInformationReporting_en> .

