                true ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#OrganisationalRestructuring/FTEAdjustments_en> , <http://example.com/InlandRevenueModel#OrganisationalRestructuring/FTEIncrease_en> , <http://example.com/InlandRevenueModel#OrganisationalRestructuring/FTEReduction_en> ;
