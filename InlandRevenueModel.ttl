<http://example.com/InlandRevenueModel#EnterpriseActivityView>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#EnterpriseActivityView/EAV_en> ;
