<http://smartlogic.com/term#83752631923000545524903>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://smartlogic.com/term#83752631923000545524903/totohu_en> ;
