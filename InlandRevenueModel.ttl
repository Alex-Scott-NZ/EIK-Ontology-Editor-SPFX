<http://example.com/InlandRevenueModel#RevenueInformation>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#RevenueInformation/RI_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p> </p><p><a href=\"https://irnz.sharepoint.com/sites/CORP-corporate-legal/SiteAssets/Forms/AllItems.aspx?id=%2Fsites%2FCORP%2Dcorporate%2Dlegal%2FSiteAssets%2FSitePages%2FHome%2F2022%2DInformation%2D%2DLaw%2Dat%2DInland%2DRevenue%2DFinal%2Epdf&amp;parent=%2Fsites%2FCORP%2Dcorporate%2Dlegal%2FSiteAssets%2FSitePages%2FHome&amp;p=true&amp;ga=1\">Information Law at Inland Revenue</a></p><p> </p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p> </p><p>Revenue information is information that is acquired, obtained, accessed, received by, disclosed to, or held by the Commissioner in connection with a Revenue Law and for a purpose set out in section 16B(1) or “an information-sharing agreement (as defined in section 16C(2) of the TAA. The purposes in s16B(1) are:</p><p> <br></p><p>\n<!-- [if !supportLists] -->(a)&nbsp;&nbsp;&nbsp; \n<!-- [endif] -->to protect the integrity of the tax system:</p><p> <br></p><p>\n<!-- [if !supportLists] -->(b)&nbsp;&nbsp;&nbsp; \n<!-- [endif] -->to carry into effect the revenue laws:</p><p> <br></p><p>\n<!-- [if !supportLists] -->(c)&nbsp;&nbsp;&nbsp; \n<!-- [endif] -->to carry out or support a function lawfully conferred on the Commissioner:</p><p> <br></p><p>\n<!-- [if !supportLists] -->(d)&nbsp;&nbsp;&nbsp; \n<!-- [endif] -->to encourage compliance with the revenue laws:</p><p> <br></p><p>\n<!-- [if !supportLists] -->(e)&nbsp;&nbsp;&nbsp; \n<!-- [endif] -->for any other function lawfully conferred on the Commissioner.</p><p> <br></p><p><br>Revenue information could include, for example:</p><p> <br></p><p>\n<!-- [if !supportLists] -->·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \n<!-- [endif] -->thresholds and tolerance levels;</p><p> <br></p><p>\n<!-- [if !supportLists] -->·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \n<!-- [endif] -->profiling information;</p><p> <br></p><p>\n<!-- [if !supportLists] -->·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \n<!-- [endif] -->investigative techniques;</p><p> <br></p><p>\n<!-- [if !supportLists] -->·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \n<!-- [endif] -->operational policies and procedures;</p><p> <br></p><p>\n<!-- [if !supportLists] -->·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \n<!-- [endif] -->aggregated compliance statistics; and</p><p> <br></p><p>\n<!-- [if !supportLists] -->·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \n<!-- [endif] -->programme evaluation.</p><p> </p>"@en ;
        sem:guid          "c44269f9-e8be-469a-ad14-e2eb1ef20c9a" ;
        skos:broader      <http://example.com/InlandRevenueModel#LegalInformation> ;
        skos:related      <http://example.com/InlandRevenueModel#SocialPolicyAdministration> , <http://smartlogic.com/term#180994193141146994107004654244499> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#RevenueInformation/RevenueInformation_en> .

