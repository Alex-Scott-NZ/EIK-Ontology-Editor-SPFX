        skosxl:literalForm     "Settlement payment"@en .

<http://example.com/InlandRevenueModel-current-#SettlementDeed>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsUsedInEvent>
                <http://example.com/InlandRevenueModel#Settlement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Isused-in-function>
                <http://smartlogic.com/term#76063862078258288179254> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Lawpath. https://lawpath.com.au/blog/deed-of-settlement"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel-current-#SettlementDeed/DeedOfSettlementAndGuarantee_en> , <http://example.com/InlandRevenueModel-current-#SettlementDeed/DeedOfSettlementOfProceedingAndGuarantee_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "LMU content"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://smartlogic.com/term#26935012703950163985629> ;
        sem:guid          "1a5758fb-d265-4d85-9e07-7320ddb987e4" ;
        skos:broader      <http://example.com/InlandRevenueModel#LegalInformation> ;
        skos:definition   "A Deed of Settlement is a legal document which formalises an agreement between relevant parties to settle a dispute. It is an alternative to litigation, and has legally binding terms the parties have agreed upon. These agreements usually prevent the parties from commencing further litigation, as the settlement is deemed to be final."@en ;
        skos:related      <http://example.com/InlandRevenueModel#CustomerFinancialInformation> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel-current-#SettlementDeed/DeedOfSettlement_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#SettlementDeed/SettlementDeed_en> .

