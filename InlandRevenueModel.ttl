<http://example.com/NZ-IRD#Contract-of-service>
        rdf:type          <http://smartlogic.com/class#Agreement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#HasAgreementParty>
                <http://smartlogic.com/term#214450621693017375393006> , <http://smartlogic.com/term#214450622583028921698271> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsOutcomeOf>
                <http://example.com/Cleaned-Inland-Revenue-model#EmploymentRelations> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IR Glossary"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/NZ-IRD#Contract-of-service/employee-employerRelationship_en> ;
        sem:guid          "dd33fd1a-76d2-4b52-8c14-813d4b55d13a" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#EmploymentAgreement> ;
        skos:definition   "<p>​<span style=\"color: rgb(55, 66, 74);font-size: 12px;background-color: rgb(218, 218, 218)\">A person's employment status depends on whether his or her employment contract is a contract of service or a contract for services</span><br><br>​<span style=\"color: rgb(55, 66, 74);font-size: 12px;background-color: rgb(218, 218, 218)\">Contract of service</span><br>​<span style=\"color: rgb(55, 66, 74);font-size: 12px;background-color: rgb(218, 218, 218)\">Employees have a contract of service with their employer. Contracts of service evolved from the earlier concept of a master-servant relationship. Such a relationship required an employee to be continuously available for service and to accept a high degree of control by the employer.</span><br><br>​<span style=\"color: rgb(55, 66, 74);font-size: 12px;background-color: rgb(218, 218, 218)\">Contract for service</span><br>​<span style=\"color: rgb(55, 66, 74);font-size: 12px;background-color: rgb(218, 218, 218)\">A contract for service applies to the relationship between an independent contractor and a principal. It emphasises the nature of the service to be provided by a person rather than his or her availability to work as directed.</span><br><br>​<span style=\"color: rgb(55, 66, 74);font-size: 12px;background-color: rgb(218, 218, 218)\">Either form of contract may include an unwritten agreement. A written contract is not necessary in determining the existence of any particular type of employment relationship. However if there is a detailed written contract, it will form the basis for analysing the nature of the relationship the parties intended to have.</span><br><br>​<span style=\"color: rgb(55, 66, 74);font-size: 12px;background-color: rgb(218, 218, 218)\">Employment contracts often change as the relationship evolves (e.g. a person takes on more duties). Changes in regulations and work practices may also cause the employment status of some workers to change. The courts will consider how the parties actually work together when they determine the type of employment relationship parties have.</span><br><br>​<span style=\"color: rgb(55, 66, 74);font-size: 12px;background-color: rgb(218, 218, 218)\">More information is available in TIB Volume 11 No. 2.</span>​<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/NZ-IRD#Contract-of-service/Contract-of-service_en> .

<http://example.com/NZ-IRD#Contract-of-service/Contract-of-service_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Contract of service"@en .

<http://example.com/NZ-IRD#Contract-of-service/employee-employerRelationship_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "employee-employer relationship"@en .

