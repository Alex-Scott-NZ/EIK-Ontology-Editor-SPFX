        skos:historyNote  "Created in 2013. There are no more findable documents from 2020 onwards."@en ;
        skos:related      <http://smartlogic.com/term#31664694521552301471433> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#NationalPropertyCommittee/NationalPropertyCommittee_en> .

