<http://example.com/InlandRevenueModel#ReleaseManagement>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/Cleaned-Inland-Revenue-model#HasEventObject>
                <http://example.com/InlandRevenueModel#Release> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span>Glossary of terms from IR's Initiative Management Framework<br/>document. May 2022.</span></p><p><span style=\"color: black;\"><a href=\"https://irnz.sharepoint.com/sites/CORP-strategic-portfolio-stewardship/SupInfo/Forms/AllItems.aspx?id=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo%2FInitiative%20Management%20Framework%2Epdf&amp;parent=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo\"><span style=\"color: #337ab7;\">Tiakitanga Kohinga<br/>Rautaki - Strategic Portfolio Stewardship - Initiative Management Framework.pdf<br/>- 1) All Documents (sharepoint.com)</span></a></span></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Realease - <br/>The deployment of completed initiatives or scope items. A release could be a set of small-medium changes that are being deployed together as part of a regular cycle through to a group of larger related changes that forms part of an annual/biannual cycle or requires a one-off release to be scheduled. <br/></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ReleaseManagement/SoftwareUpgrade_en> , <http://example.com/InlandRevenueModel#ReleaseManagement/VersionUpgrade_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IT&C content"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-8.1.2_Routine_Operations_&_Administration_of_Records_&_Information_Systems> ;
        sem:guid          "6ad8d75f-7277-4184-93c0-303de32a01a7" ;
        skos:broader      <http://example.com/InlandRevenueModel#Deployment> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ReleaseManagement/ReleaseManagement_en> .

