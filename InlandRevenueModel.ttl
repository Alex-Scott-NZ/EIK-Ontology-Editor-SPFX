<http://example.com/InlandRevenueModel#CreditsAndEntitlement>
        rdf:type            <http://example.com/InlandRevenueModel#IRProduct1> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>This business product group contains products that entitle customers to receive monies from IR funded by the Crown. The entitlement is typically tied to level of income, with some exceptions. <br>The group is made up of a range of products relating to Working for Families Tax Credits, Tax Credits, Family Boost Payments, Paid Parental Leave and a sub-set of the COVID-19 products. Some products are broken down into sub-categories in the register. <br><br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>IR business products register<br><br></p>"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#CreditsAndEntitlement/PR.CS.000_en> ;
        sem:guid            "1be73888-0861-4bc3-8306-105376dd3ebb" ;
        skos:broader        <http://example.com/InlandRevenueModel#IRProduct0> ;
        skos:editorialNote  "Previously treated as part of money classification. As part of the work of gathering all IR products into one set this heading was moved here."@en ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#CreditsAndEntitlement/CreditsAndEntitlement_en> .

