<http://example.com/Cleaned-Inland-Revenue-model#MandatoryConversionConvertibleNote>
        rdf:type          <http://smartlogic.com/class#Legal-tender> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/Cleaned-Inland-Revenue-model#MandatoryConversionConvertibleNote/MCN_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Tax Technical determination. G5C: Mandatory Conversion Convertible Notes"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A Mandatory Conversion Convertible Note is a financial arrangement in which the holder of the Note provides money to a company, and the debt is discharged at a future date by the issue of shares (or stock) in any company. Interest may be payable for the period between the issue of the Note and conversion into shares. Such payments are called Coupon Interest Payments."@en ;
        sem:guid          "6b5aa0e4-0ee1-48f2-bccc-2630fbbf4ffa" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#ConvertibleNotes> ;
        skos:definition   "A Mandatory Conversion Convertible Note (MCCN) is a financial instrument where an investor lends money to a company (the issuer) that must be converted into a specified number of shares on a predetermined date, rather than being repaid as a cash loan. Unlike traditional convertible notes, which may give the investor an option to convert, an MCCN removes this choice, forcing the conversion of the debt into equity at a future point in time."@en ;
        skos:related      <http://example.com/InlandRevenueModel#ShareManagement> , <http://smartlogic.com/term#77793849175289009165474> ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#MandatoryConversionConvertibleNote/MandatoryConvertibleNote_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#MandatoryConversionConvertibleNote/MandatoryConversionConvertibleNote_en> .

<http://example.com/Cleaned-Inland-Revenue-model#MandatoryConversionConvertibleNote/MCN_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "MCN"@en .

<http://example.com/Cleaned-Inland-Revenue-model#MandatoryConversionConvertibleNote/MandatoryConversionConvertibleNote_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Mandatory conversion convertible note"@en .

