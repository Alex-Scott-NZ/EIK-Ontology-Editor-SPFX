        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A process used to determine whether the child support formula assessed amount accurately reflects the ability of a parent to provide financial support for their children. The first step of this process is an investigation by Inland Revenue into the parent's income, earning capacity, property and financial resources."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website; CCS-B content"@en ;
        sem:guid          "1948f289-108f-403c-8a07-4b879de8c593" ;
        skos:broader      <http://example.com/InlandRevenueModel#ChildSupportReview> ;
        skos:definition   "The Commissioner of Inland Revenue may decide to review an assessment if she believes a parent's financial affairs don't accurately reflect their ability to provide financial support to their children. This is called a Commissioner review or a Commissioner-initiated administrative review."@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#CommissionerReview/Commissioner-initiatedAdministrativeReview_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CommissionerReview/CommissionerReview_en> .

