        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#NorthernProcessingCentre/NationalPropertyCommittee_en> ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#NorthernProcessingCentre/OfficeNumber29_en> ;
        sem:guid          "e2d21ca0-ecf7-4599-9464-08ff1caa336d" ;
        skos:broader      <http://example.com/InlandRevenueModel#_PreviousIROffices-> ;
        skos:historyNote  "<p><!--StartFragment--><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">Processing </span><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">Centres were Inland Revenues sites for Return &amp; Payment Processing, later </span><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">taking on customer correspondence. First established cicra 1989. Changed by Our </span><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">Way Forward 2006 to Operations Delivery under Customer Operations, Business </span><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">Development Services. Changed by Service Delivery realignment 2010 to</span><br style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);\"/><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">Transactional Services, Customer Services. Changed by Organisation Design 2017</span><br style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);\"/><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">to Customer &amp; Compliance Services – Individuals.</span><!--EndFragment--><br/></p>"@en , "<p>No longer in existence.<br><br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#NorthernProcessingCentre/NorthernProcessingCentre_en> .

