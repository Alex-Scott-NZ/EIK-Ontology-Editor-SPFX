<http://example.com/InlandRevenueModel#Oranga>
        rdf:type          <http://smartlogic.com/class#Topic> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>IR intranet<br><br></p><p> </p><p><a href=\"https://irnz.sharepoint.com/sites/CORP-our-organisation/SitePages/Oranga.aspx?web=1\">https://irnz.sharepoint.com/sites/CORP-our-organisation/SitePages/Oranga.aspx?web=1</a></p><p> </p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>​<span style=\"color: rgb(36, 36, 36);font-size: 20px;background-color: rgb(240, 240, 240)\">Our aspiration is: Improving oranga for current and future generations. Learn more about the concept of oranga and what it means for us at IR.<br></span></p><p> </p><p><span style=\"font-size:10.0pt;color:#242424\">Oranga derives from Te Ao Māori. Oranga is more than a word. It encompasses the physical, mental and spiritual wellbeing of an individual and their interconnectedness with the natural world around them.</span></p><p> </p><p><span style=\"font-size:10.0pt;color:#242424\">&nbsp;It is the condition of a person, of a group, of the community, where they are healthy, and exist comfortably in their world. Oranga is characterised by reference to the whole and not it’s individual parts.</span></p><p> </p><p><span style=\"font-size:10.0pt;color:#242424\">&nbsp;Our work has both a direct and indirect impact on oranga. We contribute to oranga&nbsp;tāngata,&nbsp;oranga&nbsp;whānau and&nbsp;oranga&nbsp;whenua&nbsp;(wellbeing for people, families, the environment).</span></p><p> </p><p><span style=\"font-size:10.0pt;color:#242424\">&nbsp;Oranga is future focussed, compelling us to think about our responsibilities to improve wellbeing for future generations. A way to think about this is ‘creating a wellbeing legacy for those to come.’</span></p><p> </p><p><span style=\"font-size:10.0pt;color:#242424\">&nbsp;Our aspiration reflects the importance we place on being stewards of the tax and social policy system so that the people of Aotearoa New Zealand will be able to benefit from the work we do now and in the future.</span></p><p> </p><p><span style=\"font-size:10.0pt;color:#242424\">&nbsp;It brings together a te ao Māori worldview and an organisational perspective reflecting our journey to become Te Tiriti-based.</span></p><p> </p>"@en ;
        sem:guid          "6f8d7b91-b755-4306-9719-ea1b7b95a537" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRCulturalValue> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Oranga/Oranga_en> .

<http://example.com/InlandRevenueModel#Oranga/Oranga_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Oranga"@en .

