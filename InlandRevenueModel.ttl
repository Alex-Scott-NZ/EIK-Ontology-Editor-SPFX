<http://example.com/InlandRevenueModel#DigitalServicesTax>
        rdf:type          <http://smartlogic.com/class#Obligation> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#DigitalServicesTax/DST_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/Cleaned-Inland-Revenue-model#MultinationalEnterprise> , <http://example.com/InlandRevenueModel#DigitalServiceProvider> , <http://example.com/InlandRevenueModel#DigitalServicesDevelopment> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#OECD> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Digital Services Tax (DST) Bill was introduced to Parliament on 31 August 2023 as a measure to address the under-taxation of digital multinationals. The bill commits New Zealand to an OECD-led global tax initiative aimed at ensuring large multinationals pay a minimum tax rate of 15 per cent in participating countries. The aim is to stop a global “race to the bottom” among countries trying to entice the mobile capital of multinationals by slashing their tax rates. The bill was discharged / withdrawn on 21 May 2025."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "SD&I content"@en ;
        sem:guid          "78306ba4-5097-4705-a74b-e407b0316e84" ;
        skos:broader      <http://smartlogic.com/term#175072654838674267587392> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DigitalServicesTax/DigitalServicesTax_en> .

