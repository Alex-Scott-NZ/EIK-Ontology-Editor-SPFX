<http://example.com/InlandRevenueModel#InitiativeConcept>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInformationRelatedTo>
                <http://example.com/InlandRevenueModel#InitiativeManagement> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Glossary of terms from IR's Initiative Management Framework document. May 2022.</p><div><p><!--StartFragment--><a href=\"https://irnz.sharepoint.com/sites/CORP-strategic-portfolio-stewardship/SupInfo/Forms/AllItems.aspx?id=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo%2FInitiative%20Management%20Framework%2Epdf&amp;parent=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo\">Tiakitanga Kohinga Rautaki - Strategic Portfolio Stewardship - Initiative Management Framework.pdf - 1) All Documents (sharepoint.com)</a><!--EndFragment--><br/></p></div>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The initiative concept is a document that presents information about the initiative to allow the following to be answered:<br/>• Is there a valid problem or opportunity, and the benefits are compelling enough, that justifies the initiative being considered?<br/>• Does the proposed initiative align with IR’s goals, strategies, objectives, and priorities described within Eke Tangaroa - IR’s enterprise plan?<br/>• Should this initiative proceed to the next stage gate?<br/></p>"@en ;
        sem:guid          "999fa8b8-88a5-48c6-8fe1-c03e089e1ef3" ;
        skos:broader      <http://example.com/InlandRevenueModel#ChangeManagementInformation> ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Business-case> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#InitiativeConcept/InitiativeConcept_en> .

<http://example.com/InlandRevenueModel#InitiativeConcept/InitiativeConcept_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Initiative concept"@en .

<http://example.com/InlandRevenueModel#InitiativeManagement>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/Cleaned-Inland-Revenue-model#HasPossibleClassID>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.1.2_Reviews_of_Strategic_Corporate_Policies_and_Procedures> , <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.1.4_Reviews_of_Operational_Corporate_Policies_and_Procedures> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#DiscretionaryInitiative> , <http://example.com/InlandRevenueModel#MandatoryInitiative> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#InitiativeConcept> , <http://example.com/InlandRevenueModel#InitiativeProposal> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<!--StartFragment--><p style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);\">Glossary of terms from IR's Initiative Management Framework document. May 2022.</p><div style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);\"><p><a href=\"https://irnz.sharepoint.com/sites/CORP-strategic-portfolio-stewardship/SupInfo/Forms/AllItems.aspx?id=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo%2FInitiative%20Management%20Framework%2Epdf&amp;parent=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo\" style=\"background-color: transparent;color: rgb(51, 122, 183);text-decoration: underline;\">Tiakitanga Kohinga Rautaki - Strategic Portfolio Stewardship - Initiative Management Framework.pdf - 1) All Documents (sharepoint.com)</a></p></div><!--EndFragment-->"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The disciplines, processes, and tools to deliver agreed initiatives in a consistent manner using common processes and shared governance pathways.<br/><br/></p>"@en ;
        sem:guid          "e4eaebc0-daa3-4f2b-9606-a549773d0246" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#ChangeManagement> ;
        skos:related      <http://example.com/InlandRevenueModel#Initiative> , <http://example.com/InlandRevenueModel#NetworkedTeam> , <http://example.com/InlandRevenueModel#ValueFramework> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#InitiativeManagement/InitiativeManagement_en> .

<http://example.com/InlandRevenueModel#InitiativeManagement/InitiativeManagement_en>
        rdf:type               skosxl:Label ;
