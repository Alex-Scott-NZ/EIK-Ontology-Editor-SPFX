        <http://example.com/IRD-test-model#Has-acronym>
                <http://smartlogic.com/term#151339279135217100211706/MFTC_en> ;
        <http://example.com/InlandRevenueModel#HasFocusOn>
                <http://example.com/InlandRevenueModel-current-#Family> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Tax & Social Policy Glossary. https://www.ird.govt.nz/working-for-families/types/minimum-family-tax-credit"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel#UsesService>
                <http://example.com/InlandRevenueModel#IndividualProductEnrolmentService> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "​A payment to make sure families are getting basic income where the parents or parents work a required number of hours for salary and wages."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://smartlogic.com/term#151339279135217100211706/MFTCThreshold_en> , <http://smartlogic.com/term#151339279135217100211706/TeWhakahekengaTakeMokitoTahaWhanau_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS-I content; Intranet; Annual Report 2015; PAS content. Māori term from Te Taura Whiri Māori Language Commission"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://smartlogic.com/term#151339279135217100211706/PR.CS.013_en> ;
        sem:guid          "3601e987-d8c8-57a1-bd06-b77a7ea045db" ;
        skos:broader      <http://example.com/InlandRevenueModel#WorkingForFamiliesTaxCredit> ;
        skos:definition   "<p>You may qualify for a minimum family tax credit if you get Working for Families, your family income is under the income limit, and you work a minimum number of hours every week. Minimum family tax credit payments ensure working families get a minimum level of income every week. If you qualify, we’ll top up your income so you’ll get a set amount per week (after tax). This amount normally changes from year to year to keep up with the cost of living. Your entitlement does not change with the number of children in your care.<br>This payment tops up a family's annual income if they are working for a salary or wage and earn below the annual income level. For a family to qualify for MFTC at least one parent needs to be working for salary and wages.<br></p>"@en ;
        skos:related      <http://example.com/IRD-test-model#Salary-Wage-earner> ;
        skosxl:prefLabel  <http://smartlogic.com/label#151339279135217100211706_English> .

