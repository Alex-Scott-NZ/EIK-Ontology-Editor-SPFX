<http://example.com/InlandRevenueModel#EmployeeIndemnityFund>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#MoneyHeld> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#EmployeeIndemnityFund/EIF_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "501fa50c-e74b-40ae-a39d-6cb8bf9b4f14" ;
        skos:broader      <http://example.com/InlandRevenueModel#MoneyHeldOnBehalf> ;
        skos:definition   "In New Zealand, employee indemnity generally refers to an employer's obligation to protect their employees from certain financial liabilities incurred while acting within the scope of their employment. This can include covering legal costs or damages arising from claims made against an employee due to their work. Employers may also choose to purchase professional indemnity insurance to further mitigate these risks. "@en ;
        skos:related      <http://example.com/InlandRevenueModel#DamagesClaim> , <http://example.com/InlandRevenueModel#EmployeeBenefit> , <http://smartlogic.com/term#357460054304124636831585641310488> , <http://smartlogic.com/term#867859429290627085143312525332433> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EmployeeIndemnityFund/EmployeeIndemnityFund_en> .

