<http://example.com/InlandRevenueModel#DividendWitholdingTax>
        rdf:type          <http://smartlogic.com/class#Obligation> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#DividendWitholdingTax/DWT_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://smartlogic.com/term#134667386383500393103361> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsAppliedTo>
                <http://smartlogic.com/term#531442512418953950816056224858867> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/kc-investment-income/SitePages/dwt-registration.aspx?web=1\">DWT registration</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A company that pays dividends may be required to deduct resident withholding tax from the dividends. The tax types used by Inland Revenue are separated into two categories:<br>Dividend Withholding Tax (DWT): RWT on all other dividends (cash and non-cash).<br>Resident Withholding Tax (RWT): RWT on specified dividends. Specified dividends are dividends treated as interest and are defined as dividends which are paid by organisations that do not operate an imputation credit account.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS knowledge base"@en ;
        sem:guid          "58cfd65d-d281-414e-a043-15863bb2c1fb" ;
        skos:broader      <http://smartlogic.com/term#716311899949028386928466293214695> ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#ImputationCreditAccount> , <http://example.com/InlandRevenueModel#ResidentWithholdingTaxOnDividends> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DividendWitholdingTax/DividendWitholdingTax_en> .

