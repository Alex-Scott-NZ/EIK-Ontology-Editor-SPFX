                "KPMG website"@en ;
        <http://example.com/NZ-IRD#Is-offered-by-supplier>
                <http://example.com/InlandRevenueModel#KPMG> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "International Revenue Strategy content"@en ;
        sem:guid          "6557b1a7-0761-438c-b1bb-a9030878718b" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#Publication> ;
        skos:definition   "KPMG’s Financial Institutions Performance Survey (FIPS) reports have provided in-depth insights into New Zealand’s financial services sector for over 30 years. We produce two sector reports, a banking report and a non-bank report covering finance companies, credit unions, P2P lenders and other non-bank entities. Each edition presents industry commentary and analysis on the performance of New Zealand registered banks and other financial institutions, together with a range of topical articles from other key stakeholders such as industry experts, regulators and our own business leaders."@en ;
        skos:related      <http://smartlogic.com/term#84951202648081637135914> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#FinancialInstitutionPerformanceSurvey/FinancialInstitutionPerformanceSurvey_en> .

