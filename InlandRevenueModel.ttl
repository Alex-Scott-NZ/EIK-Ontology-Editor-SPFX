<http://example.com/InlandRevenueModel#MahiTika>
        rdf:type          <http://smartlogic.com/class#Topic> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span style=\"color: black;\">Email from Peter Mersi to all IR 28-11-2022.</span></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "At IR we always seek to do the right thing. We’re open about the decisions we make and the actions we take. We do what we say we’re going to do. We’re flexible and learn as we go. One of three outcomes of Te Pou o te Tangata - How we do things at IR. Whanaungatanga, Manaakitanga, and Mahi Tika. Communicated to IR by Peter Mersi, Commissioner of Inland Revenue 28-11-2022."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><span style=\"color: black;\">Email from Peter Mersi 28-11-2022.</span><span></span></p>"@en ;
        sem:guid          "a69497d8-3d21-4b0a-9f20-cefb5b863364" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRCulturalValue> ;
        skos:related      <http://example.com/InlandRevenueModel#HowWeWorkAtIR> , <http://example.com/InlandRevenueModel#Manaakitanga0> , <http://example.com/InlandRevenueModel#Whanaukitanga> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MahiTika/MahiTika_en> .

