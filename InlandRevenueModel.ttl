<http://example.com/NZ-IRD#Employment-income>
        rdf:type          <http://example.com/NZ-IRD#Legally-defined-term> , <http://smartlogic.com/class#Income> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "Employment income means an amount that is income under section CE 1 (Amounts derived in connection with employment), and includes— (a) salary or wages to which section RD 3B or RD 3C (which relate to income other than PAYE) applies: and (b) income, other than from a PAYE income payment, to which section RD 3B or RD 3C applies."@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://auditingaccounting.com/employment-income-in-accounting-definition-components-and-tax-implications\">Employment Income in Accounting: Definition, Components, and Tax Implications – Auditing Accounting</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Income Tax Act 2007. Section YA1"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Employment income refers to all earnings received by an individual from an employer in exchange for services rendered under an employment relationship. It typically includes:<br><br>Salaries and wages – Regular payments for work performed.<br>Bonuses and commissions – Additional compensation tied to performance or sales.<br>Overtime pay – Extra pay for hours beyond standard working time.<br>Allowances and benefits – Such as housing, travel, meal allowances, or non-cash benefits like company cars.<br>Other emoluments – Any incidental benefit or profit arising from employment, whether in cash or kind.<br></p>"@en ;
        <http://example.com/NZ-IRD#Is-defined-by>
                <http://smartlogic.com/term#153321368926185107673047370395105> ;
        sem:guid          "bcaab080-68d8-4d5a-a32b-abe12cdec34f" ;
        skos:broader      <http://smartlogic.com/term#460716479585426992918781858541954> ;
        skosxl:altLabel   <http://example.com/NZ-IRD#Employment-income/LabourIncome_en> ;
        skosxl:prefLabel  <http://example.com/NZ-IRD#Employment-income/Employment-income_en> .

<http://example.com/NZ-IRD#Employment-income/Employment-income_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Employment income"@en .

<http://example.com/NZ-IRD#Employment-income/LabourIncome_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Labour income"@en .

<http://example.com/NZ-IRD#Employment-status-test>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#Test0> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/Cleaned-Inland-Revenue-model#Contractor> , <http://smartlogic.com/term#214450621693017375393006> ;
