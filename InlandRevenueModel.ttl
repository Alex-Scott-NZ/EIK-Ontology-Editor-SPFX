<http://example.com/Cleaned-Inland-Revenue-model#ApprovedInformationSharingAgreement>
        rdf:type          <http://smartlogic.com/class#Agreement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#Privacy-InformationSharingAgreementBetweenInlandRevenueAndInternalAffairs-Order2013> , <http://smartlogic.com/term#183844542608731402368562> ;
        <http://example.com/Cleaned-Inland-Revenue-model#HasAgreementParty>
                <http://example.com/IRD-test-model#New-Zealand-Police> , <http://smartlogic.com/term#34015113214144524595531> , <http://smartlogic.com/term#733873855465831453299914748155375> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://example.com/InlandRevenueModel-current-#InformationSharing> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/Cleaned-Inland-Revenue-model#ApprovedInformationSharingAgreement/NgaWhakaaetangaTiritiriMohiohioKuaWhakamanahia_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/Cleaned-Inland-Revenue-model#ApprovedInformationSharingAgreement/AISA_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Viva Topics."@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A mechanism in the Privacy Act 1993 to increase the sharing of information between parties that have agreed to be in an AISA. One party must be a government department, and the other can be a person or organisation, including those in the private sector, but not outside New Zealand. AISAs have the status of regulations, and authorise information to be shared, including personal information, to facilitate a specified public service. "@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "GES content; Intranet. Māori term from Te Taura Whiri Māori Language Commission"@en ;
        sem:guid          "5ec35200-1831-40b7-9a9b-e1396b67d9e2" ;
        skos:broader      <http://example.com/InlandRevenueModel#InformationSharingAgreement> ;
        skos:definition   "Approved Information Sharing Agreements (AISA) is a special provision under the Privacy Act that allows government departments to share information so they can provide efficient and effective public services."@en ;
        skos:related      <http://example.com/InlandRevenueModel#DataAndInformationSupplyRegister> , <http://example.com/InlandRevenueModel#InformationSharingMemorandaOfUnderstanding> ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#ApprovedInformationSharingAgreement/InformationSharingAgreement_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#ApprovedInformationSharingAgreement/ApprovedInformationSharingAgreement_en> .

