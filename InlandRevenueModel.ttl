<http://example.com/InlandRevenueModel#FreeTradeAgreement>
        rdf:type          <http://smartlogic.com/class#Agreement> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#FreeTradeAgreement/FTA_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#FreeTradeAgreement/EventGroup_en> , <http://example.com/InlandRevenueModel#FreeTradeAgreement/FTAPeople_en> , <http://example.com/InlandRevenueModel#FreeTradeAgreement/FinnishTaxAdministration_en> , <http://example.com/InlandRevenueModel#FreeTradeAgreement/FixedTermAgreement_en> , <http://example.com/InlandRevenueModel#FreeTradeAgreement/ForumOnTaxAdministration_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Investopedia"@en ;
        <http://example.com/NZ-IRD#Evidence>
