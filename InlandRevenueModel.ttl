<http://example.com/InlandRevenueModel-current-#Non-residentEntertainer>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel-current-#Non-residentEntertainer/NgaKaiwhakangahauKainoho-kore_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-26"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Income Tax Act 2007, section RD 19, as interpreted by CoPilot."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel-current-#Non-residentEntertainer/NgaKaiwhakangahauKainoho-kore_en0> , <http://example.com/InlandRevenueModel-current-#Non-residentEntertainer/Non-residentSportsperson_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "SME (BI). Māori term from Te Taura Whiri Māori Language Commission"@en ;
        sem:guid          "fab6ba48-aeda-492f-b4a6-d14f194c739d" ;
        skos:broader      <http://smartlogic.com/term#720171291546130472949337736176450> ;
        skos:definition   "<p>The term “non‑resident entertainer” is defined in the Income Tax Act 2007 and applied through the schedular payment rules.&nbsp;Under section RD 19, a non‑resident entertainer is a person who is not a New Zealand tax resident, and derives income from an activity or performance in New Zealand connected with activities described in the definition of non‑resident entertainer in the Act. Examples include non-residents who perform acting, singing, music, dancing, comedy, or entertaining generally; speaking or lecturing; sporting activities or competitions.</p><p><br></p><p>Same core status<br>Non‑resident entertainers&nbsp;are subject to schedular withholding tax and are taxed on New Zealand‑sourced performance income. Exemptions may include income that is exempt under a qualifying cultural programme or if a sportsperson is and official representative of a body that administers the sport in an overseas country.&nbsp;These different tests are set out in section CW 20 of the Income Tax Act 2007.<br></p>"@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Entertainer> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#Non-residentEntertainer/Non-residentEntertainer_en> .

<http://example.com/InlandRevenueModel-current-#Non-residentEntertainer/NgaKaiwhakangahauKainoho-kore_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Ngā kaiwhakangahau kainoho-kore"@en .

