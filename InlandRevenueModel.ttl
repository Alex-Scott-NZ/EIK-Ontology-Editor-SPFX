<http://example.com/InlandRevenueModel#MasterServicesAgreement>
        rdf:type          <http://smartlogic.com/class#Agreement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsOutcomeOf>
                <http://smartlogic.com/term#206221503767312345916907> ;
