<http://example.com/InlandRevenueModel#ProcurementCapabilityIndex>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ProcurementCapabilityIndex/PCI_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://smartlogic.com/term#206221503767312345916907> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Commercial & Procurement content"@en ;
        sem:guid          "f1a96a29-160e-4707-a8d9-658969219389" ;
        skos:broader      <http://example.com/InlandRevenueModel#CapabilityFramework> ;
        skos:definition   "In New Zealand, the Procurement Capability Index (PCI) is an annual self-assessment tool used by mandated government agencies to measure their ability to manage and deliver procurement effectively. It helps agencies identify their procurement strengths and weaknesses across various areas like strategy, governance, and sourcing, enabling them to create improvement plans and track progress over time. The results also allow New Zealand Government Procurement (NZGP) to understand system-wide procurement capability and track progress across the sector. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ProcurementCapabilityIndex/ProcurementCapabilityIndex_en> .

