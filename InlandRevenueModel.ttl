        <http://example.com/NZ-IRD#Source-of-term>
                "PAS content"@en ;
        sem:guid          "711b12b7-a056-4c49-b2c5-3c65318f40a9" ;
        skos:broader      <http://example.com/InlandRevenueModel#ExternalSystem> ;
        skos:definition   "<p>The Longitudinal Business Database (LBD) is a large research database. It holds de-identified microdata about businesses. <br/>Data comes from a range of Stats NZ surveys and government agencies. The data is linked together, or integrated, to form the LBD.<br/>The LBD complements the Integrated Data Infrastructure (IDI), which contains de-identified microdata about people and households. The two databases are linked through tax data.<br/>Researchers use the LBD to evaluate policies and analyse business performance. <br/><br/></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#IntegratedDataInfrastructure> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#LongitudinalBusinessDatabase/LongitudinalBusinessDatabase_en> .

