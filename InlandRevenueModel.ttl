<http://example.com/InlandRevenueModel#DataAnalyticsPracticeDevelopmentAndDelivery>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#DataAnalyticsPracticeDevelopmentAndDelivery/DAPDAD_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-enterprise-data-and-analytics/SitePages/What-we-do.aspx"@en ;
        <http://example.com/InlandRevenueModel#UsesSystem>
                <http://example.com/InlandRevenueModel#PentahoDataIntegrator> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "This team is an group of interdisciplinary expertise focused on extracting knowledge from data sets and providing it to our customers. The field encompasses analysis, preparing data for analysis, and presenting findings to inform high-level decisions in an organisation. These insights help Inland Revenue better understand their customers, evaluate their advertising campaigns, personalise content, plan engagement strategies and capture non-compliance."@en ;
        <http://example.com/InlandRevenueModel-current-#ProducesAuthority>
                <http://example.com/InlandRevenueModel#DataSciencePractice> ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#DataAnalysis> , <http://example.com/InlandRevenueModel-current-#BusinessAnalytics> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>DSA Final Decision - IIS Alignment.pdf<br/>IIS Alignment Change Proposal.pdf<br/></p>"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#DataAnalyticsPracticeDevelopmentAndDelivery/AnalyticsDeliveryTeam_en> , <http://example.com/InlandRevenueModel#DataAnalyticsPracticeDevelopmentAndDelivery/AnalyticsTeam_en> , <http://example.com/InlandRevenueModel#DataAnalyticsPracticeDevelopmentAndDelivery/DataScienceTeam_en> ;
        sem:guid          "0f6668fe-3a29-401a-8fbb-972c3ec0817c" ;
        skos:broader      <http://smartlogic.com/term#178953839036513121843655> ;
        skos:historyNote  "Officially launched 1 November 2021, including the Analytics Team and the Data Science Team. Briefly known as the Analytics Delivery Team."@en ;
        skos:scopeNote    "<p>There is an artificial functional split between Data Science and Data Analytics that can create barriers and <br/>limit our ability to scale: collective delivery using cross-functional teams would provide better outcomes <br/>for customers. We will therefore amalgamate the teams into one.<br/></p>"@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#DataAnalyticsPracticeDevelopmentAndDelivery/DataAnalyticsPracticeDevelopment-Delivery_en> , <http://example.com/InlandRevenueModel#DataAnalyticsPracticeDevelopmentAndDelivery/DataAnalyticsPracticeDevelopmentAndDelivery_en0> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DataAnalyticsPracticeDevelopmentAndDelivery/DataAnalyticsPracticeDevelopmentAndDelivery_en> .

