        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intelligence Hub content"@en ;
        sem:guid          "56a8f153-89b8-4ad3-951f-903e1005f327" ;
        skos:broader      <http://example.com/InlandRevenueModel#OrganisedCrime> ;
        skos:definition   "Transnational organized crime (TOC) refers to profit-driven criminal activities conducted by organized criminal groups across international borders, involving more than one country. These crimes include drug and human trafficking, migrant smuggling, arms smuggling, counterfeit goods, money laundering, and cybercrime. TOC threatens global security, human rights, and economic stability by fostering corruption and undermining development."@en ;
