<http://example.com/InlandRevenueModel#NewZealandCitizen>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#CitizenshipAct1977> , <http://example.com/InlandRevenueModel#CitizenshipRegulations> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-26"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling."@en ;
        sem:guid          "9632c798-5bff-4eb9-b2e0-20a87af1d073" ;
        skos:broader      <http://example.com/InlandRevenueModel#Citizenship> ;
        skos:definition   "<p>Being a New Zealand citizen means you are a full and permanent member of New Zealand as a country, not just someone who has permission to live there.<br>In practical terms, New Zealand citizenship means:<br>You can live in New Zealand for life with no visa conditions or expiry.<br>You can leave and return to New Zealand at any time, for any length of time.<br>You can hold a New Zealand passport and receive consular help overseas.<br>You have full political rights, including voting and standing for Parliament or local government.<br>You have full economic and social rights, the same as someone born in New Zealand.<br>Citizens also have responsibilities, such as obeying the law, enrolling to vote, paying tax, and acting in New Zealand’s interests.<br>Citizenship is defined and governed by the Citizenship Act 1977.<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#NewZealandCitizen/NewZealandCitizen_en> .

<http://example.com/InlandRevenueModel#NewZealandCitizen/NewZealandCitizen_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "New Zealand citizen"@en .

