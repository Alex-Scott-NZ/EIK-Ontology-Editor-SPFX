                "Google AI"@en ;
        <http://example.com/InlandRevenueModel#SupportsActivity>
                <http://example.com/InlandRevenueModel#DataAnalysis> , <http://example.com/InlandRevenueModel#ReportingFunctionality> , <http://example.com/InlandRevenueModel-current-#WorkflowManagement> ;
        <http://example.com/NZ-IRD#Is-offered-by-supplier>
