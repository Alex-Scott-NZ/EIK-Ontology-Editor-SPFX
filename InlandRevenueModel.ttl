        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Featured News Article</p><p><br></p><p><br></p><p>https://irnz.sharepoint.com/:u:/r/sites/News/SitePages/Everything-you-need-to-know-about-Copilot-at-IR.aspx?csf=1&amp;web=1&amp;share=EZ2QpRMymFxJm7ZEXPo5aXEB8gsPy8Zjvk6D6AsjpmA6Fg&amp;e=db667M<br></p><p><br></p><p><br>​<a href=\"https://irnz.sharepoint.com/:u:/r/sites/News/SitePages/Everything-you-need-to-know-about-Copilot-at-IR.aspx?csf=1&amp;web=1&amp;share=EZ2QpRMymFxJm7ZEXPo5aXEB8gsPy8Zjvk6D6AsjpmA6Fg&amp;e=db667M\">Everything you need to know about Copilot at IR</a>​<br></p>"@en ;
        sem:guid          "3add6c0a-3b15-4e3f-bc76-99af1ef46c87" ;
        skos:broader      <http://smartlogic.com/term#47372529931203401780288> ;
        skos:definition   "<p>​<strong><span style=\"font-size:15px\">Microsoft Copilot</span></strong><span style=\"font-size: 15px\">&nbsp;is an AI-powered assistant integrated into Microsoft 365 apps (like Word, Excel, Outlook, and Teams) that helps users be more productive by generating content, summarizing information, analyzing data, and automating tasks using natural language commands. <br>Although not technically a stand alone app like Word or Excel it behaves as an intelligent assistance within those apps.</span>​</p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#ArtificalIntelligence> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Copilot/Copilot_en> .

