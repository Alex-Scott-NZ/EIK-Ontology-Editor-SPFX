        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>EAV, 31 December 2019.<br>​<span style=\"color: rgb(64, 115, 223);font-size: 14px\">https://stax.ird.govt.nz/cwxv4/wcc/faces/wccdoc?dDocName=IRDOC23761789</span></p><p><br>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Enterprise Activity View (EAV) is a quarterly report providing an 18-month rolling view of key activities being undertaken across Inland Revenue. It gives us greater visibility of activities and the associated impacts for our customers, people and technology. It also supports decision-making about change, enabling discussions on enterprise prioritisation and mitigation of risks."@en ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://example.com/InlandRevenueModel#Prioritisation> , <http://example.com/InlandRevenueModel-current-#ChangeManagement> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IT & C content"@en ;
        sem:guid          "37b39116-ddb0-4461-b6e1-6726fa714483" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Enterprise-model> ;
        skos:historyNote  "Used until the end of 2019."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EnterpriseActivityView/EnterpriseActivityView_en> .

