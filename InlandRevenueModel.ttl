        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Pacific Islands Civil Aviation Safety and Security Treaty"@en .

<http://example.com/InlandRevenueModel#PacificIslandsTaxAdministratorsAssociation>
        rdf:type          <http://smartlogic.com/class#Commercial-organisation> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#PacificIslandsTaxAdministratorsAssociation/PITAA_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://pitaa.org/\">PITAA – Pacific Islands Tax Administrators Association</a>​<br></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#PacificIslandsTaxAdministratorsAssociation/PacificIslandTaxAdministratorsAssociation_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "PAS content"@en ;
        sem:guid          "7106fa20-a282-42dd-a809-6606aff7f238" ;
        skos:broader      <http://smartlogic.com/term#188519164724691362719453> ;
        skos:definition   "Our mission is 1) To be a forum where the tax administration and policy issues most relevant to Pacific Island countries can be discussed and where experiences can be shared. 2) Promote closer cooperation and coordination of information sharing in tax administration and policy formulation in pacific countries. 3) Help promote international standards and best tax administration practices, suitable to the characteristics of the Pacific Island countries. 4) Encourage taxation institutions to design and adopt strategies to modernize and enhance their effectiveness and efficiency. 5) Enhance administrative skills and encourage the development of high professional standards by facilitating training and the dissemination of resource materials."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PacificIslandsTaxAdministratorsAssociation/PacificIslandsTaxAdministratorsAssociation_en> .

