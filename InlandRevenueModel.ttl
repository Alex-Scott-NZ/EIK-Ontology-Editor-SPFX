        skosxl:literalForm     "International trade"@en .

<http://example.com/InlandRevenueModel#InternationalTransparency>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><a href=\"https://irnz.sharepoint.com/sites/CORP-international-revenue-strategy/SitePages/Exchange-of-Information-Competent-Authority.aspx?web=1\"><u><font color=\"#0066cc\">International Transparency (sharepoint.com)</font></u></a><br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Exchange of Information programme of work ensures that New Zealand meets OECD standards and remains at the forefront of global initiatives on transparency, the effective exchange of information and international collection assistance. The Competent Authority office is a small team which is accountable for a range of functions that span the organisation."@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#OECDReporting> ;
