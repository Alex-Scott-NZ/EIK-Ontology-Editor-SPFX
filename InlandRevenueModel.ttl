<http://example.com/InlandRevenueModel#GSTOnRemoteServices>
        rdf:type            <http://example.com/InlandRevenueModel#IRProduct1> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#GSTOnRemoteServices/GORS_en> , <http://example.com/InlandRevenueModel#GSTOnRemoteServices/GoRS_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/kc-goods-and-services-tax/SitePages/gst-on-remote-services.aspx?web=1\">GST on remote services</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Non-resident businesses supplying remote services and intangibles (including services such as online gaming, gambling, video streaming and music streaming services) to customers resident in NZ must register for GST if they meet all of these criteria: They have supplied services of $60,000 (NZD) or more to NZ resident customers in the last 12 months, or expect to supply services of $60,000 (NZD) or more to NZ resident customers in the next 12 months, They provide remote services to consumers in New Zealand. They supply a qualifying remote service."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#GSTOnRemoteServices/GSTCBSI_en> , <http://example.com/InlandRevenueModel#GSTOnRemoteServices/GSTOnCrossBorderServices-Intangibles_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Portfolio Finance content"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#GSTOnRemoteServices/GST-Cross-borderServices-Integrity_en> ;
        sem:guid            "160d0f91-3156-464a-a4df-32a39fcc911d" ;
        skos:broader        <http://smartlogic.com/term#89590199481890290360157> ;
