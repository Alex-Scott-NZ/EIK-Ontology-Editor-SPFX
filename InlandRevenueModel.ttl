        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Key Internal Governance Groups (2017)</p><div><p>https://irnz.sharepoint.com/sites/debt-and-returns/SitePages/What-we-do.aspx<br/></p></div>"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "This group has an active interest in developing strategies and skills for addressing debt practices that may be adopted by taxpayers and insolvency practitioners. The ongoing development of skills and knowledge enables LTS to assist IR staff and to adapt to ever-changing practices. May have been superseded by the (2021) Debt and Returns Network, which is part of the Area of Focus group network. This is made up of leaders and subject matter experts from across IR and is Chaired by Community Compliance."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel-current-#DebtSpecialInterestGroup/DebtAndReturnsNetwork_en> ;
