<http://example.com/Cleaned-Inland-Revenue-model#System>
        rdf:type          <http://example.com/IRD-test-model#System> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IRD Service Now glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A number of related things that work together to achieve an overall objective. For example: </p><div><p>- a computer system including hardware, software and applications; </p></div><div><p>- A management system, including the framework of policy, processes, functions, standards, guidelines and tools that are planned and managed together, eg a quality management system; </p></div><div><p>- A database management system or operating system that includes many software modules which are designed to perform a set of related functions.</p></div>"@en ;
        sem:guid          "b58eb59f-321d-4be5-9473-cf531b406447" ;
        skos:broader      <http://example.com/IRD-test-model#Object> ;
