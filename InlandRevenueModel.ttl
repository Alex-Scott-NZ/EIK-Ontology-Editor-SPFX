<http://example.com/InlandRevenueModel#DataAndInformationProduct>
        rdf:type          <http://example.com/InlandRevenueModel-current-#Product> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/Cleaned-Inland-Revenue-model#Data-governance> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Data and Information Governance group"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Data and Information Products are products (definition: items produced by explicit process for a specific audience, for a specific purpose, and with specific value) which significantly include data or information resources. They are governed and managed throughout their lifecycle to ensure they meet business requirements and deliver tangible business value. They can be developed, procured, adopted, used, evolved, maintained, supported, replaced, decommissioned, archived, and destroyed."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#DataAndInformationProduct/DataProduct_en> , <http://example.com/InlandRevenueModel#DataAndInformationProduct/InformationProduct_en> , <http://example.com/InlandRevenueModel#DataAndInformationProduct/KnowledgeProduct_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Data and Information Governance"@en ;
        sem:guid          "35b4e869-d179-4d54-82fe-15c537b984b2" ;
