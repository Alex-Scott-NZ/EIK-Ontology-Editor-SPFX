<http://example.com/InlandRevenueModel#IRHasAClearlyDefinedLeadershipModelWhichDescribesNetworked-DevolvedAndEnabledWayLeadershipRoles>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR's Leadership Model, July 2020"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Leaders work in a variety of groups and networks, across and outside of IR, across and traversing levels or business groups. Senior leaders operate as a cohesive cohort which collectively ensures clear strategic direction and decision making, effective performance and mitigation of risks, and drives for innovation. Our model encompasses Senior Leaders, Leaders of leaders, leaders of people, and thought leaders/non-people leaders."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><br/>http://intranet.ird.govt.nz//infoweb/sites/default/files/20200928-Recap%20-%20some%20key%20design%20features.JPG<br/></p>"@en ;
        sem:guid          "2ce7dd27-721f-48f6-b47a-1687af5dbbdb" ;
        skos:broader      <http://example.com/InlandRevenueModel#FOMPrinciple2020> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IRHasAClearlyDefinedLeadershipModelWhichDescribesNetworked-DevolvedAndEnabledWayLeadershipRoles/IRHasAClearlyDefinedLeadershipModelWhichDescribesNetworked-DevolvedAndEnabledWayLeadershipRoles_en> .

<http://example.com/InlandRevenueModel#IRHasAClearlyDefinedLeadershipModelWhichDescribesNetworked-DevolvedAndEnabledWayLeadershipRoles/IRHasAClearlyDefinedLeadershipModelWhichDescribesNetworked-DevolvedAndEnabledWayLeadershipRoles_en>
        rdf:type               skosxl:Label ;
        sem:autocompletion     sem:AutocompletionOff ;
        sem:conceptMapping     sem:ConceptMappingOff ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "IR has a clearly defined leadership model which describes networked, devolved and enabled way leadership roles"@en .

<http://example.com/InlandRevenueModel#IRInternal>
        rdf:type          <http://example.com/InlandRevenueModel#MetadataValue> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Data Domains and Sub-Domains, v2.5 2021"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IR Data Domains and Sub-Domains, 2020"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Categorise a table as being in one of the IR Activities subdomains if the data contains information about tasks, cases or any “work” performed by IR staff.​"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">IR Data Domains and Sub-domains, 2020</span><br/></p>"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#IRInternal/IRInternal_en0> ;
        sem:guid          "370c7ba6-53ef-431e-bba0-b0fa551466dd" ;
        skos:broader      <http://example.com/InlandRevenueModel#DataDomainCategory> ;
        skos:definition   "Details about IR staff and internal processes carrying out work and the costs associated with IR activities. Will provide a customer view of costs.​"@en ;
        skos:historyNote  "<p>In the previous version this was known as IR Internal. The sub-domains are now different also.</p><div><p>Updated in December 2021 from version 2.5<br/></p></div>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IRInternal/IRInternal_en> .

