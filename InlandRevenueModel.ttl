<http://example.com/InlandRevenueModel-current-#SelectCommittee>
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>NZ Parliament website&nbsp;<a href=\"https://www.parliament.nz/en/pb/sc/select-committee-faqs/#whatarecommittees\" class=\"on\">Select committee FAQs - New Zealand Parliament (www.parliament.nz)</a>​</p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "In New Zealand, Cabinet committees and select committees are distinct bodies with different roles and functions. Cabinet committees are part of the executive branch, advising and making decisions on government policy and legislation. Select committees, on the other hand, are part of the legislative branch, scrutinizing government actions, considering legislation, and conducting inquiries. "@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#ParliamentaryCommitteeWork> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel-current-#SelectCommittee/ParliamentarySelectCommittee_en> ;
        <http://example.com/NZ-IRD#Offers-product-service>
                <http://example.com/InlandRevenueModel#SelectCommitteeReport> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "GES content; PAS content"@en ;
        sem:guid          "4611543a-48f0-4192-8778-2ae20a2fd5a8" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#Committee> ;
        skos:definition   "<p>New Zealand's select committee system enables members of Parliament to examine issues in more detail than is possible in the House of Representatives.​<span style=\"color: rgb(0, 0, 0);font-size: 14px\">Select committees are made up of members of Parliament (MPs) from several political parties. There are between 5–12 MPs on each committee. Committee members work together to consider topics that Parliament’s House of Representatives needs more information on and recommendations about (e.g. proposed laws and Government spending, petitions, and international treaties). Committees can also initiate inquiries and briefings to investigate important issues and topics.</span>​<br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel-current-#CabinetCommittee> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#SelectCommittee/SelectCommittee_en> .

<http://example.com/InlandRevenueModel-current-#SelectCommittee/ParliamentarySelectCommittee_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Parliamentary select committee"@en .

<http://example.com/InlandRevenueModel-current-#SelectCommittee/SelectCommittee_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Select committee"@en .

