<http://example.com/InlandRevenueModel-current-#CertificateOfExemption>
        rdf:type          <http://example.com/InlandRevenueModel-current-#Certificate> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel-current-#CertificateOfExemption/CoE_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel-current-#CertificateOfExemption/CentreOfExpertise_en> , <http://example.com/InlandRevenueModel-current-#CertificateOfExemption/CommonOperatingEnvironment_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Certificate of exemption for income tax on schedular payments (formerly withholding payments). This type of certificate is available to self-employed people (usually contractors) who earn schedular payments. Normally tax must be deducted from these payments at the rates set out on the back of the IR330C \"Tax rate notification for contractors\", but the taxpayer can apply for a certificate of exemption so the withholding tax isn't deducted. Contractors from overseas - If a taxpayer is in NZ temporarily from overseas and is earning schedular payments, they may qualify for a certificate of exemption. Refer to Schedular payments."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "96e62b66-84a8-46a4-8968-3ebbf19fb60d" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#CertificateOrQualification> ;
        skos:related      <http://smartlogic.com/term#547761871254757204639149044657826> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#CertificateOfExemption/CertificateOfExemption_en> .

