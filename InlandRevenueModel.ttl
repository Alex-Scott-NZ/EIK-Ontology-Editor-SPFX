<http://example.com/InlandRevenueModel#Cryptoasset>
        rdf:type          <http://example.com/IRD-test-model#Object-classification> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#Cryptoasset/NgaRawaWhiti-rangi_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsTypeOf>
                <http://example.com/Cleaned-Inland-Revenue-model#Cryptocurrency> , <http://example.com/InlandRevenueModel#Non-FungibleToken> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2022-06-28"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><a href=\"https://www.ird.govt.nz/cryptoassets/what-cryptoassets-are\">https://www.ird.govt.nz/cryptoassets/what-cryptoassets-are</a> <br/></p>"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>Investopedia. <a href=\"https://www.investopedia.com/tech/why-crypto-asset-management-next-big-thing/\">https://www.investopedia.com/tech/why-crypto-asset-management-next-big-thing/</a> <br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Cryptoassets are cryptographically secured digital representations of value that can be transferred, stored or traded electronically. They use some form of distributed ledger technology such as blockchain. Cryptoassets is the term we use. They are also known as: cryptographic assets, digital financial assets, digital tokens, virtual currencies. A wide range of cryptoassets exist, including payment tokens, security tokens, utility tokens."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#Cryptoasset/CryptographicAsset_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website. Māori term from Te Taura Whiri Māori Language Commission"@en ;
        sem:guid          "a07d1b72-26ec-49b8-a16f-6bf277bcddb0" ;
        skos:broader      <http://example.com/IRD-test-model#Asset> ;
        skos:definition   "A crypto asset is a cryptocurrency or asset that has been tokenized, which is the transfer of an object's value to a blockchain. The tokens can be fractionalized for broader distribution of ownership, much like dividing ownership of an asset into shares—but these shares are digital. They include both interchangeable assets (such as cryptocurrencies) and assets that are not interchangeable (such as NFTs)."@en ;
        skos:related      <http://example.com/InlandRevenueModel#Crypto-assetReportingFramework> , <http://example.com/InlandRevenueModel-current-#Blockchain> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Cryptoasset/Cryptoasset_en> .

<http://example.com/InlandRevenueModel#Cryptoasset/Cryptoasset_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Cryptoasset"@en .

<http://example.com/InlandRevenueModel#Cryptoasset/CryptographicAsset_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Cryptographic asset"@en .

