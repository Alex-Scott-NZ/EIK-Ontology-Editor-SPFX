        skos:broader      <http://example.com/InlandRevenueModel#Ex-spouseOrPartner> ;
        skos:definition   "<p>An eligible spouse or partner is the person who is entitled to receive domestic maintenance payments from a former spouse or partner after a relationship has ended.<br>The entitlement comes from a Family Court order or a voluntary domestic maintenance agreement and is&nbsp;intended to provide financial support for the person, not for children.</p><p><br></p><p>It applies to&nbsp;ex-spouse or partner.&nbsp;The eligible spouse or partner is sometimes also called the recipient of domestic maintenance.<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EligibleSpouseOrPartner/EligibleSpouseOrPartner_en> .

