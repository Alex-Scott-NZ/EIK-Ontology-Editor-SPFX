<http://example.com/InlandRevenueModel#Manaakitanga0>
        rdf:type          <http://smartlogic.com/class#Topic> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span style=\"color: black;\">Email from Peter Mersi to all IR 28-11-2022.</span></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>At IR we seek to lift the mana of others. We're generous with our knowledge and how we support people. We see true value in diversity. We care for those around us.<br/><br/></p><p><span style=\"color: black;\">One of three outcomes of Te Pou o te<br/>Tangata - How we do things at IR. </span><span>Whanaungatanga, Manaakitanga, and Mahi Tika.<br/>Communicated to IR by Peter Mersi, Commissioner of Inland Revenue<br/>28-11-2022.</span></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><span style=\"color: black;\">Email from Peter Mersi 28-11-2022.</span></p>"@en ;
        sem:guid          "5d18b4a9-a9ec-4b8f-838b-0976fa23dfce" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRCulturalValue> ;
        skos:related      <http://example.com/InlandRevenueModel#HowWeWorkAtIR> , <http://example.com/InlandRevenueModel#MahiTika> , <http://example.com/InlandRevenueModel#Manaakitanga> , <http://example.com/InlandRevenueModel#Whanaukitanga> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Manaakitanga0/Manaakitanga_en> .

