                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR website"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);float: none;\">A</span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);float: none;\"><span class=\"Apple-converted-space\"> </span></span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);\">dividend</span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);float: none;\"><span class=\"Apple-converted-space\"> </span>where the<span class=\"Apple-converted-space\"> </span></span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);\">foreign</span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);float: none;\"><span class=\"Apple-converted-space\"> </span>company paying the<span class=\"Apple-converted-space\"> </span></span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);\">dividend</span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);float: none;\"><span class=\"Apple-converted-space\"> </span>(or a company in the same group or further up the chain as the </span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);\">foreign</span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);float: none;\"><span class=\"Apple-converted-space\"> </span>company) is allowed a<span class=\"Apple-converted-space\"> </span></span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);\">deduction</span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);float: none;\"><span class=\"Apple-converted-space\"> </span>for the payment of the<span class=\"Apple-converted-space\"> </span></span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);\">dividend</span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);float: none;\"><span class=\"Apple-converted-space\"> </span>against </span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);\">foreign</span><span style=\"color: rgb(34, 34, 34);text-align: left;background-color: rgb(255, 255, 255);float: none;\"><span class=\"Apple-converted-space\"> </span>income tax.</span><!--EndFragment--><br/><br/><br/></p>"@en , "IR website; International revenue Strategy content"@en ;
        sem:guid          "b3226656-bf43-402e-91b1-ead82db5fcc9" ;
        skos:broader      <http://smartlogic.com/term#134667386383500393103361> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DeductibleForeignEquityDistribution/DeductibleForeignEquityDistribution_en> .

