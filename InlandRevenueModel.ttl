<http://example.com/InlandRevenueModel#TechnologyDeliveryReviewBoard>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#TechnologyDeliveryReviewBoard/TDRB_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Intranet"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The role of the Technology Delivery Review Board (TDRB) is to: Provide a quality check that projects are set up for success; Review projects’ progress against agreed technology delivery milestone dates and completed deliverables in accordance with the agreed technology delivery approach (e.g. SDLC, Infrastructure Programme CIL); Provide guidance to projects that are escalating through the TDRB; Escalate project’s risks and issues to SROs (Senior Responsible Officers) and other governance boards as required; Provide feedback to technology projects and TPMO to ensure continual process improvement. The TDRB is not responsible for: endorsing business cases to initiate the project lifecycle; Project Governance; or Govern Change & Release activities (CRB, ECRB etc)."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet"@en ;
        sem:guid          "027266db-65dd-4888-8236-b2241c002b33" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skos:historyNote  "No longer in existence. Pre-Business Transformation"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TechnologyDeliveryReviewBoard/TechnologyDeliveryReviewBoard_en> .

