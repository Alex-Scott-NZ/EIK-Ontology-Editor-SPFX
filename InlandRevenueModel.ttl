<http://example.com/InlandRevenueModel#ChiefDataOfficer>
        rdf:type            <http://example.com/IRD-test-model#Job-title0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>Role Description RD2046<br><br></p>"@en ;
        sem:guid            "d6fd9a20-5222-4924-87ae-08cf10289278" ;
        skos:broader        <http://example.com/InlandRevenueModel#_PreviousJobTitles-> ;
        skos:definition     "<p>Chief Data Officer is one of a number of specific portfolios assigned to Enterprise Leaders across IR.<br><br>As Chief Data Officer, accountable for the effectiveness, health and stewardship of IR’s primary data assets and analytics and insights capabilities. <br>• Ensure the integrated provision of analysis and insights that support decision making to drive improved compliance and customer outcomes in a constantly evolving world. <br>• Ensure the fit-for-purpose delivery of IR’s primary data and analytics products, services and inputs via an integrated service model in service of customers throughout IR. <br>• Ensure that our data, analytics and insights investment is linked to organisational priorities and that enduring value is derived from our data assets. <br>• Provide advice on actions and strategies to ensure the ongoing optimisation of IR’s data, analytics and insights services in a digital world, managing risks and pursuing opportunities. <br></p>"@en ;
        skos:editorialNote  "Not on latest list of IR Units and roles October 2025"@en ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#ChiefDataOfficer/ChiefDataOfficer_en> .

