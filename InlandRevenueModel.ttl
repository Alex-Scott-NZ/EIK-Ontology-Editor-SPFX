<http://example.com/InlandRevenueModel#ChiefInformationSecurityOfficer>
        rdf:type          <http://example.com/IRD-test-model#Job-title0> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ChiefInformationSecurityOfficer/CISO_en> ;
        <http://example.com/IRD-test-model#Manages>
                <http://example.com/InlandRevenueModel#InformationSecurityOffice> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#CyberSecurityManagement> , <http://example.com/InlandRevenueModel#ICTSecurityPolicy> , <http://example.com/InlandRevenueModel-current-#InformationSecurityManagement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Viva Topics"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Chief Information Security Office. Responsible for developing and implementing IR’s information security programme, which includes procedures and policies designed to protect enterprise communications, systems and assets from both internal and external threats. Other responsibilities include responding to data breaches and other security incidents as well as anticipating, assessing and actively managing new and emerging threats. The CISO works with other parts of the organisation to align security initiatives with broader business objectives and to mitigate the risk various security threats pose to the organisation’s mission and goals."@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel-current-#InformationSecurityManagement> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IT&C content"@en ;
        sem:guid          "105ee510-dead-40b0-b9c1-0ed11e8c8158" ;
        skos:broader      <http://example.com/IRD-test-model#Job-title> , <http://example.com/InlandRevenueModel#EnterpriseLeader> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ChiefInformationSecurityOfficer/ChiefInformationSecurityOfficer_en> .

