                <http://smartlogic.com/term#46576892232815290578744> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IKM-compiled definition taken from a number of Stax sources."@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>This group was established in 2014 to support the Child Support Reform Programme and the 2014 Budget bid initiative.<br/><br/>This group meets weekly to: work collectively to plan and utilise child support capacity nationally, rather than by business unit or site; co-ordinate operational and project activities; make timely decisions on operational issues through discussion and consensus; and ensure issues are escalated to the Service Delivery Leadership Team. It is no longer in existence.<br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS content"@en ;
        sem:guid          "6b3a93b7-4f20-486c-bbc0-6a5e6b475756" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skos:scopeNote    "Disbanded in early 2016"@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#ChildSupportProgammeManagementGroup/ChildSupportProgammeManagementGroup_en0> ;
