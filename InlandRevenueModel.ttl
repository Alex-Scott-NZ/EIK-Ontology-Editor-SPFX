        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> , <http://example.com/InlandRevenueModel#NotCurrent> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#IncomeTax-AdverseEvenetIncomeEqualisationSchemeRateOfInterest-Regulations1995> , <http://example.com/InlandRevenueModel#Taxation-AnnualRatesFor2018-19-ModernisingTaxAdministration-AndRemedialMatters-Act2019> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#AdverseEventIncomeEqualisationScheme/AEIES_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#AdverseEvent> ;
