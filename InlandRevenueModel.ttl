<http://example.com/InlandRevenueModel#BusinessCommittee>
        rdf:type            <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/IRD-test-model#Manages>
                <http://example.com/Cleaned-Inland-Revenue-model#Parliament> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2025-08-08"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://www.parliament.nz/en/pb/sc/scl/business/"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>This is a specialist Committee.<br>This committee plays an important part in how Parliament and select committees are run. Each year it recommends when Parliament meets and when matters are debated (the order of business). It decides who the members of select committees are. The Business Committee also determines if Parliament meets for extended periods of time (extended settings).</p>"@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#OperationsManagement> , <http://example.com/InlandRevenueModel#ParliamentaryCommitteeWork> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Parliament website"@en ;
        sem:guid            "bcff285a-a9ba-4abf-aaaa-d5c72d41d184" ;
        skos:broader        <http://example.com/InlandRevenueModel-current-#SelectCommittee> ;
        skos:editorialNote  "<p>August 2025 - Review of all Select Committees against those listed on parliamentary website&nbsp;<br>​<a href=\"https://www.parliament.nz/en/pb/sc/scl/\" target=\"_blank\" rel=\"noreferrer noopener\"><span style=\"color: transparent;color: rgb(5, 99, 193);font-size: 15px\">https://www.parliament.nz/en/pb/sc/scl/</span></a><span style=\"color: transparent;color: rgb(0, 0, 0);font-size: 15px\">&nbsp;<br></span>To be reviewed on a 3 yearly cycle. Next review March 2027.<br></p>"@en ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#BusinessCommittee/BusinessSelectCommittee_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#BusinessCommittee/BusinessCommittee_en> .

