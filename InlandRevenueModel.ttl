        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Intranet<br/></p><p><span style=\"color: red;\"><a href=\"https://irnz.sharepoint.com/sites/CORP-intelligence-and-insight/SitePages/Intelligence.aspx\">https://irnz.sharepoint.com/sites/CORP-intelligence-and-insight/SitePages/Intelligence.aspx</a></span></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p><!--StartFragment--><span style=\"color: rgb(36, 36, 36);text-align: left;background-color: rgb(240, 240, 240);float: none;\">The Intelligence team turns information into intelligence that shows the most important details and best course of action for any issue, risk or opportunity. We do this by using the intelligence cycle (collect, collate, analyse, disseminate) to create Strategic, Operational or Tactical intelligence.</span><!--EndFragment--><br/></p>"@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#Anti-moneyLaunderingWork> , <http://example.com/InlandRevenueModel#CounteringTheFinanceOfTerrorism> , <http://example.com/InlandRevenueModel#IntelligenceGathering> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/Cleaned-Inland-Revenue-model#IntelligenceHub/HumanIntelligenceTeam_en> , <http://example.com/Cleaned-Inland-Revenue-model#IntelligenceHub/IntelligenceHub_en0> ;
        sem:guid          "4a371591-458d-4f34-864e-85fe23140ae0" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#InisghtAndIntelligenceAdvice> ;
        skos:historyNote  "Third level IR Business Unit from 8-12-2022, sits under Intelligence & Insight, under Enterprise Design & Integrity."@en ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#IntelligenceHub/IntelligenceHub_en> .

