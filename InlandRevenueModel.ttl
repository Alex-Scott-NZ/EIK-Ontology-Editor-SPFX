<http://example.com/InlandRevenueModel#Earnings-relatedCompensation>
        rdf:type          <http://smartlogic.com/class#Entitlement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsAppliedTo>
                <http://example.com/InlandRevenueModel-current-#Family> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling"@en ;
        sem:guid          "59a01b46-9b5d-46fb-8703-632f4002c931" ;
        skos:broader      <http://example.com/InlandRevenueModel#InsurancePayments> ;
        skos:definition   "<p>Earnings‑related compensation is a form of financial compensation paid by ACC to a person who suffers a covered personal injury and is unable to work or has a reduced capacity to earn income as a result of that injury.&nbsp;It is intended to replace a portion of the person’s pre‑injury earnings and is authorised under the Accident Compensation Act 2001.</p><p><br></p><p>Weekly compensation means compensation for loss of earnings, or loss of potential earning capacity, and compensation for the spouse or partner, child, or other dependant of a deceased claimant, that is payable by the Corporation—&nbsp;(a)&nbsp;under any of clauses 32, 47, 66, 70, and 71 of Schedule 1; or&nbsp;(b)&nbsp;under sections 131, 210, 224, Part 10, or Part 11.<br></p>"@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#Earnings-relatedCompensation/ACCEarningsE28091relatedCompensation_en> , <http://example.com/InlandRevenueModel#Earnings-relatedCompensation/ACCWeeklyCompensation_en> , <http://example.com/InlandRevenueModel#Earnings-relatedCompensation/IncomeReplacementFromACC_en> , <http://example.com/InlandRevenueModel#Earnings-relatedCompensation/WeeklyCompensation-ACC_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Earnings-relatedCompensation/Earnings-relatedCompensation_en> .

