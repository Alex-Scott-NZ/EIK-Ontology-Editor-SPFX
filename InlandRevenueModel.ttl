        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "P&C content - People Leaders Space."@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "​Keeping-in-touch (KIT) hours are the allowed number of hours a customer may work while receiving paid parental leave (PPL). There are restrictions around the number of hours that may be worked and when the customer can work.For more information refer to Paid parental leave (PPL) entitlement andPaid parental leave (PPL) overview."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "People Leaders Space content"@en ;
        sem:guid          "53c97992-965d-4f8a-a7f8-0b7a3f504054" ;
        skos:broader      <http://example.com/NZ-IRD#Leave> ;
        skos:definition   "If an employee is on parental leave they are able to attend work by mutual agreement for a maximum of 40 hours. This work is categorised as keeping in touch days."@en ;
        skos:related      <http://example.com/InlandRevenueModel-current-#ParentalLeave> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#KeepingInTouchDays/KeepingInTouchDays_en> .

