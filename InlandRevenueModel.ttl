<http://example.com/InlandRevenueModel#ProofOfTechnology>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsEventObjectOfActivity>
                <http://example.com/InlandRevenueModel-current-#ICTSolutionsManagement> ;
