<http://example.com/InlandRevenueModel#OffshoreBranch>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-08"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "PAS content"@en ;
        sem:guid          "2c62ffe7-d456-40d4-8122-baf1be028492" ;
        skos:broader      <http://example.com/InlandRevenueModel#Branch> ;
        skos:definition   "<p>Offshore branch describes the location of activity, not a customer or product type. New Zealand tax obligations depend on the existence of New Zealand‑sourced income or a sufficient New Zealand presence, not on offshore branch activity alone.</p><p><br></p><p>A New Zealand tax‑resident entity is taxable in New Zealand on its worldwide income, including income derived through offshore branches, unless specific relief applies.<br></p><p>A non‑resident entity is taxable in New Zealand only on New Zealand‑sourced income or income attributable to a New Zealand permanent establishment or branch.<br>Activities conducted exclusively through an offshore branch outside New Zealand do not, by themselves, create New Zealand tax obligations.<br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#OnshoreBranch> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#OffshoreBranch/OffshoreBranch_en> .

<http://example.com/InlandRevenueModel#OffshoreBranch/OffshoreBranch_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Offshore branch"@en .

