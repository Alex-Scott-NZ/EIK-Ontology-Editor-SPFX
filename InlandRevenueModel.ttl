        skos:broader      <http://example.com/InlandRevenueModel#GovernmentPolicy> ;
        skos:definition   "The New Zealand Government Locator Service (NZGLS) standard was a metadata standard that served as the foundation for the all-of-government web portal, enabling consistent presentation of information and services from a single access point across government departments. While it is not the current or overarching standard, the principle of improving access and consistency through structured information management continues today through more modern frameworks like the NZ Digital government standards. "@en ;
        skos:historyNote  "<p>No longer in existence. Replaced by the digital government standards (none of which are metadata standards).<br><br></p>"@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Search> , <http://example.com/NZ-IRD#Information-retrieval> , <http://smartlogic.com/term#11763582808079457660098> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#NewZealandGovernmentLocatorService/NZGLSMetadataElementSet_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#NewZealandGovernmentLocatorService/NewZealandGovernmentLocatorService_en> .

