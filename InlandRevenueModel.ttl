<http://example.com/InlandRevenueModel#CapitalProhibition>
        rdf:type          <http://smartlogic.com/class#Obligation> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "DA 2 General limitations Capital limitation (1) A person is denied a deduction for an amount of expenditure or loss to the extent to which it is of a capital nature. This rule is called the capital limitation. "@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Income Tax Act"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Tax Technical Website project"@en ;
        sem:guid          "49dc5755-362a-4b4b-bb48-32ab89b483a2" ;
        skos:broader      <http://example.com/InlandRevenueModel#IncomeTaxes> ;
        skos:historyNote  "Capital prohibition doesn't appear in the ontology. Capital expenditure is the same thing as Capital limitation but it has been renamed.Capital prohibition is the term that will be increasingly used. Grant Haley - SME, Tax Technical Website Project."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#CapitalExpenditure> , <http://smartlogic.com/term#163038605988186491998905> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#CapitalProhibition/CapitalLimitation_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CapitalProhibition/CapitalProhibition_en> .

