<http://example.com/InlandRevenueModel#GovernmentDigitalDeliveryAgency>
        rdf:type          <http://smartlogic.com/class#Commercial-organisation> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#GovernmentDigitalDeliveryAgency/GDDA_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsMemberOf>
                <http://example.com/InlandRevenueModel-current-#StateServicesCommission> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-05-27"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://www.digital.govt.nz/digital-government/leadership/government-digital-delivery-agency?source=rss\">Government Digital Delivery Agency | NZ Digital government</a>​<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Technology Architecture Community of Practice"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#GovernmentDigitalDeliveryAgency/GovernmentChiefDigitalOffice-GCDO-_en> ;
        sem:guid          "145ca3ee-3d16-49d3-b874-db2044ac3edf" ;
        skos:broader      <http://smartlogic.com/term#188519164724691362719453> ;
        skos:definition   "<p>The Government Digital Delivery Agency (GDDA) is part of the Public Service Commission (PSC) and takes on the functions of the Government Chief Digital Office (GCDO).&nbsp;The GDDA brings together system leadership, delivery support and capability functions to support digital public services across government.</p><p><br></p><p>Digital government is about putting people first. We’re focusing on what people need from government in these fast-changing times and how we can meet their needs using emerging technologies, data and changes to government culture, practices and processes.</p>"@en ;
        skos:historyNote  "On 1 April 2026, the Government Digital Delivery Agency was established."@en ;
        skos:related      <http://smartlogic.com/term#55080071129680651362701> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#GovernmentDigitalDeliveryAgency/GovernmentDigitalDeliveryAgency_en> .

