                <http://example.com/InlandRevenueModel#NewZealandProductivityCommission/NZPC_en> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#ForecastStatementOfComprehensiveRevenue> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel#UsesSystem>
                <http://example.com/InlandRevenueModel#OneIdentityManager> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#NewZealandProductivityCommission/ImprovingStateSectorProductivity_en> , <http://example.com/InlandRevenueModel#NewZealandProductivityCommission/TeKomihanaWhaiHuaOAotearoa_en0> ;
        <http://example.com/NZ-IRD#Offers-product-service>
                <http://example.com/InlandRevenueModel#ProductivityHubConference> , <http://example.com/InlandRevenueModel#StatementOfPerformanceExpectations> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate Finance content"@en ;
        sem:guid          "fd4d8d08-7bde-4c6f-be32-33a9ca2f98dd" ;
        skos:broader      <http://smartlogic.com/term#188519164724691362719453> ;
        skos:definition   "The New Zealand Productivity Commission was an independent Crown entity from 2011 to 2024 that provided advice to the government on improving national productivity and well-being through in-depth inquiries, research, and public engagement. It was disestablished by the New Zealand Productivity Commission Act Repeal Act 2024. The Commission undertook inquiries into complex economic and social issues, such as low-emissions economies and persistent disadvantage, and published its research and reports on the Treasury New Zealand website. "@en ;
        skos:historyNote  "<p>Disestablished in 2024.<br><br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#NewZealandProductivityCommission/NewZealandProductivityCommission_en> .

