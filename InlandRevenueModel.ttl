<http://example.com/InlandRevenueModel#High-wealthIndividualsResearchProject>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/Cleaned-Inland-Revenue-model#HighWealthIndividual> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://smartlogic.com/term#65676355394865533899241> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><font face=\"Calibri\" size=\"3\"><a href=\"https://www.ird.govt.nz/about-us/who-we-are/organisation-structure/significant-enterprises/hwi-research-project\">https://www.ird.govt.nz/about-us/who-we-are/organisation-structure/significant-enterprises/hwi-research-project</a></font></p><p><font face=\"Times New Roman\" size=\"3\"><br/><br/></font></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The high-wealth individuals research project was a statistical research project run by Inland Revenue 2021-2022. The project sought to fill a gap in IR knowledge of effective tax rates in relation to economic measures of income, particularly for high-wealth individuals. The project did not make policy recommendations, but may feed into future policy advice. 406 high-wealth tax resident individuals were asked to complete a questionnaire based on the family unit - including partners and dependent children. Findings to be made public by June 2023."@en ;
        sem:guid          "14b738a8-c529-4a2c-9b17-2d020e193a5b" ;
        skos:broader      <http://example.com/IRD-test-model#Programe-or-project> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#High-wealthIndividualsResearchProject/ProjectRAWA_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#High-wealthIndividualsResearchProject/High-wealthIndividualsResearchProject_en> .

<http://example.com/InlandRevenueModel#High-wealthIndividualsResearchProject/High-wealthIndividualsResearchProject_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "High-wealth individuals research project"@en .

