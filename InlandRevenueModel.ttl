<http://example.com/Cleaned-Inland-Revenue-model#TypesOfPerson>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#PersonType> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/NZ-IRD#Source-of-term>
                "OCTC"@en ;
        sem:guid          "3f26e655-7e46-4b56-9c74-2383dab48913" ;
        skos:broader      <http://example.com/IRD-test-model#People> ;
        skos:definition   "<p>A party role describes the part a party is playing in a particular situation.&nbsp;</p><p>The same party can have multiple roles, either at the same time or over time (for example, someone can be both a taxpayer and a tax agent).&nbsp;</p><p>Key characteristics of a party role:</p><p><br></p><p>* It      is context‑dependent</p><p><br></p><p>* It      is linked to obligations and entitlements</p><p><br></p><p>*It      explains <em>why</em> IR is interacting with the party</p><p><br></p><p>*Many      parties can share the same role (for example, many taxpayers).<br></p><p><br></p>"@en ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#TypesOfPerson/TypesOfPerson_en> .

