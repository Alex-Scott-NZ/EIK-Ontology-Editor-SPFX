<http://example.com/InlandRevenueModel#CallManagementSystem>
        rdf:type          <http://smartlogic.com/class#System-type> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#CallManagementSystem/CMS_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Glossary of Call Center Terms"@en ;
        sem:guid          "70e56159-4b56-489b-88fb-cf7298e64450" ;
        skos:broader      <http://smartlogic.com/term#158605830624998366163712> ;
        skos:definition   "A Call Management System (CMS) uses software to streamline and automate phone communication, featuring core tools like call routing to direct calls to the right agent, Interactive Voice Response (IVR) for self-service and navigation, and call recording for quality and training. Key features also include call queues for busy periods, analytics and reporting to track performance, Customer Relationship Management (CRM) integration for personalized service, and call tracking to monitor marketing effectiveness. Advanced functionalities can involve auto-dialers for outbound campaigns, call monitoring for real-time oversight, and softphones for internet-based communication. "@en ;
        skos:related      <http://example.com/InlandRevenueModel#CallCentre> , <http://example.com/InlandRevenueModel#TelephoneCall> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CallManagementSystem/CallManagementSystem_en> .

