<http://example.com/InlandRevenueModel-current-#RelationshipProperty>
        rdf:type          <http://example.com/IRD-test-model#Object-classification> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel-current-#Property-Relationships-Act1976> , <http://example.com/InlandRevenueModel-current-#Property-Relationships-AmendmentAct2001> , <http://example.com/InlandRevenueModel-current-#RelationshipPropertyAgreement> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel#RelationshipPropertyDispositions> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#NoticeOfClaim> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ThingsAndHowWeManageThem> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "https://communitylaw.org.nz/community-law-manual/chapter-12-relationships-and-break-ups/dividing-your-property-when-you-split-up-relationship-property/classifying-and-valuing-relationship-property/"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Previously called matrimonial property. The property of two people who are to be treated as being in a relationship for the purpose of the Property (Relationships) Act 1976, and in which both have a right to share."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "457f8c74-3fd2-4558-b97c-d23db83f3bb9" ;
        skos:broader      <http://example.com/IRD-test-model#Property> ;
        skos:definition   "Relationship property is the property that must be divided between the parties when their relationship ends. Relationship property will usually include: family home and chattels (including the family car, household furniture and effects, and anything else owned by the family or used for family purposes)."@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel-current-#RelationshipProperty/MatrimonialProperty_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#RelationshipProperty/RelationshipProperty_en> .

