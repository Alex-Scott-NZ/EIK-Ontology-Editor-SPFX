                <http://example.com/InlandRevenueModel#DigitalAudit> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ComputerAssistedAuditTechniques/CAATs_en> ;
        sem:guid          "4e886c4a-69db-4393-946e-0eeb6599997d" ;
        skos:broader      <http://smartlogic.com/term#143919668998349297872068> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ComputerAssistedAuditTechniques/ComputerAssistedAuditTechniques_en> .

