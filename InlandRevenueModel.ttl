<http://example.com/Cleaned-Inland-Revenue-model#TransferrableDevelopmentRights>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#Rights0> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/Cleaned-Inland-Revenue-model#TransferrableDevelopmentRights/TDR_en> ;
