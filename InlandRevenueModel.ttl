<http://example.com/InlandRevenueModel#Disbursement>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/InlandRevenueModel#HasRelatedActivity>
                <http://example.com/InlandRevenueModel#KiwisaverOutboundPayments> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#Activity-AdministeringOurProducts> ;
        <http://example.com/InlandRevenueModel#MakesUseOfService>
                <http://example.com/InlandRevenueModel#FinancialTransactionService> , <http://example.com/InlandRevenueModel#ManageFinancialTransactionService> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Viva Topics"@en ;
        <http://example.com/InlandRevenueModel#usedInME3ValueSet>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A payment from Inland Revenue to a customer, related to their tax or social policy obligations/entitlements. Typically one of these: A refund of an overpayment by the customer (or on their behalf) to Inland Revenue - e.g. an income tax refund; Payment of a customer of their social policy entitlement - e.g. a Working or Families Tax Credits weekly or fortnightly payment."@en ;
