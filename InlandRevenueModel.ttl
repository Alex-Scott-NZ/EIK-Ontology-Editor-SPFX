        skosxl:literalForm  "Customer effort survey"@en .

<http://example.com/InlandRevenueModel#ConstructionIndustry>
        rdf:type          <http://example.com/InlandRevenueModel-current-#Services> ;
        <http://example.com/InlandRevenueModel#HasANZSICCode>
                <http://example.com/Cleaned-Inland-Revenue-model#EConstruction> ;
