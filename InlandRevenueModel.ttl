<http://example.com/InlandRevenueModel#Non-disclosureAgreement>
        rdf:type          <http://smartlogic.com/class#Agreement> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#Non-disclosureAgreement/NDA_en> ;
