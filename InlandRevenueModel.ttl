<http://example.com/InlandRevenueModel#InsurancePayments>
        rdf:type          <http://smartlogic.com/class#Entitlement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsAppliedTo>
                <http://example.com/InlandRevenueModel-current-#Family> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "https://irnz.sharepoint.com/sites/kc-income-tax/SitePages/insurance-for-loss-of-earnings,-income-protection,-sickness-or-accident.aspx?web=1"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling"@en ;
        sem:guid          "87374e80-d4a5-44dc-b769-473cb350f16a" ;
        skos:broader      <http://smartlogic.com/term#31447500289797533078156> ;
        skos:definition   "<p>Insurance payments are amounts paid by an insurance entity to a person or organisation under the terms of an insurance policy, following the occurrence of an insured event.&nbsp;These payments are made by the insurer, not by the policyholder or customer, and are intended to indemnify, compensate, or provide financial support for a covered loss, cost, liability, or reduction in income.</p><p><br></p><p>These payments are made to:&nbsp;Replace or compensate for loss of income or earnings, reimburse or meet insured costs or expenses, compensate for damage, injury, or impairment, or provide financial support following a defined insured event.<br></p><p>If the payout is based on the insured person's taxable income then the payout is taxable and is included in 'other income' section on a customer's income tax return.&nbsp;If a pay-out is a fixed sum, or it isn't related to the insured's income (e.g. based on the consumer price index) then the payout is not taxable and the premiums are not deductible.<br></p>"@en ;
        skos:related      <http://example.com/NZ-IRD#Compensation> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#InsurancePayments/Income-replacementInsurancePayout_en> , <http://example.com/InlandRevenueModel#InsurancePayments/InsurancePayments_en0> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#InsurancePayments/InsurancePayments_en> .

<http://example.com/InlandRevenueModel#InsurancePayments/Income-replacementInsurancePayout_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Income-replacement insurance payout"@en .

<http://example.com/InlandRevenueModel#InsurancePayments/InsurancePayments_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Insurance payouts"@en .

