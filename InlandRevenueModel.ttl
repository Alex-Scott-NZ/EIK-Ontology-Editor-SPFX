                <http://example.com/InlandRevenueModel-current-#CharitiesAndNot-for-ProfitSpecialInterestGroup/C-NFPSIG_en> ;
        <http://example.com/InlandRevenueModel#HasGroupType>
                <http://example.com/InlandRevenueModel#SpecialInterestGroup> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/IRD-test-model#Non-profit-organisation> , <http://smartlogic.com/term#376585920000629783706622601154839> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#GovernanceAndCommunities> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Intranet"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Not-for-profits and charities play a significant role in New Zealand’s economy and support the wellbeing of New Zealanders. It is important to understand how IR can support this customer group, because when they thrive, we all do. Communities of practise look to supplement the formal structure and create new informal networks around a shared interest.  They aim to support the business by providing a trusted source of expertise, and facilitate networking and discussion across operational, technical and legal boundaries, by sharing information and ideas."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet; CCS-I content"@en ;
        sem:guid          "e8de92f8-7a7f-4eba-ad27-7faf810df80e" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
