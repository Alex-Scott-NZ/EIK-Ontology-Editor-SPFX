        <http://example.com/NZ-IRD#Source-of-term>
                "https://irnz.sharepoint.com/:b:/r/sites/govcentre/Documents/Data%20and%20Information%20Governance%20Standard.pdf?csf=1&web=1&e=2tZYGj"@en ;
        sem:guid          "42a2fa17-7155-4d86-813e-1c27d7a96115" ;
        skos:broader      <http://example.com/InlandRevenueModel#GovernancePrinciple> ;
        skos:definition   "Work as equals to create and share valuable knowledge."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Data-governance> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Mahitahitanga/Mahitahitanga_en> .

