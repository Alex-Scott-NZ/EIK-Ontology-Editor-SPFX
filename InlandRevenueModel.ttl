<http://example.com/InlandRevenueModel#EnterpriseInitiative>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsEventObjectOfActivity>
                <http://example.com/InlandRevenueModel#PortfolioGovernance> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ManagingProjects> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#PortfolioGovernanceBoard> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><a href=\"https://irnz.sharepoint.com/sites/CORP-strategic-portfolio-stewardship/SitePages/Prioritising-initiatives.aspx?web=1\"><u><font color=\"#0066cc\">Prioritising enterprise initiatives - the process (sharepoint.com)</font></u></a><br/></p>"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>There are two levels of initiatives: </p><p>Enterprise level (the enterprise portfolio) and Local or service level (e.g. START, Analytics/DIP, web services, or ATEA). An initiative is at enterprise level if it will: significantly contribute to the delivery of our performance objectives and strategic outcomes; better align our customer and product objectives and outcomes with our enterprise work programme; and require cross IR commitment to ensure a successful delivery. The enterprise portfolio captures the list of initiatives in each stage of the initiative lifecycle - emerge, discover and deliver.</p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#EnterpriseInitiative/EnterprisePortfolio_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Enterprise Design & Integrity"@en ;
        sem:guid          "3866f034-9854-4aa6-bcb3-ebf44f8baed1" ;
        skos:broader      <http://example.com/IRD-test-model#Programe-or-project> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EnterpriseInitiative/EnterpriseInitiative_en> .

