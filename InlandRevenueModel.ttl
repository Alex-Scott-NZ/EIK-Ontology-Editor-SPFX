<http://example.com/InlandRevenueModel-current-#CaseImpactStatement>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsPublishedBy>
                <http://smartlogic.com/term#72264559379166026976041> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#TaxTechnicalInformationType> ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel-current-#CaseImpactStatement/CentralAdministratorSystem_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/kc-litigation-and-prosecution/SitePages/Recent-case-summaries-and-case-impact-statements-process.aspx?web=1\">Recent case summaries and case impact statements process</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel#usedInInME2ValueSet>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Where a judgment is considered 'significant', the Preliminary View of Impact section in the RCS will be replaced by ‘Case Impact Statement’ (CIS) for the TIB publication and Case Notes page. The Technical Governance Committee (TGC), consisting of members from each tax technical unit in IR, will review recent judgments at their regular meetings and the Director, Litigation's recommendation of whether a judgment is 'routine' or 'significant'. Where a judgment is considered 'routine', the Preliminary View of Impact section in the RCS will be renamed ‘Impact’ for the TIB publication as well as the Case Notes page."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Business rules - GST analysis document; LMU content"@en ;
        sem:guid          "f143fb7c-7ffa-46c4-a5a9-15d0d34f7333" ;
        skos:broader      <http://example.com/InlandRevenueModel#OperationalServicesInformation> ;
        skos:related      <http://example.com/InlandRevenueModel#RecentCaseSummary> , <http://example.com/InlandRevenueModel#Statement> , <http://smartlogic.com/term#172926457495447331843254> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#CaseImpactStatement/CaseImpactStatement_en> .

