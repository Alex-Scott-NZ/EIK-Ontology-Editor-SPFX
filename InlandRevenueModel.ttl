<http://example.com/InlandRevenueModel#InternalBudgetScenariosReconcilliation>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#InternalBudgetScenariosReconcilliation/IBSR_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "SAP.com"@en ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://example.com/InlandRevenueModel#BankReconciliation> , <http://example.com/InlandRevenueModel#CostsForecasting> , <http://smartlogic.com/term#69937308930871997842709> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate planning and reporting"@en ;
        sem:guid          "86345053-8dfb-4340-8743-f892f3193f1a" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Enterprise-model> ;
        skos:definition   "<p>As a part of the bookkeeping process, internal reconciliation is about matching and clearing transactions for business partners or for G/L accounts. Part of the internal reconciliation process may be done automatically by an application, and part of it can be done manually.<br>Most of the time, internal reconciliation takes place automatically, for example, when you create incoming or outgoing payments linked to invoices. In this case, a system automatically reconciles payments with the linked invoices. However, a standalone transaction, such as a payment on account, is unable to be automatically reconciled, as a system cannot know to which open invoices the payment relates. Therefore, you need to decide to which invoice the payment is to be applied and perform the reconciliation manually.<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#InternalBudgetScenariosReconcilliation/InternalBudgetScenariosReconcilliation_en> .

<http://example.com/InlandRevenueModel#InternalBudgetScenariosReconcilliation/IBSR_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "IBSR"@en .

<http://example.com/InlandRevenueModel#InternalBudgetScenariosReconcilliation/InternalBudgetScenariosReconcilliation_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Internal Budget Scenarios Reconcilliation"@en .

