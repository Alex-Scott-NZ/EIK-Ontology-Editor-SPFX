<http://example.com/InlandRevenueModel#CycloneDovi>
        rdf:type            <http://smartlogic.com/class#Adverse-event> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#AdverseEvent> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#WaitomoDistrictCouncil> , <http://example.com/InlandRevenueModel#Wairarapa> , <http://example.com/InlandRevenueModel-current-#Taranaki> , <http://example.com/InlandRevenueModel-current-#Tasman-Nelson-Marlborough> , <http://example.com/InlandRevenueModel-current-#WestCoast> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-03-17"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Natural_disaster_or_emergency_event_2016-.docx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The wind damage and flooding caused by Cyclone Dovi in the West Coast, Tasman/Nelson, Marlborough, Wairarapa, and Taranaki regions, and Waitomo district is causing financial issues for many farmers and growers and is likely to affect their income for the 2022 income year. <br/>The late deposit provision for 2021 has been approved, with an extension for all customers until 30 April 2022. No late deposit discretion has been made in relation to the 2022 tax year.<br/>Applications for early refunds from the income equalisation scheme will be allowed.<br/>There is also localised damage and flooding across other regions.<br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "START Help. List of adverse events."@en ;
        sem:guid            "5e2ba34f-3510-4b34-bac8-eba9b5fd9b7f" ;
        skos:broader        <http://smartlogic.com/term#47138497716934256857234> ;
        skos:editorialNote  "Checked in Viva Topics but it wasn't there."@en ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#CycloneDovi/CycloneDoviFebruary2022_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#CycloneDovi/CycloneDovi_en> .

<http://example.com/InlandRevenueModel#CycloneDovi/CycloneDoviFebruary2022_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Cyclone Dovi February 2022"@en .

<http://example.com/InlandRevenueModel#CycloneDovi/CycloneDovi_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Cyclone Dovi"@en .

<http://example.com/InlandRevenueModel#CycloneGabrielle>
        rdf:type          <http://smartlogic.com/class#Adverse-event> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#AdverseEvent> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#AucklandCBD> , <http://example.com/Cleaned-Inland-Revenue-model#Gisborne> , <http://example.com/Cleaned-Inland-Revenue-model#TararuaDistrictCouncil> , <http://example.com/InlandRevenueModel-current-#BayOfPlenty> , <http://example.com/InlandRevenueModel-current-#Hawke-sBay> , <http://example.com/InlandRevenueModel-current-#Northland> , <http://example.com/InlandRevenueModel-current-#Waikato> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-03-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/kc-adverse-events/Shared%20Documents/Natural_disaster_or_emergency_event_2016.docx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>February 2023. Cyclone Gabrielle affected regions across the North Island, with the Northland, Auckland, Waikato, Bay of Plenty, Gisborne and Hawke’s Bay regions and Tararua district particularly affected and is likely to affect farmers/growers incomes for the 2023 income year.<br/>There may also be farmers/growers from other regions who were affected by Cyclone Gabrielle and other recent weather events; we will take a sympathetic approach to customers from other regions who have also been affected.</p><div><p>This event was close to the Upper North Island rain and flooding in January 2023 and Cyclone Hale  which also caused flooding.</p></div>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#CycloneGabrielle/TropicalCycloneGabrielle_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "https://irnz.sharepoint.com/sites/kc-adverse-events/SitePages/natural-disaster-or-emergency-event-tax-impacts.aspx?web=1"@en ;
        sem:guid          "ed7e5ee2-cfb8-419e-acbc-5e1261b49615" ;
        skos:broader      <http://smartlogic.com/term#47138497716934256857234> ;
        skos:related      <http://example.com/InlandRevenueModel#CycloneHale> , <http://example.com/InlandRevenueModel#UpperNorthIslandRainAndFlooding> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#CycloneGabrielle/CycloneGabrielleFebruary2023_en> ;
