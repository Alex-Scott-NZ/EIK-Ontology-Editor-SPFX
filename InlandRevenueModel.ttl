<http://example.com/InlandRevenueModel#WestCoastAndTasmanFloodsJuly2021>
        rdf:type            <http://smartlogic.com/class#Adverse-event> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#AdverseEvent> ;
