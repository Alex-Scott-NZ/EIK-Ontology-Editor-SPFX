<http://example.com/Cleaned-Inland-Revenue-model#Recognised-seasonal-worker>
        rdf:type          <http://example.com/InlandRevenueModel-current-#PersonType> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "As per Section YD1 (11) ITA 2007 a person will be a non-resident seasonal worker if s/he is employed under the Recognised Seasonal Employment scheme by a Recognised Seasonal Employer (RSE). The RSE Work Policy is a policy that facilitates the temporary entry of additional workers from overseas to plant, maintain, harvest and pack crops in the horticulture and viticulture industries to meet labour shortages. These workers are non-resident for tax purposes. If the customer is unsure whether they are a recognised seasonal worker, ask them to check with their employer."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "START"@en ;
        sem:guid          "8d31024e-f690-4872-8ff1-b8df796e3743" ;
        skos:broader      <http://smartlogic.com/term#22199832311116025922650> ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#NSW> ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#Recognised-seasonal-worker/SeasonalWorker_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#Recognised-seasonal-worker/Recognised-seasonal-worker_en> .

