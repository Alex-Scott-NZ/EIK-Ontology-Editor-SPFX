        <http://example.com/Cleaned-Inland-Revenue-model#HasPossibleClassID>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.2.1_Corporate_Planning_and_Reporting> , <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.2.3_Administrative_Planning_and_Reporting> ;
