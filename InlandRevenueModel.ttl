                <http://example.com/InlandRevenueModel#Taxation-AnnualRates-ForeignSuperannuation-AndRemedialMatters-Act2014> , <http://example.com/InlandRevenueModel#Taxation-AnnualRatesFor2015-16-ResearchAndDevelopment-AndRemedialMatters-Act2016> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "43171896-a1a2-43ef-90ce-b560a879da39" ;
        skos:broader      <http://smartlogic.com/term#492768876094676199672439963971808> ;
