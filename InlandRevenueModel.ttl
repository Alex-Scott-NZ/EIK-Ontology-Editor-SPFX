        skosxl:literalForm     "Resource Management Act"@en .

<http://example.com/InlandRevenueModel#ResourceManagementWorkingGroup>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ResourceManagementWorkingGroup/RMWG_en> ;
