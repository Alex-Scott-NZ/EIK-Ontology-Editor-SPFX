<http://example.com/InlandRevenueModel#PsychosocialSafetyClimate>
        rdf:type          <http://smartlogic.com/class#Topic> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/InlandRevenueModel#PsychosocialSafetyClimate/PSC_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-03-17"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Viva Topics"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A term used in organisational psychology that refers to the shared belief held by workers that their psychological health and safety is protected and supported by senior management. PSC builds on other work stress theories and concerns the corporate climate for worker psychological health and safety. Studies have found that a favourable PSC is associated with low rates of absenteeism and high productivity, while a poor climate is linked to high levels of workplace stress and job dissatisfaction. PSC can be promoted by organisational practices, policies and procedures that prioritise the psychosocial safety and wellbeing of workers. The theory has implications for the design of workplaces for the best possible outcomes for both workers and management."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "https://irnz.sharepoint.com/sites/te-pou-herenga/SitePages/People-Leaders-Message---Thursday-16-March.aspx?web=1"@en ;
        sem:guid          "f5dc8ca6-eae3-4037-a641-1783f9533a14" ;
        skos:broader      <http://smartlogic.com/term#72781818800075044437385> ;
