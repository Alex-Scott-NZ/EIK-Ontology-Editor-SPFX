<http://example.com/InlandRevenueModel#FinancialDependency>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsAttributeOf>
                <http://example.com/IRD-test-model#Child> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-27"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling."@en ;
        sem:guid          "5291e9fa-fbc2-4a5a-b94c-fb90c100ca08" ;
        skos:broader      <http://example.com/InlandRevenueModel#FinancialStatus> ;
        skos:definition   "<p>A person is financially dependent on someone else if they rely on that person for most or all of their financial support, rather than supporting themselves through their own income or government assistance paid directly to them. This usually means the person&nbsp;does not earn enough income to meet their own living costs, and<br>depends on another person (such as a parent or caregiver) to pay for things like food, housing, clothing, and day‑to‑day expenses.&nbsp;A person can still be financially dependent even if they receive some income, as long as that income is not enough to make them financially independent (for example, limited part‑time work or ACC payments).&nbsp;<br>Under Inland Revenue rules, someone is generally NOT financially dependent if they&nbsp;work full‑time (commonly treated as 30 hours or more per week),&nbsp;receive a main benefit or student allowance in their own right, or&nbsp;otherwise support themselves financially without relying on another person.<br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#WorkingForFamiliesTaxCredit> , <http://smartlogic.com/term#46576892232815290578744> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#FinancialDependency/FinanciallyDependent_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#FinancialDependency/FinancialDependency_en> .

