        skos:definition   "<p><!--StartFragment--><span style=\"color: rgb(32, 33, 36);text-align: left;background-color: rgb(255, 255, 255);float: none;\">The DOCA is<span> </span></span><b style=\"background-color: rgba(80, 151, 255, 0.18);color: rgb(4, 12, 40);text-align: left;\">the agreement between the business and its creditors to restructure the business, usually by repaying outstanding debt at a lower amount and/or over a period of time</b><span style=\"color: rgb(32, 33, 36);text-align: left;background-color: rgb(255, 255, 255);float: none;\">. For the DOCA to be approved, a majority in number representing at least 75% in value of creditors must vote in its favour.</span><!--EndFragment--><br/></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#CustomerFinancialInformation> , <http://example.com/InlandRevenueModel#CustomerIdentityInformation> , <http://example.com/NZ-IRD#Restructured-Debt-Deed> ;
        skosxl:altLabel   <http://example.com/NZ-IRD#Deed-of-Company-Arrangement/DOCA_en> ;
        skosxl:prefLabel  <http://example.com/NZ-IRD#Deed-of-Company-Arrangement/Deed-of-Company-Arrangement_en> .

