<http://example.com/InlandRevenueModel#SystemsDevelopmentLifecycle>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#SystemsDevelopmentLifecycle/SDLC_en> , <http://example.com/InlandRevenueModel#SystemsDevelopmentLifecycle/SDL_en> ;
