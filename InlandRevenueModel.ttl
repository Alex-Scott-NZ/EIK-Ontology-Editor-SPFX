                <http://example.com/InlandRevenueModel#UnclaimedMoneyClaimant> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-20"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ContactHistory/CommunicationsRecord_en> , <http://example.com/InlandRevenueModel#ContactHistory/EvidenceOfContact_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling"@en ;
        sem:guid          "49238c37-23ab-4e51-91ce-90f71a785698" ;
        skos:broader      <http://example.com/InlandRevenueModel#DeliverCustomerServicesInformation> ;
        skos:definition   "Contact history is a record of past attempts to contact, or communications with, a person or organisation, used to show what contact was made, when, how, and with what outcome. The emphasis is on evidence that reasonable contact effort occurred, not on proving a specific communication content."@en ;
        skos:note         "<p>From IR operational material, what must be proven is:&nbsp;<br>that contact was attempted, even if unsuccessful<br>when the attempt occurred<br>how it was made (phone, email, letter, web message, third party)<br>what happened (no answer, message left, invalid details, contact made)<br>This is exactly what IR instructs staff to capture in case notes and interaction records, for example in returned mail and contact attempt cases, where notes must document call attempts, channels used, and outcomes, and in child support cases where staff explicitly record successful, unsuccessful, or invalid contact attempts.<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ContactHistory/ContactHistory_en> .

