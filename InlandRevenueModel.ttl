<http://example.com/InlandRevenueModel#IRBrand>
        rdf:type          <http://smartlogic.com/class#Topic> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#Communications-Information-AndTechnology> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-marketing-and-communications/SitePages/brand-and-design.aspx"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Investopedia"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Our brand is a living entity. It represents who we are as an organisation and reﬂects customers’ and employees’ perceptions of us. If our brand is not seen in a positive light, it will affect the level of trust our customers have in us and ultimately impact customer compliance. Our brand includes: the logo, colours, typefaces, imagery we use; the customer service experience; all visual communications and advertising; social media, our culture and reputation​​​​​​​. Everyone at Inland Revenue has a role in building and protecting our brand’s positive reputation."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate space topics"@en ;
        sem:guid          "b4681216-0f72-488e-a3ee-613240d31789" ;
        skos:broader      <http://example.com/InlandRevenueModel#OrganisationalCulture> ;
        skos:definition   "The IR brand is an intangible marketing or business concept that helps people identify Inland Revenue. People often confuse brands with things like logos, slogans, or other recognizable marks, which are marketing tools that help promote goods and services."@en ;
        skos:related      <http://example.com/InlandRevenueModel#BrandGuidelines> , <http://example.com/InlandRevenueModel#InlandRevenueLogo> , <http://example.com/InlandRevenueModel#MarketResearch> , <http://example.com/InlandRevenueModel#StyleGuide> , <http://smartlogic.com/term#99984031671694145392998> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IRBrand/IRBrand_en> .

<http://example.com/InlandRevenueModel#IRBrand/IRBrand_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "IR brand"@en .

<http://example.com/InlandRevenueModel#IRBusinessService>
        rdf:type          <http://example.com/InlandRevenueModel-current-#Services> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "TOGAF"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "TechTarget"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A business service is defined as a discoverable building block capable of performing a defined task, such as providing a business function. It must have an association to a business objective, ensuring that its business value is measurable in terms of achieving that objective. Business services support business capabilities through explicitly defined interfaces and are governed by an organisation, aligning with the notion of a service in Service-Oriented Architecture (SOA)."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "BT"@en ;
        sem:guid          "c17b44bd-f1c7-4aac-a9e2-58d1f2c3e69d" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#Service> ;
        skos:definition   "Business services refer to all services that support a company. They do not create or deliver any physical products."@en ;
        skos:related      <http://example.com/InlandRevenueModel#BusinessCapability> , <http://smartlogic.com/term#194513751604847607603030> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IRBusinessService/IRBusinessService_en> .

<http://example.com/InlandRevenueModel#IRBusinessService/IRBusinessService_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Business service"@en .

