        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Unconditional gift"@en .

<http://example.com/Cleaned-Inland-Revenue-model#Unit-Trust-Act-1960>
        rdf:type          <http://smartlogic.com/class#Law> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-replaced-by>
                <http://example.com/InlandRevenueModel#FinancialMarkets-RepealsAndAmendments-Act2013> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://smartlogic.com/term#453176854918441235275578611099068> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/Cleaned-Inland-Revenue-model#Unit-Trust-Act-1960/UTA_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/Cleaned-Inland-Revenue-model#Unit-Trust-Act-1960/UnitTrustsAct_en> ;
        <http://example.com/NZ-IRD#Is-amended-by>
                <http://example.com/Cleaned-Inland-Revenue-model#Taxation-savings-investment-and-miscellaneous-provisions-Act-2006> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "e6edbd8c-b82c-497c-9888-c3b83ea71df5" ;
        skos:broader      <http://smartlogic.com/term#492768876094676199672439963971808> ;
        skos:definition   "The Unit Trusts Act 1960 was a New Zealand law that established a regulatory framework for unit trusts, which are pooled investment vehicles allowing smaller investors to access a range of securities. The Act required unit trusts to have both a manager and a trustee, vested property in the trustee, and provided protections for unit holders, similar to those for shareholders. However, this Act was repealed on December 1, 2014, and superseded by the Financial Markets Conduct Act 2013 (FMC Act), which now governs unit trusts and other managed investment schemes in New Zealand. "@en ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#Unit-Trust-Act-1960/Unit-Trust-Act-1960_en> .

<http://example.com/Cleaned-Inland-Revenue-model#Unit-Trust-Act-1960/UTA_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "UTA"@en .

