        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/CORP-data-analytics-insights\">Data, Analytics &amp; Insights | Raraunga, Tātari me ngā Māramatanga - Home</a>​<br></p>"@en ;
        sem:guid            "fe604871-1a5b-4235-b902-17f9399005b9" ;
        skos:broader        <http://example.com/InlandRevenueModel#Enterprise-IntegrityServices> ;
        skos:definition     "<p>​<span style=\"color: rgb(50, 49, 48);font-size: 18px\">Data, Analytics and Insights (DA&amp;I) brings together all the work that revolves around IR’s data into one place. We manage, model and interpret high quality data to give IR a deeper understanding of what’s important to the organisation. This includes ensuring IR as an organisation knows how to use the digital and data capabilities at it’s disposal.</span>​<br></p>"@en ;
        skos:editorialNote  "<p>​<span style=\"color: rgb(50, 49, 48);font-size: 18px\">On 1 September 2025, Inland Revenue's Data, Analytics and Insights (DA&amp;I) function implemented a new operating model.&nbsp;The new DA&amp;I structure introduces several key changes, including the establishment of a central Planning &amp; Prioritisation function and the consolidation of intervention design under a new Customer Interventions team.</span>​<br></p>"@en ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#Data-Analytics-Insights/Data-AnalyticsAndInsights_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#Data-Analytics-Insights/Data-Analytics-Insights_en> .

<http://example.com/InlandRevenueModel#Data-Analytics-Insights/DA-I_en>
