<http://example.com/InlandRevenueModel#CriticalSuccessFactor>
        rdf:type          <http://example.com/InlandRevenueModel#Measurement> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#CriticalSuccessFactor/CSF_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsMeasureOf>
                <http://example.com/InlandRevenueModel-current-#ProjectPlanning> ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#CriticalSuccessFactor/ComplyingSuperannuationFund_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Wikipedia, modified."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CTO Advisory content"@en ;
        sem:guid          "04e915eb-f6a4-4b4d-b23c-fa83d4a635c0" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Measurement> ;
        skos:definition   "A CSF is a critical factor or activity that is required for ensuring the success of a company or an organisation. For planning purposes they provide the must-do's of the requirements. None can be missed. The term was initially used in the world of data analysis and business analysis. For example, a CSF for a successful Information Technology project is user involvement. Critical success factors should not be confused with success criteria. The latter are outcomes of a project or achievements of an organisation necessary to consider the project a success or the organisation successful. Success criteria are defined with the objectives and may be quantified by key performance indicators (KPIs)."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CriticalSuccessFactor/CriticalSuccessFactor_en> .

<http://example.com/InlandRevenueModel#CriticalSuccessFactor/CSF_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "CSF"@en .

<http://example.com/InlandRevenueModel#CriticalSuccessFactor/ComplyingSuperannuationFund_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Complying superannuation fund"@en .

<http://example.com/InlandRevenueModel#CriticalSuccessFactor/CriticalSuccessFactor_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Critical success factor"@en .

<http://example.com/InlandRevenueModel#CriticalTaskAssurance>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#CriticalTaskAssurance/CTA_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Multiple internal IR SharePoint pages"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Critical task assurance (CTA) process ensures that key pieces of work posing potential technical risk to IR's integrity are independently reviewed by Legal Services, and approved as being technically correct within the timeframes contained in the CTA matrix<. Examples: Request an arrest warrant under the Student Loans Act, Refusal to supply information under the Official Information Act, Child support prosecutions, Taking of securities and guarantees in debt cases, Evasion short fall penalties, Warrant to access a private dwelling, Information sharing with Police, and many more. The intent of the process is to provide reassurance (to the Commissioner) that IR’s technical response to individual issues is correct. This in turn reduces the number of lengthy disputes and manages IR reputational risk."@en ;
        <http://example.com/NZ-IRD#Is-done-by>
                <http://example.com/InlandRevenueModel#LegalServices> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Knowledge Collection "@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://smartlogic.com/term#48168061495825248466182> ;
        sem:guid          "95b19341-48f0-4ff2-95ef-2c64d43c4d43" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#LegalOpinionProvision> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CriticalTaskAssurance/CriticalTaskAssurance_en> .

<http://example.com/InlandRevenueModel#CriticalTaskAssurance/CTA_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "CTA"@en .

<http://example.com/InlandRevenueModel#CriticalTaskAssurance/CriticalTaskAssurance_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Critical task assurance"@en .

