        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>VIVA Topics<br/>and <br/><!--StartFragment--><a href=\"https://irnz.sharepoint.com/sites/News/SitePages/Enterprise-Support-Services---new-go-live-date-and-new-name.aspx?web=1\">Enterprise Support Services - new go live date and new name (sharepoint.com)</a><!--EndFragment--><br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Ātea is an integrated toolset that supports things like the way we onboard new people, support our people’s learning and development, buy and pay for the things IR needs, claim and approve our expenses, book travel, manage our financial processes including how we budget and forecast our project costs, and deliver our internal and external reporting."@en ;
        <http://example.com/InlandRevenueModel-current-#IsInvolvedInEvent>
                <http://example.com/InlandRevenueModel-current-#EnterpriseSupportServices> ;
