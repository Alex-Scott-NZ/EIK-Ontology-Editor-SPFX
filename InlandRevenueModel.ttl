<http://example.com/InlandRevenueModel-current-#SettlementAgreement>
        rdf:type          <http://smartlogic.com/class#Agreement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IKM Team"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel-current-#SettlementAgreement/SettlementPayment_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "OCTC content"@en ;
        sem:guid          "cd67b90f-add6-4904-9e97-15cc1ba69182" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Personal-agreement> ;
        skos:definition   "<p><span style=\"color: #232222;\">A settlement agreement is a legal contract that resolves the disputes among all parties by coming to an agreement. It</span> is a legal document where all parties in a court case, in civil law, agree to an outcome of any judgment being made in advance..<br/>See Interpretation Statement IS 20/01 Income Tax - Treatment of the receipt of lump sum settlement payments, that sets out how the Commissioner<br/>will treat a lump sum payment received under a settlement agreement for claims that (if successful) would have both a capital and revenue nature.</p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#SettlementAgreement/SettlementAgreement_en> .

<http://example.com/InlandRevenueModel-current-#SettlementAgreement/SettlementAgreement_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Settlement agreement"@en .

