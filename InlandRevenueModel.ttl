                false ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Income Tax Act"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The term used in the bright-line test to describe land: Residential land does not include land that is mainly used for business or farmland."@en ;
