<http://example.com/InlandRevenueModel#ConstantElasticityOfSubstitution>
        rdf:type          <http://smartlogic.com/class#Topic> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ConstantElasticityOfSubstitution/CES_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#ConstantElasticityOfSubstitution/CustomerEffortSurvey_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Wikipedia"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "PAS content"@en ;
        sem:guid          "a8181797-f9dc-48f1-aa52-98e370cc8f08" ;
        skos:broader      <http://smartlogic.com/term#182365628939588612203668> ;
        skos:definition   "<p>Constant Elasticity of Substitution (CES) is a common specification of many production functions and utility functions in neoclassical economics. CES refers to a production or utility function where the ease of substituting one input for another (or one good for another) remains constant, regardless of the input or good mix. This means the percentage change in the ratio of inputs (or goods) due to a percentage change in their relative prices is always the same. <br><br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ConstantElasticityOfSubstitution/ConstantElasticityOfSubstitution_en> .

<http://example.com/InlandRevenueModel#ConstantElasticityOfSubstitution/CES_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "CES"@en .

