<http://example.com/InlandRevenueModel#TechnicalAndSpecialistKnowledgeAndAdviceIsAvailableToAnyoneInTheOrganisation>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Assistance Pathways model, 2018/2019"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Through the assistance pathways model, people who need support, advice and to tap into specialist knowledge or expertise can access it from across the organisation. They use this to support their decision making, rather than escalating decisions to others (in the main). Technical and specialist knowledge does not therefore need to be 'replicated' in different places in the organisation, as it can be networked in as needed."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "http://intranet.ird.govt.nz//infoweb/sites/default/files/20200928-Recap%20-%20some%20key%20design%20features.JPG"@en ;
        sem:guid          "64c81a75-71d6-45cb-9e4c-33d079ef49d0" ;
        skos:broader      <http://example.com/InlandRevenueModel#FOMPrinciple2020> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TechnicalAndSpecialistKnowledgeAndAdviceIsAvailableToAnyoneInTheOrganisation/TechnicalAndSpecialistKnowledgeAndAdviceIsAvailableToAnyoneInTheOrganisation_en> .

<http://example.com/InlandRevenueModel#TechnicalAndSpecialistKnowledgeAndAdviceIsAvailableToAnyoneInTheOrganisation/TechnicalAndSpecialistKnowledgeAndAdviceIsAvailableToAnyoneInTheOrganisation_en>
        rdf:type               skosxl:Label ;
        sem:autocompletion     sem:AutocompletionOff ;
        sem:conceptMapping     sem:ConceptMappingOff ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Technical and specialist knowledge and advice is available to anyone in the organisation"@en .

