<http://example.com/InlandRevenueModel#DirectSelling>
        rdf:type          <http://smartlogic.com/class#Third-party-activity> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IKM Team"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p> </p><p><span style=\"font-size: 12.0pt\">Direct selling can be considered either a business model or a form of marketing. Direct selling organisations sell products to the public through their distributors. The distributor for a direct selling company would fall into one of 3 types for tax purposes – commission agent, or independent reseller, or employee.</span><span style=\"font-size:12.0pt\"> Tax requirements will vary depending on which type the distributor is. <br> <a href=\"https://aus01.safelinks.protection.outlook.com/?url=https%3A%2F%2Fwww.ird.govt.nz%2Fincome-tax%2Fincome-tax-for-businesses-and-organisations%2Ftypes-of-business-income%2Fincome-from-direct-selling&amp;data=05%7C01%7CSally.Chivers%40ird.govt.nz%7C3cedf86855044321e02b08dbe16a1eb2%7Cfb39e3e923a9404e93a2b42a87d94f35%7C1%7C0%7C638351618111987258%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C3000%7C%7C%7C&amp;sdata=ySJgeimkaBDVk93tLoeXrtRoHLQCxz0H6SJ%2BWuM8ebA%3D&amp;reserved=0\">Income from direct selling (ird.govt.nz)</a></span></p><p> </p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR Topics"@en ;
        sem:guid          "16a1f4dc-7652-4157-aa07-7b4e248af3bd" ;
        skos:broader      <http://smartlogic.com/term#111151589464448966017758> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DirectSelling/DirectSelling_en> .

<http://example.com/InlandRevenueModel#DirectSelling/DirectSelling_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Direct selling"@en .

