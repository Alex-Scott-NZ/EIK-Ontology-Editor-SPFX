                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#NZAccountingStandardsBoard> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel-current-#IAAuthorityProducedBy>
                <http://example.com/InlandRevenueModel#ExternalReportingBoard> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate Finance content"@en ;
        sem:guid          "7e2e56cf-dc46-42ee-b0c9-a83ade4ae00a" ;
        skos:broader      <http://smartlogic.com/term#179971457599096168225700491349283> ;
        skos:definition   "The Public Benefit Entity Financial Reporting Standards (PBE Standards) are New Zealand's accounting standards for public benefit entities (PBEs), which are organizations focused on community or social benefit rather than financial return. These standards are based on the International Public Sector Accounting Standards (IPSASs) and are divided into different tiers (Tier 1, 2, 3, 4) based on an entity's size and accountability, with Tier 2 entities often eligible for disclosure concessions under a reduced disclosure regime (RDR). The standards provide principles for preparing financial information that is useful to users for accountability and decision-making. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PublicBenefitEntityFinancialReportingStandard/PublicBenefitEntityFinancialReportingStandard_en> .

