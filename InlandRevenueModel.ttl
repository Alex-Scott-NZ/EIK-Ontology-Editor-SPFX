<http://example.com/InlandRevenueModel#Parent-sAllowance>
        rdf:type          <http://example.com/InlandRevenueModel#NotCurrent> , <http://smartlogic.com/class#Entitlement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR main website - Working for Families"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>In Working for Families material, parent’s allowance appears only in relation to back‑dated payments, not as a current, ongoing benefit. Parent’s allowance is a legacy or administrative category, not a current frontline benefit like Sole Parent Support or Paid Parental Leave.<br>A parent’s allowance is listed alongside other benefits (such as a main benefit or student allowance) that may be back‑paid after a review or reassessment.&nbsp;The documentation does not define eligibility, rates, or an active scheme for a parent’s allowance.&nbsp;Importantly, the guidance states that a person is not considered 'in receipt' of a back‑dated allowance until the payment is actually made, and that payment can affect Working for Families income in the year it is paid.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR main website - Working for Families"@en ;
        sem:guid          "bf04cbf0-f078-427c-ad26-8517d5f13ed2" ;
        skos:broader      <http://example.com/InlandRevenueModel#Government-mandatedBenefit> ;
        skos:related      <http://example.com/InlandRevenueModel#WorkingForFamiliesTaxCredit> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Parent-sAllowance/Parent-sAllowance_en> .

<http://example.com/InlandRevenueModel#Parent-sAllowance/Parent-sAllowance_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "[Parent's allowance]"@en .

