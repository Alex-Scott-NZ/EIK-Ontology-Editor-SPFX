                <http://example.com/Cleaned-Inland-Revenue-model#United-Kingdom/Britain_en> , <http://example.com/Cleaned-Inland-Revenue-model#United-Kingdom/England_en> , <http://example.com/Cleaned-Inland-Revenue-model#United-Kingdom/NorthernIreland_en> , <http://example.com/Cleaned-Inland-Revenue-model#United-Kingdom/Scotland_en> , <http://example.com/Cleaned-Inland-Revenue-model#United-Kingdom/Wales_en> ;
        <http://example.com/NZ-IRD#Is-location-of>
                <http://smartlogic.com/term#140065335290375658374685> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "ISO 3166; OCTC content"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/Cleaned-Inland-Revenue-model#United-Kingdom/GBR_en> , <http://example.com/Cleaned-Inland-Revenue-model#United-Kingdom/GB_en> ;
        sem:guid          "919c8050-4092-4317-a2fb-3f082163d887" ;
        skos:broader      <http://smartlogic.com/term#130710328707508168484707> ;
        skos:definition   "The United Kingdom of Great Britain and Northern Ireland, commonly known as the United Kingdom (UK) or Britain, is a sovereign country in north-western Europe, off the north-­western coast of the European mainland. The United Kingdom includes the island of Great Britain, the north-eastern part of the island of Ireland, and many smaller islands within the British Isles. Northern Ireland shares a land border with the Republic of Ireland. Otherwise, the United Kingdom is surrounded by the Atlantic Ocean, with the North Sea to the east, the English Channel to the south and the Celtic Sea to the south-west, giving it the 12th-longest coastline in the world. The Irish Sea separates Great Britain and Ireland. The total area of the United Kingdom is 242,500 square kilometres (93,628 sq mi), with an estimated population in 2020 of 68 million."@en ;
        skos:related      <http://example.com/InlandRevenueModel#DoubleTaxationRelief-UnitedKingdom-Order1984> , <http://example.com/InlandRevenueModel#QualifyingRecognisedOverseasPensionScheme> ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#United-Kingdom/GreatBritain_en> , <http://example.com/Cleaned-Inland-Revenue-model#United-Kingdom/UnitedKingdomOfGreatBritainAndNorthernIreland_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#United-Kingdom/United-Kingdom_en> .

