<http://example.com/InlandRevenueModel#DataAndInformationGovernanceStandard>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><!--StartFragment--><a href=\"https://irnz.sharepoint.com/:b:/r/sites/govcentre/Documents/Data%20and%20Information%20Governance%20Standard.pdf?csf=1&amp;web=1&amp;e=QejByg\">Data and Information Governance Standard.pdf</a><!--EndFragment--><br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>This standard <br/>- defines and guides Inland Revenue's Data and Information Governance approach<br/>- defines types of governance bodies, their scopes of responsibilities, and relationships to each other<br/>- includes the Cabinet-mandated role-based delegation of stewardship and custodianship responsibilities for data and information on a daily basis<br/>- applies to all data, information, and knowledge, irrespective of type and form, Inland Revenue has stewardship of, whether it is Inland Revenue’s intellectual property or not<br/>- applies to everyone working for Inland Revenue.<br/><a href=\"https://irnz.sharepoint.com/:b:/r/sites/govcentre/Documents/Data%20and%20Information%20Governance%20Standard.pdf?csf=1&amp;web=1&amp;e=QejByg\">Data and Information Governance Standard.pdf</a><!--EndFragment--><br/><!--EndFragment--></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#IAAuthorityProducedBy>
                <http://example.com/InlandRevenueModel#Outcomes-InformationAndKnowledge> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#DataAndInformationGovernanceStandard/DataAndInformationCapabilityFramework_en> , <http://example.com/InlandRevenueModel#DataAndInformationGovernanceStandard/DataAndInformationDecisionRightsFramework_en> , <http://example.com/InlandRevenueModel#DataAndInformationGovernanceStandard/DataAndInformationGovernanceInstrumentsFramework_en> ;
        sem:guid          "d80b58d7-55de-4f2a-a663-d4d3dd1d7987" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#Standard> ;
        skos:related      <http://example.com/InlandRevenueModel#DataAndInformationPolicy> , <http://example.com/InlandRevenueModel#InformationAndDataGovernance> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DataAndInformationGovernanceStandard/DataAndInformationGovernanceStandard_en> .

<http://example.com/InlandRevenueModel#DataAndInformationGovernanceStandard/DataAndInformationCapabilityFramework_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
