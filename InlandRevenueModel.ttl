        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#ConvertibleNotes> ;
        skos:definition   "An Optional Convertible Note (OCN) is a hybrid financial instrument that combines elements of both debt and equity. Initially, it functions as a loan from an investor to a company, paying interest until a predetermined \"conversion event\" occurs, like a future funding round. At this event, the debt converts into shares (equity). The \"optional\" aspect allows the investor the right to choose to convert, but not the obligation, to convert. "@en ;
        skos:related      <http://example.com/InlandRevenueModel#ShareManagement> , <http://smartlogic.com/term#77793849175289009165474> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#OptionalConvertibleNote/OptionalConvertibleNote_en> .

