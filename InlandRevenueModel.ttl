<http://example.com/InlandRevenueModel#ValueFramework>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span>Glossary of terms from IR's Initiative Management Framework<br/>document. May 2022.<br/></span></p><p><span style=\"color: black;\"><a href=\"https://irnz.sharepoint.com/sites/CORP-strategic-portfolio-stewardship/SupInfo/Forms/AllItems.aspx?id=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo%2FInitiative%20Management%20Framework%2Epdf&amp;parent=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo\"><span style=\"color: #337ab7;\">Tiakitanga Kohinga<br/>Rautaki - Strategic Portfolio Stewardship - Initiative Management Framework.pdf<br/>- 1) All Documents (sharepoint.com)</span></a></span></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A framework to evaluate and determine the value of an initiative against strategic priorities and outcomes. Defines what value looks like for our stakeholders through providing additional detail, accountability and measurement on our strategic objectives and outcomes. Provides transparency across IR and helps ensure the work we are doing is right and best aligned to value."@en ;
        sem:guid          "2fc246b7-d39c-4318-b2be-43d7a3fd2e5e" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Enterprise-model> ;
        skos:related      <http://example.com/InlandRevenueModel#InitiativeManagement> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ValueFramework/ValueFramework_en> .

<http://example.com/InlandRevenueModel#ValueFramework/ValueFramework_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Value Framework"@en .

