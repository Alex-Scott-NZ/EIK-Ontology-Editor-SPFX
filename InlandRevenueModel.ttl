<http://example.com/InlandRevenueModel#UnitedNationsConventionOnTheRecoveryAbroadOfMaintenance>
        rdf:type            <http://smartlogic.com/class#Agreement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#HasParticipatingCountry>
                <http://example.com/Cleaned-Inland-Revenue-model#Algeria> , <http://example.com/Cleaned-Inland-Revenue-model#Argentina> , <http://example.com/Cleaned-Inland-Revenue-model#Barbados> , <http://example.com/Cleaned-Inland-Revenue-model#Bolivia> , <http://example.com/Cleaned-Inland-Revenue-model#BurkinaFaso> , <http://example.com/Cleaned-Inland-Revenue-model#Cambodia> , <http://example.com/Cleaned-Inland-Revenue-model#CentralAfricanRepublic> , <http://example.com/Cleaned-Inland-Revenue-model#Chile> , <http://example.com/Cleaned-Inland-Revenue-model#Colombia> , <http://example.com/Cleaned-Inland-Revenue-model#Cuba> , <http://example.com/Cleaned-Inland-Revenue-model#Guatemala> , <http://example.com/Cleaned-Inland-Revenue-model#Haiti> , <http://example.com/Cleaned-Inland-Revenue-model#HolySee> , <http://example.com/Cleaned-Inland-Revenue-model#Liberia> , <http://example.com/Cleaned-Inland-Revenue-model#Macedonia> , <http://example.com/Cleaned-Inland-Revenue-model#Mexico> , <http://example.com/Cleaned-Inland-Revenue-model#Moldova> , <http://example.com/Cleaned-Inland-Revenue-model#Monaco> , <http://example.com/Cleaned-Inland-Revenue-model#Morocco> , <http://example.com/Cleaned-Inland-Revenue-model#Niger> , <http://example.com/Cleaned-Inland-Revenue-model#Pakistan> , <http://example.com/Cleaned-Inland-Revenue-model#Seychelles> , <http://example.com/Cleaned-Inland-Revenue-model#SriLanka> , <http://example.com/Cleaned-Inland-Revenue-model#Suriname> , <http://example.com/Cleaned-Inland-Revenue-model#Switzerland> , <http://example.com/Cleaned-Inland-Revenue-model#Tunisia> , <http://example.com/Cleaned-Inland-Revenue-model#Uruguay> , <http://example.com/InlandRevenueModel#Israel> , <http://smartlogic.com/term#130710328707508168484707> , <http://smartlogic.com/term#189374230129126350999034> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#UnitedNationsConventionOnTheRecoveryAbroadOfMaintenance/UNCRAM_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-17"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>CoPilot / Wikipedia</p><p><br></p><p>​<a href=\"https://www.ird.govt.nz/child-support/overseas/countries-that-have-child-support-agreements-with-nz\">Find countries that have child support agreements with New Zealand</a>​<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR main website"@en ;
        sem:guid            "8f77991a-56af-46e8-81b9-19c3c0d15787" ;
        skos:broader        <http://smartlogic.com/term#198788318597836492471216> ;
        skos:definition     "<p>A multilateral United Nations treaty establishing a system of cooperation between States Parties to facilitate the cross‑border recovery of child support and other maintenance obligations through designated transmitting and receiving authorities.<br></p><p>The Convention is commonly referred to as “UNCRAM” or the “1956 New York Convention” and served as the principal international mechanism for cross‑border maintenance recovery until the adoption of the 2007 Hague Convention on the International Recovery of Child Support, which modernised and superseded it in relations between states party to that later instrument.<br></p>"@en ;
        skos:editorialNote  "<p>Generally, the 2007 Hague Convention supersedes the earlier UNCRM convention.</p><p><br></p><p>The relationships included here reflect countries for which</p><p><br></p><p>* the UNCRM Convention is in force and</p><p><br></p><p>* the country is not signed up to the Hague Convention on the International Recovery of Child Support and Other Forms of Family Maintenance</p><p><br></p><p>It is based on the United Nations Treaty Collection and the consolidated list published in authoritative secondary sources.<br></p>"@en ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#UnitedNationsConventionOnTheRecoveryAbroadOfMaintenance/1956NewYorkConvention_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#UnitedNationsConventionOnTheRecoveryAbroadOfMaintenance/UnitedNationsConventionOnTheRecoveryAbroadOfMaintenance_en> .

<http://example.com/InlandRevenueModel#UnitedNationsConventionOnTheRecoveryAbroadOfMaintenance/1956NewYorkConvention_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "1956 New York Convention"@en .

<http://example.com/InlandRevenueModel#UnitedNationsConventionOnTheRecoveryAbroadOfMaintenance/UNCRAM_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "UNCRAM"@en .

<http://example.com/InlandRevenueModel#UnitedNationsConventionOnTheRecoveryAbroadOfMaintenance/UnitedNationsConventionOnTheRecoveryAbroadOfMaintenance_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "United Nations Convention on the Recovery Abroad of Maintenance"@en .

