<http://example.com/InlandRevenueModel#ServiceIntegration-DeliveryManagement>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ServiceIntegration-DeliveryManagement/SIDM_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-technology-services/SitePages/Service-intergration-and-delivery-management.aspx?web=1"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Service Integration &amp; Delivery Management (SIDM) leverage new partner capabilities to drive efficiency and pace. We ensure the right capabilities are in place to support this, including assuring the technical integrity and integration of our services. The SIDM function will also manage the delivery of small technology lifecycle changes.<br/>The SIDM function is split into 6 roles with the responsibility of managing our partners/vendors to deliver services that are:<br/>Cost effective (through budgetary control); Reliable and stable (through SLA management); Secure; Fit for purpose; Primarily outsourced where possible.<br/></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ServiceIntegration-DeliveryManagement/CoreTax-SocialPolicySIDM_en> , <http://example.com/InlandRevenueModel#ServiceIntegration-DeliveryManagement/Data-IntelligencePlatformSIDM_en> , <http://example.com/InlandRevenueModel#ServiceIntegration-DeliveryManagement/Information-KnowledgeManagementSIDM_en> , <http://example.com/InlandRevenueModel#ServiceIntegration-DeliveryManagement/SIDMPrimaryServices_en> , <http://example.com/InlandRevenueModel#ServiceIntegration-DeliveryManagement/SupportingTechnologyServicesSIDM_en> , <http://example.com/InlandRevenueModel#ServiceIntegration-DeliveryManagement/VoiceAndContactCentreSIDM_en> , <http://example.com/InlandRevenueModel#ServiceIntegration-DeliveryManagement/WorkplaceTechnologySIDM_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IT&C content"@en ;
        sem:guid          "b5ac583a-fa99-4b87-a7f2-195e0cd994c4" ;
        skos:broader      <http://example.com/InlandRevenueModel#TechnologyServices> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ServiceIntegration-DeliveryManagement/ServiceIntegration-DeliveryManagement_en> .

