<http://example.com/InlandRevenueModel#NationalDiplomaInIntelligenceAnalysis>
        rdf:type          <http://smartlogic.com/class#Authority> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#NationalDiplomaInIntelligenceAnalysis/NDIA_en> ;
