<http://example.com/InlandRevenueModel#Customer-ComplianceServices-Planning-DesignAndDelivery>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#Customer-ComplianceServices-Planning-DesignAndDelivery/RatongaKiritakiMeTeTautukunga-Mahere-HoahoaMeTeTuku_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#Customer-ComplianceServices-Planning-DesignAndDelivery/CCS-PDD_en> , <http://example.com/InlandRevenueModel#Customer-ComplianceServices-Planning-DesignAndDelivery/CCSPDD_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2022-11-02"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Corporate Space page<br/>https://irnz.sharepoint.com/sites/CORP-customer-and-compliance-services/SitePages/Planning,-Design-&amp;-Delivery.aspx<br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "CCS Planning, Design and Delivery (PDD) business area was set up to provide an enduring home for the capability to manage change and effective end-to-end planning as BT comes to an end. It''s made up of three business units: Design & Delivery, Capabilities & Outcomes, and Customer Experience Design Network (CXD)."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#Customer-ComplianceServices-Planning-DesignAndDelivery/CCS-Planning-DesignAndDelivery_en> , <http://example.com/InlandRevenueModel#Customer-ComplianceServices-Planning-DesignAndDelivery/CCSPD-D_en> , <http://example.com/InlandRevenueModel#Customer-ComplianceServices-Planning-DesignAndDelivery/Customer-ComplianceServices-PD-D_en> , <http://example.com/InlandRevenueModel#Customer-ComplianceServices-Planning-DesignAndDelivery/Customer-ComplianceServices-Planning-Design-Delivery_en> , <http://example.com/InlandRevenueModel#Customer-ComplianceServices-Planning-DesignAndDelivery/CustomerAndComplianceServices-Planning-DesignAndDelivery_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Future Operating Model content. Māori term supplied by the Māhutonga Team."@en ;
        sem:guid          "45aa8113-7c21-4605-b8d1-df1c278b341e" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerAndComplianceServices-Individuals> ;
        skos:definition   "Planning, Design and Delivery (PD&D) is a shared centralised service spread across the country and operates in three domains with the combined purpose of optimising business outcomes, customer experience and the effectiveness and efficiency of IR’s operations. (2025)"@en ;
        skos:historyNote  "<p><!--StartFragment--><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">New business area which is part of Inland Revenue's Corporate and Enabling Services designed under our Future Operating Model. Based on blueprints that set out the outcomes and services each area will deliver, how they will work, and how they will interact with other areas across IR. First day live for CCS Planning Design and Delivery 01-03-2021.</span><!--EndFragment--><br/></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Customer-ComplianceServices-Planning-DesignAndDelivery/Customer-ComplianceServices-Planning-DesignAndDelivery_en> .

