<http://example.com/InlandRevenueModel#NewZealandGovernmentLocatorService>
        rdf:type          <http://smartlogic.com/class#Government-policy> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
