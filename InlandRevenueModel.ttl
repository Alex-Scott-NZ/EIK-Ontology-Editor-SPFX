<http://example.com/InlandRevenueModel#ProcessQualityIndicator>
        rdf:type          <http://example.com/InlandRevenueModel#Measurement> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ProcessQualityIndicator/PQI_en> ;
