        rdf:type            <http://smartlogic.com/class#Adverse-event> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#AdverseEvent> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#CluthaDistrictCouncil> , <http://example.com/Cleaned-Inland-Revenue-model#QueenstownLakesDistrictCouncil> , <http://example.com/InlandRevenueModel-current-#Otago> , <http://example.com/InlandRevenueModel-current-#Southland> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
