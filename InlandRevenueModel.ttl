        sem:guid          "bd7cd90c-58ac-46b8-af4f-f74d76d5d481" ;
        skos:broader      <http://smartlogic.com/term#130710328707508168484707> ;
        skos:definition   "Mauritius, officially the Republic of Mauritius, is an island country in the Indian Ocean, about 2,000 kilometres (1,100 nautical miles) off the southeastern coast of East Africa, east of Madagascar. It includes the main island (also called Mauritius), as well as Rodrigues, Agaléga, St. Brandon (Cargados Carajos shoals) and may include the Chagos Archipelagos. The islands of Mauritius and Rodrigues, along with nearby Réunion (a French overseas department), are part of the Mascarene Islands. Its closest neighbor is the French island of Réunion, and it is situated roughly 2,400 kilometers southeast of mainland Africa."@en ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#Mauritius/RepublicOfMauritius_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#Mauritius/Mauritius_en> .

