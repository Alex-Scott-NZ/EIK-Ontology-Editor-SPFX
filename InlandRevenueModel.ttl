        skos:broader      <http://example.com/InlandRevenueModel#ProjectPhase> ;
        skos:definition   "A post-implementation review (PIR) is a formal process after a project is finished to evaluate its success, effectiveness, and efficiency by comparing actual results against initial objectives. PIRs identify what went well, what needs improvement, and capture \"lessons learned\" to improve future projects, providing a crucial feedback loop for organizational learning and continuous improvement. "@en ;
        skos:related      <http://example.com/InlandRevenueModel#ProjectHandover> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#Post-implementationReview/PostImplementationReview_en> , <http://example.com/InlandRevenueModel#Post-implementationReview/ReviewPhase_en> ;
