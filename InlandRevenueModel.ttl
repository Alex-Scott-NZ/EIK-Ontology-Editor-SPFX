        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://www.orangatamariki.govt.nz/caregiving/financial-help/caregiver-allowance/"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Official name is Caregiver allowance, colloquially known as the Foster care allowance.<br></p><p>The foster care allowance helps caregivers to meet the reasonable costs of children in foster care.&nbsp;</p><p>The foster care allowance may be paid by an iwi social service, cultural support service or child and family support service.</p><p><br></p><p>A care allowance is paid fortnightly and covers board, personal items and pocket money. We also provide a 4-weekly kākahu (clothing) allowance, and allowances for Christmas and birthday presents. <br></p><p><br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Revenue Forecasting content"@en ;
        sem:guid          "3eebf118-7b5d-4202-aba3-86e97ccf4733" ;
        skos:broader      <http://example.com/InlandRevenueModel#Government-mandatedBenefit> ;
        skos:definition   "Foster care allowances in New Zealand are tax-free, fortnightly payments provided by Oranga Tamariki (Ministry for Children) or NGOs to caregivers to cover daily costs for children in care. These payments assist with board, pocket money, and personal items, with extra funding for clothing, birthdays, Christmas, and sometimes childcare (e.g., nappy allowance)."@en ;
        skos:note         "Other payments the tamaiti or rangatahi in your care may qualify for, but are not included in the standard care allowance, include: purchasing a first uniform for your tamaiti or rangatahi, school camps, school stationery, club costs (sports and interest groups), school fees, early childhood fees, and after school care fees."@en ;
        skos:related      <http://example.com/InlandRevenueModel#FamilyIncomesPackage> , <http://example.com/InlandRevenueModel#Fostering> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#FosterCareAllowance/FosterCareAllowance_en0> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#FosterCareAllowance/FosterCareAllowance_en> .

