        skos:broader      <http://example.com/InlandRevenueModel#IRPublication> ;
        skos:historyNote  "Public Information Bulletin (PIB) ran from about 1963 to 1989, and was the forerunner of the Tax information Bulletin. It was published by Inland Revenue."@en ;
