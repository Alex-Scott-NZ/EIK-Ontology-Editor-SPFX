        sem:guid            "4626c1e0-3645-4bdb-9317-362ce938b855" ;
        skos:broader        <http://smartlogic.com/term#47372529931203401780288> ;
        skos:definition     "Ātea means 'space' – the space, courtyard or open area in front of the wharenui (meeting house on a marae) where visitors are formally welcomed. This area is commonly known as the marae ātea."@en ;
        skos:editorialNote  "<p>Ātea go live was 1 October 2019.<br/><!--StartFragment--><a href=\"https://irnz.sharepoint.com/sites/News/SitePages/Enterprise-Support-Services---new-go-live-date-and-new-name.aspx?web=1\">Enterprise Support Services - new go live date and new name (sharepoint.com)</a><br/></p>"@en ;
