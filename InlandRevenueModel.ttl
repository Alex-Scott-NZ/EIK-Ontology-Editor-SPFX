        sem:guid          "98f99fcf-92f9-49ac-ab6b-b9d76c87b4b3" ;
        skos:broader      <http://smartlogic.com/term#531442512418953950816056224858867> ;
        skos:definition   "In New Zealand, a public limited company is a company whose shares are available for purchase by the general public, typically on a stock exchange like the NZX. These companies offer benefits such as greater access to capital, increased brand exposure, and enhanced share liquidity, but they also face stricter regulatory requirements and public scrutiny compared to private companies. Shareholders in a public company have limited liability, meaning their personal assets are protected from the company's debts, with their financial risk limited to the value of their shareholding. "@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Share> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PublicLimitedCompany/PublicLimitedCompany_en> .

