                "https://irnz.sharepoint.com/sites/kc-income-tax/SitePages/non-resident-passive-income.aspx?web=1"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Non-resident financial arrangement income (NRFAI) is a subset, introduced in 2017, of non-resident passive income. The purpose of NRFAI is to ensure that the payment of non-resident withholding tax (NRWT) aligns with when the borrower claims an income tax deduction for the expenditure. Previously it was possible to structure so that the payment of NRWT could be delayed. Generally the NRFAI rules will apply only if financial arrangement expenditure exceeds $40,000 in the previous year. If the $40,000 threshold is not exceeded then NRWT is deducted and paid on a payments basis - i.e. when interest is paid. If the borrower has a related party \"financial arrangement\" transaction and the transaction exceeds $40,000 expenditure, that borrower must do a deferral calculation to determine if they have NRFAI."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "PAS content"@en ;
        sem:guid          "637d0f42-7676-4900-b073-dbee79bd06d1" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#PassiveIncome> ;
        skos:related      <http://smartlogic.com/term#401253492428764857618526776158372> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Non-residentFinancialArrangementIncome/Non-residentFinancialArrangementIncome_en> .

<http://example.com/InlandRevenueModel#Non-residentFinancialArrangementIncome/NRFAI_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "NRFAI"@en .

