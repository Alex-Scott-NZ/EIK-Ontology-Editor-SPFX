<http://example.com/InlandRevenueModel#Release>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsEventObjectOfActivity>
                <http://example.com/InlandRevenueModel#ReleaseManagement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/govcentre/Documents/Initiative%20Management%20Framework.pdf"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The deployment or go-live of the initiative or scope. The scope from several initiatives can be bundled together into a release, for example, scope with the same due date, or an initiative can be deployed across multiple releases, for example, with scope deployed at different times. With agile delivery, there will be a release of new features and improvements on a regular cadence. For initiatives that do not have technology components, the equivalent is the launch, implementation or publication."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Initiative Management Framework, 2023."@en ;
        sem:guid          "fe168650-6d94-467e-bcbd-bb1a4cc721bb" ;
        skos:broader      <http://example.com/InlandRevenueModel#ProjectPhase> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Release/Release_en> .

<http://example.com/InlandRevenueModel#Release/Release_en>
        rdf:type            skosxl:Label ;
        sem:rulebaseAction  sem:RulebaseActionDoNotGenerate ;
        skosxl:literalForm  "Release"@en .

