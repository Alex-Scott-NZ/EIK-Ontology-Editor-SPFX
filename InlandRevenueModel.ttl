<http://example.com/InlandRevenueModel#CaseManagementConference>
        rdf:type          <http://example.com/InlandRevenueModel#Case> ;
        <http://example.com/Cleaned-Inland-Revenue-model#GeneratesInformation>
                <http://example.com/InlandRevenueModel#Defendant-sMemorandumForFirstCaseConference> , <http://example.com/InlandRevenueModel#NoticeOfCaseManagementConference> , <http://example.com/InlandRevenueModel#NoticeOfDateOfCaseManagementConference> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsEventObjectOfActivity>
                <http://smartlogic.com/term#76063862078258288179254> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#CaseManagementConference/CMC_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI / Ministry of Justice."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "LMU content"@en ;
        sem:guid          "dc60d9f1-3984-4e33-b865-fdc01f283ab7" ;
        skos:broader      <http://example.com/InlandRevenueModel#Hearing> ;
        skos:definition   "In New Zealand, a Case Management Conference (CMC) is a procedural step in civil court cases, particularly in the High Court, where a judge actively manages the progression of a case to ensure its just, speedy, and inexpensive resolution. It's a meeting where the judge, with the assistance of court staff, helps the parties identify, define, and refine the issues in dispute. The conference can also involve setting timetables, directing how the hearing will be conducted, and exploring options for settlement. "@en ;
        skos:related      <http://smartlogic.com/term#93824266317085224707033> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CaseManagementConference/CaseManagementConference_en> .

