<http://example.com/InlandRevenueModel#StateSectorRetirementSavingScheme>
        rdf:type          <http://example.com/InlandRevenueModel#FinancialProduct> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#StateSectorRetirementSavingScheme/SSRSS_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "P&C content"@en ;
        sem:guid          "c5fc248d-ce41-4fdd-b756-2ebc5600d3bd" ;
        skos:broader      <http://smartlogic.com/term#755742870035676660272218483926388> ;
        skos:definition   "The State Sector Retirement Saving Scheme (SSRSS) was a voluntary, defined contribution superannuation scheme for New Zealand state sector employees that closed to new members on October 1, 2008, when the government introduced KiwiSaver for public servants. The scheme, which provided an employer subsidy of up to three percent of an employee's gross salary, was operated by ASB and AMP (now managed by Smartshares) and was a key initiative to encourage retirement savings among public sector employees."@en ;
        skos:historyNote  "Closed in 2008."@en ;
        skos:related      <http://example.com/InlandRevenueModel-current-#GovernmentService> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#StateSectorRetirementSavingScheme/StateSectorRetirementSavingScheme_en> .

