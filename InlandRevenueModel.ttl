<http://example.com/InlandRevenueModel#PolicyDevelopment>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/Cleaned-Inland-Revenue-model#HasOutcome>
                <http://smartlogic.com/term#198484893212180408477212> , <http://smartlogic.com/term#36907720899152746377923> ;
        <http://example.com/InlandRevenueModel#HasRelatedActivity>
                <http://example.com/InlandRevenueModel-current-#Governance> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#Activity-BusinessAndCorporate> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Wikipedia"@en ;
        <http://example.com/InlandRevenueModel#usedInME3ValueSet>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The development of a deliberate system of principles and rules to guide decisions and achieve rational outcomes. A policy is a statement of intent, and is implemented as a procedure or protocol."@en ;
