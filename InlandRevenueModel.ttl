<http://example.com/InlandRevenueModel#PublicAdviceAndGuidance>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-related-documents>
                <http://example.com/Cleaned-Inland-Revenue-model#Public-Rulings-scoping-paper> , <http://example.com/InlandRevenueModel#IssuesReport-Determination> , <http://example.com/InlandRevenueModel#IssuesReport-InterpretationGuideline> , <http://example.com/InlandRevenueModel#IssuesReport-InterpretationStatement> , <http://example.com/InlandRevenueModel#IssuesReport-IssuesPaper> , <http://example.com/InlandRevenueModel#IssuesReport-QuestionWe-veBeenAsked> ;
        <http://example.com/Cleaned-Inland-Revenue-model#HasPossibleClassID>
                <http://smartlogic.com/term#144679093040415583352880> , <http://smartlogic.com/term#80872911964130117915212> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#PublicAdviceAndGuidance/TohutohuMeAratakiTumatanui_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span lang=\"mi-NZ\"><font face=\"Calibri\" size=\"3\"><a href=\"https://irnz.sharepoint.com/sites/CORP-tax-counsel-office/SitePages/What-we-do.aspx\">https://irnz.sharepoint.com/sites/CORP-tax-counsel-office/SitePages/What-we-do.aspx</a></font></span></p><p><font face=\"Times New Roman\" size=\"3\"><br/><br/></font></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Tax Counsel Office determine and publish the Commissioner’s position on various tax issues in the form of public rulings, interpretation statements and other guidance. Prior to publishing, the items go through a consultation process that gives Inland Revenue groups and external interested parties an opportunity to provide feedback. We prepare a draft programme of priority work each year. This draft is consulted on with internal and external stakeholders. This functional stream of work in TCO was previously the work of the Public Rulings Unit."@en ;
        <http://example.com/NZ-IRD#Is-done-by>
                <http://smartlogic.com/term#85359180133310229255842> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Tax Counsel Office - review of ontology terms August-September 2022."@en ;
        sem:guid          "3305a7de-aca7-4be6-9def-6a2bfbf2e39a" ;
        skos:broader      <http://smartlogic.com/term#47754121509757619729319> ;
