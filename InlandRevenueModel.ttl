<http://example.com/InlandRevenueModel#DelegationOfAuthorityCard>
        rdf:type          <http://smartlogic.com/class#Property> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/InlandRevenueModel#DelegationOfAuthorityCard/DOACard_en> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#DelegationOfAuthority> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#DelegationLetter> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/kc-litigation-and-prosecution/SitePages/commissioners-right-of-access-and-power-to-remove-documents.aspx#delegation-of-authority-cards-%28warrant-card%29"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Delegation of authority cards (warrant card). A warrant card identifies the holder as having the delegated authority in respect of either: Section 17B TAA - used when requesting (in person rather than in writing) the production of documents or information, for example when at a bank asking to review the banking records of a customer (an IR 17B card), or Section 17 and Section 17B TAA - used to identify the holder as having the delegated authority to exercise the powers of access under Section 17 TAA and to request the production of documents or information under Section 17B TAA (an IR 17 card).<br/>An unannounced visit can only be led by an officer who has completed the required training and who holds an IR 17 warrant card. A section 17 operation can only be led by an officer who has completed the required training, holds an IR17 warrant card and who has completed the specialist OIC training.<br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://example.com/InlandRevenueModel#CommunityComplianceOfficer> ;
        <http://example.com/InlandRevenueModel-current-#IsInvolvedInEvent>
                <http://example.com/InlandRevenueModel#UnannouncedVisit> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#DelegationOfAuthorityCard/AuthorityCards_en> , <http://example.com/InlandRevenueModel#DelegationOfAuthorityCard/DOACards_en> ;
        <http://example.com/NZ-IRD#Is-used-in-function>
                <http://example.com/InlandRevenueModel#DelegationsManagement> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Facilities Management SME"@en ;
        sem:guid          "cf313221-dd86-4e46-a9d0-d322b571db12" ;
        skos:broader      <http://smartlogic.com/term#81699006347435390763509> ;
        skos:related      <http://example.com/InlandRevenueModel#Section17Dataset> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#DelegationOfAuthorityCard/WarrantCard_en> , <http://example.com/InlandRevenueModel#DelegationOfAuthorityCard/WarrantsOfAuthority_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DelegationOfAuthorityCard/DelegationOfAuthorityCard_en> .

