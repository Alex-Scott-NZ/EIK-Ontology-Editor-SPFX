                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-21"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "6db8a030-aef9-590e-9c40-f8839371b354" ;
        skos:broader      <http://example.com/NZ-IRD#Depreciation-rate> ;
        skos:definition   "The percentage rate used to spread the cost of an asset or expense evenly over its useful life, so part of the cost is recognised each year rather than all at once. An amortisation rate is the rate set or approved by the Commissioner of Inland Revenue that determines how quickly certain capital expenses can be deducted for tax purposes. It commonly applies where the cost cannot be depreciated in the usual way because legislation requires amortisation instead of depreciation. It is set by a determination from the Commissioner for Inland Revenue. Horticultural plants, landfill cell construction, some land‑related or biological costs are examples. It often uses diminishing value as the method for setting the rate."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Plant> , <http://example.com/Cleaned-Inland-Revenue-model#Real-estate> , <http://example.com/IRD-test-model#Animal> ;
        skosxl:prefLabel  <http://smartlogic.com/label#34798519718308842567620_English> .

