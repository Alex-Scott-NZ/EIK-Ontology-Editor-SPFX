        skos:broader        <http://smartlogic.com/term#207151423851613694154930> ;
        skos:definition     "A customer activity of supplying information in response to a request, requirement, or interaction with Inland Revenue. Providing information is a reusable customer action that underpins multiple downstream processes (for example registration, validation, eligibility assessment, or account maintenance), without being tied to a specific product or decision pathway."@en ;
        skos:editorialNote  "This actually applies to third parties as well, for example service providers supplying receipts, but those are not obligations to IR."@en ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#ProvideInformation/ProvideInformation_en> .

