<http://example.com/IRD-test-model#Chief-Tax-Counsel>
        rdf:type          <http://example.com/IRD-test-model#Job-title0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Role description, 2025."@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "As a member of the Executive Leadership team, you will lead IR’s tax technical capability to enhance the tax and social policy system and champion IR’s customer centric and intelligence-led culture. You will determine the Commissioner's view of the law for IR, providing advice, direction and thought leadership to the Commissioner, the Executive Leadership Team and the organisation on complex tax and social policy technical issues to deliver the right outcomes for our customers, IR and the government."@en ;
