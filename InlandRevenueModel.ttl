<http://example.com/InlandRevenueModel#TimeLimitedFunding>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#TimeLimitedFunding/TLF_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://smartlogic.com/term#69937308930871997842709> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Business Partnering content"@en ;
        sem:guid          "753617c7-d860-4c2a-823f-b8bf2c5d6c99" ;
        skos:broader      <http://example.com/InlandRevenueModel#FundingModel> ;
        skos:definition   "\"Time-limited funding\" means a specific allocation of money that is available only for a predetermined, finite period, rather than being a permanent source of funds. Once the designated time or the funding limit is reached, the money runs out, and any projects or initiatives relying on it must end unless they secure alternative funding. This approach is often used for temporary initiatives, pilots, or to address urgent, short-term needs, but it can create \"funding cliffs\" if there's an expectation of ongoing service or maintenance."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TimeLimitedFunding/TimeLimitedFunding_en> .

