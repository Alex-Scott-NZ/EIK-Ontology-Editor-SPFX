<http://example.com/InlandRevenueModel#CustomerAndComplianceServices>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-participant-in>
                <http://example.com/InlandRevenueModel#IntegratedOperationalPlanning> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#CustomerAndComplianceServices/RatongaKiritakiMeTeTautukunga_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#CustomerAndComplianceServices/CCS_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Glossary"@en ;
        <http://example.com/InlandRevenueModel#UsesSystem>
                <http://example.com/InlandRevenueModel#GenesysVoicePlatform> , <http://example.com/InlandRevenueModel#VerintWFM> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "​Customer and Compliance Services (CCS) is made up of 2 groups: CCS – Individuals and CCS – Business. Together we are a team of approximately 3,200 people, in sites across the country. We’re the first point of contact for IR’s customers, from individuals through to families and local and international businesses. We provide tax technical and legal support for IR, and we’re connected to other agencies."@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://example.com/InlandRevenueModel#Capability-OutcomesSpecialist> , <http://example.com/InlandRevenueModel#CustomerComplianceSpecialist> , <http://example.com/InlandRevenueModel#CustomerSegmentLeader> , <http://example.com/InlandRevenueModel#CustomerServiceOfficer> ;
        <http://example.com/InlandRevenueModel-current-#ProducesAuthority>
                <http://example.com/InlandRevenueModel#ContentOwnershipModel> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#CustomerAndComplianceServices/CustomerAndComplianceServices_en0> , <http://example.com/InlandRevenueModel#CustomerAndComplianceServices/CustomerComplianceService_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Intranet; </p><p>Corporate Finance content</p>"@en ;
        sem:guid          "7839dd9e-f957-460c-be19-46b2ea7be155" ;
        skos:broader      <http://smartlogic.com/term#16463423238946451384634> ;
        skos:related      <http://example.com/InlandRevenueModel#CustomerExperienceDesigner> , <http://example.com/InlandRevenueModel#InlandRevenueProcessingStandards> ;
        skos:scopeNote    "Was roughly equivalent to Service Delivery"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CustomerAndComplianceServices/CustomerAndComplianceServices_en> .

<http://example.com/InlandRevenueModel#CustomerAndComplianceServices-Business>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#CustomerAndComplianceServices-Business/RatongaKiritakiMeTeTautukunga-Pakihi_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#CustomerAndComplianceServices-Business/CCS-B_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerActionsAndInteractions> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2022-07-12"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/customer-and-compliance-services/SitePages/What-we-do.aspx"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "CCS – business helps businesses to pay the right tax at the right time, from small to medium enterprises (SME) to not-for-profits to significant enterprises. Our people provide confident, accurate advice around complex and global tax issues. We work with a range of other agencies within New Zealand and internationally to provide connected services and reduce costs to customers and the government. We also provide tax technical and legal support for IR."@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#FinancialSectorRelationshipManagement> , <http://example.com/InlandRevenueModel-current-#TaxAgentManagement> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#CustomerAndComplianceServices-Business/CustomerAndComplianceServices-Business_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Intranet</p><div><p>Māori term from IR Māori translation register 2021</p></div>"@en ;
        sem:guid          "d07c918e-3b90-486b-9b1f-6aaf4e48d30e" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerAndComplianceServices> ;
        skos:definition   "CCS - business provides certainty and accuracy around complex and global tax compliance arrangements for small-to-medium-sized enterprises and significant enterprises.  This group also provides tax technical and legal support to Inland Revenue. (2025)"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CustomerAndComplianceServices-Business/CustomerAndComplianceServices-Business_en> .

