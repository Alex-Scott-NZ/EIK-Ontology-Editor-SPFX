<http://example.com/InlandRevenueModel#ObligationService>
        rdf:type          <http://example.com/InlandRevenueModel-current-#Services> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://smartlogic.com/term#63371402988779285059628> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsUsedIn>
                <http://example.com/Cleaned-Inland-Revenue-model#VoluntaryDisclosure> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-18"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Services (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>IR provides the ability to complete and submit a variety of returns and disclosures to Inland Revenue, as well as making obligation calculations based on information held by IR. The service includes the ability to change previously submitted information, request changes and provide additional information. IR also provides the ability for internal staff to take actions that impact customer obligations. <br>A disclosure can cover anything where the customer has an obligation to tell Inland Revenue about financial information that is used for assessing obligations and entitlements. <br><br>For relationship information, refer to Customer Relationship Service category. <br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR business services register"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#ObligationService/BSV.OS.000_en> ;
        sem:guid          "98a877f6-7195-4e4b-abe3-393789fe0a1f" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRBusinessService0> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ObligationService/ObligationService_en> .

<http://example.com/InlandRevenueModel#ObligationService/BSV.OS.000_en>
