<http://example.com/InlandRevenueModel#NationalHealthAndSafetyCommittee>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Register of Governance Bodies in IR - Architecture&nbsp;</p><p> </p><p><a href=\"https://irnz.sharepoint.com/sites/kc-architecture\">https://irnz.sharepoint.com/sites/kc-architecture</a></p><p> </p><p>​</p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The purpose is to discuss Health, Safety, and Wellbeing (HSW) matters at a national level, provide national oversight to the site HSW Committees, and create consistency in Committee led HSW initiatives at our sites. This also allows role progression for Health and Safety Representatives (HSRs) to look at the national picture of HSW at Inland Revenue.\n<br>This assists IR to manage risks to workers (including both our IR people and contracted workers) on our sites.<br></p>"@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://smartlogic.com/term#58633401800909789223072> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>CI&amp;A content; P&amp;C: H&amp;S content<!--EndFragment--><br/><br/></p>"@en ;
        sem:guid          "d5181264-2ae1-49bf-9983-d71a3671d8dd" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#NationalHealthAndSafetyCommittee/NHSC_en> , <http://example.com/InlandRevenueModel#NationalHealthAndSafetyCommittee/NationalHealthAndSafetyGovernanceCommittee_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#NationalHealthAndSafetyCommittee/NationalHealthAndSafetyCommittee_en> .

