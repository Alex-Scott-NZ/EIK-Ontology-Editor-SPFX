        <http://example.com/InlandRevenueModel#IsInformationRelatedTo>
                <http://example.com/InlandRevenueModel#Mediation> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Employment New Zealand"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate legal content"@en ;
        sem:guid          "e1a08cab-f1e6-4f6e-82d4-cf854b5a7650" ;
        skos:broader      <http://example.com/InlandRevenueModel#PeopleManagementInformation> ;
        skos:definition   "A Record of Settlement is a formal, written document that outlines the terms of an agreement reached between parties to resolve a dispute, particularly in employment law in New Zealand. It becomes legally binding and enforceable if signed by the parties and, in the context of employment, certified by a mediator from Employment Mediation Services. The document details the resolution of issues, often including payments and other conditions, and makes the agreement final and binding, preventing future legal claims over the same matters."@en ;
        skos:related      <http://example.com/InlandRevenueModel#LegalInformation> , <http://example.com/InlandRevenueModel#Record> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#RecordOfSettlement/Section149EmploymentRelationsAct2000_en> , <http://example.com/InlandRevenueModel#RecordOfSettlement/SettlementAgreement_en> ;
