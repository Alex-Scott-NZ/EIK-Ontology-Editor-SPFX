        skos:broader      <http://example.com/InlandRevenueModel#CustomerSegment> ;
        skos:related      <http://example.com/InlandRevenueModel#COVID-19ResurgenceSupportPaymentsScheme> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#SignificantEnterprise/SignificantEnterprise_en> .

