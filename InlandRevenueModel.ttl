<http://example.com/InlandRevenueModel#TeAwatea>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/Cleaned-Inland-Revenue-model#EngagementMaoriAndDiverseCommunities> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IKM Team created definition from various sources."@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Te Awatea is IRs learning programme to support IR people to build their Māori cultural capability. Explore the site to learn more about this mahi (work).</p><div>Te Awatea will take IR people on a learning journey that crosses three main spaces - Te Kore - the void, the unlimited potential, the Te Pō - the darkness, realised potential then into our whare ako, the house of learning, Te Awatea.<br>Te Awatea means the breaking of the day, the emergence of light. This is the place of enlightenment.<br><div>Launch 27 November 2024</div></div><div><br></div>"@en ;
        sem:guid          "664ea45c-f62a-4f9b-b74b-a8da3e6ee2a4" ;
        skos:broader      <http://example.com/IRD-test-model#Programe-or-project> ;
        skos:related      <http://example.com/InlandRevenueModel#TeAoMaori> , <http://smartlogic.com/term#24838370626904509442628> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TeAwatea/TeAwatea_en> .

