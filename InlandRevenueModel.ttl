        skos:historyNote  "No longer in existence. These functions are now done through myIR."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#FIRST> , <http://smartlogic.com/term#75420159540835943508606> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#MAASI/ManageAccountAccessStaffInterface_en> ;
