<http://example.com/InlandRevenueModel#InformationSharingMemorandaOfUnderstanding>
        rdf:type          <http://smartlogic.com/class#Agreement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/InlandRevenueModel#InformationSharingMemorandaOfUnderstanding/InformationSharingMoU_en> ;
        <http://example.com/Cleaned-Inland-Revenue-model#HasAgreementParty>
                <http://example.com/Cleaned-Inland-Revenue-model#FinancialMarketsAuthority> , <http://example.com/Cleaned-Inland-Revenue-model#LandInformationNewZealand> , <http://example.com/Cleaned-Inland-Revenue-model#MinistryOfSocialDevelopment> , <http://example.com/Cleaned-Inland-Revenue-model#StatisticsNewZealand> , <http://smartlogic.com/term#187171824070747682251094> , <http://smartlogic.com/term#32654355179300351753196963838704> , <http://smartlogic.com/term#34015113214144524595531> , <http://smartlogic.com/term#48265265052273404596923> , <http://smartlogic.com/term#60810046471901891558507> , <http://smartlogic.com/term#733873855465831453299914748155375> , <http://smartlogic.com/term#83892634052165504068826> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://example.com/InlandRevenueModel#SupplyDisclosureService> , <http://example.com/InlandRevenueModel-current-#InformationSharing> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "An operational document that sits alongside an information sharing or information matching agreement. The MOU is not a public document (unlike the agreements) and sets out how the agreement will work in practice. It outlines roles and functions of the agencies who are parties to an agreement, definitions, details of how information is to be transferred, used and stored, contact persons, financial responsibilities (if any) and other operational issues."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#InformationSharingMemorandaOfUnderstanding/GovernmentAgencyInformationSharing_en> , <http://example.com/InlandRevenueModel#InformationSharingMemorandaOfUnderstanding/Inter-agencyInformationSharing_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet"@en ;
        sem:guid          "8b25c7ca-dca0-4a69-8573-686e7ecd3514" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Government-contract> ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#ApprovedInformationSharingAgreement> , <http://example.com/Cleaned-Inland-Revenue-model#MemorandumOfUnderstanding> , <http://example.com/InlandRevenueModel-current-#InformationMatchingAgreement> ;
