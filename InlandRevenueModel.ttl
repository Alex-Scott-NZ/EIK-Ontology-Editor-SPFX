<http://example.com/InlandRevenueModel#ExclusionRules>
        rdf:type          <http://example.com/InlandRevenueModel#MetadataValue> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Data Domains and Sub-Domains, v2.5 2021"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Data that defines the precedence and priorities and other rules that allow the Campaign process to ensure that inclusion and exclusion rules are followed."@en ;
