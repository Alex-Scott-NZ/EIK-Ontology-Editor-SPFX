<http://example.com/Cleaned-Inland-Revenue-model#ImputationGroup>
        rdf:type          <http://smartlogic.com/class#Tax-payer-attribute> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel#ElectionToFormAnImputationGroup> , <http://example.com/InlandRevenueModel#ImputationGroupMaintenance> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
