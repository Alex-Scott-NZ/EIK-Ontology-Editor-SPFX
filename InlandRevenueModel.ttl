<http://example.com/InlandRevenueModel-current-#StudentLoanDeduction>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel-current-#EmployerDeductionsIR345> ;
        <http://example.com/InlandRevenueModel#Instance>
