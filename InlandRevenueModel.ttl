        skos:broader      <http://example.com/InlandRevenueModel#StrategyAndGovernanceInformation> ;
        skos:related      <http://example.com/InlandRevenueModel#Ethics> , <http://example.com/InlandRevenueModel-current-#PrivacyManagement> , <http://example.com/InlandRevenueModel-current-#Register> ;
