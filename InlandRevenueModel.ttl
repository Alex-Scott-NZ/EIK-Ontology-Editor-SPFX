<http://example.com/InlandRevenueModel#ProjectCapitalisation>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "When a project has met its delivery date(s), the capital expenditure of the project needs to be transferred out of the AUC account and into an asset, to allow the capital spend of the project to be depreciated.  For some projects this will be the end of the project, for others there may be more than one delivery date and therefore the capitalised amount may only be a % of the total project costs (a partial capitalisation)."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Portfolio Finance content; </p><p>Corporate Finance content</p>"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.2.1_Corporate_Planning_and_Reporting> ;
        sem:guid          "1c4df586-5af8-41ee-8e05-a5553d817437" ;
        skos:broader      <http://example.com/InlandRevenueModel#Capitalisation> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ProjectCapitalisation/ProjectCapitalisation_en> .

