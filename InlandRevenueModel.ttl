<http://example.com/InlandRevenueModel#DigitalRegistrationOfNewImmigrants>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-participant>
                <http://example.com/InlandRevenueModel-current-#ImmigrationNewZealand> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#DigitalRegistrationOfNewImmigrants/DRNI_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#DigitalRegistration> , <http://example.com/InlandRevenueModel#NewImmigrant> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://inlandrevenue.softlinkhosting.co.nz/liberty/opac/search.do?mode=BASIC&openDetail=true&corporation=InlandRevenue&action=search&queryTerm=ID%3D%2230288%22"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "As part of the Better Public Services Result 10, Immigration NZ (INZ) and Inland Revenue (IR) have partnered to implement the Digital Registration for New Immigrants (DRNI) initiative. This initiative allows data-sharing between the two agencies in order to streamline the process of applying for and receiving an IRD number for those migrants or visitors to New Zealand who hold a visa with work rights. Uptake by new migrants was well short of the target set by Result 10, so we wanted to identify what were the key barriers that could be addressed to increase the number of people making use of this service, (as well as identifying what's working well and shouldn't be changed)."@en ;
        <http://example.com/InlandRevenueModel-current-#InvolvesActivity>
                <http://example.com/InlandRevenueModel-current-#InformationSharing> ;
        <http://example.com/InlandRevenueModel-current-#IsSub-eventOf>
                <http://example.com/InlandRevenueModel#Result10> ;
        <http://example.com/NZ-IRD#Is-offered-by-supplier>
                <http://example.com/InlandRevenueModel#CustomerInsight> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS content"@en ;
        sem:guid          "07e778d4-8f73-4a43-9365-7d8ea31fc09c" ;
        skos:broader      <http://example.com/IRD-test-model#Programe-or-project> ;
        skos:historyNote  "This activity took place in 2018 as part of BPS and the initiative is now completed."@en ;
        skos:related      <http://example.com/InlandRevenueModel#IRDRegistration> , <http://smartlogic.com/term#102572455278684175104425> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DigitalRegistrationOfNewImmigrants/DigitalRegistrationOfNewImmigrants_en> .

