        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Families segment distributes Working for Families entitlements and paid parental leave, and collects and distributes child support payments. We do the important job of providing the right entitlements or payments at the right time, with empathy for each family’s situation. The Families segment is part of Customer and compliance services – individuals (CCS-I). We’re made up of 41 frontline teams and a team of analysts, spread across 11 sites."@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#CustomerSegmentation> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#FamiliesCustomerSegment/FamiliesCustomerSegment_en0> , <http://example.com/InlandRevenueModel#FamiliesCustomerSegment/FamiliesSegment_en> , <http://example.com/InlandRevenueModel#FamiliesCustomerSegment/WahangaKiritakiWhanau_en0> ;
