<http://example.com/InlandRevenueModel#OracleEnterpriseManager>
        rdf:type          <http://example.com/IRD-test-model#System> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#OracleEnterpriseManager/OEM_en> ;
        <http://example.com/InlandRevenueModel#Instance>
