        skos:broader      <http://example.com/InlandRevenueModel#Maoritanga> ;
        skos:definition   "Speech of greeting, tribute - introductory speeches at the beginning of a gathering after the more formal pōhiri. Often take place in the evening after karakia in the meeting house. The focus of mihimihi is on the living and peaceful interrelationships."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Mihimihi/Mihimihi_en> .

