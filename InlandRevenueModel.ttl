<http://smartlogic.com/term#209836142683206283258693>
        rdf:type          <http://smartlogic.com/class#Entitlement> , <http://smartlogic.com/class#Payment> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#BenefitsAdministration> , <http://example.com/InlandRevenueModel#RemunerationAdministration> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IR Website"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Payments made in addition to salary or wages, which benefit the employee. A benefit allowance is taxed with the employee's wages in the pay period it is paid. A benefit allowance may also include the provision of accommodation, food or clothing to an employee. The taxable benefit is the difference between the market value of the benefit provided and any amount the employee pays. Add the taxable value of the benefit to the employee's wages each pay period, and deduct PAYE from the total.<br/>Example. Market value of accommodation $150 per week. Less rent paid $90 per week. Value to be added to wages and taxed $60 per week. If the employee paid no rent, the value to be taxed would be $150 per week.<br/>The Commissioner's Statement CS 16/02 Determining &#34;Market Rental Value&#34; of Employer-Provided Accommodation provides guidance on determining the market rental value of accommodation. Gross wages for the purpose of calculating KiwiSaver deductions does not include the market value of board the employee receives in connection with their employment or payment of an allowance instead of the provision of this benefit.<br/></p>"@en ;
        <http://example.com/NZ-IRD#Is-entitlement-of>
                <http://smartlogic.com/term#214450621693017375393006> ;
        <http://example.com/NZ-IRD#Receives-payment>
                <http://smartlogic.com/term#214450622583028921698271> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "dd2f089b-670f-5fb2-8061-a75dff493407" ;
        skos:broader      <http://example.com/InlandRevenueModel#EmployeeAllowance> , <http://smartlogic.com/term#133464950737212625130954948425202> ;
        skos:definition   "<p>An allowance provided in addition to salary or wages that benefit the employee. Examples include:<br/>- food allowances<br/>- clothing allowances<br/>- accommodation allowances<br/>- farm or cottage board.<br/></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#TrainingIncentiveAllowance> , <http://smartlogic.com/term#149403043187561556930337> ;
        skosxl:prefLabel  <http://smartlogic.com/label#209836142683206283258693_English> .

