                "IR website"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://smartlogic.com/term#35238771405422338059868/1971No28_en> ;
        sem:guid          "8d6d1c54-4f46-50fe-8f7f-fcf886853bfb" ;
        skos:broader      <http://smartlogic.com/term#492768876094676199672439963971808> ;
        skos:definition   "Monies held in trust, including deposits in banks may eventually result in situations in which contact with the depositor is lost. These amounts become “unclaimed” and are transferred to IR. Such amounts are deposited into the Crown’s bank account and can be used by the Crown. These are known as Unclaimed monies (UCM). UCM is a contingent liability in the Crown’s accounts. The Crown does not pay interest on UCM when it is paid out to its owner. This act provides the legal rights to do this."@en ;
        skos:historyNote  "Date of assent 16 October 1971"@en ;
        skosxl:altLabel   <http://smartlogic.com/term#35238771405422338059868/UnclaimedMoneyAct_en> ;
        skosxl:prefLabel  <http://smartlogic.com/label#35238771405422338059868_English> .

