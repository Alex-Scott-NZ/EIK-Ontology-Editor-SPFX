        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>MICRO sized “trading” and most “non-trading” entities. These comprise self-employed, <br/>other individuals with micro business interests, micro businesses, similarly sized “trading” entities and various “non-trading” entities, i.e.: <br/>Sole traders and self-employed , with less than 6 employees, or less than $1m GST turnover<br/>Businesses, not-for-profits, Maori Authorities, Trusts &amp; Estates, Partnerships and other entities with less than 6 employees or less than $1m GST turnover<br/>Not-for-Profits, Maori Authorities, Trusts &amp; Estates, Partnerships and other entities not otherwise <br/>assigned (mostly “non-trading”).<br/>Main products: INC (PTS/IR3/IR4/IR6/IR7/IR8/IR9), Rebates/ KSS/SLS (Individuals), Debt, GST, PAYE/KSE/CSE/SLE/etc (employers).<br/></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel-current-#MicroEnterprise/MICRO-SME_en> , <http://example.com/InlandRevenueModel-current-#MicroEnterprise/MicroBusinessSegment_en> , <http://example.com/InlandRevenueModel-current-#MicroEnterprise/MicroCustomer_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS-I content; People Transition Hub; Data Science & Analytics content"@en ;
        sem:guid          "2d73d865-aec3-4783-825d-8714e68dc03d" ;
        skos:broader      <http://example.com/InlandRevenueModel#SmallBusinesses> ;
        skos:related      <http://example.com/InlandRevenueModel#COVID-19ResurgenceSupportPaymentsScheme> ;
