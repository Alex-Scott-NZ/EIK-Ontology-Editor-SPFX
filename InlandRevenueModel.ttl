        sem:guid          "a08dc70a-3e60-597e-b1ef-ed161dd8614e" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#ProjectDocumentation> ;
        skos:definition   "A Project Initiation Document (PID), sometimes called a project charter, is a comprehensive document that outlines a project's key details, such as its purpose, scope, objectives, stakeholders, risks, and budget, all gathered before the main planning phase begins. Its main function is to gain stakeholder approval and establish a clear, formal agreement between the project manager and the project sponsor, ensuring everyone understands the project's goals and direction from the outset."@en ;
        skos:historyNote  "Also known as Project Initiation Brief (old). Currently known as Project Delivery Charters."@en ;
        skosxl:altLabel   <http://smartlogic.com/term#165723513809851235794738/InitiationReport_en> ;
        skosxl:prefLabel  <http://smartlogic.com/label#165723513809851235794738_English> .

