        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Minister of Justice"@en .

<http://example.com/InlandRevenueModel#MinisterOfPolice>
