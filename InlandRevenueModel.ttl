<http://example.com/InlandRevenueModel#ChildSupportProgammeManagementGroup>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ChildSupportProgammeManagementGroup/CSPMG_en> ;
        <http://example.com/IRD-test-model#Is-managed-by>
