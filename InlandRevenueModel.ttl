        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A child who meets all of the following: Under 18, or under 19 and still at school; A New Zealand citizen or ordinarily resident in New Zealand; Not living in a marriage, civil union or de facto relationship; Not financially independent.<br/>A child is deemed to be financially independent if they are: In full employment; Receiving a student allowance; Receiving an income tested benefit; Receiving other Government financial support (does not include Working for Families, Section YA1 Income Tax Act 2007).<br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#IsRoleRelatedTo>
                <http://example.com/InlandRevenueModel#HagueConventionOnInternationalRecoveryOfChildSupportAndOtherFormsOfFamilyMaintenance> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website child support glossary"@en ;
        sem:guid          "14486916-a383-4789-ba23-c6fcae7ca669" ;
        skos:broader      <http://example.com/InlandRevenueModel#FamilyRoles> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#Qualifying-child/Qualifying-child_en> .

