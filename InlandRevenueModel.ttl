<http://example.com/InlandRevenueModel-current-#ChequeDutyRepealAct2014>
        rdf:type          <http://smartlogic.com/class#Law> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://smartlogic.com/term#636877416390326795854733487687643> ;
