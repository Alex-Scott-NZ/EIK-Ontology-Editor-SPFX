        sem:guid          "4d517168-2b7b-43b8-8e8c-da03c096e673" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#EmploymentAgreement> ;
        skos:definition   "<p>Conditions of employment refers to the full set of terms that govern the employment relationship between an employer and an employee.&nbsp;It is the formal, collective concept, usually set out in&nbsp;an employment agreement (individual or collective),&nbsp;legislation, and&nbsp;employer policies.<br>It covers what the employer and employee have agreed to overall, such as:&nbsp;pay and hours of work,&nbsp;leave entitlements,&nbsp;duties and responsibilities,&nbsp;place of work,&nbsp;termination and notice,&nbsp;rights and obligations of both parties.<br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#EmploymentConditionsDevelopment> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#ConditionsOfEmployment/ConditionsOfEmployment_en> .

