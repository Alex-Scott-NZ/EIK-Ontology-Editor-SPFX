<http://example.com/InlandRevenueModel#ChildSupportExemption>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#IRAuthority> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#ChildSupportExemption/NgaWhakawateatangaTautokoTamariki_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A liable parent can apply for an exemption for child support if they meet certain criteria. There are two types of exemption: Permanent - stopping child support liability for victims of sexual offences in certain circumstances; Temporary - stopping a child support or domestic maintenance liability while a person is a long-term prison inmate or hospital patient, or under 16 years of age. Exemption review - A process where a receiving carer can ask for a liable parent's exemption to be looked at and possibly overturned."@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://smartlogic.com/term#65946683017913937338444> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ChildSupportExemption/CSExemption_en> , <http://example.com/InlandRevenueModel#ChildSupportExemption/childTheExemptionIsGrantedFor_en> , <http://example.com/InlandRevenueModel#ChildSupportExemption/exemptionForOneChild_en> , <http://example.com/InlandRevenueModel#ChildSupportExemption/liableParentE28099sExemption_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "SD&I content. Māori term from Te Taura Whiri Māori Language Commission"@en ;
        sem:guid          "b203e652-8e00-42f8-a88e-40503b79ac1b" ;
        skos:broader      <http://smartlogic.com/term#487432373003867772618497633610116> ;
        skos:related      <http://example.com/InlandRevenueModel#ChildSupportLiability> , <http://example.com/InlandRevenueModel#Exemption> , <http://smartlogic.com/term#46576892232815290578744> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ChildSupportExemption/ChildSupportExemption_en> .

