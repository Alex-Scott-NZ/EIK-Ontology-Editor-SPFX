        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Loss to carry forward letter will be automatically issued if the following conditions are met: If a return is processed, and a Return Acknowledgement or Notice of Assessment is issued, and a loss carried forward balance exists. If a return is amended and there is a change in Residual Income Tax or Final Tax and a Notice of Assessment is issued, and a loss carried forward balance exists."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "3693700b-c570-4758-891b-1e04d388a2ec" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerObligationsAndEntitlements> ;
        skos:historyNote  "<p>Determination of loss is no longer used automatically. A Loss to carry forward letter is issued instead.<br><br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#Loss> , <http://example.com/InlandRevenueModel#Notice> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#NoticeOfDeterminationOfLoss/NoticeOfDeterminationOfLoss_en> .

