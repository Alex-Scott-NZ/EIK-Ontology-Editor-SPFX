                true ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#GovernanceAndCommunities> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2022-06-10"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>How IR is governed - Executive-Level Governance System (PDF)</p><div><p><br/></p></div><div><p><!--StartFragment--><a href=\"https://irnz.sharepoint.com/sites/News/SitePages/What-you-need-to-know-about-recent-changes-to-governance-at-IR.aspx\">What you need to know about recent changes to governance at IR (sharepoint.com)</a><!--EndFragment--><br/></p></div><p><br/></p><div><p><a href=\"https://irnz.sharepoint.com/sites/News/SitePages/What-you-need-to-know-about-recent-changes-to-governance-at-IR.aspx\">https://irnz.sharepoint.com/sites/News/SitePages/What-you-need-to-know-about-recent-changes-to-governance-at-IR.aspx</a></p></div>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Data and Information Governance Authority (DIGA) is one of the five executive-level governance bodies in Inland Revenue's Executive Governance System. The DIGA ensures right-sized, sustainable and efficient data and information governance that delivers oversight, transparency and accountability in IR’s stewardship and use of data and information as assets."@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#InformationAndDataGovernance> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#Data-IntelligenceGovernanceAuthority/DataAndIntelligenceGovernanceAuthority_en> ;
        <http://example.com/NZ-IRD#Offers-product-service>
                <http://example.com/InlandRevenueModel#ExecutiveGovernanceSystem> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "I&IS "@en ;
        sem:guid          "776695ca-7282-4efa-8b5e-0fff3a1a877d" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRExecutiveGovernanceGroups> ;
        skos:historyNote  "Establishment was endorsed by the Strategic Governance Board 2-10-2019"@en ;
        skos:related      <http://smartlogic.com/term#55018593238622116958346> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Data-IntelligenceGovernanceAuthority/Data-IntelligenceGovernanceAuthority_en> .

