                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Website glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "​The tax payable after deducting any tax credits from the total income tax payable for the income year. It does not include any: provisional tax paid for the year; Working for Families Tax Credits over or underpayment; voluntary payments. Residual income tax can also be a credit. Income Tax Act 2007, Section YA1 Definitions. "@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Website glossary; </p><p>Revenue Forecasting content</p>"@en ;
        sem:guid          "a99a691c-eeec-4a4e-85f6-98a97751659c" ;
        skos:broader      <http://example.com/InlandRevenueModel#IncomeTaxes> ;
        skos:definition   "The amount payable for the year, after deducting any tax credits from income tax assessed, but before deducting any provisional tax paid."@en ;
        skos:related      <http://example.com/InlandRevenueModel#WorkingForFamiliesTaxCredit> , <http://smartlogic.com/term#195867451054967333481936> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#ResidualIncomeTax/ResidualIncomeTax_en> .

