        sem:conceptMapping     sem:ConceptMappingOff ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Leaders of people focus primarily on coaching and enabling their people"@en .

<http://example.com/InlandRevenueModel#LeadershipDevelopmentCentre>
        rdf:type          <http://smartlogic.com/class#Commercial-organisation> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#LeadershipDevelopmentCentre/LDC_en> ;
        <http://example.com/InlandRevenueModel#HasMember>
                <http://smartlogic.com/term#733873855465831453299914748155375> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/te-pou-herenga/SitePages/External-leadership-development.aspx?web=1\">External leadership development</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "IR is a member agency of the LDC which means anyone can access a range of free resources and have the opportunity to apply for face-to-face and virtual development programmes for a fee. LDC is the primary supplier of leadership development within the public sector.  Whether you’re an aspiring or experienced leader, there are a range of resources for you. "@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/Cleaned-Inland-Revenue-model#LeadershipDevelopment> ;
        <http://example.com/NZ-IRD#Offers-product-service>
                <http://example.com/InlandRevenueModel-current-#OnlineTrainingCourse> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "P&C content."@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#LeadershipDevelopmentCentre/ManagementDevelopmentCentreTrust_en> ;
        sem:guid          "4d067d04-87eb-4c1f-8385-e28a0c303464" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#StateServicesCommission> ;
        skos:definition   "The Leadership Development Centre (LDC) is a business unit within Te Kawa Mataaho Public Service Commission that functions as a member organisation serving the public sector."@en ;
        skos:historyNote  "The LDC was originally settled as the Management Development Centre Trust in 1994.  The object of the trust was to establish and maintain a Management Development Centre in New Zealand as a centre for the development of excellence in senior public service leadership."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#LeadershipDevelopmentCentre/LeadershipDevelopmentCentre_en> .

