<http://example.com/InlandRevenueModel#StrategicFuturesSteeringGroup>
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-participant-in>
                <http://example.com/InlandRevenueModel#StrategicFuturesProgramme> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#StrategicFuturesSteeringGroup/SFSG_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://smartlogic.com/term#28946931813930496164431> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>An informal interagency group which meets to share thinking and expertise on major strategic issues facing New Zealand. Members come from the fields of strategy, futuring, strategic policy, and planning.<br/></p><p>Formed in February 2017, the Strategic Futures Group studies<br/>trends and emerging risks that may affect government and New Zealand society over the long term – five years, ten years, and even thirty years into the future.</p>"@en ;
        <http://example.com/NZ-IRD#Does-activity>
