<http://example.com/Cleaned-Inland-Revenue-model#ActiveIncomeExemption>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#IRAuthority> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The active income exemption is only relevant where the attributable FIF income method is applied to FIF interest. The attributable FIF income method is based on the controlled foreign company rules. In summary, if FIF interest is greater than 10% and has less than 5% passive income, then all the FIF income is exempt, or if greater than 10% and passive income is greater than 5%, then only the passive income is taxable. The active income is exempt. "@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website glossary"@en ;
        sem:guid          "da8543c2-fbb0-4359-8490-3d1e9ad77add" ;
        skos:broader      <http://example.com/InlandRevenueModel#TaxExemption> ;
        skos:related      <http://example.com/InlandRevenueModel#Exemption> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#ActiveIncomeExemption/ActiveIncomeExemption_en> .

