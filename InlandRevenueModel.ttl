                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "​The OECD is an intergovernmental economic organisation with 36 member countries, founded in 1961 to stimulate economic progress and world trade."@en ;
        <http://example.com/InlandRevenueModel-current-#ProducesAuthority>
                <http://example.com/InlandRevenueModel#TaxControlFramework> , <http://example.com/InlandRevenueModel-current-#ConventionOnMutualAdministrativeAssistanceInTaxMatters> , <http://example.com/InlandRevenueModel-current-#ModelTaxConventionOnIncomeAndOnCapital> , <http://example.com/InlandRevenueModel-current-#MultilateralConventionToImplementTaxTreatyRelatedMeasuresToPreventBEPS> ;
        <http://example.com/NZ-IRD#Offers-product-service>
                <http://example.com/InlandRevenueModel#ATPDirectory> , <http://example.com/InlandRevenueModel#ForumOnHarmfulTaxPractices> , <http://example.com/InlandRevenueModel#ForumOnTaxAdministration> , <http://example.com/InlandRevenueModel#GenderBalanceNetwork> , <http://example.com/InlandRevenueModel#OECDEconomicsDepartmentWorkingParty> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "OCTC content; CI&A content"@en ;
        sem:guid          "5d600f2a-0581-46ac-aea5-e134a22a5cb8" ;
        skos:broader      <http://smartlogic.com/term#188519164724691362719453> ;
        skos:definition   "The OECD is an international organization of democratic countries with market economies that promotes sustainable economic growth and prosperity by setting global standards and providing data-driven policy analysis. It serves as a forum for governments to share best practices, exchange experiences, and seek solutions to shared problems, covering areas like economic growth, environmental sustainability, education, employment, and taxation. Established in 1961, the OECD has headquarters in Paris and works to improve the well-being of people worldwide through evidence-based policymaking."@en ;
        skos:related      <http://example.com/InlandRevenueModel#OECDReporting> ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#OECD/OrganisationForEconomicCo-operationAndDevelopment_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#OECD/OECD_en> .

