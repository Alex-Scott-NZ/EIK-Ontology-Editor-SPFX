<http://example.com/InlandRevenueModel#IRIsACapability-basedOrganisation>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "People Capabilities Approach, Dec 2015"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "We have 12 People Capabilities that span the whole of IR. Capabilities are a mix of skills, knowledge, experience and attitudes. These are 'descriptive' not 'prescriptive' because we expect people to adapt them on the job in line with their context. Most people will need fundamental capabilities with 1-2 at applied. We don't need to all get to 'expert'."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><br/>http://intranet.ird.govt.nz//infoweb/sites/default/files/20200928-Recap%20-%20some%20key%20design%20features.JPG<br/></p>"@en ;
        sem:guid          "b66121f4-f8b3-44f6-be30-0c9a05c07ea4" ;
        skos:broader      <http://example.com/InlandRevenueModel#FOMPrinciple2020> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IRIsACapability-basedOrganisation/IRIsACapability-basedOrganisation_en> .

<http://example.com/InlandRevenueModel#IRIsACapability-basedOrganisation/IRIsACapability-basedOrganisation_en>
        rdf:type               skosxl:Label ;
        sem:autocompletion     sem:AutocompletionOff ;
        sem:conceptMapping     sem:ConceptMappingOff ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "IR is a capability-based organisation"@en .

<http://example.com/InlandRevenueModel#IRIsAgile>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Org Design Blueprint - cultural anchors 2015."@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Our roles, teams, behaviours, processes, governance and decision making are designed to enable fast and effective responsiveness and adaptation. We form and reform networks and teams as required to solve problems and take opportunities. We work effectively within a wider ecosystem that enables us to respond to emerging trends and partner where we need to. We can work flexibly and remotely and we offer this as a value proposition to our people, customers and partners."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "http://intranet.ird.govt.nz//infoweb/sites/default/files/20200928-Recap%20-%20some%20key%20design%20features.JPG"@en ;
        sem:guid          "104ffda0-10b8-494c-a7b9-cb8027ec6e3f" ;
        skos:broader      <http://example.com/InlandRevenueModel#FOMPrinciple2020> ;
        skos:related      <http://example.com/InlandRevenueModel#Agile> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IRIsAgile/IRIsAgile_en> .

<http://example.com/InlandRevenueModel#IRIsAgile/IRIsAgile_en>
        rdf:type               skosxl:Label ;
        sem:autocompletion     sem:AutocompletionOff ;
        sem:conceptMapping     sem:ConceptMappingOff ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "IR is agile"@en .

<http://example.com/InlandRevenueModel#IRIsCustomerCentric>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Org Design Blueprint - KDD1+2, cultural anchors 2015."@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "We provide proactive customer support, relevant to points in the customer lifecycle. People have clear accountability to take an integrated approach to the delivery of services to customers. We segment our customers (external and internal) in order to understand their lifecycle, how to support them to get it right from the start, and to tailor our interventions to where we get maximum value for IR and for customers."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "http://intranet.ird.govt.nz//infoweb/sites/default/files/20200928-Recap%20-%20some%20key%20design%20features.JPG"@en ;
        sem:guid          "c521319d-8519-4f04-9f21-ae94ba6e6d45" ;
        skos:broader      <http://example.com/InlandRevenueModel#FOMPrinciple2020> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IRIsCustomerCentric/IRIsCustomerCentric_en> .

<http://example.com/InlandRevenueModel#IRIsCustomerCentric/IRIsCustomerCentric_en>
        rdf:type               skosxl:Label ;
        sem:autocompletion     sem:AutocompletionOff ;
        sem:conceptMapping     sem:ConceptMappingOff ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "IR is customer centric"@en .

<http://example.com/InlandRevenueModel#IRIsInclusive>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Cultural anchors update 2019"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "We value the diversity of experience and perspectives our people bring to their work and workplace, and we encourage them to bring their whole self to work through capability-based roles, whanake and devolved decision making. We listen to and co-design with customers and partners, taking on existing approaches and processes rather than always designing IR-bespoke ones."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "http://intranet.ird.govt.nz//infoweb/sites/default/files/20200928-Recap%20-%20some%20key%20design%20features.JPG"@en ;
        sem:guid          "fa685763-a600-4bcb-a0a1-91a36552aeea" ;
        skos:broader      <http://example.com/InlandRevenueModel#FOMPrinciple2020> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IRIsInclusive/IRIsInclusive_en> .

<http://example.com/InlandRevenueModel#IRIsInclusive/IRIsInclusive_en>
        rdf:type               skosxl:Label ;
        sem:autocompletion     sem:AutocompletionOff ;
        sem:conceptMapping     sem:ConceptMappingOff ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "IR is inclusive"@en .

<http://example.com/InlandRevenueModel#IRIsIntelligence-led>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Org Design Blueprint - KDD3, cultural anchors 2015."@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "We use consolidated intelligence and information across the organisation to support effective decision making. We enable devolved decision making through the accessibility of data and information in real time, usable formats. We use intelligence and information to drive choices about investment, intervention, automation, experience, design, etc."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "http://intranet.ird.govt.nz//infoweb/sites/default/files/20200928-Recap%20-%20some%20key%20design%20features.JPG"@en ;
        sem:guid          "28ad8a45-30cd-4f43-87e4-35d81a3da04b" ;
        skos:broader      <http://example.com/InlandRevenueModel#FOMPrinciple2020> ;
        skos:related      <http://example.com/InlandRevenueModel#Intelligence-led> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IRIsIntelligence-led/IRIsIntelligence-led_en> .

<http://example.com/InlandRevenueModel#IRIsIntelligence-led/IRIsIntelligence-led_en>
        rdf:type               skosxl:Label ;
        sem:autocompletion     sem:AutocompletionOff ;
        sem:conceptMapping     sem:ConceptMappingOff ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "IR is intelligence-led"@en .

<http://example.com/InlandRevenueModel#IRLegalTechnicalRole>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CoPilot"@en ;
        sem:guid          "d1444d46-c62d-4dd1-8271-889bac1af22b" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRRole> ;
        skos:definition   "<p>People in technical roles work out what the law, policy, or rules actually mean in complex situations. They provide expert advice, guidance, or decisions that others rely on.<br>They don’t usually handle day‑to‑day customer queries. Instead, they support customer service and compliance staff by giving authoritative answers.<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IRLegalTechnicalRole/IRLegalTechnicalRole_en> .

<http://example.com/InlandRevenueModel#IRLegalTechnicalRole/IRLegalTechnicalRole_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "IR legal technical role"@en .

<http://example.com/InlandRevenueModel#IRMakesEffectiveUseOfTechnology-ProcessesAndPartners>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Org Design Blueprint - KDD8, 2015, Common Service Model, 2018"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Where possible, we use automation and straight-through processing to reduce our organisational effort on low value, high volume transactions and free up capacity to focus on the high value, complex or new. We maximise our investment in tools and technology to support how we work as well as what we work on. We use standardised processes and external delivery partners where it makes sense to do so."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "http://intranet.ird.govt.nz//infoweb/sites/default/files/20200928-Recap%20-%20some%20key%20design%20features.JPG"@en ;
        sem:guid          "15ada94e-a0dc-489f-b437-bb03105487e5" ;
        skos:broader      <http://example.com/InlandRevenueModel#FOMPrinciple2020> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IRMakesEffectiveUseOfTechnology-ProcessesAndPartners/IRMakesEffectiveUseOfTechnology-ProcessesAndPartners_en> .

<http://example.com/InlandRevenueModel#IRMakesEffectiveUseOfTechnology-ProcessesAndPartners/IRMakesEffectiveUseOfTechnology-ProcessesAndPartners_en>
        rdf:type               skosxl:Label ;
        sem:autocompletion     sem:AutocompletionOff ;
        sem:conceptMapping     sem:ConceptMappingOff ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "IR makes effective use of technology, processes and partners"@en .

<http://example.com/InlandRevenueModel#IROperatesAsANetwork-WithPeopleComingTogetherToSolveProblems-RealiseOpportunities-AndDeliverEnd-to-end>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><!--StartFragment--><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">Org Design Blueprint 2015, CCS/IIS Design 2017</span><!--EndFragment--></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Networks become the way that work gets done, with people in specific areas having accountability for forming and facilitating networks on particular processes or issues (e.g. ED&I, CXD). Design of functions is based on the ability and flexibility to network in expertise and support as needed, and to supply people to work in networks as required. This enables agility."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "http://intranet.ird.govt.nz//infoweb/sites/default/files/20200928-Recap%20-%20some%20key%20design%20features.JPG"@en ;
        sem:guid          "273ea9c1-415d-481f-b098-836543d0b3b8" ;
        skos:broader      <http://example.com/InlandRevenueModel#FOMPrinciple2020> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IROperatesAsANetwork-WithPeopleComingTogetherToSolveProblems-RealiseOpportunities-AndDeliverEnd-to-end/IROperatesAsANetwork-WithPeopleComingTogetherToSolveProblems-RealiseOpportunities-AndDeliverEnd-to-end_en> .

<http://example.com/InlandRevenueModel#IROperatesAsANetwork-WithPeopleComingTogetherToSolveProblems-RealiseOpportunities-AndDeliverEnd-to-end/IROperatesAsANetwork-WithPeopleComingTogetherToSolveProblems-RealiseOpportunities-AndDeliverEnd-to-end_en>
        rdf:type               skosxl:Label ;
        sem:autocompletion     sem:AutocompletionOff ;
        sem:conceptMapping     sem:ConceptMappingOff ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "IR operates as a network, with people coming together to solve problems, realise opportunities, and deliver end-to-end"@en .

<http://example.com/InlandRevenueModel#IRPeople>
        rdf:type            <http://example.com/InlandRevenueModel#MetadataValue> ;
