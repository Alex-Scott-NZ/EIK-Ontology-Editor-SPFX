                "OCTC content"@en ;
        sem:guid          "52ac8cb0-fbaf-423f-8505-7001f1b283dd" ;
        skos:broader      <http://smartlogic.com/term#198788318597836492471216> ;
        skos:definition   "The Vienna Convention on the Law of Treaties (VCLT) is the key international treaty that codifies the rules governing treaties between states, establishing a legal framework for how they are made, applied, and terminated. Adopted in 1969, it covers how treaties are defined, concluded, interpreted, and amended, as well as the grounds for their invalidity, termination, and suspension. The VCLT is widely considered the \"treaty on treaties\" and serves to promote international cooperation and the peaceful resolution of disputes. "@en ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#ViennaConventionOnTheLawOfTreaties1969/ViennaConventionOnTheLawOfTreaties1969_en> .

<http://example.com/Cleaned-Inland-Revenue-model#ViennaConventionOnTheLawOfTreaties1969/VCLT_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "VCLT"@en .

