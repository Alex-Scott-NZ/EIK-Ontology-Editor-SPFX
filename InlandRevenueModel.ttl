                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "https://www.gln.govt.nz/"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "LMU content; Corporate Legal content"@en ;
        sem:guid          "91f872b9-3bd0-41fb-bb56-fb0aee34f63f" ;
        skos:broader      <http://example.com/IRD-test-model#Professional-group> ;
        skos:definition   "The Government Legal Network (GLN) is a collaborative initiative of the Solicitor-General and departmental Chief Legal Advisors, on behalf of their Chief Executives. GLN membership encompasses all lawyers employed by Public Service departments (including Crown Law) plus the NZ Police, NZ Defence Force and the Parliamentary Counsel Office (around 850 lawyers). Crown entity lawyers currently participate in some GLN activities, to the extent that privilege and conflict considerations permit (another 400 lawyers). The purpose of the GLN is to leverage the collective legal resources and expertise of the Crown to support the government in the lawful delivery of services to New Zealanders."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Barrister> , <http://example.com/InlandRevenueModel#GovernmentOfNewZealand> , <http://example.com/InlandRevenueModel#Inter-agencyGroup> , <http://example.com/InlandRevenueModel#Lawyer> , <http://example.com/InlandRevenueModel#Solicitor> ;
        skosxl:prefLabel  <http://example.com/IRD-test-model#Government-Legal-Network-/Government-Legal-Network-_en> .

