<http://example.com/InlandRevenueModel#ProtectiveSecurityRequirements>
        rdf:type          <http://smartlogic.com/class#Government-policy> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://example.com/InlandRevenueModel#ProtectiveSecurityRequirementsReport> , <http://example.com/InlandRevenueModel-current-#InformationSecurityManagement> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ProtectiveSecurityRequirements/PSR_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#ProtectiveSecurityRequirements/ProjectStatusReport_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "https://protectivesecurity.govt.nz/about-the-psr/overview/"@en ;
        <http://example.com/InlandRevenueModel-current-#UsesModel>
                <http://example.com/InlandRevenueModel#Framework> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate Security content"@en ;
        sem:guid          "fe7211f8-644b-4859-abb3-7dfc9be2ac88" ;
        skos:broader      <http://example.com/InlandRevenueModel#GovernmentPolicy> ;
        skos:definition   "<p>The PSR is a policy framework that sets out what your organisation must do to manage security effectively. It also contains best practice guidance you should consider following. The PSR is suitable for both public and private sector organisations.<br/>Effective security enables New Zealand organisations to work together securely in an environment of trust and confidence. Protecting your people, information, and assets helps your organisation to meet its strategic and operational objectives.<br/></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ProtectiveSecurityRequirements/ProtectiveSecurityRequirements_en> .

