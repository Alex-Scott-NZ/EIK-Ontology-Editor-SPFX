<http://example.com/Cleaned-Inland-Revenue-model#Carer>
        rdf:type          <http://smartlogic.com/class#Role> ;
        rdfs:comment      "The business definition from START Help is specifically focused on child support, so may not be appropriate for this concept."@en ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#PaymentWaivers> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsValidFor>
                <http://example.com/InlandRevenueModel#EstablishEligibility> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>​​A carer is defined as a person (not limited to the parent) who provides on-going daily care to a child and care can be recognised only where the intention is that care will be on-going.</p><p><br></p><p>A guardian is about decision‑making responsibility; a carer is about day‑to‑day care. One person may be both, but they are not always the same.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Customer Insight content"@en ;
        sem:guid          "da2f9bb1-9bb4-4bd4-8210-433f5c758fbc" ;
        skos:broader      <http://example.com/InlandRevenueModel#FamilyRoles> ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Guardian> , <http://example.com/InlandRevenueModel#FlexibleRespiteBudget> , <http://smartlogic.com/term#46576892232815290578744> , <http://smartlogic.com/term#85430349453040543166524> ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#Carer/Caregiver_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#Carer/Carer_en> .

