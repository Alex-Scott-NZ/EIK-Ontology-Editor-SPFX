                "IR knowledgebase"@en ;
        sem:guid          "c7fc8680-9440-45e6-9a57-d23e6953a7e2" ;
        skos:broader      <http://example.com/NZ-IRD#Profession0> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PrivateDomesticWorker/PrivateDomesticWorker_en> .

