                false ;
        <http://example.com/InlandRevenueModel#IsInformationRelatedTo>
                <http://example.com/InlandRevenueModel#UnclaimedMoneyClaimant> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-20"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling"@en ;
        sem:guid          "5e15db9f-8bac-4138-8321-886e23ae0678" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerIdentityInformation> ;
        skos:definition   "Proof (or evidence) of identity is information or documents used to confirm a person’s identity, such as their name, date of birth, or photograph, so it can be verified that they are the right person."@en ;
