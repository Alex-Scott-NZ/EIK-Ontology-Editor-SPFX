        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>An Employee share scheme (ESS) is an arrangement for issuing or transferring shares in a company to past, present and future employees. The arrangement must be connected to the person's employment or service. This includes transfers to directors or shareholder-employees in a company, the transfer of shares in a group company and transfers to associates.<br>The value of the ESS is declared in the employment information return, even if no tax is withheld from it.</p><p><br></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://smartlogic.com/term#97426359325368100811245/ESSBenefits_en> , <http://smartlogic.com/term#97426359325368100811245/ESSDeferral_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website; PAS content"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://smartlogic.com/term#97426359325368100811245/PR.T.022_en> ;
        sem:guid          "f3d639d5-afc5-51a2-8847-b4f93e4e7e58" ;
        skos:broader      <http://smartlogic.com/term#32367411335895523177952203629346> ;
        skos:definition   "An arrangement with a purpose or effect of issuing or transferring shares in a company to a person who will be, is, or has been an employee (or shareholder-employee) of that company or of another company in the same group, or to an associate of the person, if the arrangement is connected to the person’s employment or service."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#ExecutiveShareScheme> ;
