<http://example.com/InlandRevenueModel#StrategicArchitecture>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#StrategicArchitecture/HoahoaRautaki_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-strategic-architecture/SitePages/What-we-do.aspx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Strategic Architecture brings together our strategy and the architecture functions as one team. By joining these services, we aim to ensure that the strategies we develop are grounded and understandable for everyone at IR, and there is a clear link between strategy and implementation. Strategic Architecture aims to enable the translation of strategy and policy into integrated, connected and feasible design, ensuring the alignment and integrity of cross-organisational frameworks, processes and systems. As a team we provide oversight and assurance of innovation and excellence in relation to architecture principles and patterns across the organisation, supporting IR’s decision making by providing holistic architecture expertise, system-wide thinking and an end-to-end perspective."@en ;
        <http://example.com/NZ-IRD#Offers-product-service>
                <http://example.com/InlandRevenueModel#DesignAuthority> , <http://example.com/InlandRevenueModel#IRBusinessService0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Māori term supplied by the Māhutonga Team 2022."@en ;
        sem:guid          "a7d42500-ee14-4c6c-a631-6009cbc78dad" ;
        skos:broader      <http://example.com/InlandRevenueModel#Enterprise-IntegrityServices> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#StrategicArchitecture/StrategicArchitecture_en> .

