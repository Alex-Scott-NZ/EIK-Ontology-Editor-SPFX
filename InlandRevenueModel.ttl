<http://example.com/Cleaned-Inland-Revenue-model#QualifyingCollectiveInvestmentVehicle>
        rdf:type          <http://example.com/InlandRevenueModel#FinancialProduct> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/Cleaned-Inland-Revenue-model#QualifyingCollectiveInvestmentVehicle/CIV_en> , <http://example.com/Cleaned-Inland-Revenue-model#QualifyingCollectiveInvestmentVehicle/QCIV_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/Cleaned-Inland-Revenue-model#CollectiveInvestmentVehicle> , <http://smartlogic.com/term#453176854918441235275578611099068> , <http://smartlogic.com/term#755742870035676660272218483926388> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/kc-income-tax/SitePages/collective-investment-vehicles.aspx?web=1\">Collective investment vehicles</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A Collective Investment Vehicle (CIV) is an entity that pools funds on behalf of investors for investment purposes. The Income Tax Act 2007 Section YA1) contains the definitions of a group investment fund, superannuation scheme, superannuation fund, and unit trust.<br><br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website; OCTC content"@en ;
        sem:guid          "9e17901f-d004-423f-8b32-edf43e918414" ;
        skos:broader      <http://smartlogic.com/term#44042442706048495183340> ;
        skos:historyNote  "The term Qualifying Collective Investment Vehicle seems to have been used only in 2004-2007 while discussions on the new Income Tax Act (2007) were taking place. After that only Collective Investment Vehicle was used."@en ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#QualifyingCollectiveInvestmentVehicle/QualifyingCollectiveInvestmentVehicle_en0> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#QualifyingCollectiveInvestmentVehicle/QualifyingCollectiveInvestmentVehicle_en> .

