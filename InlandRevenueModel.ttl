        <http://example.com/NZ-IRD#Source-of-term>
                "Business partnering content"@en ;
        sem:guid          "bcc91988-9ff2-45a0-b3e7-dd7bc63a088f" ;
        skos:broader      <http://example.com/InlandRevenueModel#PeopleManagementInformation> ;
        skos:definition   "A performance improvement plan (PIP) is a document that aims to help employees who are not meeting job performance goals. A PIP covers specific areas of performance deficiencies, identifies skills or training gaps and sets clear expectations for an associate's future conduct."@en ;
