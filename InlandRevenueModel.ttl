        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://www.digital.govt.nz/digital-government/strategy/strategy-summary\">Strategy for a Digital Public Service | NZ Digital government</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#IAAuthorityProducedBy>
                <http://smartlogic.com/term#34015113214144524595531> ;
        <http://example.com/NZ-IRD#Source-of-term>
