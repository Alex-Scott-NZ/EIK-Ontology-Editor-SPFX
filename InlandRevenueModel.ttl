        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Annual Report 2016"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A New Zealand Business Number (NZBN) is a 13 digit universal identifier which enables businesses to easily update, share key information and interact with each other. The Companies Office has allocated NZBNs to companies since 31 October 2013. Some companies may use the NZBN in their correspondence and transactions with Inland Revenue. In START, this number is recorded as an ID under the Customer springboard and can be used to search for the customer. Refer to START Help: ID types and formats and Search for Customers and Accounts. "@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Annual Report 2016; START"@en ;
        sem:guid          "10583f1e-a297-4fbb-95fb-738f76c99053" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#GlobalIntermediaryIdentificationNumber> ;
        skos:definition   "A unique business identifier assigned to businesses in New Zealand"@en ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#NewZealandBusinessNumber/NZBN_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#NewZealandBusinessNumber/NewZealandBusinessNumber_en> .

