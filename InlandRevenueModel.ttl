<http://example.com/InlandRevenueModel#Customer-centricCommittee>
        rdf:type          <http://example.com/InlandRevenueModel#NotCurrent> , <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#Customer-centricCommittee/CCC_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#Customer-centricCommittee/ChristchurchCityCouncil_en> , <http://example.com/InlandRevenueModel#Customer-centricCommittee/CodeComplianceCertificate_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Customer Centric Committee Charter 2019 revision"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Customer-centric Committee (CC) forms a part of IR's executive level governance system. It's role is to provide overall direction and strategic decision-making in the area of customer centricity for the organisation, and ensure we are operating from a customer-centric point of view. The Committee will be the steward of the customer-centric and intelligence-led blueprints."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#Customer-centricCommittee/CCMembers_en> , <http://example.com/InlandRevenueModel#Customer-centricCommittee/Customer-Centric_en> , <http://example.com/InlandRevenueModel#Customer-centricCommittee/Customer_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet; Governance & Integrity content; CCS-I content"@en ;
        sem:guid          "b8b37ac9-0b00-4752-91ff-05f4f8958e41" ;
        skos:broader      <http://example.com/InlandRevenueModel#_PreviousBoards-CommitteesOrGroups-> ;
        skos:historyNote  "<p><span style=\"color: black;\">Ran from August 2017 to October 2019.<br/>Was approved to be place in hiatus in February 2020 by CIR with<br/>responsibilities passing to SBG at high level. In August 2020 was approved by<br/>CIR that this committee would not be restarted, alongside Organisation Development Committee and Performance and Investment Committee as IR would move forward with streamlined executive level governance model.</span><span></span></p>"@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#Customer-centricCommittee/CustomerCentricityCommittee_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Customer-centricCommittee/Customer-centricCommittee_en> .

