<http://example.com/InlandRevenueModel#Crypto-assetReportingFramework>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#Crypto-assetReportingFramework/CARF_en> , <http://example.com/InlandRevenueModel#Crypto-assetReportingFramework/CRF_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The Crypto-Asset Reporting Framework (CARF) is a global initiative led by the Organisation for Economic Co-operation and Development (OECD) to improve transparency in crypto‑asset transactions. It requires crypto‑asset service providers to report relevant information to tax authorities, similar to the Common Reporting Standard (CRS). By doing so, the framework helps authorities identify tax evasion risks and enhance overall tax compliance.<br><br>The&nbsp;first reporting period&nbsp;in New Zealand is from 01 April 2026 to 31 March 2027. Filing will commence from 01 April 2027.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>IR business products register<br><br></p>"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#Crypto-assetReportingFramework/PR.ID.008_en> ;
        sem:guid          "b0b07874-fea8-463f-82c2-66a3cd286244" ;
        skos:broader      <http://example.com/InlandRevenueModel#InternationalDisclosures> ;
        skos:related      <http://example.com/InlandRevenueModel#Cryptoasset> , <http://example.com/InlandRevenueModel#FinancialReporting> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Crypto-assetReportingFramework/Crypto-assetReportingFramework_en> .

<http://example.com/InlandRevenueModel#Crypto-assetReportingFramework/CARF_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "CARF"@en .

<http://example.com/InlandRevenueModel#Crypto-assetReportingFramework/CRF_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "CRF"@en .

