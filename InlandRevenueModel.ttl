<http://example.com/Cleaned-Inland-Revenue-model#AvailableSubscribedCapital>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#MoneyHeld> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/Cleaned-Inland-Revenue-model#AvailableSubscribedCapital/ASC_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://www.taxtechnical.ird.govt.nz/interpretation-statements/is9708-available-subscribed-capital-consequences-of-deemed-reregistration\">Available subscribed capital - consequences of deemed reregistration</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The amount calculated in accordance with the following formula in respect of all shares of the same class (referred to in this definition as the \"specified class\") as the share: a + b - c where 'a' is (i) In the case of any company which existed before 1 July 1994, the transitional capital amount; and (ii) In any other case, nil; and 'b' is the aggregate amount of consideration received by the company on or after 1 July 1994 and before the relevant time in respect of the issue of all shares in the company of the specified class, including as consideration; and 'c' is the aggregate of amounts distributed (i) Upon the acquisition, redemption, or other cancellation by the company of shares in the company of the specified class; and (ii) On or after 1 July 1994 and before the relevant time."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "TIB index; Website"@en ;
        sem:guid          "5c932858-79b7-4707-9f78-4b98057ea0e4" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Capital> ;
        skos:definition   "Under the Income Tax Act 1994, the concept of “available subscribed capital” (ASC) is important in determining whether a distribution by a company to its shareholders is a dividend or a return of capital."@en ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#AvailableSubscribedCapital/AvailableSubscribedCapital_en> .

