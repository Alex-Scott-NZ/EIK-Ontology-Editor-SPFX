        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#NewZealandFinancialInstitution> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#NewZealandReportingFinancialInstitution/NewZealandReportingFinancialInstitution_en> .

