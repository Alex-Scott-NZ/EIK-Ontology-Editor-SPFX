<http://example.com/InlandRevenueModel#EnterpriseSecurityReferenceArchitecture>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#EnterpriseSecurityReferenceArchitecture/ESRA_en> ;
