                <http://example.com/InlandRevenueModel#NewZealandQualificationsAndCredentialsFramework/NZQCF_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://www2.nzqa.govt.nz/assets/Qualifications-standards/Understanding-NZQF/The-New-Zealand-Qualifications-and-Credentials-Framework.pdf\">The New Zealand Qualifications and Credentials Framework</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR main website - Fees Free"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#NewZealandQualificationsAndCredentialsFramework/NewZealandQualificationsFramework_en> ;
        sem:guid          "3e758aff-7daf-46dd-b4c6-0225a93fe190" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Enterprise-model> ;
        skos:definition   "The core architecture of the NZQCF is unchanged from the previous New Zealand Qualifications Framework (NZQF), ensuring it fulfils its primary function as the definitive source of accurate information about all quality assured qualifications and credentials. At its core, the NZQCF is a hierarchy of levels of knowledge and skills that describe what graduates know and can do, along with the characteristics of learning at each level."@en ;
        skos:related      <http://example.com/InlandRevenueModel#FeesFreeTertiaryEducation> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#NewZealandQualificationsAndCredentialsFramework/NewZealandQualificationsAndCredentialsFramework_en> .

