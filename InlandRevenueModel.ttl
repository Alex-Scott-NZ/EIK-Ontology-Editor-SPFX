<http://example.com/Cleaned-Inland-Revenue-model#OECD>
        rdf:type          <http://smartlogic.com/class#Commercial-organisation> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-party-classification>
                <http://example.com/InlandRevenueModel#IntergovernmentalOrganisation> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#DigitalPlatformInformationReporting> , <http://example.com/InlandRevenueModel#DigitalServicesTax> ;
