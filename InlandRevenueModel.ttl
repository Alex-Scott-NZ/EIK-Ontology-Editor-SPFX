<http://example.com/InlandRevenueModel#BestStart>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#FamiliesPackage-IncomeTaxAndBenefits-Act2017> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#BestStart/BSTC_en> ;
        <http://example.com/InlandRevenueModel#HasFocusOn>
                <http://example.com/InlandRevenueModel-current-#PrincipleCareGiver> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ProductsWeAdminister> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel-current-#Family> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR). Tax & Social Policy Glossary. Kuputaka (IR START Glossary)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel#UsesService>
                <http://example.com/InlandRevenueModel#IndividualProductEnrolmentService> ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A weekly payment for families supporting a newborn baby. Can be paid via IR or MSD.&nbsp;</p><p>It was introduced to help families with the costs of raising a child in their first three years of life. </p><p><br></p><p>This payment is available to all qualifying families with children due or born on or after 1 July 2018. It replaces the Parental Tax Credit (PTC) which helped with the cost of a new-born child for the first 10 weeks. All eligible families receive this payment until the child turns one, regardless of their household income, then may receive abated payments for the second and third years.</p><p>&nbsp;Best Start begins when Paid Parental Leave finishes – you can’t receive both at the same time.<br></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#BestStart/BestStartPayment_en> , <http://example.com/InlandRevenueModel#BestStart/BestStart_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Revenue Forecasting content; PAS content"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#BestStart/PR.CS.011_en> ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#BestStart/ParentalTaxCredit_en> ;
        sem:guid          "49b97876-1c64-40fb-a5cc-9b1609c69ebb" ;
        skos:broader      <http://example.com/InlandRevenueModel#WorkingForFamiliesTaxCredit> ;
        skos:historyNote  "BSTC was a new tax credit introduced to help families with the costs of raising a child in their first three years of life. This payment is available to all qualifying families with children due or born on or after 1 July 2018. It replaces the Parental Tax Credit (PTC) which helped with the cost of a new-born child for the first 10 weeks. The Parental Tax Credit was available from 1999, was updated in 2014, and replaced with Best Start Tax Credit in 2018."@en ;
        skos:related      <http://example.com/InlandRevenueModel#FamilyIncomesPackage> , <http://example.com/InlandRevenueModel#PaidParentalLeave> , <http://example.com/InlandRevenueModel#PregnancyConfirmation> , <http://smartlogic.com/term#156891602208818459594514> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#BestStart/BestStartTaxCredit_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#BestStart/BestStart_en> .

