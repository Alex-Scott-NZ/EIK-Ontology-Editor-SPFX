<http://example.com/InlandRevenueModel#SecurityIncidentDatabase>
        rdf:type          <http://example.com/IRD-test-model#System> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#SecurityIncidentDatabase/SID_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/Cleaned-Inland-Revenue-model#SecurityIncident> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsSystemUsedBy>
                <http://smartlogic.com/term#188945527009410301973540> , <http://smartlogic.com/term#29070262796189956337956> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/kc-protecting-information/SitePages/report-security-incidents.aspx?web=1\">Report security incidents</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel#SupportsActivity>
                <http://example.com/InlandRevenueModel#StaffSafetyManagement> , <http://smartlogic.com/term#47765963176520709341237> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Occasionally, IR staff may interact with customers who are unhappy or dissatisfied. This can result in threatening calls where the caller may pose a threat to themselves, their community or towards Inland Revenue staff, property or premises. Information about these security incidents is collected in the Security Incidents Database.<br><br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
