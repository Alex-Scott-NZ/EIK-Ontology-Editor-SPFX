<http://example.com/InlandRevenueModel#DuressTeam>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#BusinessAndCorporate> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/govcentre/Documents/Forms/AllItems.aspx?id=%2Fsites%2Fgovcentre%2FDocuments%2FWhat%20you%20need%20to%20know%20about%20the%20Duress%20Team%2Epdf&parent=%2Fsites%2Fgovcentre%2FDocuments"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Each IR site has a duress alarm response team that assist with situations where staff meet customers face to face, such as interviews, or working in reception. A response team is required to provide assistance to staff when requested or summonsed by the activation of duress alarms. When IR staff believe a situation is escalating to a point they feel is out of their control, or perceive that the situation may deteriorate into an episode of aggression and/or violence; they should activate the duress alarms."@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#EmergencyManagement> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#DuressTeam/DuressLead_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate Security content"@en ;
        sem:guid          "a305a94b-7181-4b64-9d87-8d1367d03faf" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRTeam> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DuressTeam/DuressTeam_en> .

