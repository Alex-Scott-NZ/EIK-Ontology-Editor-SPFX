                <http://example.com/InlandRevenueModel#InformationCollectionLegalService> , <http://example.com/InlandRevenueModel#SupplyCollectionService> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<div><p>https://irnz.sharepoint.com/sites/CORP-data-science-and-analytics/SitePages/Identifying,-Collecting-&amp;-Analysing-Data.aspx<br/></p></div>"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Wikipedia, https://www.dimagi.com/data-collection/."@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "We can help to identify what data might be helpful in answering your business question. This will include associated requirements like quality and granularity, and we can do a quality assessment to understand the business impact of not having fit for purpose data. The data may already be available to IR, or we may need to source it from elsewhere. ​​​​​​​If the data has accessibility, use or quality constraints we can support you in identifying and using the right channels and processes to make the data available. Once you have the data, we use the most appropriate technique to derive information and knowledge to support your business decisions."@en ;
        <http://example.com/InlandRevenueModel-current-#UsesModel>
                <http://example.com/InlandRevenueModel#ExternalDatasetsFramework> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#DataCollection/CollectingBaselineData_en> , <http://example.com/InlandRevenueModel#DataCollection/CollectingData_en> , <http://example.com/InlandRevenueModel#DataCollection/CollectionPlan_en> , <http://example.com/InlandRevenueModel#DataCollection/DataSources_en> , <http://example.com/InlandRevenueModel#DataCollection/furnishTheInformation_en> , <http://example.com/InlandRevenueModel#DataCollection/informationIsToBeFurnished_en> , <http://example.com/InlandRevenueModel#DataCollection/requireYouToFurnishInformation_en> , <http://example.com/InlandRevenueModel#DataCollection/requireYouToFurnishTheFollowingInformation_en> , <http://example.com/InlandRevenueModel#DataCollection/section17OfTheTaxAdministrationAct_en> , <http://example.com/InlandRevenueModel#DataCollection/supplyUsWithTheData_en> , <http://example.com/InlandRevenueModel#DataCollection/theInformationIsToMadeAvailableToTheInlandRevenue_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intelligence Hub content; CCS content"@en ;
        sem:guid          "4ec23a1c-a532-4039-bbde-fd1f6026099e" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#BusinessAnalytics> ;
        skos:definition   "Data collection is the process of identifying and gathering quantitative and/or qualitative data or information and measuring information on targeted variables, which then enables one to answer relevant questions and evaluate outcomes. This will include associated requirements like quality and granularity."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DataCollection/DataCollection_en> .

