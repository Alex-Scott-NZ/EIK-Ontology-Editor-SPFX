<http://example.com/InlandRevenueModel-current-#ForeignTrust>
        rdf:type          <http://smartlogic.com/class#Taxpayer> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/InlandRevenueModel-current-#ForeignTrust/FrgnTrust_en> , <http://example.com/InlandRevenueModel-current-#ForeignTrust/FrnTrust_en> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/Cleaned-Inland-Revenue-model#ForeignTrustDisclosureRules> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsPartyObjectOf>
                <http://example.com/InlandRevenueModel#ForeignTrustPayments> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel#ElectionToPayIncomeTaxOnTrusteeIncome> , <http://example.com/InlandRevenueModel#ForeignTrustConnectedPersonSchedule> , <http://example.com/InlandRevenueModel#ForeignTrustRegistrationForm> , <http://example.com/InlandRevenueModel#ScheduleOfBeneficiary-sEstateOrTrustIncome> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#ForeignTrustAnnualReturn> , <http://example.com/InlandRevenueModel#ForeignTrustSettlements-DistributionsSchedule> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "​Foreign trusts are trusts for which at all times no settlor of the trust was resident in NZ since the later of: 17 December 1987. The date the trust was first settled.Foreign trusts have no connection with New Zealand apart from the residence here of a potential beneficiary and/or a trustee. A foreign trust is taxed on trustee income at the same rates as a complying trust, but the nature of a foreign trust is that it is generally only taxed on New Zealand sourced income. If a foreign trust has a New Zealand resident trustee, it is known as a New Zealand foreign trust and is subject to certain registration and disclosure requirements. When a foreign trust elects to be a complying trust it is known as a dual-status trust - it is both foreign and complying."@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://example.com/InlandRevenueModel#ResidentForeignTrustee> ;
        <http://example.com/NZ-IRD#Is-offered-by-supplier>
                <http://example.com/InlandRevenueModel#ForeignTrustProvider> ;
        <http://example.com/NZ-IRD#Offers-product-service>
                <http://example.com/InlandRevenueModel#ForeignTrustAccount> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>IR website; START; </p><p>Corporate Finance content; IT&amp;C content</p>"@en ;
        sem:guid          "90ece960-da85-4bc6-b620-705a6e214b41" ;
        skos:broader      <http://smartlogic.com/term#256314115914621774342898064281208> ;
        skos:definition   "A trust will be a foreign trust if none of its settlors have been resident in New Zealand since the later of these dates: 17 December 1987 or the date the trust was first settled."@en ;
        skos:related      <http://example.com/InlandRevenueModel-current-#GovernmentInquiryIntoForeignTrustDisclosureRules> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#ForeignTrust/ForeignTrust_en> .

