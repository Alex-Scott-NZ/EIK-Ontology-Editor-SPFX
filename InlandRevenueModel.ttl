<http://example.com/InlandRevenueModel#Haukainga>
        rdf:type          <http://example.com/IRD-test-model#System> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p> </p><p>https://irnz.sharepoint.com/sites/CORP-marketing-and-communications/SitePages/Hauk%C4%81inga-home-base.aspx</p><p> </p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<div><p style=\"text-align: right;\">​<span style=\"color: rgb(50, 49, 48);font-size: 18px\">Haukāinga is a search-first tool. The Haukāinga search engine allows IR people to search for information across different sources and platforms at IR.</span>​<br></p></div><p style=\"text-align: right;\"></p><div><p style=\"text-align: right;\"><br></p></div>Haukāinga (Hoe-KAA-ing-ah) means ‘true home’. 'Kāinga’ on its own means ‘home’. The prefix ‘Hau’ intensifies the word that follows it, which makes Haukāinga&nbsp;<strong>the</strong>&nbsp;home or one's true home. This is an online space to which we as IR whānau can&nbsp;always return to&nbsp;find the information we need.<br><p></p><p style=\"text-align: right;\"><br>Haukāinga is a place for IR people to come together to find news, information, knowledge and guidance. It is the first place we visit when we log on&nbsp;and our touchstone for information throughout the day. It has&nbsp;an intelligent search that reaches&nbsp;IR information sources. IR whānau can access Haukāinga&nbsp;on any device.</p>"@en ;
        <http://example.com/NZ-IRD#Is-offered-by-supplier>
                <http://example.com/InlandRevenueModel#DigitalContentManagementPlanningDesignAndDelivery> ;
        sem:guid          "54ad08ba-5184-48e9-9b8e-c948b10afe2b" ;
        skos:broader      <http://smartlogic.com/term#47372529931203401780288> ;
        skos:related      <http://example.com/InlandRevenueModel#Coveo> , <http://smartlogic.com/term#204225685797784346977577> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Haukainga/Haukainga_en> .

<http://example.com/InlandRevenueModel#Haukainga/Haukainga_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Haukāinga"@en .

