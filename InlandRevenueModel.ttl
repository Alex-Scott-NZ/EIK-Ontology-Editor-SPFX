<http://example.com/InlandRevenueModel#VirtualPrivateNetwork>
        rdf:type          <http://smartlogic.com/class#System-type> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#VirtualPrivateNetwork/VPN_en> ;
