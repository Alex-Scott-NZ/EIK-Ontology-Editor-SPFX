<http://example.com/InlandRevenueModel#AllOfGovernmentAndPolicyTeam>
        rdf:type          <http://smartlogic.com/class#Event> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://smartlogic.com/term#178953839036513121843655> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-07-28"^^xsd:date ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p></p><p><span>O</span>ptimising the applied value that IR generates using Data Analytics within the broader context of other NZ government agencies. Example: Cryptoasset Programme IR focuses on gathering data and using analytics technology to create a better base of knowledge from which to make better tax decisions, whether those decisions are policy, what cluster of customers to target, or which customer to investigate. In the process of doing this we also generate awareness of customers that fit the signature of money laundering, organised crime, child exploitation, and extremism. In this context IR has an obligation to collaborate with key NZ government agencies to derive maximal value from these analytical endeavours – whether that is in the form of intelligence or transfer of knowledge in relation to the domain knowledge or software design.</p><p></p>"@en , "CEDA team"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>DSA Final Decision - IIS Alignment.pdf<br/>IIS Alignment Change Proposal.pdf<br/></p>"@en ;
        sem:guid          "1e2475c1-b3b9-4ddf-9fad-6301b7ce0609" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#ProgrammeOrProject> ;
        skos:historyNote  "Created in November 2021 as part of the CEDA creation."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#AllOfGovernmentAndPolicyTeam/AllOfGovernmentAndPolicyTeam_en> .

