<http://example.com/InlandRevenueModel#TasmanBayFloodingAugust2022>
        rdf:type            <http://smartlogic.com/class#Adverse-event> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#AdverseEvent> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#FarNorthDistrictCouncil> , <http://example.com/InlandRevenueModel-current-#Tasman-Nelson-Marlborough> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The flooding caused by recent heavy rainfall in the Tasman, Nelson, Marlborough and Far North districts is causing financial issues for many farmers and growers and is likely to affect their income for the 2023 income year. The late deposit provision for 2022 has been approved, with an extension for all customers until 31 May 2023. Applications for early refunds from the income equalisation scheme will be allowed. Cabinet has also declared the adverse weather as an emergency event for the purposes of section 183ABA of the TAA which allows Inland Revenue to remit interest payable on late payments following the emergency event. There is also localised flooding across other regions, and we will take a sympathetic approach to customers from other regions who have also been affected. "@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "START Help - List of adverse events 2016-"@en ;
        sem:guid            "e0c8193a-e84d-4ca3-91b8-2d778cc0ad65" ;
        skos:broader        <http://smartlogic.com/term#47138497716934256857234> ;
        skos:editorialNote  "Checked in Viva Topics but it wasn't there."@en ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#TasmanBayFloodingAugust2022/FloodingInTasman-Nelson-MarlboroughAndFarNorthDistrictsAugust2022_en> , <http://example.com/InlandRevenueModel#TasmanBayFloodingAugust2022/TasmanBayFlooding_en> , <http://example.com/InlandRevenueModel#TasmanBayFloodingAugust2022/UpperSouthFloods_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#TasmanBayFloodingAugust2022/TasmanBayFloodingAugust2022_en> .

<http://example.com/InlandRevenueModel#TasmanBayFloodingAugust2022/FloodingInTasman-Nelson-MarlboroughAndFarNorthDistrictsAugust2022_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Flooding in Tasman, Nelson, Marlborough and Far North districts August 2022"@en .

