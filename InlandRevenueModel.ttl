<http://example.com/InlandRevenueModel#PartyAttribute>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#EvidenceOfIdentityStandard> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-08"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling"@en ;
        sem:guid          "35042f59-b323-4daf-95c8-59c05d697d78" ;
        skos:broader      <http://example.com/IRD-test-model#People> ;
        skos:definition   "<p>A party attribute is a piece of information that describes a party or a party in a role. It answers the question: “What is true about this party (or this role)?”<br>Some attributes apply to the party as a whole, while others apply only when the party is acting in a specific role (for example, different contact details for different obligations).&nbsp;Key characteristics of a party attribute<br>•\tIt is descriptive, not behavioural<br>•\tIt can change over time<br>•\tIt does not define obligations by itself<br>•\tIt provides detail needed to apply rules correctly<br><br></p>"@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Non-individual> , <http://example.com/InlandRevenueModel#EstablishEligibility> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PartyAttribute/PartyAttribute_en> .

