        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#InformationClassification0> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<div><p>http://intranet.ird.govt.nz/enterprise-ict-security/endorsement-markings</p></div><div><p>Protective Security - government site. https://www.protectivesecurity.govt.nz/information-security/security-classification-system-and-handling-requirements/new-zealand-government-security-classification-system/endorsement-and-compartmented-markings/<br/></p></div>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "New Zealand Government Security Classification System also has endorsements that can be used in conjunction with classifications to specify warnings that the information has special requirements in addition to those indicated by the security classification. Endorsements should only be used when there is a clear need for special care. Endorsement markings are not security classifications in their own right — they mustn’t appear without a security classification."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>http://intranet.ird.govt.nz/enterprise-ict-security/endorsement-markings<br/>Protective Security - government site.<br/></p>"@en ;
        sem:guid          "327d90dc-730e-451b-b543-6ad51c128192" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#MetadataValues> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EndorsementMarkings/EndorsementMarkings_en> .

