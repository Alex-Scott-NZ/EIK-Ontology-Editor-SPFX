<http://example.com/InlandRevenueModel#KeepingInTouchDays>
        rdf:type          <http://smartlogic.com/class#Life-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/InlandRevenueModel#KeepingInTouchDays/KITDays_en> ;
        <http://example.com/InlandRevenueModel#Instance>
