<http://example.com/InlandRevenueModel#Issue>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#ReportAnAccessIssueService> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<!--StartFragment--><p style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);\">Glossary of terms from IR's Initiative Management Framework document. May 2022.</p><div style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);\"><p><a href=\"https://irnz.sharepoint.com/sites/CORP-strategic-portfolio-stewardship/SupInfo/Forms/AllItems.aspx?id=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo%2FInitiative%20Management%20Framework%2Epdf&amp;parent=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo\" style=\"background-color: transparent;color: rgb(51, 122, 183);text-decoration: underline;\">Tiakitanga Kohinga Rautaki - Strategic Portfolio Stewardship - Initiative Management Framework.pdf - 1) All Documents (sharepoint.com)</a></p></div><!--EndFragment-->"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>An issue is an unplanned situation that justifies management consideration and possible action. If left unresolved it will affect the achievement of objectives. An issue can also be a risk that has come to fruition and requires resolution. Something that has already happened (a materialised risks) and is impacting on objectives. Issues are identified problems that will have a detrimental impact if left unresolved.<br/><br/></p>"@en ;
        sem:guid          "409ed9a3-0876-4731-9635-310927dc54e1" ;
        skos:broader      <http://smartlogic.com/term#70562128021572352832915> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Issue/Issue_en> .

<http://example.com/InlandRevenueModel#Issue/Issue_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Issue"@en .

