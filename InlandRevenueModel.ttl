<http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit/R-DLossTaxCredit_en> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/Cleaned-Inland-Revenue-model#Taxation-Business-Taxation-and-Remedial-Matters-Act-2007> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit/TeWhakahekengaTakeNgaromangaRangahauMeTeWhakawhanake_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit/RDTC_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ProductsWeAdminister> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#ResearchAndDevelopmentCosts> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "https://irnz.sharepoint.com/sites/kc-research-and-development/SitePages/research-and-development-loss-tax-credit-rdltc.aspx"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "RDLTC is a New Zealand tax incentive that allows eligible companies to cash out tax losses from qualifying R&D activities instead of carrying them forward. The refund is up to 28% of the loss, providing early-stage businesses with immediate cash flow. Once cashed out, those losses cannot be used to offset future income and must be repaid under certain conditions."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit/R-DCashingUp_en> , <http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit/R-DLossTaxCredits_en> , <http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit/R-DTaxCredit_en> , <http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit/R-DTaxCredits_en> , <http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit/R-DTaxLosses_en> , <http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit/ResearchAndDevelopment-R-D-LossTaxCredit_en> , <http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit/ResearchAndDevelopmentTaxLosses_en> , <http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit/TeWhakahekengaTakeNgaromangaRangahauMeTeWhakawhanake_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>IR website; Intranet; </p><p>Revenue Forecasting content. Māori term from Te Taura Whiri Māori Language Commission</p>"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit/PR.CS.018_en> ;
        sem:guid          "e8df6ac2-cf81-4f80-aa6e-df4b5c742dfa" ;
        skos:broader      <http://example.com/InlandRevenueModel#TaxCredits> ;
        skos:definition   "The Government wants to encourage business innovation and recognises that research and development (R&D) is a key element in the innovation process. This has led to the introduction of the R&D loss tax credit initiative. Tax losses are generally carried forward to the next income year. The R&D loss tax credit, will allow losses from eligible expenditure associated with R&D, to be cashed out instead of carried forward. Losses that are cashed out are no longer available to apply against future income years."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#ResearchServices> , <http://example.com/InlandRevenueModel#CashingOutLosses> , <http://example.com/InlandRevenueModel#ResearchAndDevelopment> , <http://example.com/InlandRevenueModel#ResearchAndDevelopment-R-D-TaxLossesProject> , <http://example.com/InlandRevenueModel-current-#LossRecoveryEvent> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#ResearchAndDevelopmentTaxCredit/ResearchAndDevelopmentTaxCredit_en> .

