<http://example.com/InlandRevenueModel#InternalControlAssessmentTool>
        rdf:type          <http://example.com/IRD-test-model#System> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#InternalControlAssessmentTool/ICAT_en> ;
