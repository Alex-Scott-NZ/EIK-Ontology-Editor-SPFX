<http://example.com/InlandRevenueModel-current-#QualifyingCompanyElectionTax>
        rdf:type          <http://smartlogic.com/class#Obligation> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel-current-#QualifyingCompanyElectionTax/QCET_en> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://smartlogic.com/term#332232282734990593924592237114874> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Qualifying company election tax (QCET) has, up to now, where a company has elected to become a qualifying company, been a final tax on that part of a company's shareholder's funds that are not sheltered by imputation credits. From 17 May 2007, payments of QCET are credited to the imputation credit account (ICA) and so they become more of a withholding tax. "@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "66bde68e-6f9b-4d32-8d39-f6b2dbc86961" ;
        skos:broader      <http://smartlogic.com/term#716311899949028386928466293214695> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#QualifyingCompanyElectionTax/QualifyingCompanyElectionTax_en> .

