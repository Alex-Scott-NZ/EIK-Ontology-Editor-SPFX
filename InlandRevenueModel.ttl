        skosxl:literalForm     "Effective marginal tax rate"@en .

<http://example.com/InlandRevenueModel#EgmontGroupOfFinancialIntelligenceUnits>
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/InlandRevenueModel#EgmontGroupOfFinancialIntelligenceUnits/Egmont_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#Anti-moneyLaunderingWork> ;
        <http://example.com/InlandRevenueModel#HasMember>
                <http://example.com/Cleaned-Inland-Revenue-model#FinancialIntelligenceUnit> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#GovernmentAndPartners> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "https://egmontgroup.org/en"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intelligence Hub content"@en ;
        sem:guid          "e55df641-5ab6-469e-9771-66f6451465ea" ;
        skos:broader      <http://example.com/InlandRevenueModel#Inter-agencyGroup> ;
        skos:definition   "Recognizing the importance of international cooperation in the fight against money laundering and financing of terrorism, a group of Financial Intelligence Units (FIUs) met at the Egmont Arenberg Palace in Brussels, Belgium, and decided to establish an informal network of FIUs for the stimulation of international co-operation. he Egmont Group is a united body of 167 Financial Intelligence Units (FIUs). The Egmont Group provides a platform for the secure exchange of expertise and financial intelligence to combat money laundering and terrorist financing (ML/TF). This is especially relevant as FIUs are uniquely positioned to cooperate and support national and international efforts to counter terrorist financing and are the trusted gateway for sharing financial information domestically and internationally in accordance with global Anti Money Laundering and Counter Financing of Terrorism (AML/CFT) standards."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EgmontGroupOfFinancialIntelligenceUnits/EgmontGroupOfFinancialIntelligenceUnits_en> .

<http://example.com/InlandRevenueModel#EgmontGroupOfFinancialIntelligenceUnits/EgmontGroupOfFinancialIntelligenceUnits_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Egmont Group of Financial Intelligence Units"@en .

<http://example.com/InlandRevenueModel#EgmontGroupOfFinancialIntelligenceUnits/Egmont_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Egmont"@en .

<http://example.com/InlandRevenueModel#EkeTangaroa>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsPublishedBy>
                <http://smartlogic.com/term#733873855465831453299914748155375> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Isused-in-function>
                <http://example.com/InlandRevenueModel#CorporatePlanning> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#EkeTangaroa/EkeTangaroa_en0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><a href=\"https://irnz.sharepoint.com/sites/News/SitePages/Introducing-Eke-Tangaroa-2021-22-%E2%80%93-our-new-enterprise-plan.aspx\"><u><font color=\"#0066cc\">Introducing Eke Tangaroa 2021-22 – our new enterprise plan (sharepoint.com)</font></u></a><br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Eke Tangaroa is our annual enterprise-wide plan and sets out our priorities for the year ahead, alongside our vision, mission and outcomes. The plan also includes a summary of our enterprise risks and the performance management framework, which is used to help make sure things are on track. The plan supports us in delivering the outcomes set out in the Statement of Intent and contributing to the Government’s priorities."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#EkeTangaroa/OurEnterprisePlan_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Māori term from IR Māhutonga team"@en ;
        sem:guid          "85eac302-3318-4321-a8c6-ce68af2d5b78" ;
        skos:broader      <http://example.com/InlandRevenueModel#EnterprisePlan> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#EkeTangaroa/EnterprisePlan_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EkeTangaroa/EkeTangaroa_en> .

