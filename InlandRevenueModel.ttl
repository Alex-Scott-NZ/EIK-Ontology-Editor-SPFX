<http://example.com/InlandRevenueModel#Option>
        rdf:type          <http://example.com/InlandRevenueModel#FinancialProduct> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#ISIN> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>An option is a contract giving the buyer the right, but not the obligation, to buy (in the case of a call) or sell (in the case of a put) the underlying asset at a specific price on or before a certain date. <br/> - People use options for income, to speculate, and to hedge risk. <br/> - Options are known as derivatives because they derive their value from an underlying asset. <br/> - A stock option contract typically represents 100 shares of the underlying stock, but options may be written on any sort of underlying asset from bonds to currencies to commodities. Call options allow the holder to buy the asset at a stated price within a specific time frame. Put options allow the holder to sell the asset at a stated price within a specific time frame.<br/></p>"@en ;
        sem:guid          "2f083994-eb8f-416e-adc9-fe3ddb39db94" ;
        skos:broader      <http://smartlogic.com/term#185397716530282738530987> ;
        skos:related      <http://example.com/InlandRevenueModel#FinancialAsset> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Option/Option_en> .

<http://example.com/InlandRevenueModel#Option/Option_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Option"@en .

<http://example.com/InlandRevenueModel#OptionsAnalysis>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/Cleaned-Inland-Revenue-model#HasPossibleClassID>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.1.2_Reviews_of_Strategic_Corporate_Policies_and_Procedures> , <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.1.4_Reviews_of_Operational_Corporate_Policies_and_Procedures> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#OptionsAnalysisReport> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span>Glossary of terms from IR's Initiative Management Framework<br/>document. May 2022.<br/></span></p><p><span style=\"color: black;\"><a href=\"https://irnz.sharepoint.com/sites/CORP-strategic-portfolio-stewardship/SupInfo/Forms/AllItems.aspx?id=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo%2FInitiative%20Management%20Framework%2Epdf&amp;parent=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo\"><span style=\"color: #337ab7;\">Tiakitanga Kohinga<br/>Rautaki - Strategic Portfolio Stewardship - Initiative Management Framework.pdf<br/>- 1) All Documents (sharepoint.com)</span></a></span></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>An evaluation of possible pathways leading to a desired outcome.<br/><br/></p>"@en ;
        sem:guid          "aba9395e-3b07-4979-bacc-0cf1ad33fdb8" ;
        skos:broader      <http://example.com/InlandRevenueModel#BusinessAnalysis> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#OptionsAnalysis/OptionsAnalysis_en> .

<http://example.com/InlandRevenueModel#OptionsAnalysis/OptionsAnalysis_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Options analysis"@en .

<http://example.com/InlandRevenueModel#OptionsAnalysisReport>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Isused-in-function>
                <http://example.com/InlandRevenueModel#ProjectReporting> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#OptionsAnalysisReport/OAR_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInformationRelatedTo>
                <http://example.com/InlandRevenueModel#OptionsAnalysis> , <http://example.com/InlandRevenueModel#PreferredOptionReport> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#OptionsAnalysisReport/OptionsReport_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Portfolio Office content"@en ;
        sem:guid          "a9b5261e-d296-4327-a6a4-25da475fd6c0" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#ProjectDocumentation> ;
        skos:definition   "An options analysis report is a structured document that evaluates various possible solutions or approaches to a problem or opportunity, identifying their pros, cons, costs, benefits, risks, and feasibility to help decision-makers select the most suitable option for a project or investment. The process involves identifying a long list of potential options, narrowing them down to a manageable shortlist, and then conducting a high-level assessment against agreed-upon criteria to determine the best course of action."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#OptionsAnalysisReport/OptionsAnalysisReport_en> .

