        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#ServiceLevelManagement> , <http://example.com/InlandRevenueModel#TechnologyServices> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
