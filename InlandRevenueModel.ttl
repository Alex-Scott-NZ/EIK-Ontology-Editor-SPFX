                "Intranet"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The Information Sharing Sharing Governance group ensures that governance, coordination and controls are in place across the Information Sharing work streams.With significant reputational risks to Inland Revenue, and impacts on the integrity of the tax system without governance and oversight, the group:<br/>- provides strong management/oversight at a strategic and operational level to ensure activities support our strategy<br/>- manage common issues across different information shares<br/>- manages information sharing resourcing.<br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet"@en ;
        sem:guid          "b2bc8ffb-dffb-43e6-be4e-55b45ddfefa2" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
