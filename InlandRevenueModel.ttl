<http://example.com/InlandRevenueModel#TransferPricingMethodology>
        rdf:type          <http://example.com/NZ-IRD#Financial-method> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#TransferPricingMethodology/TPM_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#TransferPricingMethodology/EPMO_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "https://insightsoftware.com/blog/transfer-pricing-methods/"@en ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://example.com/Cleaned-Inland-Revenue-model#TransferPricing> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS-B content"@en ;
        sem:guid          "93f6d9b1-151b-481a-9e12-5228303b65c8" ;
        skos:broader      <http://smartlogic.com/term#172989254134847250795521> ;
        skos:definition   "Transfer pricing methods are the approaches used to determine the price at which transactions between related entities within a multinational enterprise are conducted. These methods help ensure that transactions are priced in a way that reflects market conditions, complying with regulatory requirements and avoiding tax avoidance. By using one of the recognized transfer pricing methods, companies can demonstrate that their intercompany transactions are conducted at arm’s length, meaning the prices are comparable to those that would have been charged between unrelated parties under similar circumstances. There are 5 of these: 1) 1. Comparable Uncontrolled Price (CUP) Method; 2) Cost Plus Method; 3) Resale Minus Method; 4) Transactional Net Margin (TNMM) Method; and 5) Profit Split Method."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TransferPricingMethodology/TransferPricingMethodology_en> .

<http://example.com/InlandRevenueModel#TransferPricingMethodology/EPMO_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "EPMO"@en .

