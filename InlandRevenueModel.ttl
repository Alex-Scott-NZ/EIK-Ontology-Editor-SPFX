<http://example.com/InlandRevenueModel#PrivateProhibition>
        rdf:type          <http://smartlogic.com/class#Obligation> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "DA 2 General limitations ... Private limitation (2) A person is denied a deduction for an amount of expenditure or loss to the extent to which it is of a private or domestic nature. This rule is called the private limitation."@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Income Tax Act"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Relates to prohibiting tax deductions for private expenditures."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Tax Technical Website Project"@en ;
        sem:guid          "815047f5-9413-43fd-a1bd-e85093232b77" ;
        skos:broader      <http://example.com/InlandRevenueModel#IncomeTaxes> ;
        skos:historyNote  "<p><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">Private prohibition is the term that will be increasingly used, although Private limitation is the term in use in the past. Grant Haley - SME, Tax Technical Website Project.</span><!--EndFragment--><br/><br/><br/></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#PersonalExpense> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#PrivateProhibition/PrivateLimitation_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PrivateProhibition/PrivateProhibition_en> .

