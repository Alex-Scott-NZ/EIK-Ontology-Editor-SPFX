                true ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "An approved issuer is a borrower who elects to be an approved issuer and notifies Inland Revenue of this election. The Approved Issuer Levy is a levy paid on interest rather than deducting non-resident withholding tax. "@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://example.com/Cleaned-Inland-Revenue-model#ApprovedIssuer> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website glossary; Revenue Forecasting content; Corporate Finance content"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/Cleaned-Inland-Revenue-model#ApprovedIssuerLevy/PR.T.008_en> ;
        sem:guid          "7c8de8cb-0025-4dbf-87b7-137d376215e4" ;
        skos:broader      <http://smartlogic.com/term#39540492458666896042871634590083> ;
        skos:definition   "When an overseas lender wants to receive their interest in full with no NRWT deducted, the NZ borrower can apply to Inland Revenue to pay approved issuer levy to IR (usually at 2%) on top of the interest, rather than deducting NRWT."@en ;
        skos:related      <http://smartlogic.com/term#95097366254976153085859> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#ApprovedIssuerLevy/ApprovedIssuerLevy_en> .

