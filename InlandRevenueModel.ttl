<http://example.com/InlandRevenueModel#PropertyComplianceGovernanceGroup>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#PropertyComplianceGovernanceGroup/PCNG_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#GovernanceAndCommunities> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/CORP-property-compliance/SitePages/Home.aspx?web=1\">Rawa Tautukunga - Property Compliance - Rawa Tautukunga - Property Compliance</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Property Compliance Network Group addresses the ever-changing landscape of property compliance risks. In recent years, one of the priorities has been ensuring that the bright-line test is applied correctly. The Property Compliance Network Group is made up of people across IR including Policy, Design, Capabilities & Outcomes, Marketing, Community Compliance and Customer Compliance Specialists who are working collectively to improve compliance in this key area."@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/Cleaned-Inland-Revenue-model#PropertyCompliance> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#PropertyComplianceGovernanceGroup/PCGG_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS-I content"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#PropertyComplianceGovernanceGroup/PropertyComplianceGovernanceGroup_en0> ;
        sem:guid          "c104b484-d835-42ac-bc73-d287ec099ad7" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skos:historyNote  "Starting in 2008 a programme was established to address any compliance risks with property development and speculation and associated tax obligations. This team has existed in various forms since then. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PropertyComplianceGovernanceGroup/PropertyComplianceGovernanceGroup_en> .

