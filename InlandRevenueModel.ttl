<http://example.com/InlandRevenueModel#Pre-consultation>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Future Operating Model glossary 2020. http://intranet.ird.govt.nz/our-new-organisation/glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Activities to make sure people to be consulted are well prepared for the up-coming consultation and know what to expect."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Future Operating Model glossary 2020"@en ;
        sem:guid          "21eeecdd-09d2-40ff-a1e0-d2db3db01a5e" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#Consultation> ;
        skos:related      <http://smartlogic.com/term#81421232302518545413232> ;
        skos:scopeNote    "For IR this means: This includes activities to make sure you are well prepared for the up-coming consultation and know what to expect. Mostly it includes your leader and ELT (Enterprise Leadership Team), with support from the FOM (Future Operating Model) team, making sure that you have all the information you need, including what the proposed timeframes and processes are, how to provide feedback and where to go for support. It may also include your leader holding direct conversations with you and your team to give you some indication of what you can expect to find in the consultation proposals. It's important to note that there may still be some questions you have that cannot be answered at this stage until final decisions are made after consultation."@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#Pre-consultation/Preconsultation_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Pre-consultation/Pre-consultation_en> .

