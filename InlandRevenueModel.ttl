<http://example.com/InlandRevenueModel#HiddenEconomySpecialInterestGroup>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#HiddenEconomySpecialInterestGroup/HESIG_en> ;
        <http://example.com/InlandRevenueModel#HasGroupType>
                <http://example.com/InlandRevenueModel#SpecialInterestGroup> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://smartlogic.com/term#110481616277029930443037> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#GovernanceAndCommunities> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>https://irnz.sharepoint.com/sites/CORP-hidden-economy/SitePages/Our-programme-approach.aspx?sw=bypass</p><div><p>Key internal governance groups<br/></p></div>"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Legal and technical services' hidden economy special interest group (HESIG). The key focus is to recognise the co-operative nature of Hidden Economy (HE) work between Investigations and Advice and Collections with the aim of sharing information to gain consistency in the application of the application of the Commissioners powers and guidelines for HE projects."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS-I content"@en ;
        sem:guid          "9d348f1a-4c15-4263-922d-fd26359e7ade" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#HiddenEconomySpecialInterestGroup/HiddenEconomySpecialInterestGroup_en> .

