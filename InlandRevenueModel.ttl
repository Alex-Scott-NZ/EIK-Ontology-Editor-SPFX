<http://smartlogic.com/term#165636821457795120382006>
        rdf:type          <http://smartlogic.com/class#Entitlement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://smartlogic.com/term#165636821457795120382006/TeWhakahokiINgaUtuTapui_en> ;
