<http://example.com/InlandRevenueModel#ValueOfSupply>
        rdf:type          <http://example.com/InlandRevenueModel#ProductClassification> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerAttributes> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/kc-audit-and-investigation/SitePages/GT03---Goods-and-Services-Tax---Value-of-Supply.aspx"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The value of a supply determines the amount of goods and services tax (GST) paid on the supply. Fundamentally, value of supply + GST charged = consideration. “Consideration” is generally the agreed GST-inclusive price for a supply and may be expressed in monetary and/or non-monetary terms. Non-monetary consideration is valued at open market value."@en ;
        sem:guid          "667bb096-b908-4a6e-86ad-8ab64cde5f47" ;
        skos:broader      <http://example.com/InlandRevenueModel#ProductType> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ValueOfSupply/ValueOfSupply_en> .

