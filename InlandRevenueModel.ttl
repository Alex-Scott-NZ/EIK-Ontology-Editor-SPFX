                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "An IR business service is a set of activities or tasks that Inland Revenue provides to accomplish its operations and objectives for the New Zealand public."@en ;
        <http://example.com/NZ-IRD#Is-offered-by-supplier>
                <http://example.com/InlandRevenueModel#StrategicArchitecture> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Register of Business Services (IR)"@en ;
        sem:guid            "5e9ea420-3910-4581-a22e-0b4a597a471e" ;
        skos:broader        <http://example.com/InlandRevenueModel#IRBusinessService> ;
        skos:editorialNote  "The register was created in 2024, but only includes customer-facing business services."@en ;
