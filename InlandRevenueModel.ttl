<http://example.com/InlandRevenueModel#_DEPARTMENT-USEONLY>
        rdf:type          <http://example.com/InlandRevenueModel#SecurityEndorsementMetadata> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<div><p>Protective Security - government site. https://www.protectivesecurity.govt.nz/information-security/security-classification-system-and-handling-requirements/new-zealand-government-security-classification-system/endorsement-and-compartmented-markings/</p></div><div><p>Intranet - http://intranet.ird.govt.nz/enterprise-ict-security/endorsement-markings.</p></div>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>This marking may be used for material intended only for use within the specified department(s). <br>Information bearing agency specific endorsement markings should be relabeled or appropriate procedures agreed before release or transmission outside of that agency.</p>&nbsp;For IR the label become INLAND REVENUE USE ONLY."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet"@en ;
        sem:guid          "91456444-2a27-47ec-b0f4-eef083cea81b" ;
        skos:broader      <http://example.com/InlandRevenueModel#EndorsementMarkings> ;
        skos:scopeNote    "No-one ever uses this exact term. Each government department uses their own name. So for IR the marking is \"INLAND REVENUE\", but for MPI it is \"MINISTRY FOR PRIMARY INDUSTRIES\"."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#_DEPARTMENT-USEONLY/_DEPARTMENT-USEONLY_en> .

<http://example.com/InlandRevenueModel#_DEPARTMENT-USEONLY/_DEPARTMENT-USEONLY_en>
        rdf:type               skosxl:Label ;
        sem:caseSensitivity    sem:CaseSensitive ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "[DEPARTMENT] USE ONLY"@en .

