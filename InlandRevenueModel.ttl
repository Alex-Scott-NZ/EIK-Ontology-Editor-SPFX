<http://example.com/InlandRevenueModel#SecurityClassificationVocabulary>
        rdf:type          <http://example.com/InlandRevenueModel#MetadataValue> , <http://example.com/InlandRevenueModel#SecurityClassificationMetadata> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#InformationClassification0> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
