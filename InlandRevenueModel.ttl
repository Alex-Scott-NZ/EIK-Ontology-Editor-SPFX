        sem:guid          "05190502-14a9-44e6-a7b8-7976245443da" ;
        skos:broader      <http://smartlogic.com/term#32367411335895523177952203629346> ;
        skos:definition   "The tax payable on an Employer Superannuation Contribution. A tax on any cash contribution an employer makes to a superannuation fund for the benefit of an employee. For example, employer contributions to an employee's KiwiSaver. If an employee asks their employer to make deductions from their wages and pay them to a superannuation scheme, these are not employer superannuation contributions."@en ;
        skos:related      <http://example.com/InlandRevenueModel#EmployeeBenefit> , <http://smartlogic.com/term#716311899949028386928466293214695> ;
