<http://example.com/InlandRevenueModel#Myres-BriggsTest>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#Test0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Wikipedia"@en ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://example.com/Cleaned-Inland-Revenue-model#Recruitment> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#Myres-BriggsTest/MBTI_en> , <http://example.com/InlandRevenueModel#Myres-BriggsTest/Myres-BriggsTypeIndicator_en> , <http://example.com/InlandRevenueModel#Myres-BriggsTest/MyresBriggsTest_en> , <http://example.com/InlandRevenueModel#Myres-BriggsTest/PersonalityType_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "P&C content"@en ;
        sem:guid          "0543228e-bc76-4f49-88e4-87fd98b6a968" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Test> ;
        skos:definition   "<p> </p><p>The&nbsp;<strong>Myers–Briggs Type Indicator</strong>&nbsp;(<strong>MBTI</strong>) is a self-report questionnaire that makes&nbsp;pseudoscientific&nbsp;claims&nbsp;to categorize individuals into sixteen distinct \"psychological types\" or \"personality types\".</p><p> </p><p>The MBTI was constructed during World War II by Americans&nbsp;Katharine Cook Briggs&nbsp;and her daughter&nbsp;Isabel Briggs Myers, inspired by Swiss psychiatrist&nbsp;Carl Jung's 1921 book&nbsp;<em>Psychological Types</em>.<sup><a href=\"https://en.wikipedia.org/wiki/Myers%E2%80%93Briggs_Type_Indicator#cite_note-Pittenger_467%E2%80%93488-7\">[</a></sup>&nbsp;The test assigns a binary value to each of four categories: introversion or extraversion, sensing or intuition, thinking or feeling, and judging or perceiving. One letter from each category is taken to produce a four-letter test result representing one of sixteen possible types, such as \"INFP\" or \"ESTJ\". </p><p> </p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Myres-BriggsTest/Myres-BriggsTest_en> .

<http://example.com/InlandRevenueModel#Myres-BriggsTest/MBTI_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "MBTI"@en .

<http://example.com/InlandRevenueModel#Myres-BriggsTest/Myres-BriggsTest_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Myers-Briggs test"@en .

