        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The 'Financial period' for a student loan statement is the same as the tax year (1 April to 31 March). Tax years are referred to by the year they end in, for example the 2025 tax year ends on 31 March 2025. When you get a loan determines what tax year the transaction will be under."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "SD&I content"@en ;
        sem:guid          "a066f292-ad0c-4e0c-b73e-0948b5669589" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerFinancialInformation> ;
        skos:definition   "In New Zealand, the annual student loan statement is not a single, consolidated document issued once a year. Instead, it's an ongoing process of tracking your loan balance, with statements issued by Inland Revenue (IRD) as needed, particularly when there are changes to your loan balance or when you need to understand your repayment obligations. "@en ;
        skos:related      <http://example.com/IRD-test-model#Overdue-student-loan-debt> , <http://example.com/InlandRevenueModel#Statement> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#AnnualLoanStatement/AnnualLoanStatement_en> .

