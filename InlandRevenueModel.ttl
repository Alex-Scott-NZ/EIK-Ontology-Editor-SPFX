<http://example.com/InlandRevenueModel#IRPolicyRole>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CoPilot"@en ;
        sem:guid          "fba0410d-b787-4e4e-b234-18e19e45bbc9" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRRole> ;
        skos:definition   "<p>People in policy roles help decide what the rules should be. They research issues, analyse impacts, consult with others, and help design laws or settings that are fair, workable, and effective.<br>They don’t deal with individual customer cases. Their work affects everyone by shaping how the tax and social policy system works.&nbsp;</p><div>Policy roles focus on <strong>future system design</strong>, not operational delivery.</div><p><br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IRPolicyRole/IRPolicyRole_en> .

<http://example.com/InlandRevenueModel#IRPolicyRole/IRPolicyRole_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "IR policy role"@en .

<http://example.com/InlandRevenueModel#IRProduct0>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> ;
