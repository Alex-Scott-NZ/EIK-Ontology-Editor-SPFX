        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Initiative management"@en .

<http://example.com/InlandRevenueModel#InitiativeManagementFramework>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#InitiativeManagementFramework/TeAngaKaupapa_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel-current-#ChangeManagement> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Intranet<br/></p><p><span><a href=\"https://irnz.sharepoint.com/sites/news/sitepages/what-you-need-to-know-about-recent-changes-to-governance-at-ir.aspx?web=1\">https://irnz.sharepoint.com/sites/news/sitepages/what-you-need-to-know-about-recent-changes-to-governance-at-ir.aspx?web=1</a></span></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "This framework contains the approach, processes, and standards for delivering change initiatives at Inland Revenue. It will help ensure initiatives are delivered in a consistent manner. "@en ;
        <http://example.com/NZ-IRD#Is-offered-by-supplier>
                <http://example.com/InlandRevenueModel#StrategicPortfolioStewardship> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Intranet<br/></p><p><span><a href=\"https://irnz.sharepoint.com/sites/news/sitepages/what-you-need-to-know-about-recent-changes-to-governance-at-ir.aspx?web=1\">https://irnz.sharepoint.com/sites/news/sitepages/what-you-need-to-know-about-recent-changes-to-governance-at-ir.aspx?web=1</a></span></p>"@en ;
        sem:guid          "7d8a46ba-b961-49a1-8217-334d449b093c" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Enterprise-model> ;
        skos:related      <http://example.com/InlandRevenueModel#Initiative> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#InitiativeManagementFramework/InitiativeManagementFramework_en> .

<http://example.com/InlandRevenueModel#InitiativeManagementFramework/InitiativeManagementFramework_en>
        rdf:type               skosxl:Label ;
