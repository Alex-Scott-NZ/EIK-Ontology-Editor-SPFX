                false ;
        <http://example.com/NZ-IRD#Source-of-term>
                "OCTC content"@en ;
        sem:guid          "50a73086-30a4-4a24-a224-d1b8184e44eb" ;
        skos:broader      <http://smartlogic.com/term#188519164724691362719453> ;
        skos:definition   "The New Zealand Fire Service Commission (NZFSC) was a Crown entity that existed from 1975 to 2017, overseeing the New Zealand Fire Service (NZFS) and acting as the National Rural Fire Authority (NRFA) to manage urban and rural fire services. Established by the Fire Service Act 1975, it focused on fire prevention, safety, and emergency response, while the NRFA coordinated rural fire control efforts through local authorities. On July 1, 2017, the NZFSC was dissolved and replaced by Fire and Emergency New Zealand (FENZ), a unified agency that combines the functions of the former NZFS and the rural fire authorities to provide comprehensive emergency services."@en ;
        skos:historyNote  "The New Zealand Fire Service Commission (NZFSC) was a Crown entity that existed from 1975 to 2017. Now replaced by Fire and Emergency New Zealand (FENZ)."@en ;
        skos:related      <http://example.com/InlandRevenueModel#FireAndEmergencyNewZealand> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#NewZealandFireServiceCommission/NewZealandFireServiceCommission_en> .

