<http://example.com/InlandRevenueModel#AnimalWelfareAmendmentAct-No2-2015>
        rdf:type          <http://smartlogic.com/class#Law> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#AnimalHusbandry> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#PrincipalAct> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2022-05-25"^^xsd:date ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>An Act—<br/>(a) to reform the law relating to the welfare of animals and the prevention of their ill-treatment; and, in particular,—<br/>(i) to recognise that animals are sentient:<br/>(ia) to require owners of animals, and persons in charge of animals, to attend properly to the welfare of those animals:<br/>(ii) to specify conduct that is or is not permissible in relation to any animal or class of animals:<br/>(iii) to provide a process for approving the use of animals in research, testing, and teaching:<br/>(iv) to establish a National Animal Welfare Advisory Committee and a National Animal Ethics Advisory Committee:<br/>(v) to provide for the development and issue of codes of welfare and the approval of codes of ethical conduct:<br/>(b) to repeal the Animals Protection Act 1960<br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#IsAdministeredBy>
                <http://example.com/InlandRevenueModel-current-#MinistryForPrimaryIndustries> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#AnimalWelfareAmendmentAct-No2-2015/AnimalWelfareAmendmentAct-No2-2015_en0> ;
        <http://example.com/NZ-IRD#Is-amended-by>
                <http://example.com/InlandRevenueModel#COVID-19Response-TaxationAndOtherRegulatoryUrgentMeasures-Act2020> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Legislation website"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#AnimalWelfareAmendmentAct-No2-2015/2015No49_en> ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#AnimalWelfareAmendmentAct-No2-2015/AnimalsProtectionAct1960_en> ;
        sem:guid          "29fc4966-ab44-4840-8159-3efe38a16723" ;
        skos:broader      <http://smartlogic.com/term#492768876094676199672439963971808> ;
        skos:historyNote  "Date of assent 14 October 1999"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#AnimalWelfareAmendmentAct-No2-2015/AnimalWelfareAmendmentAct-No2-2015_en> .

