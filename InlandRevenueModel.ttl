        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/Cleaned-Inland-Revenue-model#BarterTransaction> , <http://example.com/InlandRevenueModel-current-#GSTSpecialInterestGroup> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel#ApplicationToRegisterForGSTOnRemoteServices> , <http://example.com/InlandRevenueModel#GSTTransitionalAndProvisionalTaxReturn> , <http://example.com/InlandRevenueModel#GSTTransitionalReturn> , <http://example.com/InlandRevenueModel#GoodsAndServicesTaxApplicationForGroupRegistration> , <http://example.com/InlandRevenueModel#GoodsAndServicesTaxReturnForGoodsSoldInSatisfactionOfDebt> ;
