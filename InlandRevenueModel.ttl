<http://example.com/InlandRevenueModel#TaxChallenge>
        rdf:type          <http://example.com/InlandRevenueModel#Case> ;
        <http://example.com/Cleaned-Inland-Revenue-model#GeneratesInformation>
                <http://example.com/Cleaned-Inland-Revenue-model#Affadavit> , <http://example.com/Cleaned-Inland-Revenue-model#ChallengeNotice> , <http://example.com/Cleaned-Inland-Revenue-model#StatementOfClaim> , <http://example.com/Cleaned-Inland-Revenue-model#StatementOfDefence> , <http://example.com/InlandRevenueModel#AffidavitOfDocumentsOfThePlaintiff> , <http://example.com/InlandRevenueModel#AgreedBundleOfDocuments> , <http://example.com/InlandRevenueModel#AgreedStatementOfFacts> , <http://example.com/InlandRevenueModel#Defendant-sAffidavitOfDocuments> , <http://example.com/InlandRevenueModel#InterlocutoryApplication> , <http://example.com/InlandRevenueModel#JointMemorandumOfCounsel> , <http://example.com/InlandRevenueModel#MemorandumForDirectionsConference> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "<p>A notice issued by the Commissioner of Inland Revenue in accordance with section 89P of the Tax Administration Act 1994; a notice issued by the Commissioner of Inland Revenue to a disputant, usually after the completion of the dispute process, with the following purposes:<br/>· to notify the disputant that the Commissioner will not be issuing an amended assessment that includes or that takes into account the adjustment proposed by the disputant;<br/>· to allow the disputant to proceed with a challenge with a hearing authority.To dispute the truth or validity of an assumption, inference, interpretation, or authority.<br/></p>"@en ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#AgreedStatementOfIssues> , <http://example.com/InlandRevenueModel#BriefOfEvidence> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Law Insider"@en ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Tax Administration Act"@en ;
        <http://example.com/InlandRevenueModel-current-#HasSub-event>
                <http://example.com/InlandRevenueModel#Discovery> , <http://example.com/InlandRevenueModel#StandardDiscovery> , <http://example.com/InlandRevenueModel#TailoredDiscovery> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "LMU content"@en ;
        sem:guid          "dbeaaf07-ab28-4fcf-8d99-e05c19c11edb" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#LegalProceeding> ;
        skos:definition   "A tax challenge means a challenge by a Taxing Authority to a specific tax treatment. In New Zealand this is done by means of a Challenge Notice."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TaxChallenge/TaxChallenge_en> .

