        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#VoluntaryBondingScheme-InformationForEmployees> , <http://example.com/InlandRevenueModel#VoluntaryBondingScheme-InformationForIndependentContractorsAndTheSelf-employed> , <http://example.com/InlandRevenueModel#VoluntaryBondingScheme-TaxInformationForPayingAgencies> ;
        <http://example.com/InlandRevenueModel#Instance>
