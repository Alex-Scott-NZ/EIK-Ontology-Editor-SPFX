<http://example.com/InlandRevenueModel#Diversity-EquityAndInclusionRoadmap>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/News/SitePages/New-addition-to-the-2024-Diversity%2C-Equity-and-Inclusion-roadmap.aspx?web=1\" class=\"on\">New addition to this year's Diversity, Equity and Inclusion roadmap (sharepoint.com)</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p style=\"text-align: left\"><span style=\"color: rgb(36, 36, 36)\">Te Tari Taake Inland Revenue’s Diversity, Equity and Inclusion (DE&amp;I) roadmap is an annual report that shows:</span></p><ul><li><span style=\"color: rgb(36, 36, 36)\">how we’ve progressed as a diverse and inclusive organisation over the past 12 months</span></li><li><span style=\"color: rgb(36, 36, 36)\">what our planned actions are for the year ahead.</span></li></ul>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Intranet<br>​<a href=\"https://irnz.sharepoint.com/sites/News/SitePages/New-addition-to-the-2024-Diversity%2C-Equity-and-Inclusion-roadmap.aspx?web=1\" class=\"on\">New addition to this year's Diversity, Equity and Inclusion roadmap (sharepoint.com)</a>​<br></p>"@en ;
        sem:guid          "15b993ac-8d7b-4f0b-9d58-e6d82f18c2e9" ;
        skos:broader      <http://example.com/InlandRevenueModel#PeopleManagementInformation> ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Annual-report> , <http://example.com/Cleaned-Inland-Revenue-model#Diversity> , <http://example.com/InlandRevenueModel#DiversityAndInclusion> , <http://example.com/InlandRevenueModel#StrategyAndGovernanceInformation> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#Diversity-EquityAndInclusionRoadmap/PapaPounamu_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Diversity-EquityAndInclusionRoadmap/Diversity-EquityAndInclusionRoadmap_en> .

<http://example.com/InlandRevenueModel#Diversity-EquityAndInclusionRoadmap/Diversity-EquityAndInclusionRoadmap_en>
