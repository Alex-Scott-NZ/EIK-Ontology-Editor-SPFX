<http://example.com/Cleaned-Inland-Revenue-model#CashWages>
        rdf:type          <http://smartlogic.com/class#Income> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://sprintlaw.co.nz/articles/illegal-cash-in-hand/\">Is It Illegal To Pay Cash In Hand In New Zealand? (2025 Updated) | Sprintlaw NZ</a>​<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "OCTC content"@en ;
        sem:guid          "2086d908-77a0-4bae-bc71-0d6043233339" ;
        skos:broader      <http://smartlogic.com/term#149403043187561556930337> ;
        skos:definition   "‘Cash in hand’ refers to when an employee is paid directly in cash rather than through a bank transfer or cheque. This method of payment is sometimes colloquially described as being “off the books,” though that is not necessarily the case when all legal requirements are met. While cash payments can sometimes be used by employers to avoid paying taxes, they are completely legal if you meet all statutory requirements."@en ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#CashWages/CashWages_en> .

