        skos:broader      <http://example.com/InlandRevenueModel#CallManagementSystem> ;
        skos:definition   "A device for handling incoming calls. Typically it answers an incoming call, gives the caller a message and puts them on hold, signalling agents a call is waiting. It has no internal switching mechanism and does not affect the call in any way. It provides an indication of which call should be picked up next in order of arrival and keeps statistical information on the progress of calls. No agent statistics are provided."@en ;
        skos:related      <http://example.com/InlandRevenueModel#QueueMonitoring> ;
