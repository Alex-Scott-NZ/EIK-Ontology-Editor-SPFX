<http://example.com/InlandRevenueModel#ProtectedDisclosurePolicy>
        rdf:type          <http://smartlogic.com/class#IR-corporate-policy> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#ProtectedDisclosureAct2000> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "MBIE Factsheet"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ProtectedDisclosurePolicy/WhistleBlowingPolicy_en> ;
        sem:guid          "b7777904-c1e8-41bc-bc7c-de8097280685" ;
        skos:broader      <http://smartlogic.com/term#36907720899152746377923> ;
        skos:definition   "<p>Protected disclosures (sometimes referred to as ‘whistle-blowing’) must be made in&nbsp;accordance with the Protected Disclosures Act 2000 (‘the Act’). The Act aims to promote the&nbsp;public interest by facilitating the disclosure and investigation of serious wrongdoing in or by a <br>public or private sector organisation. The Act also provides protection for employees who&nbsp;choose to use this policy and associated procedures to make disclosures about serious&nbsp;wrongdoing.<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ProtectedDisclosurePolicy/ProtectedDisclosurePolicy_en> .

