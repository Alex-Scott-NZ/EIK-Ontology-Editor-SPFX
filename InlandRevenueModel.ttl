        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/:u:/r/sites/kc-architecture/SitePages/About-Business-Products.aspx?csf=1&amp;web=1&amp;e=cuNBf1\">About Business Products</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A product is produced and supplied to a consumer. While Inland Revenue does not manufacture goods, it does produce products. Our products are either supplied internally, or externally to the Government/Treasury. The IR products listed here are all from the Business Products Register - a comprehensive and formally agreed list of IR’s past and current business products. "@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR business products register"@en ;
        sem:guid          "8fdcee38-8c33-4c87-89e9-e7c03ff4263f" ;
        skos:broader      <http://smartlogic.com/term#185397716530282738530987> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IRProduct0/IRProduct_en> .

