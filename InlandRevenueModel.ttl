<http://example.com/InlandRevenueModel#CostOfLivingPayment>
        rdf:type            <http://example.com/InlandRevenueModel#IRProduct1> , <http://example.com/InlandRevenueModel#NotCurrent> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Te Mātāwai"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "As part of Budget 2022, the Government announced a Cost of Living payment (COL). This is aimed at providing provide short-term financial support to eligible low- to middle-income individuals earning up to $70,000 in the period 1 April 2021 to 31 March 2022 and who are not eligible for the Winter Energy Payment (WEP)."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>IR internal</p><div><p>From review of Haukāinga top 100 list from 2022</p></div>"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#CostOfLivingPayment/PR.CS.002_en> ;
        sem:guid            "b4b46cba-3830-449c-8c00-f7c9d126e921" ;
        skos:broader        <http://example.com/InlandRevenueModel#COVID-19Support> ;
        skos:definition     "The Government has introduced a Cost of Living Payment of $350 to help with the rising costs of inflation for eligible individuals."@en ;
        skos:editorialNote  "As at 31 March 2024 The Cost of Living Payment scheme (COL) is now closed. If a customer has been assessed as eligible and has not provided a bank account, they can no longer receive the payment(s)."@en ;
        skos:related        <http://example.com/InlandRevenueModel#Budget2022> , <http://example.com/InlandRevenueModel#Subsidy> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#CostOfLivingPayment/CostOfLivingPayment_en> .

