        sem:guid          "a0442f09-869d-4822-8bd6-adee3aa06316" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerAndComplianceServices-Individuals> ;
        skos:definition   "<p>Māori team name Te Rōpū Kaitūāhanga Mātāmua which means, people that are critical to our infrastructure. New team within CCS-I recruited for the first time in July 2023 and will be kept and managed as a cohort for up to one year. The team will focus on specific targeted work in CCS and will be moved on to existing teams across CCS when their time as a cohort is completed. Source of Māori team name is Te Kāhui Tūhono.<!--EndFragment--></p>"@en ;
