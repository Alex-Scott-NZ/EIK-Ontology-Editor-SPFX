<http://example.com/InlandRevenueModel#DigitalForensics>
        rdf:type            <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#DigitalForensics/DFU_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-enterprise-data-and-analytics/SitePages/What-we-do.aspx"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Digital Forensics Team is part of the Centre for Enterprise Data Analytics. Digital Forensics is a branch of the forensic sciences that deals specifically with computing devices in a forensically sound manner, with the end goal of producing evidence in court. At Inland Revenue, Digital Forensic evidence is mainly used in support of customer compliance cases."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet"@en ;
        sem:guid            "335206c0-77ef-4776-a73b-400e86d3ffa3" ;
        skos:broader        <http://example.com/InlandRevenueModel#_PreviousBusinessUnits-> ;
        skos:editorialNote  "The Digital Forensics Unit and the Digital Audit Team have operated as both one team and two separate teams over their history. In 2023 they are operating as one team under the Centre for Enterprise Data and Analysis, so have moved this term into the previous business units group."@en ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#DigitalForensics/DigitalForensicsTeam_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#DigitalForensics/DigitalForensics_en> .

