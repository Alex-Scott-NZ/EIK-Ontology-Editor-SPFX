        sem:guid          "c2c07c9e-d301-401a-b604-ed949a077097" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#CompanyIdentifiers> ;
        skos:definition   "An International Securities Identification Number (ISIN) is a 12-character, alphanumeric code that uniquely identifies a financial instrument, such as a stock, bond, or option. Its main purpose is to facilitate the uniform and precise identification of securities for global trading, clearance, and settlement processes, enhancing market efficiency and enabling regulators to better supervise activities and detect potential fraud. The International Organization for Standardization (ISO) publishes the ISIN standard (ISO 6166), while the Association of National Numbering Agencies (ANNA) oversees the global system and ensures that national numbering agencies are responsible for issuing ISINs within their respective countries. "@en ;
        skos:related      <http://example.com/InlandRevenueModel-current-#DebtInstrument> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ISIN/ISIN_en> .

