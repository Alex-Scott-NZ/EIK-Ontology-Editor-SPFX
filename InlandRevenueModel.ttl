        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>State Services Commission document:</p><div><p><a href=\"https://aus01.safelinks.protection.outlook.com/?url=https%3A%2F%2Fwww.publicservice.govt.nz%2Fassets%2FLegacy%2Fresources%2Freviewing-mog_0.pdf&amp;data=04%7C01%7CSally.Chivers%40ird.govt.nz%7C0e632528c6ab4e2afbf508d9929486ef%7Cfb39e3e923a9404e93a2b42a87d94f35%7C1%7C0%7C637701988876885840%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C1000&amp;sdata=BFehytSNgpqGpv0UYBor3JQr481BgKfnTffuSj7XCKg%3D&amp;reserved=0\">Reviewing the Machinery of Government (publicservice.govt.nz)</a></p></div><p><span><a href=\"https://aus01.safelinks.protection.outlook.com/?url=https%3A%2F%2Fwww.publicservice.govt.nz%2Fassets%2FLegacy%2Fresources%2Freviewing-mog_0.pdf&amp;data=04%7C01%7CSally.Chivers%40ird.govt.nz%7C0e632528c6ab4e2afbf508d9929486ef%7Cfb39e3e923a9404e93a2b42a87d94f35%7C1%7C0%7C637701988876895838%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C1000&amp;sdata=0A5%2FWWl3kww2DBiNspBjBG7rlvE6sIcZjc%2BcKU0DFWQ%3D&amp;reserved=0\">https://www.publicservice.govt.nz/assets/Legacy/resources/reviewing-mog_0.pdf</a></span></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Machinery is an apt metaphor for the structures and systems of government. Can refer to: the allocation of functions to and between departments and other government agencies, or the creation of a new department or other government agency, and the amalgamation or abolition of existing departments and other government agencies, or the co-ordination of the activities of departments and other government agencies.<br/><br/></p>"@en ;
        <http://example.com/NZ-IRD#Is-done-by>
                <http://example.com/InlandRevenueModel#GovernmentOfNewZealand> ;
        sem:guid          "1f085356-ae56-5d93-bb22-c639da574fea" ;
        skos:broader      <http://example.com/IRD-test-model#Activities> ;
        skosxl:prefLabel  <http://smartlogic.com/label#45770838521112907358998_English> .

