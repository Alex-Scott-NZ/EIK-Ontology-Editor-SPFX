<http://example.com/InlandRevenueModel#ChildSupportInternationalSupport>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#AgreementBetweenTheGovernmentOfNewZealandAndTheGovernmentOfAustraliaOnChildAndSpousalMaintenance> , <http://example.com/InlandRevenueModel#HagueConventionOnInternationalRecoveryOfChildSupportAndOtherFormsOfFamilyMaintenance> , <http://example.com/InlandRevenueModel-current-#ChildSupport-ReciprocalAgreementWithAustralia-Order2000> ;
        <http://example.com/InlandRevenueModel#HasFocusOn>
                <http://example.com/Cleaned-Inland-Revenue-model#Receiving-carer> , <http://smartlogic.com/term#65946683017913937338444> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel#UsesService>
                <http://example.com/InlandRevenueModel#IndividualProductEnrolmentService> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "New Zealand is party to a number of international agreements to facilitate the assessment and collection of child support cross border.  Depending on which international agreement applies cases can be referred to New Zealand direct from an overseas child support agency or from the Ministry of Justice (after they have recognised an overseas court order for child support)."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR Products - Facilitated payments"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#ChildSupportInternationalSupport/PR.FP.001_en> ;
        sem:guid          "7c1b7194-92a3-4ec4-92e7-71abff4ab953" ;
        skos:broader      <http://example.com/IRD-test-model#Child-Support-System-> ;
        skos:related      <http://example.com/InlandRevenueModel#DebtCollectionEnforcementService> , <http://example.com/InlandRevenueModel#InternationalCourtOrder> , <http://smartlogic.com/term#198788318597836492471216> ;
