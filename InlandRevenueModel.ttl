        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>IR intranet news article May 2023<br/><!--StartFragment--><a href=\"https://irnz.sharepoint.com/sites/News/SitePages/Introducing-IR%E2%80%99s-Integrity-Champion---Mary-Craig(1).aspx?web=1\">Introducing IR's Integrity Champion - Mary Craig (sharepoint.com)</a><!--EndFragment--><br/><br/></p>"@en ;
        sem:guid          "8bd1ab91-f6d4-4783-8501-380b668bda8b" ;
        skos:broader      <http://smartlogic.com/term#188649781203397804479981> ;
        skos:definition   "<p><!--StartFragment--><span style=\"color: rgb(36, 36, 36);text-align: left;background-color: rgb(255, 255, 255);float: none;\">As part of its preparation for the 2023 general election, Te Kawa Mataaho Public Service Commission worked with chief executives on the Public Service Leadership Team to establish a cohort of Integrity Champions.  This role is a way to support us at IR to do the right thing and contribute to New Zealanders' trust and confidence in the Public Service.</span><br/></p>"@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#IntegrityChampion/IR-sIntegrityChampion_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IntegrityChampion/IntegrityChampion_en> .

