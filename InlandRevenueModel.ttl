<http://example.com/InlandRevenueModel#PlanningAndPrioritisationGroup>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#PlanningAndPrioritisationGroup/PPG_en> ;
        <http://example.com/IRD-test-model#Is-managed-by>
                <http://example.com/InlandRevenueModel#StrategicPortfolioStewardship> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Register of Governance Bodies in IR - Architecture&nbsp;</p><p> </p><p><a href=\"https://irnz.sharepoint.com/sites/kc-architecture\">https://irnz.sharepoint.com/sites/kc-architecture</a></p><p> </p><p>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Provide a coordinated and consistent approach to portfolio planning and initiative prioritisation ensuring expected benefits are aligned to Te Pae Tawhiti (IR's strategy approach), the priorities and outcomes identified through Eke Tangaroa (IR's enterprise plan) and annual budgeting processes.\n<br>Provide for business engagement, scheduling, and resource management. \n<br>Present any escalations in scope or resourcing to EPPC. Provide formal stage gate processes while progresses through the initiative lifecycle. Considerations by the Portfolio Governance Committee (PGC).</p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Strategic Portfolio Stewardship"@en ;
        sem:guid          "9e5f948d-eac7-410e-be30-c1b02e4f8564" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skos:related      <http://example.com/InlandRevenueModel#EnterprisePrioritiesAndPerformanceCommittee> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#PlanningAndPrioritisationGroup/Planning-PrioritisationGroup_en> , <http://example.com/InlandRevenueModel#PlanningAndPrioritisationGroup/PrioritisationAndPlanningGroup_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PlanningAndPrioritisationGroup/PlanningAndPrioritisationGroup_en> .

