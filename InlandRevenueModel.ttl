<http://example.com/Cleaned-Inland-Revenue-model#ComplyingFund>
        rdf:type          <http://example.com/InlandRevenueModel#FinancialProduct> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/Cleaned-Inland-Revenue-model#ComplyingFund/CSF_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#FinancialSectorRelationshipManagement> ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/Cleaned-Inland-Revenue-model#ComplyingFund/CriticalSuccessFactor_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "D117_Data sources high level stage 2"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A superannuation scheme that has been approved by the Financial Markets Authority. These schemes must comply with the following rules: Have the same lock-in provisions as a KiwiSaver scheme where the funds are locked in until the member reaches the NZ superannuation qualification age (currently 65) or they have been a member of the scheme for 5 years (whichever is the later); Complies with any enactment that would require the trustees to release the funds from that scheme; Provides for withdrawal by personal representative on the death of the member; Is able to be transferred to a KiwiSaver scheme or to another complying superannuation scheme. Provides for the following permitted KiwiSaver withdrawals: first home purchase, significant financial hardship, serious illness, permanent emigration."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "D117_Data sources high level stage 2"@en ;
        sem:guid          "766f2092-557f-4a03-97f1-6295c9b28527" ;
        skos:broader      <http://smartlogic.com/term#755742870035676660272218483926388> ;
        skos:definition   "A New Zealand retirement scheme that offers KiwiSaver-consistent savings incentives to members who agree to contribute on terms similar to the KiwiSaver scheme rules."@en ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#ComplyingFund/CSFProvider_en> , <http://example.com/Cleaned-Inland-Revenue-model#ComplyingFund/ComplyingFund_en0> , <http://example.com/Cleaned-Inland-Revenue-model#ComplyingFund/ComplyingSuperannuationScheme_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#ComplyingFund/ComplyingFund_en> .

