<http://example.com/InlandRevenueModel#RiskMethodology>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#BusinessAndCorporate> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "https://www.sspa.se/tools-and-methods/risk-analysis-methodologies#:~:text=Risk%20Analysis%20Methodologies%20are%20a,assessments%20of%20risk%20control%20measures."@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#RiskMethodology/RiskAnalysisMethodology_en> , <http://example.com/InlandRevenueModel#RiskMethodology/RiskManagementMethodology_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Enterprise Design & Integrity"@en ;
        sem:guid          "ed004366-ba9b-40e1-8365-5976f44a86d6" ;
        skos:broader      <http://smartlogic.com/term#143919668998349297872068> ;
        skos:definition   "Risk Methodologies are methods for identifying and analysing undesirable events or results of a process, and determining whether the risks are acceptable. If risks are unacceptable, the process may include recommendations and assessments of risk control measures. There are three kinds of methods used for determining the level of risk to business. The methods can be: Qualitative Methods – Quantitative Methods – Semi-quantitative Methods. Examples of the methodologies in use are: Hazard and Operability (HAZOP); Preliminary Hazard Analysis (PHA); Failure Mode and Effects Analysis (FMEA/FMECA); Event trees; Cause-Consequence Analysis; Fault tree analysis; Bayesian network analysis; Bowtie risk methodology."@en ;
        skos:related      <http://example.com/InlandRevenueModel#EnterpriseRiskManagementFramework> , <http://example.com/InlandRevenueModel#ISO31000> , <http://smartlogic.com/term#47765963176520709341237> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#RiskMethodology/RiskMethodology_en> .

