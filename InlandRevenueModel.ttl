<http://example.com/InlandRevenueModel#OneIdentityManager>
        rdf:type          <http://example.com/IRD-test-model#System> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/InlandRevenueModel#OneIdentityManager/OneIM_en0> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-system-type>
                <http://example.com/InlandRevenueModel#AccessControlSystem> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#PositionBasedRole> ;
        <http://example.com/InlandRevenueModel#IsSystemUsedBy>
                <http://example.com/InlandRevenueModel#NewZealandProductivityCommission> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-people-and-workplace-services/SitePages/One-Identity-Manager.aspx?web=1"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "https://www.oneidentity.com/products/identity-manager/"@en ;
        <http://example.com/InlandRevenueModel#SupportsActivity>
                <http://example.com/InlandRevenueModel#IdentityManagementFunctionality> ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "One Identity Manager (OneIM) is Inland Revenue's system access management tool. It currently manages and provides automated \"basic\" system access to Ātea, Payroll (SAP/MIRI), Microsoft365/network (Active Directory) and STAX. It is also the front door to request further system access as required.​​​​​​​ It also manages Ātea provisioning access for NZPC staff. NZPC - (New Zealand Productivity Commission) uses IRs Ātea platform to provide HR/financial services to NZPC."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Enterprise Services Korero, July 2023"@en ;
        sem:guid          "24a088c8-f600-4274-9adc-3a1d24c97b1a" ;
        skos:broader      <http://smartlogic.com/term#47372529931203401780288> ;
        skos:definition   "One Identity Manager governs, provisions and secures your enterprise identities, data and users to meet uptime requirements, reduce risk and satisfy compliance by giving users access to data and applications they need - and only what they need - whether on-premises, hybrid or in the cloud. Identity Manager unifies security policies across your entire enterprise and provides a clear 360-degree view of your governance posture."@en ;
        skos:related      <http://example.com/InlandRevenueModel#Atea> , <http://example.com/InlandRevenueModel#SAP> , <http://example.com/InlandRevenueModel#Stax> , <http://smartlogic.com/term#75420159540835943508606> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#OneIdentityManager/OneIM_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#OneIdentityManager/OneIdentityManager_en> .

