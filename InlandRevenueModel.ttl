        sem:guid          "6a5cb071-3b43-4dcc-8a85-bc78e72823e8" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRDRegistration> ;
        skos:definition   "<p>A person or entity may become a registered intermediary if they: carry on a professional public practice, or are in a business or occupation in which they act for others, and act for 10 or more clients (excluding themselves), and hold a valid Authority to Act for each client.<br>If a person acts for fewer than 10 clients, they are treated as a nominated person, not a registered intermediary.<br></p><p>Inland Revenue recognises several types of registered intermediaries, including:<br>Tax agents – prepare income tax returns for 10+ clients<br>Registered bookkeepers – act for 10+ clients in relation to GST, payroll, or other tax types<br>PAYE intermediaries – manage employer obligations (PAYE, filing, payments)<br>Other intermediaries – approved representatives acting for clients on tax or social‑policy matters<br>An intermediary may be registered as more than one type if eligibility criteria are met.<br></p>"@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Bookkeeper> , <http://example.com/Cleaned-Inland-Revenue-model#PAYEIntermediary> , <http://smartlogic.com/term#197328649962691294233513> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#RegisteredIntermediary/RecognisedIntermediary_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#RegisteredIntermediary/RegisteredIntermediary_en> .

