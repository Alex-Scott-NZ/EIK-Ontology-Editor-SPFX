                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>An agreement to pay child support or domestic maintenance where both parties agree on the amount to be paid.&nbsp;</p><p><br></p><p>A private agreement is an informal, parent‑managed arrangement with no Inland Revenue involvement.<br>A voluntary agreement is a formal, written agreement registered with Inland Revenue, which IR collects and enforces under the Child Support Act 1991.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website child support glossary"@en ;
        sem:guid          "b44c2868-3637-4b78-a40e-9072299386eb" ;
