        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p><a href=\"https://www.digital.govt.nz/standards-and-guidance/privacy-security-and-risk/privacy/data-protection-and-use-policy-dpup/read-the-dpup-principles/\">https://www.digital.govt.nz/standards-and-guidance/privacy-security-and-risk/privacy/data-protection-and-use-policy-dpup/read-the-dpup-principles/</a>   Te Aka Māori dictionary. <a href=\"https://maoridictionary.co.nz/\">https://maoridictionary.co.nz/</a> <br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Ensuring we engage with customers in ways that work best for them so they understand why we need the data and information we ask for and what we will do with it."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "https://irnz.sharepoint.com/:b:/r/sites/govcentre/Documents/Data%20and%20Information%20Governance%20Standard.pdf?csf=1&web=1&e=2tZYGj"@en ;
        sem:guid          "f7a5159b-97f3-47a9-b010-c95bcd01144d" ;
        skos:broader      <http://example.com/InlandRevenueModel#GovernancePrinciple> ;
        skos:definition   "Empower people by giving them choice and enabling their access to and use of their data and information. Governance, authority, jurisdiction, management, mandate, power."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Data-governance> , <http://example.com/Cleaned-Inland-Revenue-model#Jurisdiction> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ManaWhakahaere/ManaWhakahaere_en> .

