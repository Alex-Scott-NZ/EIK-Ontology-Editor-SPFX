<http://example.com/InlandRevenueModel#DataAndInformationMetadataStandard>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span>https://irnz.sharepoint.com/sites/govcentre/Documents/Forms/AllItems.aspx?id=%2Fsites%2Fgovcentre%2FDocuments%2FData%20and%20Information%20Metadata%20Standard%2Epdf&amp;parent=%2Fsites%2Fgovcentre%2FDocuments</span></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "This Standard exists to support effective data and information management practices in Inland Revenue and the Public Sector. Meeting this Standard enables us to manage information assets in a more coherent and integrated way. This Standard supports the principles of our Information Management Policy."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#DataAndInformationMetadataStandard/DataAndInformationMetadataFramework_en> , <http://example.com/InlandRevenueModel#DataAndInformationMetadataStandard/MetadataFoundationSpecification_en> , <http://example.com/InlandRevenueModel#DataAndInformationMetadataStandard/MinimumMandatoryMetadataSpecification_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
