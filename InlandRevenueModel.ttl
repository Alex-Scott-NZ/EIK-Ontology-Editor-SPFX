<http://example.com/InlandRevenueModel#RightOfRenewal>
        rdf:type          <http://smartlogic.com/class#Agreement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsAuthorityObjectOf>
                <http://example.com/InlandRevenueModel#ContractManagement> ;
        <http://example.com/IRD-test-model#Has-acronym>
