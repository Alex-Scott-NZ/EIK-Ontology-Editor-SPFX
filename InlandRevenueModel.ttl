<http://example.com/InlandRevenueModel#AbatementRate>
        rdf:type          <http://smartlogic.com/class#Rate> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-21"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#AbatementRate/WfFAbatement_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "SD&I content"@en ;
        sem:guid          "8bda230e-2ad9-4371-8494-3a0d0e66240e" ;
        skos:broader      <http://smartlogic.com/term#41270193211275050540129> ;
        skos:definition   "<p>The abatement rate is the rate at which a payment or entitlement is reduced as income increases above a set threshold. It is usually expressed as cents reduced for every dollar of income over that threshold.&nbsp;In other words, once a person or family’s income goes above the abatement threshold, their entitlement does not stop immediately — instead, it is gradually reduced at the abatement rate.</p><p><br></p><p>Abatement rate is used where government assistance is income‑tested, and&nbsp;reduced progressively above a threshold, and expressed as a linear reduction per dollar of income.&nbsp;That applies to:&nbsp;Working for Families components; FamilyBoost; and&nbsp;Income‑tested benefits.&nbsp;It does not apply to standard income tax rates,&nbsp;PAYE thresholds, and general tax deductions or obligations.<br></p>"@en ;
        skos:related      <http://example.com/IRD-test-model#Income-tested-benefit> , <http://example.com/InlandRevenueModel#AbatementThreshold> , <http://example.com/InlandRevenueModel#EffectiveMarginalTaxRate> , <http://example.com/InlandRevenueModel#FamilyBoost> , <http://example.com/InlandRevenueModel#WorkingForFamiliesTaxCredit> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#AbatementRate/AbatementRate_en> .

<http://example.com/InlandRevenueModel#AbatementRate/AbatementRate_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Abatement rate"@en .

<http://example.com/InlandRevenueModel#AbatementRate/WfFAbatement_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "WfF abatement"@en .

<http://example.com/InlandRevenueModel#AbatementThreshold>
        rdf:type          <http://smartlogic.com/class#Rate> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-21"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "SD&I content"@en ;
        sem:guid          "84819689-ffd4-4369-81f4-092f04ef7279" ;
        skos:broader      <http://smartlogic.com/term#41270193211275050540129> ;
        skos:definition   "The abatement threshold is the income level at which an entitlement starts to reduce because income has exceeded that amount. Below the abatement threshold, the full entitlement is payable. Once income goes over the threshold, the entitlement is reduced using the applicable abatement rate."@en ;
        skos:related      <http://example.com/IRD-test-model#Income-tested-benefit> , <http://example.com/InlandRevenueModel#AbatementRate> , <http://example.com/InlandRevenueModel#FamilyBoost> , <http://example.com/InlandRevenueModel#WorkingForFamiliesTaxCredit> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#AbatementThreshold/AbatementThreshold_en> .

