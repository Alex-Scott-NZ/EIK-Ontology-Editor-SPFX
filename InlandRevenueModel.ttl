<http://example.com/InlandRevenueModel#PouHereTangata>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/InlandRevenueModel#PouHereTangata/IPV_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2025-08-29"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-integrated-planning-voice-and-more"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>One programme, two initiatives.&nbsp;Pou Here Tangata is a programme focused on delivering two initiatives:&nbsp;Future Proofed Voice Channel (FPVC) and&nbsp;Integrated Operational Planning (IOP).</p><p><br></p><p>In recent years, customers have increasingly shifted toward using IR’s digital channels, while continuing to contact us by phone. Internally, we've adapted by moving to capability-based roles, introduced some new broad operational roles, and our CCS people are progressively working in new ways, across multiple channels and products. With this shift in mind, we need to invest in both our core ‘voice’ and ‘non-voice’ technology and planning systems, as well as future proof our technology platforms to best support our people and work management flows. At the same time, we need to keep pace with changing customer needs and contact demands.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "https://irnz.sharepoint.com/sites/News/SitePages/Pou-Here-Tangata---go-live-dates.aspx?web=1"@en ;
        sem:guid          "fb6f210a-c4a3-4a91-82be-7b9c11a85b0e" ;
        skos:broader      <http://example.com/IRD-test-model#Programe-or-project> ;
        skos:historyNote  "Started in 2022. Due to finish in 2025."@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#PouHereTangata/IntegratedPlanning-Voice-More_en> , <http://example.com/InlandRevenueModel#PouHereTangata/PouHereTangata_en0> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PouHereTangata/PouHereTangata_en> .

<http://example.com/InlandRevenueModel#PouHereTangata/IPV_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "IPV"@en .

<http://example.com/InlandRevenueModel#PouHereTangata/IntegratedPlanning-Voice-More_en>
        rdf:type               skosxl:Label ;
