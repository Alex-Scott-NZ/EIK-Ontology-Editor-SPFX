<http://example.com/InlandRevenueModel#OctoberBaselineUpdate0>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#OctoberBaselineUpdate0/OBU_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Twice a year, in March and October, departments ask their own Minister and the Minister of Finance to approve changes to their baselines for the current and coming years. This involves making changes to the baseline because, for example, money that is no longer needed for a particular programme is being given back to the Crown; money is being given to IR for a new programme; or money given to IR for use on a programme in one year will instead be<br/>used in another year.<br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website; Corporate Finance content"@en ;
        sem:guid          "04a61587-4e6b-490f-a412-57ae6065485f" ;
        skos:broader      <http://example.com/InlandRevenueModel#BaselineUpdate> ;
        skos:related      <http://example.com/InlandRevenueModel#FinancialStatement> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#OctoberBaselineUpdate0/OctoberBaselineUpdate_en> .

