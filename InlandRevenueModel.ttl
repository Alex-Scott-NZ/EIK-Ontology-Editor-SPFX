        skos:definition  "<p>The occupation of an individual eg barrister, doctor, journalist<br/></p>"@en .

<http://example.com/NZ-IRD#Profession0>
        rdf:type          <http://example.com/NZ-IRD#Profession> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/NZ-IRD#Source-of-term>
                "ANZSOC - Australia New Zealand Standard Occupations Classification"@en ;
        sem:guid          "9003f115-3642-48e7-b85e-db8168713af7" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#TypesOfPerson> ;
        skos:scopeNote    "<p>Used in Enterprise Ontology. Also used by Talent &amp; People Analytics. Contact Paul Morrissey (April 2021). </p><div><p>&#34;From a People &amp; Workplace Services perspective, we assign ANZSOC codes to all Job/Role Descriptions within IR, and this data is recorded and held in Atea and SAP against each respective job/role. We then use these codes to further categorise and segment our workforce, which is then used in various workforce analyses and research we conduct as well as for use in any relevant internal and external reporting exercises we are involved in – for example, the Public Service Commission requires agencies to provide workforce data, on an annual basis, which must include ANZSOC codes, that are assigned to each role that is occupied by an individual staff member. The Public Service Commission then uses this data to produce and publish an external report on the composition of the Public Service workforce. We also use ANZSOC codes when extracting and analysing data from the various data sets produced and provided by Statistics NZ  (e.g. Census, Household Labour Force, Labour Market) in order to gain further insight and intelligence when conducting analyses and research.</p></div>"@en ;
        skosxl:prefLabel  <http://example.com/NZ-IRD#Profession0/Profession_en> .

<http://example.com/NZ-IRD#Profession0/Profession_en>
        rdf:type            skosxl:Label ;
        sem:autocompletion  sem:AutocompletionOff ;
        sem:conceptMapping  sem:ConceptMappingOff ;
        sem:rulebaseAction  sem:RulebaseActionDoNotGenerate ;
        skosxl:literalForm  "Occupation"@en .

<http://example.com/NZ-IRD#Professional-association>
