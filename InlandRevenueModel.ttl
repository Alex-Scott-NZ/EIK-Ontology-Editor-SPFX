        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Imputation grouping enables any Australian or New Zealand company within a wholly owned group to pay an imputed dividend using imputation credits gained by any Australian or New Zealand company within the group from tax any of those companies have paid, or imputation credits attached to dividends received by any of those companies that are shareholders of companies."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "9dcbef57-0ea3-4b20-be2e-5cc04ee2b98b" ;
        skos:broader      <http://example.com/IRD-test-model#Taxpayer-status> ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Imputation> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#ImputationGroup/ImputationGroup_en> .

