<http://example.com/Cleaned-Inland-Revenue-model#FIRST>
        rdf:type            <http://example.com/IRD-test-model#System> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-system-type>
                <http://example.com/InlandRevenueModel#HeritageServices> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/InlandRevenueModel#DownlistingReport> , <http://example.com/InlandRevenueModel-current-#ElectronicAmendmentSchedule> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsSystemUsedBy>
                <http://example.com/InlandRevenueModel#Revenue-SocialPolicy> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2022-08-02"^^xsd:date ;
        <http://example.com/InlandRevenueModel#NotInNPT>
                <http://example.com/Cleaned-Inland-Revenue-model#FIRST/FIRSTADMINISTRATIVE_en> , <http://example.com/Cleaned-Inland-Revenue-model#FIRST/FIRSTNAME_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IKM Team"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Between 1990-1994 Future Inland Revenue Systems & Technology (FIRST) was development with Andersen Consulting assistance. It took 250,000 days of development ($200m). In excess of 30 projects, were all delivered on-time and within budget. FIRST was Cobol based (6,000 programs, 40 million lines of code). FIRST infrastructure was primarily Algol based and was housed by Unisys DMSII (database). Our FIRST solution delivered almost all the core Tax & Social Policy functionality. It was decommissioned November 2021. Replaced by START."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/Cleaned-Inland-Revenue-model#FIRST/CAYD_en> , <http://example.com/Cleaned-Inland-Revenue-model#FIRST/CEA_en> , <http://example.com/Cleaned-Inland-Revenue-model#FIRST/CRE-_en> , <http://example.com/Cleaned-Inland-Revenue-model#FIRST/ECLIENTREGISTRATION_en> , <http://example.com/Cleaned-Inland-Revenue-model#FIRST/HeritageCoreTaxSystem_en> , <http://example.com/Cleaned-Inland-Revenue-model#FIRST/NEXTCONV-_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IM team content; IT&C content"@en ;
        sem:guid            "36440453-16f1-4093-97dd-93524a5dd7c1" ;
        skos:broader        <http://smartlogic.com/term#47372529931203401780288> ;
        skos:editorialNote  "FIRST decommissioned as at 30 November 2021."@en ;
        skos:related        <http://example.com/InlandRevenueModel#MAASI> , <http://example.com/InlandRevenueModel#NXVIEW> , <http://example.com/InlandRevenueModel-current-#OLACS> , <http://smartlogic.com/term#20431262389795396317914> ;
        skosxl:prefLabel    <http://example.com/Cleaned-Inland-Revenue-model#FIRST/FIRST_en> .

