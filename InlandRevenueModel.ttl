        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "RMWG charter."@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The purpose of the RMWG is to determine the mechanisms required to provide an aggregated view of resource information from multiple systems across IR demonstrating demand, supply and fulfillment. Being able to provide this information will provide assurance in the ability of the organisation to successfully deliver the transformation and beyond, in addition to the services of Inland Revenue to the public of New Zealand. We will also be able to articulate the impacts of portfolio demand at an enterprise level for escalation (if required)."@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#ResourceManagement> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Portfolio Office"@en ;
        sem:guid          "376095ae-e1d1-4472-b9e7-309fff3fba2e" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skos:historyNote  "<p>Set up in 2018 to manage the impacts of Business Transformation. No longer in existence.<br><br></p>"@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#ResourceManagementWorkingGroup/ResourceWorkingGroup_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ResourceManagementWorkingGroup/ResourceManagementWorkingGroup_en> .

