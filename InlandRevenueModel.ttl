        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerActionsAndInteractions> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2022-07-12"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/customer-and-compliance-services/SitePages/What-we-do.aspx"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "CCS – individuals makes it easier for people to pay the right tax and receive the right entitlement. Our people give advice and support to individual, families and micro business customers, including not-for-profit organisations. We’re the first point of contact for customers who call IR, and we’re out in the community.​​​​​​​"@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://example.com/InlandRevenueModel#CommunityComplianceLeader> , <http://example.com/InlandRevenueModel#CustomerEnquiriesAssistant> ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#ContinuousImprovementManagement> , <http://example.com/InlandRevenueModel#CustomerSegmentation> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#CustomerAndComplianceServices-Individuals/CCSI-I_en> , <http://example.com/InlandRevenueModel#CustomerAndComplianceServices-Individuals/CustomerAndComplianceServices-Individuals_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Intranet</p><div><p>Māori term from IR Māori translation register 2021</p></div>"@en ;
        sem:guid          "b8665b03-8587-4bba-b3f5-b151e44343de" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerAndComplianceServices> ;
        skos:definition   "CCS - Individuals makes tax compliance simpler by giving advice and support to individuals, families, tax agents, and community groups. We also provide design and delivery, planning and performance, and operational support for the CCS business groups. (2025)"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CustomerAndComplianceServices-Individuals/CustomerAndComplianceServices-Individuals_en> .

