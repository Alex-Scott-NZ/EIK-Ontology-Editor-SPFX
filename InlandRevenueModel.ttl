<http://example.com/Cleaned-Inland-Revenue-model#QualifyingForeignPrivateAnnuity>
        rdf:type          <http://example.com/InlandRevenueModel#FinancialProduct> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
