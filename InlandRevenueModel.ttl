<http://example.com/InlandRevenueModel#FutureProofedVoiceChannel>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#FutureProofedVoiceChannel/FPVC_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#GenesysVoicePlatform> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IR Glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Future Proofed Voice Channel (FPVC) – in November 2023, the technology our people use to make and receive customer calls, (WDE, Workspace Desktop Edition) as well as voice administration tools, were replaced by Genesys Cloud technology.&nbsp;</p><p><br></p><p>When the Pou Here Tangata programme was established, the vision for the Future Proofed Voice Channel initiative was agreed:&nbsp;… to have an adaptable Voice Channel supporting vulnerable customers and the prompt resolution of complex customer issues, while enhancing the reputation of IR and enriching the voice of our customers.&nbsp;This vision formed the foundation of the changes implemented in November 2023.<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#InvolvesObject>
                <http://example.com/InlandRevenueModel#CallCentre> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/CORP-integrated-planning-voice-and-more/SitePages/Future-Proofed-Voice-Channel.aspx?csf=1&amp;web=1&amp;share=EQBCh_Bmm3ZNnASHVdCD46kBasHm5ZZEtRCzfE-KbNorJg&amp;e=wqNpSZ\">Future Proofed Voice Channel (FPVC)</a>​<br></p>"@en ;
        sem:guid          "f050b522-944b-4db0-8606-f72ed753be3c" ;
        skos:broader      <http://example.com/InlandRevenueModel#PouHereTangata> ;
        skos:definition   "An initiative under Pou Here Tangata – Integrated Planning, Voice & more (IPV). The initiative is looking at how our voice channel can be more flexible  in our ability to respond appropriately to customers and their needs."@en ;
        skos:historyNote  "This was started in 2022 and finished in 2023."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#FutureProofedVoiceChannel/FutureProofedVoiceChannel_en> .

<http://example.com/InlandRevenueModel#FutureProofedVoiceChannel/FPVC_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "FPVC"@en .

