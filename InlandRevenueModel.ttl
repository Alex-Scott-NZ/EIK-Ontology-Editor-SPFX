<http://example.com/Cleaned-Inland-Revenue-model#BonusPayment>
        rdf:type          <http://smartlogic.com/class#Income> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "​Regular bonus: a bonus paid to employees at regular intervals, such as a weekly or monthly production bonus. It is to be taxed as part of the employee's regular earnings. Special or irregular bonus: a bonus paid as a one-off or infrequent payment, such as an end-of-year bonus for exceptional performance. Refer toCalculate PAYE on lump sum/bonus/allowance for an explanation of tax treatment."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>TIB index; </p><p>Corporate Finance content</p>"@en ;
        sem:guid          "ab3895a2-0b57-41b6-8bda-4e199dd63c2c" ;
        skos:broader      <http://smartlogic.com/term#149403043187561556930337> ;
        skos:definition   "A bonus payment is any additional amount paid to an employee in connection with their employment, beyond their ordinary salary or wages. This includes performance bonuses, incentive payments, and discretionary lump sums. Therefore, a bonus is legally classified as employment income."@en ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#BonusPayment/Bonus_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#BonusPayment/BonusPayment_en> .

