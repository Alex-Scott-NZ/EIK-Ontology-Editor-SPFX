<http://example.com/InlandRevenueModel#IncomeProtectionInsurancePayout>
        rdf:type          <http://smartlogic.com/class#Entitlement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling"@en ;
        sem:guid          "0ebfb75d-26a6-49d1-87f7-7d17123d7278" ;
        skos:broader      <http://example.com/InlandRevenueModel#InsurancePayments> ;
        skos:definition   "<p>An income‑protection insurance payout is a regular payment made by a private insurance company to a policyholder who is unable to work because of illness or injury, where the claim meets the conditions of the insurance policy.&nbsp;The payout is designed to replace a portion of the policyholder’s pre‑disability income while they are unable to work, and it is paid under a private insurance contract, not under statute.<br></p><p>Key features:&nbsp;Paid by a private insurer;&nbsp;Triggered by illness or injury (including non‑accidental illness);&nbsp;Usually paid monthly, up to a set percentage of income;&nbsp;Subject to policy terms, such as waiting periods and benefit periods;&nbsp;Exists to supplement gaps where ACC does not apply, particularly for illness.<br></p>"@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#IncomeProtectionInsurance> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IncomeProtectionInsurancePayout/IncomeProtectionInsurancePayout_en> .

<http://example.com/InlandRevenueModel#IncomeProtectionInsurancePayout/IncomeProtectionInsurancePayout_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Income protection insurance payout"@en .

