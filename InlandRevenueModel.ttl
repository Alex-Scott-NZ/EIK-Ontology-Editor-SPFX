<http://example.com/InlandRevenueModel#PolicyImpactAssessment>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-related-documents>
                <http://example.com/Cleaned-Inland-Revenue-model#Commentary> , <http://example.com/InlandRevenueModel#ImpactSummary> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment0> , <http://example.com/InlandRevenueModel#RegulatoryImpactAssessment> , <http://example.com/InlandRevenueModel#SpecialReport> , <http://example.com/InlandRevenueModel#TaxPolicyReport> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#PolicyImpactAssessment/PIA_en> ;
        <http://example.com/InlandRevenueModel#HasRelatedActivity>
                <http://example.com/InlandRevenueModel#PolicyReview> , <http://smartlogic.com/term#97783351948796139392048> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#Activity-CreatingPolicy> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#PolicyImpactAssessmentForuem> ;
        <http://example.com/InlandRevenueModel#MakesUseOfService>
                <http://example.com/InlandRevenueModel#LegislationService> ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#PolicyImpactAssessment/PrivacyImpactAssessment_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-policy-and-regulatory-stewardship/SitePages/Forms/ByAuthor.aspx"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Wikipedia"@en ;
        <http://example.com/InlandRevenueModel#usedInME3ValueSet>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Our advice to Ministers includes the costs and impacts that proposed changes will have on Inland Revenue. We identify these using the policy impact assessment process, and a forum of people from across Inland Revenue review and approve our assessments. The aim of the policy impact assessment process and forum is to make sure that the costs and impacts we provide to Ministers and Cabinet are as comprehensive, accurate and consistent as possible. It’s essential that we get agreement from all areas of IR on the expected costs and impacts of any proposed policy changes and how practical or convenient it would be to put those changes into place."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#PolicyImpactAssessment/ASpecialReportFromC2B6-PolicyAndStrategy-InlandRevenueC2B6_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/ASpecialReportFromPolicyAndStrategy_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/CommentaryOnTheBill_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/CostingTaxPolicy_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/EconomicImplications_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/EnterTheTaxBase_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/ImpactSummaryTable_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/ImpactSummary_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/Non-monetisedBenefit_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/PIAs_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/PolicyAssumptions_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/PolicyChallenge_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/PolicyOption_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/PolicyProblemOrOpportunity_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/RevenueImplications_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/SummaryOfImpacts_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/TaxPolicyCosts_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/TechnicalCostingInformation_en> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment/TotalMonetisedBenefit_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Revenue Forecasting content; IR website"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://smartlogic.com/term#132034173310816237815769> ;
        sem:guid          "84c4f783-664a-4dbb-862a-86c26bcb3149" ;
        skos:broader      <http://example.com/InlandRevenueModel#PolicyWork> ;
        skos:definition   "Policy Impact Assessments (IAs) are formal, evidence-based procedures that assess the economic, social, and environmental effects of public policy. Contributing to continuous learning in policy development by identifying causalities that inform ex-post review of policies."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PolicyImpactAssessment/PolicyImpactAssessment_en> .

