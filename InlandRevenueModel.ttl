<http://example.com/InlandRevenueModel#Individuals>
        rdf:type          <http://smartlogic.com/class#Party-classification> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#IndividualsCustomerSegment> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-06-23"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-customer-and-compliance-services/SitePages/Individuals-customer-segments.aspx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Our Individual customers make the up the largest percentage of the population, comprised of 86% of salary and wage earners and 8% of provisional tax payers. They include everyone who isn’t already classified in the Families or Small Businesses segments. Customers may change segments as they transition through life, for example starting a family. The Individuals segment’s opportunities include new migrants to New Zealand, engagement with people who are just starting to grow an interest in business or transitioning out of one. Individuals are likely to have some engagement with our KiwiSaver or Student Loan products in their lifetime."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#Individuals/IndividualCustomer_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS-I content"@en ;
        sem:guid          "3aaf2587-1784-4ff0-94c9-ca749b9c6fdb" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerSegment> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Individuals/Individuals_en> .

<http://example.com/InlandRevenueModel#Individuals/IndividualCustomer_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Individual customer"@en .

<http://example.com/InlandRevenueModel#Individuals/Individuals_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Individuals segment"@en .

<http://example.com/InlandRevenueModel#IndividualsCustomerSegment>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#IndividualsCustomerSegment/WahangaKiritakiTakitahi_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#IndividualsCustomerSegment/CCSI-I_en> , <http://example.com/InlandRevenueModel#IndividualsCustomerSegment/CCSIIND_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#Individuals> , <http://example.com/InlandRevenueModel-current-#Individual> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerSegmentsAndRoles> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "CCS intranet page. https://irnz.sharepoint.com/sites/CORP-customer-and-compliance-services/SitePages/CCS-Individuals.aspx"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Individuals segment manages over 3 million IRD numbers, mostly for salary and wage earners and provisional tax payers who are not in business and do not have family-related entitlements. We also look after income tax, student loans and KiwiSaver. Part of Customer and Compliance Services. Individuals go through different events and experiences and can react to triggers in different ways. Inland Revenue proactively supports individuals as they move through different life events and experience changes to their financial situations. "@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#CustomerSegmentation> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#IndividualsCustomerSegment/IndividualsCustomerSegment_en0> , <http://example.com/InlandRevenueModel#IndividualsCustomerSegment/WhangaKiritakiTakitahi_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS-I content; Intranet. Māori term supplied by the Māhutonga Team 2022."@en ;
        sem:guid          "f1003574-826e-46dd-b383-dfeb88015648" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerAndComplianceServices-Individuals> ;
        skos:definition   "The Individuals segment manages over 3 million IRD numbers, mostly for salary and wage earners and provisional tax payers who are not in business and do not have family-related entitlements. We also look after income tax, student loans and KiwiSaver."@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#IndividualsCustomerSegment/IndividualsSegment_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IndividualsCustomerSegment/IndividualsCustomerSegment_en> .

