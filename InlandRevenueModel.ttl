<http://example.com/InlandRevenueModel#PrivacyMaturityAssessmentFramework>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#PrivacyMaturityAssessmentFramework/PMAF_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel-current-#IAAuthorityProducedBy>
                <http://smartlogic.com/term#34015113214144524595531> ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://example.com/InlandRevenueModel#PrivacyReportingAndAssessment> ;
        sem:guid          "19d7c097-0f8e-4c41-8c4f-aa57a67c1695" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Enterprise-model> ;
        skos:definition   "The Privacy Maturity Assessment Framework (PMAF), developed by the New Zealand government, is a tool for public agencies to assess their current privacy practices against five defined maturity levels and identify areas for improvement. It guides agencies in improving their ability to manage personal information by focusing on four sections: core expectations, leadership, planning, policies and practice, and privacy domains. PMAF encourages agencies to integrate privacy into service delivery, promote a people-centered approach to data handling, and align with other good practices like the Data Protection and Use Policy (DPUP). "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PrivacyMaturityAssessmentFramework/PrivacyMaturityAssessmentFramework_en> .

