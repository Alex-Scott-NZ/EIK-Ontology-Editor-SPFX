        rdf:type          <http://example.com/InlandRevenueModel#Time0> , <http://smartlogic.com/class#Tax-event> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Website glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Each annual period over which a business accounts for its income and the tax payable on that. Each income year ends on the business’s balance date. A standard income year runs from 1 April to 31 March but some customers have a non-standard balance date. Their income year can start much earlier or later."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website glossary"@en ;
        sem:guid          "751a82cb-7047-5636-8b3a-7e3128f13539" ;
        skos:broader      <http://smartlogic.com/term#98013322332129375403684842273989> ;
        skos:definition   "The year that starts on 1 April and ends on 31 March (although some people may have arranged to use different dates)."@en ;
        skos:related      <http://example.com/InlandRevenueModel#BalanceDate> ;
        skosxl:prefLabel  <http://smartlogic.com/label#83292200388079318254210_English> .

