<http://example.com/InlandRevenueModel#NewZealandPermanentResident>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-26"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Required for eligibility modelling."@en ;
        sem:guid          "cd528b55-000f-4833-ba8c-21e9b5fe416c" ;
        skos:broader      <http://example.com/InlandRevenueModel#Citizenship> ;
        skos:definition   "<p>A New Zealand permanent resident can live in New Zealand forever and travel freely but is still living there by permission rather than as a citizen.&nbsp;Your status still comes from immigration law, not full membership of the country.&nbsp;</p><p>In everyday terms, it means:<br>You can live in New Zealand permanently — there’s no end date on your stay.<br>You can work and study without restrictions.<br>You can travel in and out of New Zealand freely, with no travel expiry or conditions.<br>You usually have access to public healthcare, education, and other services, subject to standard eligibility rules.<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#NewZealandPermanentResident/NewZealandPermanentResident_en> .

