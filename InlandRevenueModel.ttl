<http://example.com/InlandRevenueModel#SeniorResponsibleOwner>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#SeniorResponsibleOwner/SRO_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CI&A content; Portfolio Finance content"@en ;
        sem:guid          "dad32e60-7527-434f-8b30-4ee86d17c0d7" ;
        skos:broader      <http://smartlogic.com/term#188649781203397804479981> ;
        skos:definition   "In Agile methodology, a Senior Responsible Owner (SRO) is a senior leader accountable for a project's or program's successful delivery, ensuring it achieves its business objectives and benefits. While the specific SRO role originates from traditional program management, its principles—like championing change, making strategic decisions, managing stakeholders, and owning the business case—are vital in Agile contexts to ensure alignment, resource commitment, and risk mitigation. The SRO ensures the change maintains business focus, has clear authority, and provides leadership and vision, often working with a Product Owner who focuses on product features and backlog. "@en ;
        skos:related      <http://example.com/InlandRevenueModel#AgileMethodology> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SeniorResponsibleOwner/SeniorResponsibleOwner_en> .

