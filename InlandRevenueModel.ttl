<http://example.com/InlandRevenueModel#Initiative>
        rdf:type          <http://example.com/IRD-test-model#Event-classification> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/govcentre/Documents/Forms/AllItems.aspx?id=%2Fsites%2Fgovcentre%2FDocuments%2FInitiative%20Management%20Framework%2Epdf&amp;parent=%2Fsites%2Fgovcentre%2FDocuments\" class=\"on\">irnz.sharepoint.com/sites/govcentre/Documents/Forms/AllItems.aspx?id=%2Fsites%2Fgovcentre%2FDocuments%2FInitiative Management Framework%2Epdf&amp;parent=%2Fsites%2Fgovcentre%2FDocuments</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p> </p><p>An initiative is defined as a time-bound piece of work that delivers a change to IR’s services, products, channels or systems, achieving defined outcomes or legislative requirements. At IR, business groups plan and manage their change initiatives alongside their operational work with the aim of achieving agreed outcomes and enterprise priorities.</p><p> </p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR internal"@en ;
        sem:guid          "1a397167-1688-44c4-b101-8ce5f9b9c939" ;
        skos:broader      <http://example.com/NZ-IRD#Event-classification> ;
        skos:related      <http://example.com/InlandRevenueModel#InitiativeManagement> , <http://example.com/InlandRevenueModel#InitiativeManagementFramework> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Initiative/Initiative_en> .

