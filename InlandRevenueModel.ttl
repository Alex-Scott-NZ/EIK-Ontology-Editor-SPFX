<http://example.com/InlandRevenueModel#DesignAuthority>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#DesignAuthority/DefaultAssessment_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Governance Groups in IR list from Architecture Share Point site"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The scope of the Strategic Architecture Design Authority (DA) is all aspects of change design across the primary services, including (but not limited to): CCS- PDD (START, eServices, GWS, Contact Centre), CCS-CSI (Analytics), ES (Ātea, STAX, Haukāinga, www. etc), ED&amp;I (DIP).\n<br>The DA will provide a forum at which all design aspects of change activity will be presented, discussed, demonstrated (where practical) endorsed and/or approved. ​In addition, the DA will consider the ongoing cost and change impacts to customer, IR, our partners, and revenue of the decisions made and advise this to EPPC. The DA does not have authority to make any commercial or cost decisions.<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#IsRoleRelatedTo>
                <http://example.com/InlandRevenueModel-current-#ICTSolutionsManagement> ;
        <http://example.com/NZ-IRD#Is-offered-by-supplier>
                <http://example.com/InlandRevenueModel#StrategicArchitecture> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "SD&I content"@en ;
