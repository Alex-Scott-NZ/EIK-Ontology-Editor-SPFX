<http://example.com/InlandRevenueModel#SchedularIncome>
        rdf:type          <http://smartlogic.com/class#Income> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/NZ-IRD#Is-income-of>
                <http://example.com/InlandRevenueModel#RealEstateAgent> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Revenue Forecasting content"@en ;
        sem:guid          "5296f7e1-69ab-41ac-9e9a-3ae841b4e648" ;
        skos:broader      <http://smartlogic.com/term#460716479585426992918781858541954> ;
        skos:definition   "<p>In the New Zealand tax context, schedular income refers to income that is subject to withholding tax under the schedular payments regime, rather than PAYE. It generally applies to:<br>Contractors who provide labour or services (not goods) under certain arrangements or to specific payments such as:&nbsp;Directors’ fees;&nbsp;Commissions;&nbsp;Payments to non-resident contractors;&nbsp;Certain entertainment or prize money; and&nbsp;Labour-hire arrangements where contractors work for clients through an agency.<br>Unlike salary or wages, schedular payments are not employment income. Tax is deducted at source by the payer, but the recipient remains responsible for filing an income tax return and paying any additional tax if the withholding was insufficient.<br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#SchedularIncomeTaxDeduction> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SchedularIncome/SchedularIncome_en> .

<http://example.com/InlandRevenueModel#SchedularIncome/SchedularIncome_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Schedular income"@en .

<http://example.com/InlandRevenueModel#SchedularIncomeTaxDeduction>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://smartlogic.com/term#127100371737950821186621> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Income tax deducted by an employer on behalf of a contractor. The tax is deducted at the time the income is paid. There are other categories, such as prize money that form part of this sub-product."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR Products"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
