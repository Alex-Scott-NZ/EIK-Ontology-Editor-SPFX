<http://example.com/InlandRevenueModel#TaxAdjustment>
        rdf:type          <http://example.com/InlandRevenueModel#Measurement> ;
        <http://example.com/InlandRevenueModel#HasRelatedInformation>
                <http://example.com/Cleaned-Inland-Revenue-model#TaxAdjustmentStatement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "PAS content"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Tax adjustments are differences between: Profits/losses calculated for accounting purposes which comply with generally accepted accounting practice (GAAP) i.e. the calculations comply with NZ accounting standards, or Profits/losses calculated for accounting purposes which do not comply with GAAP and Profits/losses calculated under the Income Tax Act. Companies typically prepare accounting financial statements. However, they adjust their accounting profit/loss to arrive at taxable income. Tax adjustments are typically recorded in a tax adjustment schedule or “Statement of Taxable Income”."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "PAS content"@en ;
        sem:guid          "d7b94f8f-cc4d-4825-a34b-17924a6e1052" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Measurement> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TaxAdjustment/TaxAdjustment_en> .

