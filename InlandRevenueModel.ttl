<http://example.com/InlandRevenueModel#SocialSecurityAct2018>
        rdf:type          <http://smartlogic.com/class#Law> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Replaces>
                <http://example.com/InlandRevenueModel-current-#SocialSecurityAct1964> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#PrincipalAct> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>Form Section 3 (a) of the act - Purpose of this Act<br/><!--StartFragment--><a href=\"https://www.legislation.govt.nz/act/public/2018/0032/latest/whole.html#DLM6783121\">Social Security Act 2018 No 32 (as at 26 November 2022), Public Act – New Zealand Legislation</a><!--EndFragment--><br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#IsAdministeredBy>
                <http://example.com/Cleaned-Inland-Revenue-model#MinistryOfSocialDevelopment> ;
        <http://example.com/NZ-IRD#Is-amended-by>
                <http://example.com/InlandRevenueModel#COVID-19Response-TaxationAndSocialAssistanceUrgentMeasures-Act2020> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Legislation website"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#SocialSecurityAct2018/2018No32_en> ;
        sem:guid          "66826eda-df8a-41f9-b60e-3a420e3f7d29" ;
        skos:broader      <http://smartlogic.com/term#492768876094676199672439963971808> ;
        skos:definition   "<p><!--StartFragment-->The Social Security Act enables the provision of financial and other support as appropriate - <br/>- to help people to support themselves and their dependants while not in paid employment; and<br/>- to help people to find and retain paid employment; and<br/>- to help people for whom work is not currently appropriate - because of sickness, injury, disability, or caring responsibilities - to support themselves and their dependants.<br/>The original Social Security Act was passed 14 September 1938 and the cornerstone of the first Labour government's welfare programme.<!--EndFragment--><br/></p>"@en ;
        skos:historyNote  "Date of assent 28 September 2018"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SocialSecurityAct2018/SocialSecurityAct2018_en> .

<http://example.com/InlandRevenueModel#SocialSecurityAct2018/2018No32_en>
        rdf:type               skosxl:Label ;
        <http://smartlogic.com/relationship#Is-code-of_14_None_None>
                <http://example.com/InlandRevenueModel#SocialSecurityAct2018> ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "2018 No 32"@en .

