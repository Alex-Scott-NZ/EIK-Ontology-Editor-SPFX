                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "http://www.fma.govt.nz/assets/Guidance/_versions/9939/171010-BKBM-resource-sheet.1.pdf"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "International Revenue Strategy content"@en ;
        sem:guid          "986f1dfb-f1bb-4677-b3a4-4d52682bf799" ;
        skos:broader      <http://smartlogic.com/term#177230178356924340450739> ;
        skos:definition   "<p>The main interest rate benchmark in New Zealand. It is designed to reflect the supply and demand for Bank Bills  and is used by market participants to calculate the amounts payable under various financial instruments. It is also used in calculating the value of many financial instruments.<br><br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#BankBillRate/BankBillRate_en> .

