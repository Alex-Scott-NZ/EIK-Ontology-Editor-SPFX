<http://example.com/Cleaned-Inland-Revenue-model#EquatorialGuinea>
        rdf:type          <http://smartlogic.com/class#Country> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#Africa> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-15"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "ISO 3166"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/Cleaned-Inland-Revenue-model#EquatorialGuinea/GNQ_en> , <http://example.com/Cleaned-Inland-Revenue-model#EquatorialGuinea/GQ_en> ;
        sem:guid          "73d19ce6-5ae4-4ed1-8237-70c8f32efae9" ;
        skos:broader      <http://smartlogic.com/term#130710328707508168484707> ;
        skos:definition   "Equatorial Guinea, officially the Republic of Equatorial Guinea, is a country on the west coast of Central Africa. Equatorial Guinea consists of two parts. The mainland region, Río Muni, is bordered by Cameroon to the north and Gabon to the south and east. Río Muni's small offshore islands include Corisco, Elobey Grande, and Elobey Chico. The insular region consists of the islands of Bioko (formerly Fernando Po) in the Gulf of Guinea and Annobón. Bioko Island is the northernmost part of Equatorial Guinea and is the site of the country's capital, Malabo. The Portuguese-speaking island nation of São Tomé and Príncipe is located between Bioko and Annobón."@en ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#EquatorialGuinea/RepublicOfEquatorialGuinea_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#EquatorialGuinea/EquatorialGuinea_en> .

