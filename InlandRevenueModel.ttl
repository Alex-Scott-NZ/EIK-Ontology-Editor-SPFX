        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Minister of Corrections"@en .

<http://example.com/InlandRevenueModel#MinisterOfCustoms>
        rdf:type          <http://example.com/IRD-test-model#Job-title0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsMemberOf>
                <http://example.com/InlandRevenueModel#MinisterialOversightGroupOnGangs> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://dpmc.govt.nz/cabinet/portfolios/customs"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Responsibilities include oversight of border management, including the detection of and response to illegal activity at the border, the facilitation of the movement of legitimate imports, exports, and travellers, the collection of GST and customs duties owing at the border, as well as the collection of excise duties on tobacco, alcohol, and motor spirits.<br/><br/></p>"@en ;
        sem:guid          "63c5298e-5737-44dc-92bb-d3063709c963" ;
        skos:broader      <http://example.com/IRD-test-model#Job-title> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MinisterOfCustoms/MinisterOfCustoms_en> .

