<http://example.com/InlandRevenueModel#LeadersOfPeopleFocusPrimarilyOnCoachingAndEnablingTheirPeople>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Whanake approach, 2017/8"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Leaders spend much of their time supporting and enabling their people, with the rest of their time taken up with management responsibilities and connecting with the organisation's strategy, managing risks and H&S. Leaders' decision making is devolved as much as possible, and most leaders of people are no longer the 'source' of technical expertise but are one place to go for advice and guidance for their people, along with other technical experts across the organisation."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "http://intranet.ird.govt.nz//infoweb/sites/default/files/20200928-Recap%20-%20some%20key%20design%20features.JPG"@en ;
        sem:guid          "b5f0fe18-abf2-481b-b982-f8ead684df06" ;
        skos:broader      <http://example.com/InlandRevenueModel#FOMPrinciple2020> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#LeadersOfPeopleFocusPrimarilyOnCoachingAndEnablingTheirPeople/LeadersOfPeopleFocusPrimarilyOnCoachingAndEnablingTheirPeople_en> .

