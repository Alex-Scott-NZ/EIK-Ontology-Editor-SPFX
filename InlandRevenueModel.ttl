<http://example.com/InlandRevenueModel#InternationalSurveyOnRevenueAdministration>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#Publication> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#InternationalSurveyOnRevenueAdministration/ISORA_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IMF, Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate planning and reporting content"@en ;
        sem:guid          "33c4c7c3-bce7-48b5-b3d5-824a1d21b338" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRPublication> ;
        skos:definition   "<p>The International Survey on Revenue Administration (ISORA) collects data on tax administration from administrations around the world using questions and definitions agreed by five international organizations: the International Monetary Fund (IMF), the Asian Development Bank (ADB), the Inter-American Center of Tax Administration (CIAT), the Intra-European Organization of Tax Administrations (IOTA), and the Organization for Economic Co-operation and Development (OECD).The first survey, launched in 2016, was completed by 135 tax administration, and the survey data is now accessible for participating jurisdictions on a secured online database. The survey is continued every four years, with the most recent being in 2023.<br>The objectives of ISORA include:<br>Strengthening tax administrations' focus on data management, performance measurement and reporting;<br>Providing a set of comparable and standardized tax administration data to enable:<br>- meaningful benchmarking by tax administrations; and<br>- analysis that leads to improved capacity development advice; and<br>Assisting senior revenue administration executives in managing and evaluating their administrations' performance.<br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#OECDReporting> ;
