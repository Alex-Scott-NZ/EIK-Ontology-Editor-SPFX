        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://example.com/InlandRevenueModel#KiwiSaverMember> ;
        <http://example.com/NZ-IRD#Is-offered-by-supplier>
                <http://example.com/InlandRevenueModel-current-#MinistryForPrimaryIndustries> , <http://example.com/InlandRevenueModel-current-#MinistryOfEducation> , <http://example.com/InlandRevenueModel-current-#MinistryOfHealth> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "cbb4d5f5-a743-413e-a716-a9d93e7af51c" ;
        skos:broader      <http://example.com/IRD-test-model#Social-policy-progamme> ;
        skos:definition   "New Zealand's Voluntary Bonding Scheme offers financial payments to newly qualified health and education professionals, such as doctors, nurses, teachers, and veterinarians, to encourage them to work in hard-to-staff areas or specialties for a defined period, typically three to five years. The payments are intended to help with student loan repayments or serve as a top-up income, with the amount increasing with more years of service in the chosen hard-to-staff role. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#VoluntaryBondingScheme/VoluntaryBondingScheme_en> .

