        sem:guid          "e5e96925-c648-4fe3-a561-6ce0a871aa0a" ;
        skos:broader      <http://smartlogic.com/term#492768876094676199672439963971808> ;
        skos:definition   "The Public Service Act 2020 is really about cementing work that was already underway to create a more modern, agile, unified public service that can deliver across agency boundaries to wrap services around New Zealanders' needs. Just like we proved we could do in response to COVID. The Act also formalises our commitments in relation to Māori Crown relationship building, diversity and inclusion, leadership development and core values for the Public Service, including our Spirit of Service. And, of course, it introduces a name change for what was formerly the State Services Commission which is now known as Te Kawa Mataaho | Public Service Commission."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#PublicServiceAct2020/PublicServiceAct2020_en> .

