<http://example.com/InlandRevenueModel#SecureFileTransferProtocol>
        rdf:type          <http://smartlogic.com/class#Topic> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#SecureFileTransferProtocol/SFTP_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IT&C content"@en ;
        sem:guid          "dd63ca9f-4f4f-4f12-9617-18149243a3cc" ;
        skos:broader      <http://example.com/InlandRevenueModel#Technology> ;
        skos:definition   "SFTP (Secure File Transfer Protocol, also known as SSH File Transfer Protocol) is a network protocol that enables secure file transfers over an encrypted SSH (Secure Shell) connection, providing a high level of security through encryption and authentication for sensitive data during transmission. It operates on a client-server model, allowing remote file management such as copying, deleting, and listing directories, and supports authentication with passwords or SSH public/private keys. SFTP is widely used in various industries, including finance, healthcare, and legal, for transferring confidential information securely."@en ;
        skos:related      <http://example.com/InlandRevenueModel#SecureFileTransfer> , <http://example.com/InlandRevenueModel-current-#Standard> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SecureFileTransferProtocol/SecureFileTransferProtocol_en> .

<http://example.com/InlandRevenueModel#SecureFileTransferProtocol/SFTP_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
