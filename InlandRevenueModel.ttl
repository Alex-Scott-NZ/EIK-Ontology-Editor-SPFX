<http://example.com/InlandRevenueModel#ContentOwnershipModel>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/Content-Facilitators/Shared%20Documents/Forms/AllItems.aspx?id=%2Fsites%2FContent%2DFacilitators%2FShared%20Documents%2FGeneral%2FProject%20and%20background%20Info%2FKey%20project%20documents%2FSolution%20for%20content%20ownership%20and%20management%2Epdf&amp;parent=%2Fsites%2FContent%2DFacilitators%2FShared%20Documents%2FGeneral%2FProject%20and%20background%20Info%2FKey%20project%20documents&amp;p=true&amp;ct=1696269135715&amp;or=Teams%2DHL&amp;ga=1&amp;LOF=1\" rel=\"noreferrer noopener\" target=\"_blank\" class=\"on\">Solution for content ownership and management.pdf</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The CCS content ownership model was introduced April 2022. The model provides ownership of all IR’s external and internal guidance (excluding the Tax Technical and Policy websites) for customer-facing content. The model is owned by CCS PD&D, with ICM maintaining oversight and support. "@en ;
        <http://example.com/InlandRevenueModel-current-#IAAuthorityProducedBy>
                <http://example.com/InlandRevenueModel#CustomerAndComplianceServices> ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://example.com/InlandRevenueModel#InformationAndDataGovernance> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/Content-Facilitators/Shared%20Documents/Forms/AllItems.aspx?id=%2Fsites%2FContent%2DFacilitators%2FShared%20Documents%2FGeneral%2FProject%20and%20background%20Info%2FKey%20project%20documents%2FSolution%20for%20content%20ownership%20and%20management%2Epdf&amp;parent=%2Fsites%2FContent%2DFacilitators%2FShared%20Documents%2FGeneral%2FProject%20and%20background%20Info%2FKey%20project%20documents&amp;p=true&amp;ct=1696269135715&amp;or=Teams%2DHL&amp;ga=1&amp;LOF=1\" rel=\"noreferrer noopener\" target=\"_blank\" class=\"on\">Solution for content ownership and management.pdf</a>​<br></p>"@en ;
        sem:guid          "03e9c80a-6388-437d-9cd8-e3d762b0c4f2" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Enterprise-model> ;
