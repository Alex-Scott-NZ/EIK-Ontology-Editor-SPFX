        sem:guid          "594d1285-6c3c-45dd-9e22-d5893b63e5fe" ;
        skos:broader      <http://smartlogic.com/term#47372529931203401780288> ;
        skos:definition   "Oracle Fusion Middleware (OFM) is a standards-based platform and collection of software products designed to help businesses create, deploy, and manage applications and integrate them into cloud and on-premises environments. It provides tools for development, a Java EE application server, integration services, business intelligence, and identity management, enabling the development of agile and intelligent applications. "@en ;
