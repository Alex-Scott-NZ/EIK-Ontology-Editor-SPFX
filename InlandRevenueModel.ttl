<http://example.com/InlandRevenueModel#Capability-Outcomes-Events>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#BusinessAndCorporate> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Stax Design - CCS-I Capability & Outcomes."@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A team that is part of Capability & Outcomes. Events & Business Incidents work as a virtual team across many Business and IT groups for end-to-end management, support, and delivery of Annual Tax and Social Policy communications across multi-channel outputs to make sure legislative changes and system improvements are included on an annual or cyclic basis. This includes responsibility for managing business or customer related incidents and identifying/implementing sustainable solutions and improvements to problems reducing recurring impacts to customers and IR."@en ;
        <http://example.com/NZ-IRD#Does-activity>
