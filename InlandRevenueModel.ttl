<http://example.com/Cleaned-Inland-Revenue-model#CourtOrder>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#JudicialAuthority0> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel-current-#FamilyProceedingsAct1980> , <http://smartlogic.com/term#474166795587487981954316542391767> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://example.com/InlandRevenueModel#EstablishEligibility> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A direction issued by a court or judge requiring a person to do or not do something."@en ;
        <http://example.com/InlandRevenueModel-current-#IAAuthorityProducedBy>
                <http://example.com/InlandRevenueModel-current-#FamilyCourt> , <http://smartlogic.com/term#205733277916899973098635> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Business Rules business terms"@en ;
        sem:guid          "d6c96b80-d26b-4025-8cd1-313229cc6691" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#JudicialAuthority> ;
        skos:definition   "<p>For this concept, an undifferentiated court order is considered to be a New Zealand court order.</p><p><br></p><p>A court order is a formal, legally binding direction issued by a New Zealand court that requires a person, organisation, or public body to do, refrain from doing, or permit specified actions, in accordance with New Zealand law.&nbsp;Key elements: issued by a New Zealand judicial body (for example, District Court, High Court, Family Court); recorded in writing as the official decision of the court; legally enforceable within New Zealand; binding on the parties named in the order.&nbsp;Breach of a court order may constitute a criminal offence or contempt of court, depending on the order type.<br>The New Zealand Ministry of Justice describes a court order as recording the official legal decision of the court, which all involved parties must follow. A legal glossary used by the Ministry of Justice defines a court order as “a formal direction from the court requiring a person to do or not do certain things”.<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#CourtOrder/CourtOrder_en> .

<http://example.com/Cleaned-Inland-Revenue-model#CourtOrder/CourtOrder_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Court order"@en .

<http://example.com/Cleaned-Inland-Revenue-model#Credit>
        rdf:type          <http://example.com/NZ-IRD#Legally-defined-term> , <http://smartlogic.com/class#Entitlement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "An amount that is any of the following: tax paid by or on behalf of the taxpayer that is in excess of the amount required to be paid, to the extent the tax paid in excess is refundable and has not been applied to satisfy a tax liability or other amount due; an amount of provisional tax paid in excess of the taxpayer’s provisional tax liability as of the transfer date; an amount of interest the Commissioner of Inland Revenue is liable to pay to the taxpayer under Part 7 of the Tax Administration Act 1994."@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Tax Administration Act 1994, ss 173K(1), 173P(1)(b),  173Q(1)(b), 173R(1)(b) and 173S(1)  (Reprint as at 1 April 2015)"@en ;
        <http://example.com/NZ-IRD#Is-defined-by>
                <http://smartlogic.com/term#11769840510976632981956266406159> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Business Rules business terms"@en ;
