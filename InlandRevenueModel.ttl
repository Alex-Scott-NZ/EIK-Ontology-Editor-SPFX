<http://example.com/InlandRevenueModel#Channel>
        rdf:type          <http://smartlogic.com/class#Property> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel-current-#CommunicationsManagement> , <http://example.com/InlandRevenueModel-current-#InformationSharing> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Channel Strategy 2024"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A channel is a means by which Inland Revenue (IR) can make its products and services available to the customers.  Services include the provision of information to and from customers. For the purposes of our channel strategy, customers include all IR customer segments, intermediaries, business partners and government or non-government agencies that interact with IR."@en ;
        <http://example.com/NZ-IRD#Is-used-in-function>
                <http://example.com/InlandRevenueModel#ChannelManagement> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR Channel Strategy"@en ;
        sem:guid          "d9c2790d-5a95-438f-bd34-f975583ac54b" ;
        skos:broader      <http://example.com/IRD-test-model#Object> ;
        skos:definition   "A channel is the method, medium, or pathway used to transmit a message from a sender to a receiver, enabling the sharing of information. Channels can be as simple as face-to-face conversation, written notes, or telephone calls, or they can be more complex, involving online platforms like social media, email, or broadcast media such as television and radio. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Channel/Channel_en> .

<http://example.com/InlandRevenueModel#Channel/Channel_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Channel"@en .

