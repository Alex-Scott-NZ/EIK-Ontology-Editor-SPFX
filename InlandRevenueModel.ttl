        sem:guid          "d584e63e-6be0-4def-89c8-f5b51b421d23" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skos:historyNote  "<p><!--StartFragment--><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">In 2017 it was Chaired by Collections (SD). May have been superseded by the </span></p><p><span>MSD-IR Joint Debt Governance Group which is (2018):</span></p><div><p><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">Accountable for scoping and facilitating governance arrangements for the three streams of work in the MSD-IR Joint Debt Programme. These are: Identify policy improvements, Improve information sharing, and Co-management of joint debtors.<br/></span></p></div>"@en ;
