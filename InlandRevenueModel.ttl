<http://example.com/InlandRevenueModel#SummaryOfAccount>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#SummaryOfAccount/SOA_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInformationRelatedTo>
                <http://smartlogic.com/term#187521577273317409134042> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/kc-correspondence/SitePages/Statement-of-account.aspx?web=1"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A SOA letter is issued to a customer showing a summary of all non-zero balanced periods. Summaries are issued at customer level, the SOA displays a summary for all periods with a non-zero balance, except for the Rulings (RUL) tax type. Typically, summaries accompany other billing notices that are issued to inform the customer of all debt that is due. Every 30 days a SOA will be issued for all periods when the customers total balance of all accounts is greater than $20. These summaries will provide details about the tax, penalty, interest, credit, and other transactions for a specific period. Typically, when Inland Revenue is asking a customer for payment, a SOA will be included. Summaries can also be generated manually when the overall balance is $20 or more."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#SummaryOfAccount/ContactUsToObtainAnUp-to-dateBalance_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS Collections content"@en ;
        sem:guid          "629f43b9-aaa7-4af8-ade2-cbd44b7f088b" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerFinancialInformation> ;
        skos:related      <http://example.com/InlandRevenueModel-current-#DebtRecoveryAction> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#SummaryOfAccount/StatementOfAccount_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SummaryOfAccount/SummaryOfAccount_en> .

<http://example.com/InlandRevenueModel#SummaryOfAccount/ContactUsToObtainAnUp-to-dateBalance_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Contact us to obtain an up-to-date balance"@en .

