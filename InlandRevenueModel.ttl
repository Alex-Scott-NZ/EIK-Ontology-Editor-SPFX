        skosxl:literalForm     "PAYE intermediary"@en .

<http://example.com/Cleaned-Inland-Revenue-model#PAYESubsidy>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> , <http://example.com/InlandRevenueModel#NotCurrent> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#IncomeTax-PayrollSubsidy-Regulations2006> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ProductsWeAdminister> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#PayrollManagement> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR website"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The government will subsidise or partly subsidise the cost of an employer engaging a payroll intermediary. The subsidy will be available for up to five employees of a particular employer per month. </p><div><p>PAYE intermediaries provide payroll services to employers. If you provide a PAYE intermediary with gross payment and other relevant information they are responsible for meeting your employer responsibilities. Listed PAYE intermediaries are no longer eligible for the payroll subsidy from 1 April 2020.<br/></p></div>"@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://example.com/Cleaned-Inland-Revenue-model#PAYEIntermediary> ;
        <http://example.com/InlandRevenueModel-current-#TermInLegislation>
                <http://example.com/Cleaned-Inland-Revenue-model#PAYESubsidy/PaymentOfSubsidiesToCertainPAYEIntermediaries_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>IR website; IR Product Wheel; </p><p>Corporate Finance content; PAS content</p>"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/Cleaned-Inland-Revenue-model#PAYESubsidy/PR.CS.006_en> ;
        sem:guid          "e4e6d3da-76ed-4fb0-8bb3-d2e828492d3c" ;
        skos:broader      <http://example.com/InlandRevenueModel#CreditsAndEntitlement> ;
        skos:definition   "REPEALED:  Subsidy payment available to small employers who engage payroll agents to manage their payroll obligations."@en ;
        skos:historyNote  "This product ceased to exist as of 1 April 2020."@en ;
        skos:related      <http://example.com/InlandRevenueModel#Subsidy> , <http://smartlogic.com/term#214450622583028921698271> ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#PAYESubsidy/PAYESubsidy_en0> ;
