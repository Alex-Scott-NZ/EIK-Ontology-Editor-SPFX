<http://example.com/InlandRevenueModel#AnalyticsAndReporting>
        rdf:type            <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#Activity-Data-Information-AndTechnology> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<div><p>Qlik&nbsp;<a href=\"https://www.qlik.com/us/reporting-analytics#:~:text=Reporting%20is%20the%20process%20of,identify%20patterns%20and%20gain%20insights.\" class=\"on\">Analytics vs Reporting: Key Differences &amp; Examples (qlik.com)</a>​</p></div>"@en ;
        <http://example.com/InlandRevenueModel#usedInME3ValueSet>
                true ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Te Ara Huri Huri Metadata discussion"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.2.1_Corporate_Planning_and_Reporting> ;
        sem:guid            "7c6d25a2-846e-4a86-94b0-ab089706c9a1" ;
        skos:broader        <http://smartlogic.com/term#184149025169191612011423> ;
        skos:definition     "Reporting is the process of gathering and presenting data in a structured format such as graphs and tables. Organizing information in predefined KPIs and metrics makes it easier for you to understand what is happening. Analytics is the process of analyzing your data to identify patterns and gain insights."@en ;
        skos:editorialNote  "Prefer to use two activities for this, not one. One for reporting and one for any analytics / intelligence work. This covers the whole function of using data for report and for analytics."@en ;
        skos:related        <http://example.com/InlandRevenueModel#ChangeReporting> , <http://example.com/InlandRevenueModel#DataAnalysis> , <http://example.com/InlandRevenueModel#PerformanceReporting> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#AnalyticsAndReporting/AnalyticsAndReporting_en> .

<http://example.com/InlandRevenueModel#AnalyticsAndReporting/AnalyticsAndReporting_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Analytics and reporting"@en .

<http://example.com/InlandRevenueModel#AnalyticsGovernanceTeam>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "CEDA Team"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<!--StartFragment--><p style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);\">This role within the Centre for Enterprise Data &amp; Analytics in IR </p><p style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);\">looks after data and analytics governance; including guiding how to connect the data strategy, business strategy and analytics strategy to planning, design and governance in order to deliver on the strategic direction.</p><!--EndFragment-->"@en ;
        <http://example.com/NZ-IRD#Is-done-by>
                <http://smartlogic.com/term#178953839036513121843655> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>DSA Final Decision - IIS Alignment.pdf<br/>IIS Alignment Change Proposal.pdf<br/></p>"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.1.1_Strategic_Corporate_Policy_and_Procedures> ;
        sem:guid          "583fc1a4-0ab7-4968-a666-49ff6d19474f" ;
        skos:broader      <http://example.com/InlandRevenueModel#InformationAndDataGovernance> ;
        skos:historyNote  "Created in November 2021 as part of the CEDA creation."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#AnalyticsGovernanceTeam/AnalyticsGovernanceTeam_en> .

<http://example.com/InlandRevenueModel#AnalyticsGovernanceTeam/AnalyticsGovernanceTeam_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Analytics Governance"@en .

<http://example.com/InlandRevenueModel#AnalyticsPlanningTeam>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-enterprise-data-and-analytics/SitePages/What-we-do.aspx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The newest team in this area, Analytics Planning team looks to improve the visibility of work; connecting team planning, delivery and learning processes  and mechanisms to strategic outcomes. This Planning team will ensure time and resources are optimised, change is delivered, and that foundational assets are being developed, reused and leveraged."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>DSA Final Decision - IIS Alignment.pdf<br/>IIS Alignment Change Proposal.pdf<br/></p>"@en ;
