<http://example.com/InlandRevenueModel#CommonReportingStandardDisclosure>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>New Zealand, along with many other jurisdictions, has adopted the Common Reporting Standard (CRS) for the Automatic Exchange of Financial Account Information (AEOI) in line with the Organisation for Economic Co-operation and Development (OECD). This global framework facilitates the collection, reporting, and exchange of financial account information about individuals who invest outside their tax residence. <br><br>Financial institutions in New Zealand, as well as worldwide, are legally required to gather this information and report it to tax authorities. These authorities then exchange the information to ensure everyone pays the correct amount of tax, helping to detect and prevent offshore tax evasion.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR business products register"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#CommonReportingStandardDisclosure/PR.ID.003_en> ;
        sem:guid          "4ebe2548-26c6-4b58-9bc1-61be7f72b522" ;
        skos:broader      <http://example.com/InlandRevenueModel#InternationalDisclosures> ;
        skos:related      <http://example.com/InlandRevenueModel-current-#CommonReportingStandard> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#CommonReportingStandardDisclosure/CRSDisclosure_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CommonReportingStandardDisclosure/CommonReportingStandardDisclosure_en> .

<http://example.com/InlandRevenueModel#CommonReportingStandardDisclosure/CRSDisclosure_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "CRS disclosure"@en .

