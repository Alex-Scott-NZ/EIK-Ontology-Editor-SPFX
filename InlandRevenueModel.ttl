<http://example.com/InlandRevenueModel#TrustBeneficiary>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Investopedia"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The beneficiaries of a trust are those people who receive benefits from the trust during the lifetime of the trust and/or who will ultimately receive the trust assets when the trust is wound up. A beneficiary can be a person, a group of people (either named or otherwise specified) or an organisation for whose benefit the trust property has been settled and is held. This includes individuals, companies, other trusts, charities or clubs."@en ;
        <http://example.com/NZ-IRD#Receives-income>
                <http://smartlogic.com/term#521177223102249369105353866530028> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Tax Technical Website Project"@en ;
        sem:guid          "a9ece343-1a0d-40b9-b4df-8cfa7dcebe63" ;
        skos:broader      <http://example.com/IRD-test-model#Beneficiary> ;
        skos:definition   "A beneficiary of trust is the individual or group of individuals for whom a trust is created. The trust creator or settlor designates beneficiaries and trustees, who have a fiduciary duty to manage trust assets in the best interests of beneficiaries as outlined in the trust deed."@en ;
        skos:related      <http://smartlogic.com/term#256314115914621774342898064281208> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#TrustBeneficiary/BeneficiaryOfATrust_en> , <http://example.com/InlandRevenueModel#TrustBeneficiary/BeneficiaryOfAnEstate_en> , <http://example.com/InlandRevenueModel#TrustBeneficiary/EstateBeneficiary_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TrustBeneficiary/TrustBeneficiary_en> .

<http://example.com/InlandRevenueModel#TrustBeneficiary/BeneficiaryOfATrust_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Beneficiary of a trust"@en .

<http://example.com/InlandRevenueModel#TrustBeneficiary/BeneficiaryOfAnEstate_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Beneficiary of an estate"@en .

<http://example.com/InlandRevenueModel#TrustBeneficiary/EstateBeneficiary_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Estate beneficiary"@en .

<http://example.com/InlandRevenueModel#TrustBeneficiary/TrustBeneficiary_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Trust beneficiary"@en .

<http://example.com/InlandRevenueModel#TrustDeed>
        rdf:type          <http://smartlogic.com/class#Agreement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://smartlogic.com/term#256314115914621774342898064281208> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<div class=\"TbwUpd\"><cite class=\"iUh30\" style=\"color: rgb(0, 102, 33);\"><span><font size=\"2\">https://www.howtolaw.co/nz/trusts/trust-formation-maintenance</font></span></cite></div>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A Deed that provides for the removal of a trustee of a New Zealand Trust by the person or persons who have that power under the trust deed, with the consent of the continuing trustees."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "International Revenue Strategy content"@en ;
        sem:guid          "33708202-c696-4f41-8079-3411a913dee5" ;
        skos:broader      <http://smartlogic.com/term#147891654668390767194534> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TrustDeed/TrustDeed_en> .

<http://example.com/InlandRevenueModel#TrustDeed/TrustDeed_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Trust deed"@en .

<http://example.com/InlandRevenueModel#TrustMoney>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#MoneyHeld> , <http://example.com/NZ-IRD#Legally-defined-term> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "<p>The following money shall be deemed to be trust money:<br/>(a) money that is deposited with the Crown pending the completion of a transaction or dispute and which may become repayable to the depositor or payable to the Crown or any other person:<br/>(b) all money that is paid into court for possible repayment to the payee or a third party, by virtue of any Act, rule, or authority whatsoever:<br/>(c) all money that is paid to the Crown in trust for any purpose:<br/>(d) money that belongs to or is due to any person and is collected by the Crown pursuant to any agreement between the Crown and that person:<br/>(e) unclaimed money that is due to or belongs to any person and is deposited with the Crown.<br/></p>"@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Public Finance Act 1989"@en ;
        <http://example.com/NZ-IRD#Is-defined-by>
                <http://example.com/InlandRevenueModel#PublicFinanceAct1989> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Corporate Finance content"@en ;
        sem:guid          "c84a151b-c249-45ff-82a1-93c130e1cd3c" ;
        skos:broader      <http://example.com/InlandRevenueModel#MoneyHeldOnBehalf> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TrustMoney/TrustMoney_en> .

<http://example.com/InlandRevenueModel#TrustMoney/TrustMoney_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Trust money"@en .

<http://example.com/InlandRevenueModel#TrustOrCompanyServiceProvider>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#TrustOrCompanyServiceProvider/TCSP_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intelligence Hub content"@en ;
        sem:guid          "49fd03ad-7359-4c80-807a-5e0a4f98caa1" ;
        skos:broader      <http://smartlogic.com/term#188649781203397804479981> ;
        skos:definition   "A Trust or Company Service Provider (TCSP) is a business or individual that offers services to form, manage, and administer legal entities like companies and trusts, including providing registered addresses and acting as nominee shareholders. TCSPs are critical in financial structures, but their work also makes them vulnerable to misuse by criminals for money laundering and terrorist financing, as they can obscure beneficial ownership and facilitate anonymous transactions. As a result, TCSPs are subject to strict Anti-Money Laundering (AML) regulations and must implement robust due diligence and oversight to prevent illicit activities. "@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#FinancialInstitution> , <http://example.com/InlandRevenueModel#Anti-moneyLaunderingWork> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#TrustOrCompanyServiceProvider/TrustOrCompanyServiceProvider_en> .

<http://example.com/InlandRevenueModel#TrustOrCompanyServiceProvider/TCSP_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "TCSP"@en .

