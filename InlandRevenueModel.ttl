<http://example.com/InlandRevenueModel-current-#FamilyProceedingsAct1980>
        rdf:type          <http://smartlogic.com/class#Law> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://example.com/Cleaned-Inland-Revenue-model#CourtOrder> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#IsAdministeredBy>
                <http://smartlogic.com/term#48265265052273404596923> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel-current-#FamilyProceedingsAct1980/FamilyProceedingsAct_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR Knowledgebase; CCS content"@en ;
        sem:guid          "f7ff38e6-c9eb-4063-ad78-bbd3f59df142" ;
        skos:broader      <http://smartlogic.com/term#492768876094676199672439963971808> ;
        skos:definition   "<p>The Family Proceedings Act 1980 is a New Zealand law that sets out how the Family Court deals with adult relationship issues when relationships break down.<br>It provides the legal rules and processes for:&nbsp;separation and divorce,&nbsp;confirming whether a marriage or civil union is valid,&nbsp;declaring a marriage or civil union ended,&nbsp;deciding who a child’s legal parents are (paternity), and&nbsp;requiring counselling or mediation to help people resolve disputes where possible.<br>The Act’s overall aim is to help families resolve relationship disputes fairly, while encouraging reconciliation, counselling, and agreement before matters proceed through the courts.<br></p>"@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#FamilyProceedingsAct1980/FamilyProceedingsAct1980_en> .

<http://example.com/InlandRevenueModel-current-#FamilyProceedingsAct1980/FamilyProceedingsAct1980_en>
