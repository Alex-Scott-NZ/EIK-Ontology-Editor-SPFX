<http://example.com/InlandRevenueModel#LocalInitiative>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ManagingProjects> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><a href=\"https://irnz.sharepoint.com/sites/CORP-strategic-portfolio-stewardship/SitePages/Local-initiatives.aspx\"><u><font color=\"#0066cc\">Local or service level initiatives - how these are managed (sharepoint.com)</font></u></a><br/><br/></p><!--StartFragment--><p style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);\">Glossary of terms from IR's Initiative Management Framework document. May 2022.</p><div style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);\"><p><a href=\"https://irnz.sharepoint.com/sites/CORP-strategic-portfolio-stewardship/SupInfo/Forms/AllItems.aspx?id=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo%2FInitiative%20Management%20Framework%2Epdf&amp;parent=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo\" style=\"background-color: transparent;color: rgb(51, 122, 183);text-decoration: underline;\">Tiakitanga Kohinga Rautaki - Strategic Portfolio Stewardship - Initiative Management Framework.pdf - 1) All Documents (sharepoint.com)</a></p></div><!--EndFragment-->"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>There are two levels of initiatives: Enterprise level (the enterprise portfolio) and Local or service level (e.g. START, Analytics/DIP, web services, or ATEA). A local or service level initiative is determined by Planning, Design and Delivery (PDD) teams. Primary service areas (via their Planning, Design &amp; Delivery teams) are accountable for providing visibility and managing their portfolio of initiatives. This includes prioritisation of demand, dependencies and escalation.<br/><br/>Local initiatives:<br/>• Require commitment from within existing BAU teams (including existing support functions)<br/>• Can be funded from existing budgets<br/>• Are considered lower risk and/or have minimal visible customer touch points<br/>• Can be more operational or tactical in focus.<br/><br/></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#LocalInitiative/ServiceLevelInitiative_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Enterprise Design and Integrity"@en ;
        sem:guid          "f3a57d78-4604-417d-9356-89fd09ed1851" ;
        skos:broader      <http://example.com/IRD-test-model#Programe-or-project> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#LocalInitiative/LocalInitiative_en> .

<http://example.com/InlandRevenueModel#LocalInitiative/LocalInitiative_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Local initiative"@en .

<http://example.com/InlandRevenueModel#LocalInitiative/ServiceLevelInitiative_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Service level initiative"@en .

