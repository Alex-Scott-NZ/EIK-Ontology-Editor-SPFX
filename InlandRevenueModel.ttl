<http://example.com/InlandRevenueModel#TaranakiFloodsFebruary2022>
        rdf:type            <http://smartlogic.com/class#Adverse-event> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel-current-#Taranaki> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-03-17"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Natural_disaster_or_emergency_event_2016-.docx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The flooding in the Taranaki region may cause financial issues for some customers. At this time, the Commissioner has not exercised her 'class of case' discretion for early withdrawals from (or late deposits to) the income equalisation scheme. Customers are however able to apply on a case-by-case for basis for that discretion.<br/>If customers require relief, then normal process apply, including late filing/payment penalty remission, and debt arrangements or write-offs.<br/><br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "START Help. List of adverse events."@en ;
        sem:guid            "bb7a251d-a8f3-46aa-9234-f74f2069442e" ;
        skos:broader        <http://smartlogic.com/term#47138497716934256857234> ;
        skos:editorialNote  "<p>Checked in Viva Topics but it wasn't there.<br/><br/></p>"@en ;
        skos:related        <http://example.com/InlandRevenueModel#AdverseEvent> ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#TaranakiFloodsFebruary2022/FloodingInTheTaranakiRegion_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#TaranakiFloodsFebruary2022/TaranakiFloodsFebruary2022_en> .

