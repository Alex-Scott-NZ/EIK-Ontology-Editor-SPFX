<http://example.com/Cleaned-Inland-Revenue-model#GST-resident>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> , <http://example.com/NZ-IRD#Legally-defined-term> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "<p>A person is a resident for GST purposes if any of the following apply:<br>1. Fixed or permanent place in New Zealand.&nbsp;A person is resident to the extent of any taxable or other activity carried on in New Zealand if they have a fixed or permanent place in New Zealand relating to that activity.<br>2.&nbsp;Unincorporated bodies.&nbsp;An unincorporated body is resident if its centre of administrative management is in New Zealand.<br>3. Individuals — day‑count test.&nbsp;An individual is resident if they are present in New Zealand for more than 183 days in any 12‑month period (with GST‑specific start and end rules).</p><p><br></p><p>4.&nbsp;</p><p>Branches and divisions.&nbsp;A branch or division may be treated as resident to the extent it carries on activities in New Zealand.<br></p>"@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-26"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Goods and Services Tax Act 1985, section 2 — “resident”"@en ;
        <http://example.com/NZ-IRD#Is-defined-by>
                <http://example.com/Cleaned-Inland-Revenue-model#GoodsAndServicesTaxAct1985-S2-1-> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>Business Rules Modelling Analysis<!--EndFragment--><br/><br/><br/></p>"@en ;
        sem:guid          "20b73896-cb57-4a30-a04e-a3ab396a9aaa" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#NewZealandResident> ;
        skos:related      <http://smartlogic.com/term#650811096916297130982251982071421> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#GST-resident/GST-resident_en> .

