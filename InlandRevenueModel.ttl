                <http://example.com/InlandRevenueModel#SpecialInterestGroup> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/IRD-test-model#Child-Support-System-> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Intranet"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Communities of practice look to supplement the formal structure and create new informal networks around a shared interest. They aim to support the business by providing a trusted source of expertise, and facilitate networking and discussion across operational, technical, and legal boundaries, by sharing information and ideas. This is a group dedicated to managing child support payments made by parents who are not living with their children, or who share care of their children. Our teams help paying parents pay the right amount on time, and pass this on to the receiving carer to help with the cost of raising the child."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Intranet; CCS-I content"@en ;
        sem:guid          "b660dc45-4ec7-40a6-a538-f7ea6557fdb2" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#ChildSupportSpecialInterestGroup/ChildSupportSpecialInterestGroup_en> .

