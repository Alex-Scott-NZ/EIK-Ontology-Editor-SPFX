<http://example.com/InlandRevenueModel#CustomerAdvice>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-related-documents>
                <http://example.com/Cleaned-Inland-Revenue-model#SupplementaryIssuesReport> , <http://example.com/InlandRevenueModel#IssuesReport-FinancialArrangementDetermination> , <http://example.com/InlandRevenueModel#IssuesReport-PrivateRuling> , <http://example.com/InlandRevenueModel#IssuesReport-ProductRuling> , <http://example.com/InlandRevenueModel#IssuesReport-Short-processRuling> , <http://example.com/InlandRevenueModel#IssuesReport-TaxpayerRuling> ;
        <http://example.com/Cleaned-Inland-Revenue-model#HasOutcome>
                <http://smartlogic.com/term#132897328262992050070197> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#CustomerAdvice/TohutohuKiritaki_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#MakesUseOfService>
                <http://example.com/InlandRevenueModel#CustomerAssistanceService> , <http://smartlogic.com/term#76870434583501431179403> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span lang=\"mi-NZ\"><font face=\"Calibri\" size=\"3\"><a href=\"https://irnz.sharepoint.com/sites/CORP-tax-counsel-office/SitePages/What-we-do.aspx\">https://irnz.sharepoint.com/sites/CORP-tax-counsel-office/SitePages/What-we-do.aspx</a></font></span></p><p><font face=\"Times New Roman\" size=\"3\"><br/><br/></font></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Tax Counsel Office Binding rulings are our interpretation of how a tax law applies to a particular arrangement, person, item or other matter. TCO issue the following as part of a fee-based service: private rulings, product rulings, status rulings and financial arrangement determinations. Some ruling applications are allocated to the Customer and Compliance Services Group, some are handled jointly by TCO and CCS. This functional stream of work in TCO was previously the work of the Taxpayer Rulings Unit."@en ;
        <http://example.com/NZ-IRD#Is-done-by>
                <http://smartlogic.com/term#85359180133310229255842> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Tax Counsel Office - review of ontology terms August-September 2022."@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://smartlogic.com/term#15260887287545657680416> ;
        sem:guid          "d920d89a-b1f4-4a8f-9b49-0858cfb6c07b" ;
        skos:broader      <http://smartlogic.com/term#47754121509757619729319> ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#TaxpayerRulingsWork> , <http://example.com/InlandRevenueModel#FinancialArrangementDetermination> , <http://example.com/InlandRevenueModel#ShortProcessRuling> , <http://smartlogic.com/term#65142242106862688814301> , <http://smartlogic.com/term#681198969859133347289894436963429> , <http://smartlogic.com/term#72930922055037082275389> , <http://smartlogic.com/term#919057981968049010899569655471324> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CustomerAdvice/CustomerAdvice_en> .

