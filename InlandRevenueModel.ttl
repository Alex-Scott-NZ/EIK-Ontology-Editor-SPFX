<http://example.com/InlandRevenueModel#Statement>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>Google - noun &amp; IKM<br/><!--StartFragment--><a href=\"https://www.google.co.nz/search?q=meaning+of+statement&amp;safe=active&amp;ei=Rr-eYb3fFKySseMP9oWL4AE&amp;ved=0ahUKEwi9mvzQiLL0AhUsSWwGHfbCAhwQ4dUDCA4&amp;oq=meaning+of+statement&amp;gs_lcp=Cgdnd3Mtd2l6EAwyCggAEIAEEEYQ-QEyBQgAEIAEMgUIABCABDIFCAAQgAQyBQgAEIAEMgUIABCABDIFCAAQgAQyBQgAEIAEMgUIABCABDIFCAAQgAQ6BwgAEEcQsAM6BwgAELADEEM6CQgAEEMQRhD5AToECAAQQzoICAAQsQMQgwE6BQgAEJECOgoIABCRAhBGEPkBSgQIQRgAUKoFWPYhYJs1aAFwAngBgAH1AogB4huSAQcwLjUuNC41mAEAoAEByAEKwAEB&amp;sclient=gws-wiz\">meaning of statement - Google Search</a><!--EndFragment--><br/></p>"@en ;
        sem:guid          "c6e4c5c0-600b-4dd2-917f-8e335e65eab6" ;
