                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.2.1_Corporate_Planning_and_Reporting> , <http://example.com/Cleaned-Inland-Revenue-model#GDA6-6.1.2_External_Communications_Received_by_Agency> ;
