<http://example.com/InlandRevenueModel#PublicServiceAct2020>
        rdf:type          <http://smartlogic.com/class#Law> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://example.com/InlandRevenueModel-current-#StateServicesCommission> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#PublicServiceAct2020/PublicServiceAct_en> ;
