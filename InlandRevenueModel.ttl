        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-people-and-workplace-services/Shared%20Documents/Forms/AllItems.aspx?id=%2Fsites%2FCORP%2Dpeople%2Dand%2Dworkplace%2Dservices%2FShared%20Documents%2FAbout%2Dcapability%2Dbased%2Droles%2Epdf&parent=%2Fsites%2FCORP%2Dpeople%2Dand%2Dworkplace%2Dservices%2FShared%20Documents"@en ;
