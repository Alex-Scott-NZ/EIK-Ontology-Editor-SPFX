<http://example.com/Cleaned-Inland-Revenue-model#Logbook>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/Cleaned-Inland-Revenue-model#Logbook/PukapukaHono_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>For a vehicle logbook (term in IR Glossary):</p><div><p>Business customers who use a vehicle for business and private purposes can keep a logbook to establish the proportion of business use. The logbook is generally kept for a 90 day test period every three years. The proportion may be used for these purposes: To apportion vehicle running costs and depreciation for income tax; To determine whether a vehicle is used principally in the making of taxable supplies for GST; To calculate private use adjustments for GST. In some cases, to determine the number of days each quarter the vehicle is available for private use and enjoyment for FBT purposes. For further information refer to Vehicle expenses.<br/></p></div>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "3e75fae5-ca85-4416-be2c-f9fba907c01b" ;
        skos:broader      <http://example.com/InlandRevenueModel#OperationalServicesInformation> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#Logbook/Logbook_en> .

