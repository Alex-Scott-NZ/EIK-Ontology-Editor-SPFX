<http://example.com/InlandRevenueModel#E-File>
        rdf:type          <http://example.com/IRD-test-model#System> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-system-type>
                <http://example.com/InlandRevenueModel#ElectronicFilingSystem> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#ElectronicFilingManagement> ;
        <http://example.com/InlandRevenueModel#IsSystemUsedBy>
                <http://smartlogic.com/term#197328649962691294233513> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2021-04-16"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "E-File was a system that allowed tax agents to transmit data from their PC system, directly into FIRST on Inland Revenue's mainframe computer. Returns that could be E-Filed were IR3, IR3NR, IR4, IR526, IR6, IR7, IR8, IR9 (and all attachments), GST returns, personal tax summaries and the IR215. Groups of returns were E-Filed in uniquely numbered sessions. As well as filing returns, E-File was used for correspondence and these TAMS (Tax Agent Management System) requests: Agent Configuration, Link and Delink Clients, Update client listing, EOT Statistics Request, Client Listing, Lodgement Status Request, Update Client Information, Stationery Request."@en ;
        <http://example.com/NZ-IRD#Is-used-in-function>
                <http://example.com/InlandRevenueModel#ElectronicFilingManagement> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "BT content; CCS-B content"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-8.1.1_Purchase_Development_&_Operational__Management_of_Systems_used_to_Manage_&/or_hold_Records> ;
        sem:guid          "dafd0e10-bae1-412a-8731-dec419d4c2de" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#Public-facingSystem> ;
        skos:definition   "E-File service allows tax agents to send information such as bulk tax returns, personal tax summary requests, correspondence and administration direct to IR using software developer's practice management software."@en ;
        skos:historyNote  "​E-file was decommissioned on 16 April 2021."@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#E-File/E-FileSoftware_en> , <http://example.com/InlandRevenueModel#E-File/Efile_en> , <http://example.com/InlandRevenueModel#E-File/IRDElectronicFiling_en> , <http://example.com/InlandRevenueModel#E-File/TaxAgentFilingService_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#E-File/E-File_en> .

<http://example.com/InlandRevenueModel#E-File/E-FileSoftware_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "E-File software"@en .

