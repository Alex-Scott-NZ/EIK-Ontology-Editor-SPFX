<http://example.com/Cleaned-Inland-Revenue-model#ViennaConventionOnTheLawOfTreaties1969>
        rdf:type          <http://smartlogic.com/class#Agreement> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Abbreviation>
                <http://example.com/Cleaned-Inland-Revenue-model#ViennaConventionOnTheLawOfTreaties1969/ViennaConvention_en> ;
