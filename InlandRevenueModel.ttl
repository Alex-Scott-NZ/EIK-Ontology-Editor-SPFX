<http://example.com/Cleaned-Inland-Revenue-model#NewZealandFireServiceCommission>
        rdf:type          <http://smartlogic.com/class#Commercial-organisation> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-party-classification>
                <http://smartlogic.com/term#80400946175753219181710> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/Cleaned-Inland-Revenue-model#NewZealandFireServiceCommission/WhakaratongaIwi_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/Cleaned-Inland-Revenue-model#NewZealandFireServiceCommission/NZFC_en> ;
