<http://example.com/InlandRevenueModel#p-Rule>
        rdf:type          <http://example.com/InlandRevenueModel#Measurement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Treasury website"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "PAS content"@en ;
        sem:guid          "979b06d4-9b2d-4e2d-8681-c90775f57896" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Measurement> ;
        skos:definition   "The p% rule states that a cell, contained in a table of magnitudes, is sensitive if the value for any contributor can be calculated to within a given percentage. Cells that are identified as sensitive must be suppressed or otherwise avoided (through table design). The p% rule calculates the distance (as a percentage) between the estimated value and the true value for the largest contributor in a table, as follows: X is the value for the largest contributor, X{est} is the estimate of X, Y is the value for the second largest contributor. {X(est) –X}/X * 100%  = p."@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#p-Rule/pPercentRule_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#p-Rule/p-Rule_en> .

<http://example.com/InlandRevenueModel#p-Rule/p-Rule_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "p% rule"@en .

<http://example.com/InlandRevenueModel#p-Rule/pPercentRule_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "p percent rule"@en .

