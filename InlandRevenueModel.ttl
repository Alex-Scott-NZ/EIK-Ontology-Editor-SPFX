        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "https://www.digital.govt.nz/standards-and-guidance/privacy-security-and-risk/privacy/data-protection-and-use-policy-dpup/read-the-dpup-principles/"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
