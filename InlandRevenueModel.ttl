        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#CodeLetters> ;
        skos:definition   "At Inland Revenue, CAE is a PAYE tax code used for: Casual Agricultural Employees. It applies to people doing short-term, seasonal agricultural work (e.g. orchard work, shearing, horticulture, nurseries). Typically, day‑to‑day employment for up to 3 months. It uses a flat PAYE deduction rate (including ACC earner levy) rather than the standard progressive PAYE calculation."@en ;
        skos:related      <http://example.com/InlandRevenueModel#CasualAgriculturalAmployee> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#CAE/CAE_en> .

