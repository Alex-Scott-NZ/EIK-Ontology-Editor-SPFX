        sem:guid          "b857f609-349d-47af-97d7-67fd0a52e323" ;
        skos:broader      <http://example.com/IRD-test-model#New-Zealand-Police> ;
        skos:definition   "The National Intelligence Centre (NIC) provides intelligence leadership and support to all of Police, and ensures national consistency in the processes, products and staffing of intelligence. It is made up of five workgroups: Intelligence Collections, Open Source Intelligence (OSINT) Team, Analytics & Intelligence Operations, High Risk Targeting Team, Security Intelligence and Threats (STIG). It also hosts two functions: Gang Harm Insights Centre (GHIC), National Drug Intelligence Bureau (NDIB)."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#NationalIntelligenceCentre/NationalIntelligenceCentre_en> .

