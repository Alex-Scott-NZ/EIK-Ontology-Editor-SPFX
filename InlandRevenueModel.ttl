<http://example.com/InlandRevenueModel-current-#AccountantsAndTaxAgentsInstituteOfNewZealand>
        rdf:type          <http://smartlogic.com/class#Commercial-organisation> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-party-classification>
                <http://example.com/NZ-IRD#Professional-association> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsPartyObjectOf>
                <http://example.com/InlandRevenueModel-current-#ExternalRelationshipManagement> , <http://example.com/InlandRevenueModel-current-#TaxAgentManagement> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel-current-#AccountantsAndTaxAgentsInstituteOfNewZealand/ATAINZ_en> ;
        <http://example.com/InlandRevenueModel#HasMember>
                <http://example.com/Cleaned-Inland-Revenue-model#CharteredAccountant> , <http://smartlogic.com/term#197328649962691294233513> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Accountants and Tax Agents Institute of New Zealand (ATAINZ) are a professional body who have approved advisory group status (from IR) which can assure clients of tax agents, that their agent meets the requirements to be an ‘approved advisor’. ATAINZ exists to promote the welfare and professional development of its members (approx. 400) and to represent members’ interest within New Zealand. IR hold a good working relationship with ATAINZ who have the opportunity to be involved in customer testing, workshops etc to assist in co-design. Community Compliance have links into their regional co-ordinators so that ATAINZ have the opportunity for IR to attend their regional meetings that run frequently around the country."@en ;
        <http://example.com/InlandRevenueModel-current-#HasRelatedRole>
                <http://example.com/InlandRevenueModel#ApprovedAdvisorGroup> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel-current-#AccountantsAndTaxAgentsInstituteOfNewZealand/Accountants-TaxAgentsInstituteOfNewZealand_en> , <http://example.com/InlandRevenueModel-current-#AccountantsAndTaxAgentsInstituteOfNewZealand/Accountants-TaxAgentsInstituteOfNewZealand_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Enterprise Architecture content; IR website; PAS content; External relationships content"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel-current-#AccountantsAndTaxAgentsInstituteOfNewZealand/TINZ_en> ;
        sem:guid          "d376af56-21ac-4d0e-9202-265cb123d221" ;
        skos:broader      <http://smartlogic.com/term#188519164724691362719453> ;
        skos:historyNote  "<p>Accountants and Tax Agents Institute Of New Zealand Incorporated&nbsp;<span style=\"color: rgb(106, 108, 111);font-size: 14px\">was started on 26 Aug 1976.&nbsp;ATAINZ used other aliases, namely: T<strong>axagents' Institute Of New Zealand Incorporated&nbsp;</strong>from 17 Nov 2005 to 23 Nov 2012,&nbsp;<strong>Taxation Institute Of New Zealand Inc&nbsp;</strong>(26 Aug 1976 to 17 Nov 2005). The Businesscheck data was updated on 16 May 2025.</span>​<br></p>"@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel-current-#AccountantsAndTaxAgentsInstituteOfNewZealand/Taxagents-InstituteOfNewZealandInc._en> , <http://example.com/InlandRevenueModel-current-#AccountantsAndTaxAgentsInstituteOfNewZealand/TaxationInstituteOfNewZealandInc._en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#AccountantsAndTaxAgentsInstituteOfNewZealand/AccountantsAndTaxAgentsInstituteOfNewZealand_en> .

<http://example.com/InlandRevenueModel-current-#AccountantsAndTaxAgentsInstituteOfNewZealand/ATAINZ_en>
