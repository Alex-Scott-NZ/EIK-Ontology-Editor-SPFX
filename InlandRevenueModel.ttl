        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Tax Technical website"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Child Support Amendment Act 2013 introduces significant reforms to the child support scheme that will come into effect over the next two years. The intention is to make the child support scheme fairer, taking more factors into account and being more flexible. The changes will take into account a wider range of individual circumstances and reflect changes in family structure and involvement in child upbringing since the child support scheme was first introduced."@en ;
        <http://example.com/InlandRevenueModel-current-#IsAdministeredBy>
                <http://smartlogic.com/term#733873855465831453299914748155375> ;
        <http://example.com/NZ-IRD#Amends-legislation>
                <http://smartlogic.com/term#474166795587487981954316542391767> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#ChildSupportAmendmentAct2013/ChildSupportAmendmentAct_en> ;
