<http://example.com/InlandRevenueModel#ReviewForSufficiencyOfEvidence>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Isused-in-function>
                <http://example.com/Cleaned-Inland-Revenue-model#Investigation> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#ReviewForSufficiencyOfEvidence/SoE_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#ReviewForSufficiencyOfEvidence/State-ownedEnterprise_en> , <http://example.com/InlandRevenueModel#ReviewForSufficiencyOfEvidence/SummaryOfEarnings_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS Investigations content"@en ;
        sem:guid          "4274feff-9473-48e3-b7ac-7d645c70e654" ;
        skos:broader      <http://example.com/InlandRevenueModel#LegalInformation> ;
        skos:definition   "In New Zealand law, a \"review for sufficiency of evidence\" assesses whether the evidence presented in a case adequately supports a particular finding, such as guilt. It requires the court to determine if there is enough admissible evidence to prove the key facts of the matter, such as a charge or claim, to the necessary legal standard. This review focuses on the quantity and quality of the evidence and whether it establishes the authenticity or relevance of the facts in question to a sufficient degree. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ReviewForSufficiencyOfEvidence/ReviewForSufficiencyOfEvidence_en> .

