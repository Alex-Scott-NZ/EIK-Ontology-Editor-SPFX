                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#CustomerSegmentation> , <http://example.com/InlandRevenueModel#MicroBusinessCustomerSegment> , <http://example.com/InlandRevenueModel#MicroBusinessLeaderForum> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-06-23"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
