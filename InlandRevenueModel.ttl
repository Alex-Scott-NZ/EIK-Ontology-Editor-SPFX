        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "IR's Integrity Champion"@en .

<http://example.com/InlandRevenueModel#IntegrityChampion/IntegrityChampion_en>
        rdf:type               skosxl:Label ;
