        sem:guid          "01689bc4-4658-4661-83b4-6486bbc67ef1" ;
        skos:broader      <http://example.com/InlandRevenueModel#OfficialCorrespondence> ;
        skos:definition   "The Official Information Act 1982 (OIA) is a New Zealand law enabling public access to official information held by central government agencies and Ministers, operating under the principle that information should be released unless there's a good reason to withhold it. Requests should be directed to the correct agency and can include various types of information, such as reports, advice, and emails. Agencies are obligated to provide information without undue delay unless grounds for withholding, such as privacy, exist, and individuals can complain to the Ombudsman if unsatisfied with a response."@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel-current-#OfficialInformationRequest/OIAAcknowledgementLetter_en> , <http://example.com/InlandRevenueModel-current-#OfficialInformationRequest/OIARequest_en> , <http://example.com/InlandRevenueModel-current-#OfficialInformationRequest/OfficialInformationActRequest_en> , <http://example.com/InlandRevenueModel-current-#OfficialInformationRequest/OfficialInformationActRequest_en0> , <http://example.com/InlandRevenueModel-current-#OfficialInformationRequest/RequestForOfficialInformation_en> , <http://example.com/InlandRevenueModel-current-#OfficialInformationRequest/RequestMadeUnderrTheOfficialInformationAct_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#OfficialInformationRequest/OfficialInformationRequest_en> .

