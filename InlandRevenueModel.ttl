<http://example.com/InlandRevenueModel#Probate>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#JudicialAuthority0> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://example.com/InlandRevenueModel#EstateAdministration> , <http://example.com/InlandRevenueModel#ProbateAdministration> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
