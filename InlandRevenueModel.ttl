<http://example.com/InlandRevenueModel#IntegratedOperationalPlanning>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-participant>
                <http://example.com/InlandRevenueModel#CustomerAndComplianceServices> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#VerintWFM> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/CORP-integrated-planning-voice-and-more/SitePages/Integrated-Operational-Planning-(IOP).aspx\">Integrated Operational Planning (IOP)</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IR Glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Integrated Operational Planning (IOP) is an initiative. It will introduce an integrated planning solution that encompasses both voice and non-voice work and will enable us to align planning processes, technology, and data. The aim is to have voice and relevant non-voice work, and frontline CCS people profiled in one system to enable more accurate forecasting, scheduling of (relevant) people, and allocation of time. To do this, Verint WFM will be introduced and training supplied for using it."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "https://irnz.sharepoint.com/sites/CORP-integrated-planning-voice-and-more/SitePages/Integrated-Operational-Planning-(IOP).aspx"@en ;
        sem:guid          "495e98e1-3e8e-4ac1-90ff-061ab5e096f4" ;
        skos:broader      <http://example.com/InlandRevenueModel#PouHereTangata> ;
        skos:definition   "​IOP is defined as operational level CCS planning as well as tactical level planning for CCS - up to 12 months out."@en ;
        skos:historyNote  "Started at the end of 2023. Go-live in August 2025. Will wrap up in 2026."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#IntegratedOperationalPlanning/IntegratedOperationalPlanning_en> .

<http://example.com/InlandRevenueModel#IntegratedOperationalPlanning/IntegratedOperationalPlanning_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Integrated Operational Planning"@en .

