        sem:guid          "dfa3ee54-3f7f-4f51-951c-6d99c2057fe2" ;
        skos:broader      <http://example.com/IRD-test-model#Job-title> ;
        skos:definition   "The New Zealand Government Chief Privacy Officer (GCPO) leads an all-of-government approach to privacy, focusing on improving public service privacy maturity and capability. The GCPO provides leadership, assurance, and advice on privacy issues, supports agencies in meeting their privacy responsibilities, and coordinates engagement with the Privacy Commissioner. The GCPO also supports the Government Chief Information Officer (GCIO) in setting standards and ensuring privacy is appropriately managed. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel-current-#GovernmentChiefPrivacyOfficer/GovernmentChiefPrivacyOfficer_en> .

