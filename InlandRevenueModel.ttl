        skos:broader      <http://example.com/InlandRevenueModel#CourtFilingRecord> ;
        skos:definition   "In New Zealand District Court proceedings, after a party files a pleading, they must serve a \"list of documents relied on\" on the other parties, which includes all documents mentioned in their pleading, any principal documents used to prepare it, and any documents they intend to use at the trial. This list ensures fairness and transparency, preventing a party from surprising their opponent with undisclosed documents. "@en ;
        skos:related      <http://example.com/InlandRevenueModel#Pleading> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#ListOfDocumentsReliedOn/ListOfDocuments_en> ;
