<http://example.com/InlandRevenueModel#HealthAndSafetyReportingSystem>
        rdf:type          <http://example.com/IRD-test-model#System> ;
        rdfs:comment      "<p>History note sourced from&nbsp;<a href=\"https://irnz.sharepoint.com/sites/News/SitePages/Our-new-HS%26W-tool%2C-Te-Aka-Oranga%2C-is-now-live.aspx?web=1\">Our new HS&amp;W tool, Te Aka Oranga, is now live</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#HealthAndSafetyReportingSystem/H-SOnlineReportingTool_en> , <http://example.com/InlandRevenueModel#HealthAndSafetyReportingSystem/Health-Safety-H-S-OnlineReportingTool_en> , <http://example.com/InlandRevenueModel#HealthAndSafetyReportingSystem/Health-SafetyOnlineReporting_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "C&O content; P & C intranet content"@en ;
        sem:guid          "19cc099e-03ca-4a08-9db7-83f72ddbbb18" ;
        skos:broader      <http://smartlogic.com/term#47372529931203401780288> ;
        skos:definition   "Looking after our health, safety and wellbeing is important to working safely at Te Tari Taake. Each of us has a responsibility to take reasonable care of our own health and safety, and to take care that others are not harmed by our actions or inactions. Part of that responsibility is reporting an accident, injury or near miss. That is done through the Health & Safety Reporting System."@en ;
        skos:historyNote  "Implemented in 2008. Was replaced by Te Aka Oranga in 2022."@en ;
        skos:related      <http://example.com/InlandRevenueModel#HealthAndSafetyReport> , <http://example.com/InlandRevenueModel#HealthAndWellbeingManagement> , <http://example.com/InlandRevenueModel-current-#Health-SafetyRepresentative> ;
