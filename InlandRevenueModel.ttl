        skos:broader      <http://example.com/InlandRevenueModel#QualityAssurance> ;
        skos:definition   "<p></p><p style=\"margin-left:72.0pt\"><span style=\"color:red\" \"=\"\">Continuous auditing is an automatic method used to perform auditing activities, such as control assessments, on a frequent basis.</span><span style=\"color:#37424A\"> </span><span style=\"color:red\" \"=\"\">Technology plays a key role by automating the identification of exceptions or anomalies, analyse patterns within key fields, review trends and test controls. Processes for the management of funds, especially through accounts payable, accounts receivable, corporate credit card transactions and expense claim processes are known targets for internal fraud.</span></p><p> </p>"@en ;
        skos:historyNote  "Name change from Continuous data assurance to Continuous auditing confirmed by Domain Principal for Internal Assurance 01-06-2023."@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#ContinuousDataAssurance/ContinuousAssurance_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ContinuousDataAssurance/ContinuousDataAssurance_en> .

