                <http://smartlogic.com/term#110481616277029930443037> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p><span style=\"float: none;background-color: transparent;color: rgb(0, 0, 0);text-align: left;\">http://intranet.ird.govt.nz/hidden-economy-programme/</span> <!--EndFragment--><br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Hidden Economy Programme is a ten-year strategy to help improve Inland Revenue’s ability to detect and address those operating in the hidden economy, and to develop and implement innovative approaches. It commenced after IR received bilateral funding from Budget 2010 and additional funding from Budget 2015.The Programme is overseen by a Technical Working Group."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/NZ-IRD#Hidden-Economy-Programme/KaupapaAoOhangaHuna_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><span style=\"color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);float: none;\">CCS C&amp;O content; </span>Intranet</p>"@en ;
        sem:guid          "84610a33-87e7-4152-b46a-d38666137661" ;
        skos:broader      <http://example.com/IRD-test-model#Programe-or-project> ;
        skosxl:prefLabel  <http://example.com/NZ-IRD#Hidden-Economy-Programme/Hidden-Economy-Programme_en> .

