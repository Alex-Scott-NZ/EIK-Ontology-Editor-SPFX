                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#Norway> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-15"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "ISO 3166"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/Cleaned-Inland-Revenue-model#BouvetIsland/BVT_en> , <http://example.com/Cleaned-Inland-Revenue-model#BouvetIsland/BV_en> ;
        sem:guid          "b8db1ffd-5d2b-4356-9453-a4d1835b5a99" ;
        skos:broader      <http://smartlogic.com/term#130710328707508168484707> ;
        skos:definition   "Bouvet Island (Norwegian: Bouvetøya) is an uninhabited subantarctic volcanic island and dependency of Norway. A protected nature reserve situated in the South Atlantic Ocean at the southern end of the Mid-Atlantic Ridge, it is the world's most remote island. Located north of the Antarctic Circle, the island lies 1,700 km (1,100 mi; 920 nmi) north of the Princess Astrid Coast of Queen Maud Land, Antarctica, 1,870 km (1,160 mi; 1,010 nmi) east of the South Sandwich Islands, 1,845 km (1,146 mi; 996 nmi) south of Gough Island, and 2,520 km (1,570 mi; 1,360 nmi) south-southwest of the coast of South Africa."@en ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#BouvetIsland/Bouvetoya_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#BouvetIsland/BouvetIsland_en> .

