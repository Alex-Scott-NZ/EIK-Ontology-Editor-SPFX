<http://example.com/Cleaned-Inland-Revenue-model#Unconditional-gift>
        rdf:type          <http://example.com/NZ-IRD#Legally-defined-term> , <http://smartlogic.com/class#Income> , <http://smartlogic.com/class#Payment> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "A payment voluntarily made to any non-profit body for the carrying on or carrying out of the purposes of that non-profit body and in respect of which no identifiable direct valuable benefit arises or may arise in the form of a supply of goods and services to the person making that payment, or any other person where that person and that other person are associated persons; but does not include any payment made by the Crown or a public authority"@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerActionsAndInteractions> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Kuputaka (IR START Glossary)"@en ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Goods and Services Tax Act 1985"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>​A donation or payment made that meets all of these conditions: It is made voluntarily to any non-profit body. It is for the non-profit body to use. There is no identifiable direct valuable benefit to the giver, or the family of the giver.<br/>Some unconditional gifts are: Donations; Contributions to door-to-door appeals and street collections; Bequests; Voluntary school fees (but not school activity fees); Subscriptions, income from trading activities, and payments made by the Crown or a public authority are not unconditional gifts for GST purposes.</p>"@en ;
        <http://example.com/NZ-IRD#Is-defined-by>
                <http://smartlogic.com/term#769477633007581059603718679399876> ;
        <http://example.com/NZ-IRD#Is-financial-object-of>
                <http://example.com/InlandRevenueModel#MakingADonation> ;
        <http://example.com/NZ-IRD#Is-income-of>
                <http://example.com/IRD-test-model#Non-profit-organisation> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website glossary"@en ;
        sem:guid          "bc971970-258b-41b1-86af-e0d5589ac83b" ;
        skos:broader      <http://smartlogic.com/term#88134021828634349643377> ;
        skos:definition   "<p>A donation or payment made voluntarily to any non-profit body, for the non-profit body to use, and when there is no identifiable direct valuable benefit to the giver or the family of the giver.<br/>A payment you make to a non-profit: voluntarily for the carrying on or carrying out of the non-profit's purposes; without an 'identifiable direct valuable benefit' in the form of a supply of goods and services to the payer or an associated person.<br/></p>"@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#Koha> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#Unconditional-gift/Unconditional-gift_en> .

