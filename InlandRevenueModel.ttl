<http://example.com/InlandRevenueModel#EnterpriseArchitectureTechnicalCommittee>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#EnterpriseArchitectureTechnicalCommittee/EATC_en> ;
        <http://example.com/IRD-test-model#Is-managed-by>
                <http://example.com/InlandRevenueModel#ArchitectureTeam> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel-current-#EnterpriseArchitecture> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "EATC Terms of Reference 2015"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The EATC is part of the Enterprise Architecture (EA) internal sign off process and is a final EA quality assurance stage gate regarding the release of EA work for consumption. The key purpose of the EATC is to ensure consistent enterprise architecture viewpoints are voiced and positioned. This includes: approving the release of EA artefacts to stakeholders, providing a forum for discussion and decision making, sharing information on EA work, advising the Chief Enterprise Architect, and escalations to the Technical Architecture Design Council."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Portfolio Office content; Intranet; IT&C content"@en ;
        sem:guid          "4ce4836b-4c31-4098-b672-8af1fcee434d" ;
        skos:broader      <http://example.com/InlandRevenueModel#_PreviousBoards-CommitteesOrGroups-> ;
        skos:historyNote  "From 2022 this was incorporated into the Technical Governance Committee."@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#EnterpriseArchitectureTechnicalCommittee/EATechnicalCommittee_en> , <http://example.com/InlandRevenueModel#EnterpriseArchitectureTechnicalCommittee/EnterpriseArchitectureTechnicalCommittee_en0> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EnterpriseArchitectureTechnicalCommittee/EnterpriseArchitectureTechnicalCommittee_en> .

