        sem:guid          "b9dc8878-6aa8-42bc-8921-487fbc01159b" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Share> ;
        skos:definition   "Mandatory redeemable preference shares are equity instruments that, unlike traditional shares, are required by their terms to be redeemed by the company for cash or other assets at a specific time or upon the occurrence of a particular event. These shares blur the lines between debt and equity because they have a contractual obligation to be repaid, meaning they are often classified as a liability on a company's balance sheet rather than equity, unless the redemption is only possible upon liquidation. "@en ;
        skos:related      <http://example.com/InlandRevenueModel#FinancialAsset> , <http://smartlogic.com/term#77793849175289009165474> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MandatoryRedeemablePreferenceShares/MandatoryRedeemablePreferenceShares_en> .

