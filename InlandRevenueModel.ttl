<http://example.com/InlandRevenueModel#CanterburyFloodsJuly2022>
        rdf:type            <http://smartlogic.com/class#Adverse-event> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#AdverseEvent> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#Wairoa> , <http://example.com/InlandRevenueModel-current-#Canterbury> , <http://example.com/InlandRevenueModel-current-#GisborneRegion> , <http://example.com/InlandRevenueModel-current-#Otago> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-03-17"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Natural_disaster_or_emergency_event_2016-.docx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The flooding and disruption caused by the adverse weather throughout July 2022 (11 July to 31 July) in the Northland, Canterbury and Otago regions and Gisborne and Wairoa districts is causing financial issues for many farmers and growers and is likely to affect their income for the 2023 income year. The late deposit provision for 2022 has been approved, with an extension for all customers until 31 May 2023.<br/>Applications for early refunds from the income equalisation scheme will be allowed.<br/>Cabinet has also declared the adverse weather as an emergency event for the purposes of section 183ABA of the TAA which allows Inland Revenue to remit interest payable on late payments following the emergency event.<br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "START Help. List of adverse events."@en ;
        sem:guid            "1e94d2cd-1fd2-4e99-8e32-61e7624ce1d5" ;
        skos:broader        <http://smartlogic.com/term#47138497716934256857234> ;
        skos:editorialNote  "Checked in Viva Topics but it wasn't there."@en ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#CanterburyFloodsJuly2022/FloodingInNorthland-CanterburyAndOtagoRegionsAndGisborneAndWairoaDistricts_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#CanterburyFloodsJuly2022/CanterburyFloodsJuly2022_en> .

<http://example.com/InlandRevenueModel#CanterburyFloodsJuly2022/CanterburyFloodsJuly2022_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Canterbury floods July 2022"@en .

<http://example.com/InlandRevenueModel#CanterburyFloodsJuly2022/FloodingInNorthland-CanterburyAndOtagoRegionsAndGisborneAndWairoaDistricts_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Flooding in Northland, Canterbury and Otago regions and Gisborne and Wairoa districts"@en .

<http://example.com/InlandRevenueModel#CanterburyFloodsMay2021>
        rdf:type            <http://smartlogic.com/class#Adverse-event> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#AdverseEvent> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel-current-#Canterbury> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-03-17"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Natural_disaster_or_emergency_event_2016-.docx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The flooding in Canterbury is causing financial issues for many farmers and growers and is likely to affect their income for the 2021 and 2022 years.<br/>Applications for early refunds from the income equalisation scheme will be allowed. <br/>Customers can request relief from penalties if they have missed filing returns or making payments and may consider re-estimating their provisional tax.<br/><br/></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "START Help. List of adverse events."@en ;
        sem:guid            "231d2bca-6845-4fff-9f71-43192574ba47" ;
        skos:broader        <http://smartlogic.com/term#47138497716934256857234> ;
        skos:editorialNote  "Checked in Viva Topics but it wasn't there."@en ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#CanterburyFloodsMay2021/FloodingInCanterburyMay2021_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#CanterburyFloodsMay2021/CanterburyFloodsMay2021_en> .

