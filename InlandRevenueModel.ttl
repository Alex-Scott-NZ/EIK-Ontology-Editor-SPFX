<http://example.com/InlandRevenueModel-current-#ChildSupportSpecialInterestGroup>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel-current-#ChildSupportSpecialInterestGroup/CSSIG_en> ;
