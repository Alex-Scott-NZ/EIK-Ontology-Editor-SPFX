        sem:guid          "8545d2d6-571c-4860-850f-10b5aa62f385" ;
        skos:broader      <http://example.com/InlandRevenueModel#Government-mandatedBenefit> ;
        skos:definition   "A payment made to certain parents to support them and their children, usually in specific circumstances such as the parent receiving a surviving spouse’s pension. This allowance is not a general parenting payment — it applies in limited situations (for example, where a parent’s partner has died while serving overseas)."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Parent-sAllowance0/Parent-sAllowance_en> .

