<http://example.com/InlandRevenueModel#Secrecy>
        rdf:type          <http://smartlogic.com/class#IR-core-function> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-related-documents>
                <http://example.com/InlandRevenueModel#DeclarationOfFidelityAndSecrecy> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#ConfidentialityAndSecrecy> , <http://smartlogic.com/term#11769840510976632981956266406159> ;
        <http://example.com/InlandRevenueModel#HasRelatedActivity>
                <http://smartlogic.com/term#137744752454863129712908> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel-current-#CertificateOfSecrecy> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#Activity-AssistingCompliance> , <http://example.com/InlandRevenueModel#ProductAdministration> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://taxpolicy.ird.govt.nz/"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel#usedInME3ValueSet>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Inland Revenue officers must maintain secrecy on all matters relating to the Inland Revenue Acts, and must not communicate any matter other than for the purpose of carrying into effect that legislation.  The tax secrecy rule is supported by taxpayer confidentiality and forms a key role in maintaining the integrity of the tax system. The coverage of the tax secrecy rule is not limited to taxpayer-specific information, rather it covers all information relating to the legislation administered by Inland Revenue."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#Secrecy/SecrecyObligations_en> , <http://example.com/InlandRevenueModel#Secrecy/Section81_en> , <http://example.com/InlandRevenueModel#Secrecy/consideredTaxSecretUnderSection81_en> , <http://example.com/InlandRevenueModel#Secrecy/obligationToMaintainTheSecrecy_en> , <http://example.com/InlandRevenueModel#Secrecy/obligationsUnderSection81_en> , <http://example.com/InlandRevenueModel#Secrecy/s81_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "LMU content; CI&A content"@en ;
        <http://smartlogic.com/relationship#Has-retention-class_15_Function_40_RDS_18>
                <http://example.com/Cleaned-Inland-Revenue-model#GDA6-1.1.1_Strategic_Corporate_Policy_and_Procedures> ;
        sem:guid          "d50bea3a-e7d7-4f66-b162-458c72ed56c7" ;
