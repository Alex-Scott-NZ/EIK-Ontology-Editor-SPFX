<http://example.com/InlandRevenueModel#DecisionMakingIsDevolvedToAsCloseToThe-customer-AsPossible>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR's Decision Making Model, Dec 2018"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "People working with customers are enabled and empowered to support customers to get it right from the start. Leaders and other technical specialists support people by providing coaching, technical expertise and advice, without taking decision making away from them. Very few decisions are 'reserved' to particular roles or tiers."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><br/>http://intranet.ird.govt.nz//infoweb/sites/default/files/20200928-Recap%20-%20some%20key%20design%20features.JPG<br/></p>"@en ;
        sem:guid          "56e2d101-f268-4576-967d-377ab63461b4" ;
        skos:broader      <http://example.com/InlandRevenueModel#FOMPrinciple2020> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#DecisionMakingIsDevolvedToAsCloseToThe-customer-AsPossible/DecisionMakingIsDevolvedToAsCloseToThe-customer-AsPossible_en> .

