        sem:guid          "33bfce52-eb24-4e5f-a1bc-74c2c89d9848" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRFinancialInformation> ;
        skos:definition   "In New Zealand's public finance system, \"receipts on behalf of the Crown\" refer to revenue that a government department or agency earns from providing services or goods to the public or other entities, but this revenue is then recorded and handled as if it were directly received by the Crown itself, rather than by the department's own revenue stream. These receipts, often from specific funds or activities that benefit community services or legal aid, are categorized separately from departmental revenue to reflect that the ultimate financial benefit and control rests with the wider government entity, or the Crown."@en ;
        skos:related      <http://example.com/InlandRevenueModel#FinancialReport> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ReceiptsOnBehalfOfTheCrown/ReceiptsOnBehalfOfTheCrown_en> .

