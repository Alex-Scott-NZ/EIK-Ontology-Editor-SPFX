<http://example.com/Cleaned-Inland-Revenue-model#ResidualIncomeTax>
        rdf:type          <http://smartlogic.com/class#Obligation> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/Cleaned-Inland-Revenue-model#ResidualIncomeTax/RIT_en> ;
