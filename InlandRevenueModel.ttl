<http://example.com/InlandRevenueModel#PulseSurvey>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInformationRelatedTo>
                <http://smartlogic.com/term#144339026141687964061284> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Intranet"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p> </p><p style=\"margin-right:0cm;margin-left:18.0pt\"><span style=\"font-size: 13.5pt;color:#242424\">The People Experience Pulse (PX Pulse) is a survey that provides a quick check in on the heartbeat of the organisation.&nbsp; We do it regularly to understand people’s thoughts on Wellbeing, Work Experience, Inclusion, Development, Advocacy and Value.</span></p><p> </p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#PulseSurvey/PulseSurvey_en1> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Performance & Optimisation content"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#PulseSurvey/PulseSurvey_en0> ;
        sem:guid          "349667dd-0aba-4a08-8a14-8ece7643b058" ;
        skos:broader      <http://example.com/InlandRevenueModel#StaffSurvey> ;
        skos:historyNote  "Confirmed with Analyst from People and Workplace Analytics that this concept is now referred to as People Experience Pulse. November 2023."@en ;
