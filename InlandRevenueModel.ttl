<http://example.com/InlandRevenueModel#SharingEconomy>
        rdf:type          <http://smartlogic.com/class#Topic> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#SharingEconomy/TeOhangaTiritiri_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://smartlogic.com/term#97783351948796139392048> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://www.ird.govt.nz/sharing-economy"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Investopedia"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The sharing economy is any economic activity through a digital platform (such as a website or an app), where people share assets or services for a fee."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#SharingEconomy/TeOhangaTiritiri_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Data Science & Analytics content; PAS content"@en ;
        sem:guid          "b534b457-dad9-495c-85f2-4f5da6ecb001" ;
        skos:broader      <http://smartlogic.com/term#182365628939588612203668> ;
        skos:definition   "Sharing economies allow individuals and groups to make money from underused assets. In a sharing economy, idle assets such as parked cars and spare bedrooms can be rented out when not in use. In this way, physical assets are shared as services."@en ;
        skos:related      <http://example.com/InlandRevenueModel#DigitalPlatformInformationReporting> , <http://example.com/InlandRevenueModel#GigEconomy> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#SharingEconomy/CollaborativeEconomy_en> , <http://example.com/InlandRevenueModel#SharingEconomy/TheSharingEconomy_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SharingEconomy/SharingEconomy_en> .

<http://example.com/InlandRevenueModel#SharingEconomy/CollaborativeEconomy_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Collaborative economy"@en .

<http://example.com/InlandRevenueModel#SharingEconomy/SharingEconomy_en>
        rdf:type               skosxl:Label ;
