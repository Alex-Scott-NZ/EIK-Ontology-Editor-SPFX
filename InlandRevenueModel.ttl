<http://example.com/InlandRevenueModel#STARTAnalytics>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#STARTAnalytics/RautakiTautukungaMeTeAuahatanga_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Corporate Space page<br/><!--StartFragment--><a href=\"https://irnz.sharepoint.com/sites/CORP-compliance-strategy-and-innovation/SitePages/Who-we-are.aspx\"></a></p><p><a href=\"https://irnz.sharepoint.com/sites/CORP-compliance-strategy-and-innovation/SitePages/Who-we-are.aspx\">https://irnz.sharepoint.com/sites/CORP-compliance-strategy-and-innovation/SitePages/Who-we-are.aspx</a></p><!--EndFragment--><p><br/></p><p></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Compliance Strategy and Innovation is dedicated to ensuring a Right from the Start ‘end to end’ focus on applying innovation into our compliance approach and combine insights from customer segments, systems, products, and analytics. Made up of two teams, Innovation & Intervention Design and Insights & Configurations, they work closely together in a networked way to support CCS and wider IR. Just like Community Compliance, Legal Services, and CCS Planning Design & Delivery, we are a shared service – supporting CCS and IR more broadly."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p><!--StartFragment--><span style=\"color: rgb(0, 0, 0);float: none;background-color: rgb(255, 255, 255);\">Org Structure spreadsheet from Workforce Information and Intelligence Team within People &amp; Workplace Services. Māori term supplied by the Māhutonga Team 2022.</span><!--EndFragment--><br/></p>"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#STARTAnalytics/STARTAnalytics_en0> ;
        sem:guid          "678d433a-fb29-48e9-beb1-b6e18ecc87b2" ;
        skos:broader      <http://example.com/InlandRevenueModel#CustomerAndComplianceServices-Business> , <http://example.com/InlandRevenueModel#Data-Analytics-Insights> ;
        skos:historyNote  "<div><p><span><span style=\"float: none;\"><span style=\"color: rgb(50, 49, 48);\">Team created April 2022.</span></span></span></p></div>"@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#STARTAnalytics/ComplianceStrategyAndInnovation_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#STARTAnalytics/STARTAnalytics_en> .

