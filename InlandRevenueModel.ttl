<http://smartlogic.com/term#401253492428764857618526776158372>
        rdf:type          <http://smartlogic.com/class#Obligation> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://smartlogic.com/term#401253492428764857618526776158372/TakeMoNgaHuamoniMeNgaPangaKiTauiwi_en> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://smartlogic.com/label#798544114741759131501870025879879_English_2700> ;
        <http://example.com/InlandRevenueModel#HasRelatedIRForm>
                <http://example.com/InlandRevenueModel#NRWTOnInterest-DividendsAndRoyaltiesReconciliationStatement> , <http://example.com/InlandRevenueModel#NRWTPayerRegistration> , <http://example.com/InlandRevenueModel#NewZealandNon-residentWithholdingTax> , <http://example.com/InlandRevenueModel#Non-residentWithholdingTaxCertificate> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://smartlogic.com/term#332232282734990593924592237114874> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/kc-investment-income/SitePages/non-resident-withholding-tax-overview.aspx?web=1\">Non-resident withholding tax overview</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "New Zealand imposes non-resident withholding tax (NRWT) on New Zealand sourced interest, dividends or royalties paid to non-residents. The New Zealand sourced income is known as [non-resident passive income] (NRPI). The New Zealand borrower (including banks taking deposits) must deduct NRWT. NRWT is still a tax on the foreign investor and they will usually get a credit in their home jurisdiction for the New Zealand tax paid. NRWT is to be deducted from the gross payment made - expenses should not be deducted."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://smartlogic.com/term#401253492428764857618526776158372/TakeMoNgaHuamoniMeNgaPangaKiTauiwi_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website"@en ;
        sem:guid          "08a64982-348d-5a1e-818d-cbc431373787" ;
        skos:broader      <http://smartlogic.com/term#716311899949028386928466293214695> ;
        skos:related      <http://example.com/InlandRevenueModel#Non-ResidentWithholdingTaxOnDividends-Royalties> , <http://example.com/InlandRevenueModel#Non-ResidentWithholdingTaxOnInterest> , <http://example.com/InlandRevenueModel#Non-residentFinancialArrangementIncome> ;
        skosxl:prefLabel  <http://smartlogic.com/label#401253492428764857618526776158372_English> .

