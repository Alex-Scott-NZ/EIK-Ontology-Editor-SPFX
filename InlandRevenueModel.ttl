<http://example.com/InlandRevenueModel#LongServiceLeave>
        rdf:type          <http://smartlogic.com/class#Life-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#LeavePolicy> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsEventObjectOfActivity>
                <http://example.com/Cleaned-Inland-Revenue-model#EmploymentRelations> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#LongServiceLeave/LSL_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#AbsenceManagement> , <http://example.com/InlandRevenueModel#EmploymentConditionsDevelopment> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>​<a href=\"https://irnz.sharepoint.com/sites/CORP-people-and-workplace-services/SitePages/Leave-types.aspx?web=1\">Leave types</a>​<br></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Once you reach five years of service, and every five years after that, you are entitled to one week of long service leave (please note “a week: is the number of days you are contracted to work per week at the time the entitlement is granted/ when your anniversary falls due).&nbsp;<br>Long service leave days can be taken together in one block or as separate days. A request to take long service leave may be in no less than single days (it is not able to be requested in hours or part days).&nbsp;<br>Long service leave will not accumulate from one qualifying period to another and must be taken before the next entitlement falls due, or it will be forfeited.<br></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#LongServiceLeave/LongServiceLve_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>People and Culture content; LMU content; CCS content; Corporate Finance content; P&amp;C: Employment Relations content<!--EndFragment--><br/><br/><br/></p>"@en ;
        sem:guid          "d7249083-cf2a-4149-9a2e-4514b21c18e0" ;
        skos:broader      <http://example.com/NZ-IRD#Leave> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#LongServiceLeave/LongServiceLeave_en> .

