        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#EngagementMaoriAndDiverseCommunities> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Future Operating Model glossary 2020. http://intranet.ird.govt.nz/our-new-organisation/glossary"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Inland Revenue's approach to weaving te Tiriti o Waitangi (the Treaty of Waitangi) and Māori principles, concepts and practices into Inland Revenue. As a government department we have a responsibility to support the government to meet its obligations under te Tiriti o Waitangi in relation to the Acts we administer and the services we provide. Māhutonga is the Māori name for the constellation of stars also known as the Southern Cross."@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#MahutongaProgramme/MahutongaApproach_en> , <http://example.com/InlandRevenueModel#MahutongaProgramme/MahutongaWork_en> , <http://example.com/InlandRevenueModel#MahutongaProgramme/Mahutonga_en> , <http://example.com/InlandRevenueModel#MahutongaProgramme/Mahutonga_en0> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Future Operating Model glossary 2020"@en ;
        sem:guid          "25b8ad80-0e81-4fa8-bc02-e38bde02ba31" ;
        skos:broader      <http://example.com/InlandRevenueModel#Strategy> ;
        skos:related      <http://example.com/InlandRevenueModel-current-#TreatyOfWaitangi> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MahutongaProgramme/MahutongaProgramme_en> .

