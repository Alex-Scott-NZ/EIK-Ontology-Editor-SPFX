                <http://example.com/InlandRevenueModel#GSTCrossBorderNeutralityProject> , <http://example.com/InlandRevenueModel#ProvisionalTaxAndGSTAlignmentProject> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#NotInNPT>
                <http://smartlogic.com/term#89590199481890290360157/excl.GST_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Kuputaka (IR START Glossary)"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A tax charged in accordance with the provisions of the Goods and Services Tax Act 1985 on the supply in New Zealand of goods and services by a registered person.</p><div><p>GST is a tax of 15% added to the price of most goods and services, including imports. <br/>As a customer, you'll pay this when you buy goods and services. You'll also pay this on most imported goods and some imported services. If you're selling goods or services that are taxable, you may need to register for GST and charge it to customers.<br/></p></div>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://smartlogic.com/term#89590199481890290360157/TakeHokohoko_en0> , <http://smartlogic.com/term#89590199481890290360157/ValueAddedTax_en> ;
        <http://example.com/NZ-IRD#Is-defined-by>
                <http://example.com/Cleaned-Inland-Revenue-model#GoodsAndServicesTaxAct1985-S8-1-> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR concept model; Business Rules Modelling Analysis; PAS content. Māori term from Te Taura Whiri Māori Language Commission"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://smartlogic.com/term#89590199481890290360157/PR.T.002_en> ;
        sem:guid          "966e6bdd-5499-5841-b991-aff1270a1636" ;
        skos:broader      <http://example.com/InlandRevenueModel#Taxes0> ;
        skos:definition   "<p>Goods and services tax (GST) is a tax added to the price of most goods and services in New Zealand, including most imported services: s 8 GST Act 1985.<br>A person or a business which is registered for GST is called a \"registered person\". Registered persons must charge and collect GST from their customers on behalf of the Government, file GST returns, and pay GST to Inland Revenue.<br></p>"@en ;
        skos:related      <http://example.com/InlandRevenueModel#AssociatedTransaction> , <http://example.com/InlandRevenueModel#GSTAdjustment> , <http://example.com/InlandRevenueModel#GSTCessation> , <http://example.com/InlandRevenueModel#GSTEstimations> , <http://example.com/InlandRevenueModel#GoodsAndServicesTax-LocalAuthoritiesAccountingOnPaymentsBasis-Order2005> , <http://example.com/InlandRevenueModel#GoodsAndServicesTaxReturn> , <http://example.com/InlandRevenueModel#Value-addedTax> , <http://smartlogic.com/term#175072654838674267587392> ;
        skosxl:prefLabel  <http://smartlogic.com/label#89590199481890290360157_English> .

