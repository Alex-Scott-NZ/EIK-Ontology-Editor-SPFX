<http://example.com/InlandRevenueModel#IntegrityChampion>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsRoleOf>
                <http://example.com/InlandRevenueModel#Enterprise-IntegrityServices> ;
