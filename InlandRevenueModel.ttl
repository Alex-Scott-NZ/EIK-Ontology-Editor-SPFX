<http://example.com/Cleaned-Inland-Revenue-model#Shortfall-penalty-for-not-taking-reasonable-care>
        rdf:type          <http://smartlogic.com/class#Penalty> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-penalty-for>
                <http://example.com/Cleaned-Inland-Revenue-model#Not-taking-reasonable-care> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "A shortfall penalty imposed on a taxpayer who does not take reasonable care in taking a taxpayer’s tax position, which results in a tax shortfall."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "OCTC content"@en ;
        sem:guid          "c5efecea-218c-4532-a786-47b7f68e14f2" ;
        skos:broader      <http://smartlogic.com/term#198463689315270855790496> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#Shortfall-penalty-for-not-taking-reasonable-care/Shortfall-penalty-for-not-taking-reasonable-care_en> .

