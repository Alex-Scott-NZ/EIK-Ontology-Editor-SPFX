        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "​Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "https://www.taxpolicy.ird.govt.nz/news/2024/2024-govt-familyboost"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel#UsesService>
                <http://example.com/InlandRevenueModel#BusinessProductRegistrationService> , <http://example.com/InlandRevenueModel#IndividualProductEnrolmentService> ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Family Boost is a childcare payment to help eligible households pay for the cost of early childhood education (ECE). Being eligible for Family Boost will depend on who cares for the children, the household income and the type of childcare paid for.<br><br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Tax Policy website"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#FamilyBoost/PR.CS.016_en> ;
        sem:guid          "4af6bd95-1203-4147-abdd-f22b45cc2884" ;
        skos:broader      <http://example.com/InlandRevenueModel#CreditsAndEntitlement> ;
        skos:definition   "FamilyBoost is a childcare payment made to families with young children to help with the rising costs of early childhood education (ECE). Introducted as part of the 2024 Budget, FamilyBoost is available for ECE fees paid from 1 July 2024, with the first FamilyBoost refunds being made in October 2024."@en ;
        skos:related      <http://example.com/InlandRevenueModel#AbatementRate> , <http://example.com/InlandRevenueModel#AbatementThreshold> , <http://example.com/InlandRevenueModel#EarlyChildhoodEducationProvider> , <http://example.com/InlandRevenueModel#Families> , <http://example.com/InlandRevenueModel#Quarterly> , <http://example.com/InlandRevenueModel#Subsidy> , <http://smartlogic.com/term#46576892232815290578744> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#FamilyBoost/FamilyBoostPayment_en> ;
