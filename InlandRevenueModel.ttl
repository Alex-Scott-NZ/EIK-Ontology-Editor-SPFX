<http://example.com/InlandRevenueModel#Absentee>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "Absentee— (a) means a person other than a person who is resident in New Zealand during any part of the tax year: (b) is defined in section HD 18 (Agency in relation to absentees generally) for the purposes of subpart HD (Agents)."@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerSegmentsAndRoles> ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#Absentee/AbsenceManagement_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<div><p></p></div><p>IR Glossary (General - START Help)</p><p><br/></p><p>https://irnz.sharepoint.com/sites/kc-common-vocabulary/Lists/irglossary/AllItems.aspx</p><div><div><p><br/></p></div></div>"@en ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Income Tax Act "@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>An absentee is a person who does not qualify as a resident; they remain non-resident at all times throughout the year as they:<br/>Normally live overseas.<br/>Are in New Zealand for 183 or fewer days.<br/>Don't have a permanent place of abode in New Zealand.<br/>While in New Zealand they receive New Zealand sourced income, for example - a person on a short term working holiday.<br/>Absentees are taxed at New Zealand rates for the period worked in New Zealand on all New Zealand income including salary and wages. They are not taxed on overseas income.</p>"@en ;
        <http://example.com/InlandRevenueModel-current-#IsRoleRelatedTo>
                <http://example.com/Cleaned-Inland-Revenue-model#Non-resident> , <http://example.com/InlandRevenueModel#Agent> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#Absentee/Absentees_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Tax Technical Website Project"@en ;
        sem:guid          "f781afc7-f8da-4adb-a5a7-3c3154234b0c" ;
        skos:broader      <http://smartlogic.com/term#188649781203397804479981> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Absentee/Absentee_en> .

<http://example.com/InlandRevenueModel#Absentee/AbsenceManagement_en>
        rdf:type            skosxl:Label ;
        skosxl:literalForm  "Absence management"@en .

