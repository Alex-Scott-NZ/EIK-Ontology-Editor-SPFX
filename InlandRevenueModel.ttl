<http://example.com/Cleaned-Inland-Revenue-model#AccrualExpenditure>
        rdf:type          <http://smartlogic.com/class#Payment> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://smartlogic.com/term#153321368926185107673047370395105> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "An expenditure that is deductible under the Income Tax Act other than expenditure incurred - a) In the purchase of trading stock; b) In respect of any financial arrangement; c) In respect of a lease to which sections 222A and 222E of the Act apply; or d) Pursuant to a binding contract entered into before 8.30 pm New Zealand Standard Time on 31 July 1986."@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Glossary"@en ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Income Tax Act"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>These are expenses that have been incurred, but which have not yet been paid. Often they relate to services that have been consumed but the firm has either not yet received the account, or have not yet paid the account. Accrued expenses are a current liability in the balance sheet.\n<br>Examples: accrued wages payable, accrued interest payable.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "80560c24-73f9-4f2e-828e-aca530cb5d65" ;
        skos:broader      <http://smartlogic.com/term#133464950737212625130954948425202> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#AccrualExpenditure/AccrualExpenditure_en> .

<http://example.com/Cleaned-Inland-Revenue-model#AccrualExpenditure/AccrualExpenditure_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Accrual expenditure"@en .

