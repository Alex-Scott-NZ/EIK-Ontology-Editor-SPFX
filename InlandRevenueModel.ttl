<http://example.com/IRD-test-model#Group>
        rdf:type          <http://example.com/IRD-test-model#Group0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-04-09"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "CoPilot"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        sem:guid          "854a6fb7-22d8-4400-85cb-d9d38951f06c" ;
        skos:broader      <http://example.com/IRD-test-model#People> ;
        skos:definition   "<p>A group is two or more people who are socially connected through shared interaction, identity, interest, or purpose, and who recognise themselves (or are recognised by others) as belonging together.&nbsp;A group typically has some, but not necessarily all, of the following: more than one person, social connection or interaction (regular, ongoing, or meaningful), shared purpose, interest, or identity (a&nbsp;sense of “we”, either explicit or implicit), and persistence over time (even if temporary).<br>Importantly, a group does not require: legal status, formal structure, governance, incorporation, or registration although it may include those elements.&nbsp;&nbsp;A group is not&nbsp;a crowd: people in the same place with no social relationship (e.g. people at a bus stop) or a category: people who share a characteristic but do not interact (e.g. “taxpayers”, “people aged 18–25”).</p>"@en ;
        skosxl:prefLabel  <http://example.com/IRD-test-model#Group/Group_en> .

