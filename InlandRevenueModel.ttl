        sem:guid          "cfc1a657-8852-4a5f-a34e-9efb2686a115" ;
        skos:broader      <http://example.com/InlandRevenueModel#FunctionalPlan> ;
        skos:definition   "A site emergency plan is a documented strategy to respond to potential emergencies at a specific workplace or location, outlining how to protect people, manage the incident, and resume operations. It includes procedures for warning and evacuating staff, providing first aid, contacting emergency services, and securing the site. Key components of an effective plan are identifying risks, establishing clear roles and responsibilities, maintaining emergency resources, training personnel, and regularly testing the plan through drills."@en ;
        skos:related      <http://example.com/InlandRevenueModel#Plan> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#SiteEmergencyPlan/SiteEmergencyPlan_en> .

