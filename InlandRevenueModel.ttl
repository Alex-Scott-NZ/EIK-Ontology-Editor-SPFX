<http://smartlogic.com/term#53476886664968526062353>
        rdf:type          <http://example.com/InlandRevenueModel#NotCurrent> , <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://smartlogic.com/term#53476886664968526062353/E-A_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ProductAdministration> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/kc-tax-law-community/SitePages/managing-the-tco-escalations-and-advising-process.aspx"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Tax Counsel Office (TCO) Escalations and Advising team determine the Commissioner's view of the law under Inland Revenue's Escalation Policy. Escalation: If a staff member thinks that the existing position is incorrect then they must follow the Escalation Policy, which may result in the unit reconsidering and determining the Commissioner's position. Advising: Providing advice to Inland Revenue's senior management on complex tax technical issues, mostly to the Chief Tax Counsel or the Deputy Commissioner, Policy and Strategy. They also have the responsibility (on behalf of TCO) to: Liaise with Investigations and Advice on legal and technical matters, to promote a consistent application of the law in investigations and disputes, and Provide input into disputes and cases being handled by Litigation Management and the Crown Law Office, especially where significant and potentially contentious issues are involved."@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel#LegalAdvice> , <http://smartlogic.com/term#76063862078258288179254> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://smartlogic.com/term#53476886664968526062353/Director-EscalationsAndAdvising_en> , <http://smartlogic.com/term#53476886664968526062353/EscalationsAndAdvisingUnit_en> , <http://smartlogic.com/term#53476886664968526062353/EscalationsAndAdvisory_en> ;
        <http://example.com/NZ-IRD#Offers-product-service>
                <http://example.com/InlandRevenueModel-current-#InlandRevenueGuidance> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "OCTC content plan; Annual Report 2016"@en ;
        sem:guid          "99266cbf-7bbf-5685-bce8-13a6c320dc8f" ;
        skos:broader      <http://example.com/InlandRevenueModel#_PreviousBusinessUnits-> ;
        skos:historyNote  "<p><span lang=\"EN\" style=\"color: black;\">No longer used from February 2020 when Office of the Chief Tax Counsel changed to Tax Counsel Office and a new operating model.</span></p><p><font face=\"Times New Roman\" size=\"3\"><br/><br/></font></p>"@en ;
        skosxl:altLabel   <http://smartlogic.com/label#186453191727129011805026_English_2792> ;
