<http://example.com/InlandRevenueModel#ExternalDatasetsFramework>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://example.com/InlandRevenueModel-current-#ThirdPartyData> ;
