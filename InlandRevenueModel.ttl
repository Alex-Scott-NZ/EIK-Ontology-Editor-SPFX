<http://example.com/InlandRevenueModel#Non-cashDividend>
        rdf:type          <http://smartlogic.com/class#Income> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IR website"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Companies may provide other benefits to shareholders rather than paying a cash dividend. Non-cash dividends may arise from the provision of low-interest loans and other company property to shareholders. These benefits are also treated as dividends and NRWT must be deducted. To avoid the potential double taxation of the same benefit as both a fringe benefit and as a non-cash dividend, the term 'dividends' is excluded from benefits which are subject to FBT: s CD 32(1) ITA 2007. Also refer to Interpretation Statement 21/05 Non-cash dividends."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR website"@en ;
        sem:guid          "8d55263d-be3d-4da1-9272-36e7a82db249" ;
        skos:broader      <http://smartlogic.com/term#134667386383500393103361> ;
        skos:definition   "Companies  may provide other benefits to shareholders rather than paying a cash dividend. These are non-cash dividends, and such benefits are also treated as dividends for tax purposes, and RWT must be paid on them."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#Non-cashDividend/Non-cashDividend_en> .

