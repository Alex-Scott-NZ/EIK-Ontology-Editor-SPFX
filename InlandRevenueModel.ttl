<http://example.com/InlandRevenueModel#DebtCollectionEnforcementService>
        rdf:type            <http://example.com/InlandRevenueModel-current-#Services> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsUsedBy>
                <http://smartlogic.com/term#180435716853590549192692> , <http://smartlogic.com/term#733873855465831453299914748155375> ;
        <http://example.com/InlandRevenueModel#IsUsedIn>
                <http://example.com/InlandRevenueModel-current-#DebtRecoveryAction> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-05-12"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Services (IR)"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>​Inland Revenue is responsible for managing financial obligations and recovering unpaid amounts using a range of approaches. This includes domestic and international collection and enforcement arrangements where obligations become overdue or are legally treated as debt.<br>The service also supports customers to meet their obligations by providing assistance to comply and avenues to request relief. Inland Revenue will notify customers of any decisions made.<br></p>"@en ;
        <http://example.com/NZ-IRD#Is-offered-by-supplier>
                <http://smartlogic.com/term#180435716853590549192692> , <http://smartlogic.com/term#733873855465831453299914748155375> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR business services register"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#DebtCollectionEnforcementService/BSV.CES.002_en> ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#DebtCollectionEnforcementService/DebtCollectionEnforcementService_en0> ;
        sem:guid            "e23abb3e-6d9e-4c96-baf8-1d30a9a95f93" ;
        skos:broader        <http://example.com/InlandRevenueModel#CollectionEnforcementService> ;
        skos:editorialNote  "Renamed May 2026 so that it covers regular collection of child support internationally."@en ;
        skos:related        <http://example.com/InlandRevenueModel#ChildSupportInternationalSupport> , <http://example.com/InlandRevenueModel#DebtLegalService> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#DebtCollectionEnforcementService/DebtCollectionEnforcementService_en> .

