<http://example.com/InlandRevenueModel#NaturalEvent>
        rdf:type          <http://smartlogic.com/class#Adverse-event> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>https://www.lawinsider.com/dictionary/natural-event<br/>https://www.nationalgeographic.org/activity/<br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#IsSub-eventOf>
                <http://example.com/InlandRevenueModel#BusinessDisruption> ;
        <http://example.com/NZ-IRD#Source-of-term>
