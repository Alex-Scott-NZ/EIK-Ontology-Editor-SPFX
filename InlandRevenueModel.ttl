<http://example.com/InlandRevenueModel#HiddenEconomyGovernanceGroup>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#HiddenEconomyGovernanceGroup/HEGG_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://smartlogic.com/term#110481616277029930443037> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#GovernanceAndCommunities> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-hidden-economy/SitePages/What-is-the-hidden-economy.aspx"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The hidden economy is made up of people or businesses who deliberately hide their income, or under-report it to avoid paying tax. The Hidden economy programme was initially a 10-year strategy to improve IR's ability to detect and deal with those who do not pay tax on all their income. Addressing hidden economy risk is now captured within the Compliance Operating Model and overseen by the Hidden Economy Network Group.  Fraud risks are overseen by the Non-GST fraud portfolio network group."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "CCS-I content"@en ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#HiddenEconomyGovernanceGroup/HiddenEconomyGovernanceGroup_en0> ;
        sem:guid          "bfb28965-34ab-40d0-8ceb-355304252399" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skos:historyNote  "The Hidden Economy Programme began when IR received bilateral funding from Budget 2010, with further funding provided in Budget 2015."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#HiddenEconomyGovernanceGroup/HiddenEconomyGovernanceGroup_en> .

<http://example.com/InlandRevenueModel#HiddenEconomyGovernanceGroup/HEGG_en>
        rdf:type             skosxl:Label ;
        sem:caseSensitivity  sem:CaseSensitive ;
        sem:stemming         sem:StemmingOff ;
        skosxl:literalForm   "HEGG"@en .

