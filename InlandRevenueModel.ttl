                <http://example.com/InlandRevenueModel#ForumOnTaxAdministration/EventGroup_en> , <http://example.com/InlandRevenueModel#ForumOnTaxAdministration/FinnishTaxAdministration_en> , <http://example.com/InlandRevenueModel#ForumOnTaxAdministration/FixedTermAgreement_en> , <http://example.com/InlandRevenueModel#ForumOnTaxAdministration/FreeTradeAgreement_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "<p>​<a href=\"https://www.oecd.org/en/networks/oecd-forum-on-tax-administration.html\">OECD Forum on Tax Administration | OECD</a>​<br></p>"@en ;
        <http://example.com/NZ-IRD#Is-offered-by-supplier>
