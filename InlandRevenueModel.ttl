        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Register of Governance Bodies in IR - Architecture&nbsp;</p><p> </p><p><a href=\"https://irnz.sharepoint.com/sites/kc-architecture\">https://irnz.sharepoint.com/sites/kc-architecture</a></p><p> </p><p>​</p>"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The CAB is accountable for continuity of Business Services by ensuring all technical changes are effectively risk and impact assessed, sequenced, planned, coordinated, and controlled.\n<br>The CAB will execute its role by approving the deployment of all medium and high-risk changes to production and non-production environments. The CAB will ensure that changes to technical services are subjected to rigorous business and technical readiness assessment, so that impacts are minimised, risks are fully understood and accepted.<br></p>"@en ;
        sem:guid          "afba03be-9a25-4688-a1a3-7b979e631a32" ;
        skos:broader      <http://smartlogic.com/term#30800050241132908903544> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#ChangeAdvisoryBoard/ChangeAdvisoryBoard_en> .

