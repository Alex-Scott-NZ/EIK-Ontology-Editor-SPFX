<http://example.com/InlandRevenueModel#LearningHappensPrimarilyOnTheJob-Self-directedByTheIndividual>
        rdf:type          <http://smartlogic.com/class#Method> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Learning Strategy, 2017"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "We have adopted the 70/20/10 model, with 70% of learning happening while people are working, supported by leaders as coaches. Only 10% of learning is 'formal' and directed by the organisation. Everyone is expected to keep learning, deepening or broadening their capability."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
