        sem:guid          "5cc30689-01a8-4a38-9830-db1ed153c093" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Annuity> ;
        skos:definition   "A qualifying foreign private annuity (QFPA) is a foreign pension or annuity that provides benefits to a New Zealand resident and is exempt from the Foreign Investment Fund (FIF) rules under New Zealand tax law. To be a QFPA, the annuity must be a \"private\" (not government-provided) entitlement from a foreign entity. QFPAs are generally not treated as FIF income and are taxed only when amounts are actually received or transferred, with potential temporary exemptions available for transitional residents."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#QualifyingForeignPrivateAnnuityExemption> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#QualifyingForeignPrivateAnnuity/QualifyingForeignPrivateAnnuity_en> .

