<http://example.com/InlandRevenueModel#StudentAllowance>
        rdf:type          <http://smartlogic.com/class#Entitlement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsAppliedTo>
