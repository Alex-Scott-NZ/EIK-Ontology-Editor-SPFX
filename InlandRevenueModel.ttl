                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#MasterServicesAgreement/MSA-_en> , <http://example.com/InlandRevenueModel#MasterServicesAgreement/MSAVariation_en> , <http://example.com/InlandRevenueModel#MasterServicesAgreement/MasterAgreement_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Commercial & Procurement content"@en ;
        sem:guid          "4f60b4f3-0041-48a6-ace7-01fcf5ad6338" ;
        skos:broader      <http://example.com/InlandRevenueModel#ServicesAgreement> ;
        skos:definition   "A Master Services Agreement (MSA) is a contract that sets the fundamental, overarching terms and conditions for an ongoing business relationship between two parties, typically a client and a service provider. It acts as a foundational legal framework, streamlining future transactions and projects by pre-negotiating key provisions like intellectual property ownership, payment terms, and confidentiality. This reduces the time and effort needed to negotiate these terms for every subsequent service order or project, making the overall process more efficient and cost-effective. "@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#MasterServicesAgreement/MasterServicesAgreement_en> .

