<http://example.com/NZ-IRD#Bright-line-test>
        rdf:type          <http://example.com/Cleaned-Inland-Revenue-model#Test0> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#Taxation-Bright-LineTestForResidentialLand-Act2015> , <http://example.com/InlandRevenueModel-current-#Taxation-AnnualRatesFor2017-2018-EmploymentAndInvestmentIncome-AndRemedialMatters-BIll> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Is-source-of-rules-for>
                <http://example.com/Cleaned-Inland-Revenue-model#PropertyCompliance> , <http://example.com/InlandRevenueModel#BuyingOrSellingAHome> , <http://example.com/InlandRevenueModel#PropertyDevelopment> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ProductAdministration> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Kuputaka (IR START Glossary). IR website"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A test that is used to determine if tax should be paid on the sale of residential property. If an agreement to purchase residential property was entered into on or after 29 March 2018 and and the property was sold within 5 years, it may be taxable under the bright-line test. If a property was purchased on or after 1 October 2015 through to 28 March 2018, the bright-line test will look at whether the property was sold within 2 years. The bright-line test doesn’t apply if the property was: the main home, transferred as part of an inheritance, or transferred to the taxpayer as an executor/ administrator of a deceased estate.<br/><br/></p>"@en ;
        <http://example.com/InlandRevenueModel-current-#IsModelUsedBy>
                <http://example.com/Cleaned-Inland-Revenue-model#SaleOfLand> , <http://example.com/InlandRevenueModel#PropertyTax> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/NZ-IRD#Bright-line-test/Bright-lineCompliance_en> , <http://example.com/NZ-IRD#Bright-line-test/Bright-lineInformation_en> , <http://example.com/NZ-IRD#Bright-line-test/Bright-linePeriod_en> , <http://example.com/NZ-IRD#Bright-line-test/Bright-linePropertyTax_en> , <http://example.com/NZ-IRD#Bright-line-test/E28098bright-lineE28099Test_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Income tax Act 2007; PAS content; IR website"@en ;
        sem:guid          "40b31867-64a9-4767-85c2-8b78ffde5e4e" ;
        skos:broader      <http://example.com/Cleaned-Inland-Revenue-model#Test> ;
