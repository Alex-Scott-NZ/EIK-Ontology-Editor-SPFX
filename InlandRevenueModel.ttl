<http://example.com/InlandRevenueModel#KiwiSaverSchemeRegistrationNumber>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
