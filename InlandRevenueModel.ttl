<http://example.com/InlandRevenueModel#VoluntaryDisclosure>
        rdf:type          <http://example.com/InlandRevenueModel#IRForm> ;
        <http://example.com/InlandRevenueModel#HasShoulderCode>
                <http://example.com/InlandRevenueModel#VoluntaryDisclosure/IR281P_en> , <http://example.com/InlandRevenueModel#VoluntaryDisclosure/IR281_en> , <http://example.com/InlandRevenueModel#VoluntaryDisclosure/IR281_en0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ProductAdministration> ;
        <http://example.com/InlandRevenueModel#IsIRFormRelatedTo>
                <http://example.com/Cleaned-Inland-Revenue-model#VoluntaryDisclosure> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/kc-audit-and-investigation/SitePages/voluntary-disclosures.aspx"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>A voluntary disclosure is when a customer tells us what is wrong with their tax return before we find out in some other way. This can include a request to amend their return, declare omitted income or incorrectly claimed expenses. Anyone can make a voluntary disclosure. This includes salary and wage earners, individuals, businesses, trusts and employers.<br/>IR281P Voluntary disclosure form is used when customer should have paid tax on sale of a property but didn't.</p>"@en ;
