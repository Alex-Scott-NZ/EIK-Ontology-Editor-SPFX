<http://example.com/InlandRevenueModel#ImpactAssessment>
        rdf:type            <http://smartlogic.com/class#Information> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>Inland Revenue's Initiative Management Framework V1.0, May 2022 as approved by Deputy Commissioner Enterprise Design &amp; Integrity.<br/></p><p><a href=\"https://irnz.sharepoint.com/sites/CORP-strategic-portfolio-stewardship/SupInfo/Forms/AllItems.aspx?id=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo%2FInitiative%20Management%20Framework%2Epdf&amp;parent=%2Fsites%2FCORP%2Dstrategic%2Dportfolio%2Dstewardship%2FSupInfo\">Tiakitanga<br/>Kohinga Rautaki - Strategic Portfolio Stewardship - Initiative Management<br/>Framework.pdf - 1) All Documents (sharepoint.com)</a><span></span></p>"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "IKM Team"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "An assessment of the initiative's impact on people, platform, process, policy, and customers."@en ;
        sem:guid            "55008f91-ff23-4af9-a7ca-1c442f45b57f" ;
        skos:broader        <http://example.com/InlandRevenueModel#ChangeManagementInformation> ;
        skos:definition     "<p>An impact can be positive or negative and may be intended&nbsp;or accidental. Assessing impacts is about identifying and evaluating change. <span style=\"color: black\">An impact&nbsp;assessment will look at what possible outcome a specific action can have and&nbsp;how to minimize or prevent any negative outcomes.</span></p>"@en ;
        skos:editorialNote  "Term added to act as a high-level category for the group of impact assessments that are referred to in IR records."@en ;
        skos:related        <http://example.com/InlandRevenueModel#CustomerImpactAssessment> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#ImpactAssessment/ImpactAssessment_en> .

<http://example.com/InlandRevenueModel#ImpactAssessment/ImpactAssessment_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Impact assessment"@en .

