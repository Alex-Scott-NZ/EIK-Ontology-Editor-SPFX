<http://example.com/InlandRevenueModel#CreditTransfer>
        rdf:type          <http://smartlogic.com/class#Transaction> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Definition taken from Learning Module - Financial transactions in START."@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p> </p><p><span style=\"font-size:9.0pt;color:black\" \"=\"\">Credit transfer is an action taken by an IR employee on a customer’s account.</span></p><p> </p><p><span style=\"font-size:9.0pt;color:black\">Credit transfers can be within a customer's account or between customer accounts. It can be automatic where START will transfer any available credit automatically and apply this to any debt or obligation outstanding on a customer's account, or it will need to be manually transferred.&nbsp;</span><br> <span style=\"font-size:9.0pt;color:black\" \"=\"\">The transfer rules allow customers to choose the date they want excess tax to be transferred on, provided it is not earlier than the dates set out in the legislation.</span></p><p> </p><p><span style=\"font-size:9.0pt;color:black\" \"=\"\">A credit can arise mainly when these transaction types occur.</span></p><p> </p><p><strong><span style=\"font-size: 9.0pt;color:#0D8390\">By a payment:</span></strong><span style=\"font-size:9.0pt;color:black\" \"=\"\">&nbsp;Where a customer has made a payment into the account where the credit is located.</span></p><p> </p><p><strong><span style=\"font-size: 9.0pt;color:#0D8390\">By an inward transfer:</span></strong><strong><span style=\"font-size:9.0pt;color:black\">&nbsp;</span></strong><span style=\"font-size:9.0pt;color:black\" \"=\"\">The credit in the customer's account has been created by a transfer from either another of the customer's accounts or from another related customer.</span></p><p> </p><p><strong><span style=\"font-size: 9.0pt;color:#0D8390\">By a credit assessment:</span></strong><strong><span style=\"font-size:9.0pt;color:black\">&nbsp;</span></strong><span style=\"font-size:9.0pt;color:black\" \"=\"\">A credit assessment occurs when an end-of-year period or assessment is completed. Example: an end-of-year income tax assessment results in a credit balance in that account.</span></p><p> </p><p><strong><span style=\"font-size: 9.0pt;color:#0D8390\">By credit use of money interest:</span></strong><span style=\"font-size:9.0pt;color:black\" \"=\"\">&nbsp;Be aware that the transfer date may cause the interest to recalculate causing the credit amount in the account to reduce or even to disappear completely.</span></p><p> </p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Review of Haukāinga top 100 from 2022"@en ;
        sem:guid          "f1edc1d1-e587-4189-aac9-b44461c2c6f3" ;
        skos:broader      <http://smartlogic.com/term#59335543856898607395094599600876> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#CreditTransfer/CreditTransfer_en> .

<http://example.com/InlandRevenueModel#CreditTransfer/CreditTransfer_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Credit transfer"@en .

