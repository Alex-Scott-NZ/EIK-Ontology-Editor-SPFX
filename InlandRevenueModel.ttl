<http://example.com/InlandRevenueModel#SpecialReport>
        rdf:type          <http://smartlogic.com/class#Information> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Isused-in-function>
                <http://example.com/InlandRevenueModel#PolicyCommunications> , <http://example.com/InlandRevenueModel#PolicyImpactAssessment> , <http://smartlogic.com/term#113077075611557228353748> ;
        <http://example.com/InlandRevenueModel#Instance>
