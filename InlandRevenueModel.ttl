<http://smartlogic.com/term#72194765388424808199295>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBusinessGroup> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Publishes>
                <http://example.com/IRD-test-model#Annual-Report> , <http://example.com/InlandRevenueModel#FourYearPlan> , <http://example.com/InlandRevenueModel#Long-termInvestmentPlan> , <http://example.com/InlandRevenueModel-current-#StatementOfIntent> ;
