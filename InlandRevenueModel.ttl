<http://example.com/InlandRevenueModel#OffshoreGamblingDuty>
        rdf:type          <http://example.com/InlandRevenueModel#IRProduct1> , <http://example.com/NZ-IRD#Legally-defined-term> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-source-of-rules>
                <http://example.com/InlandRevenueModel#OnlineCasinoGamblingAct> , <http://smartlogic.com/term#8962203925880645502417219920243> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "Offshore gambling duty is a duty paid to the crown at the rate of 12% of the offshore gambling profits of an offshore gambling operator for offshore gambling profits arising on or after 1 July 2024."@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#ProductsWeAdminister> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/IRD-test-model#Gaming-duty-collection> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-24"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Register of Business Products (IR)"@en ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "Online Casino Gambling Act 2026"@en ;
        <http://example.com/InlandRevenueModel#UsedInSemantics>
                true ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>The Online Casino Gambling Act came into force 1 May 2026. It impacts the&nbsp;Offshore&nbsp;Gambling Duty by:&nbsp;• Renaming the duty to the Online Gambling Duty (recognising that NZ resident&nbsp;operators will be able to apply to be licenced).&nbsp;• Increasing the duty from 12% to 16% from 1 January 2027.&nbsp;• Requiring operators to be licenced from 1 January 2027, and&nbsp;• Requiring licenced operators to also pay problem gambling levy of 1.24%.</p><p><br></p><p>Offshore gambling duty was a duty paid to the crown at a percentage of the offshore gambling profits of an offshore gambling operator for offshore gambling profits arising on or after 1 July 2024.<br></p>"@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Requested as IR Topic"@en ;
        <http://smartlogic.com/relationship#Has-code_14_None_None>
                <http://example.com/InlandRevenueModel#OffshoreGamblingDuty/PR.D.005_en> ;
        <http://smartlogic.com/relationship#Previously-known-as_4_None_None>
                <http://example.com/InlandRevenueModel#OffshoreGamblingDuty/OffshoreGamblingDuty_en0> ;
        sem:guid          "608ae43c-0c8e-4c08-aa32-04452ebe8c5a" ;
        skos:broader      <http://example.com/InlandRevenueModel#Duties0> ;
        skos:historyNote  "Name changed from 1 May 2026, from Offshore Gambling Duty to Online Gambling Duty."@en ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#OffshoreGamblingDuty/OffshoreGamblingDuty_en> .

<http://example.com/InlandRevenueModel#OffshoreGamblingDuty/OffshoreGamblingDuty_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        sem:stemming           sem:StemmingOff ;
        skosxl:literalForm     "Online gambling duty"@en .

