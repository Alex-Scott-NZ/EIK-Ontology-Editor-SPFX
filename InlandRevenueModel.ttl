        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerActionsAndInteractions> ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/Cleaned-Inland-Revenue-model#ComplaintsManagement/CaseManagementSystem_en> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p>IR Main/Core website</p><div><p>https://www.ird.govt.nz/about-us/who-we-are/organisation-structure/complaints-management<br/></p></div>"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Our Complaints management service is responsible for all complaints made to Inland Revenue. It is a unit dedicated to managing feedback from customers. Complaints or feedback may cover policy decisions, processes and services we provide. The service provides: a process for customers to make complaints and give feedback; uses customer feedback to inform improvements and prevent similar situations from happening in the future."@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/InlandRevenueModel-current-#ComplaintsManagement> , <http://smartlogic.com/term#94121152413715782242739> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/Cleaned-Inland-Revenue-model#ComplaintsManagement/AvailabilityOfServicesComplaints_en> , <http://example.com/Cleaned-Inland-Revenue-model#ComplaintsManagement/ComplaintCategories_en> , <http://example.com/Cleaned-Inland-Revenue-model#ComplaintsManagement/LegislationComplaints_en> , <http://example.com/Cleaned-Inland-Revenue-model#ComplaintsManagement/ProcessComplaint_en> , <http://example.com/Cleaned-Inland-Revenue-model#ComplaintsManagement/StaffComplaints_en> , <http://example.com/Cleaned-Inland-Revenue-model#ComplaintsManagement/fromCMS_en> ;
