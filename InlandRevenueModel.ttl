        skos:related        <http://example.com/InlandRevenueModel#InternalAudit> , <http://example.com/InlandRevenueModel-current-#BusinessRiskControls> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#NationalControlFramework/NationalControlFramework_en> .

