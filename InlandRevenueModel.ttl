<http://example.com/InlandRevenueModel#WhakangunguKaitiaki>
        rdf:type          <http://smartlogic.com/class#Business-event> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Has-participant>
                <http://example.com/InlandRevenueModel#KnowBe4> ;
        <http://example.com/Cleaned-Inland-Revenue-model#IsEventObjectOfActivity>
                <http://example.com/InlandRevenueModel#CyberSecurityManagement> , <http://example.com/InlandRevenueModel-current-#InformationSecurityManagement> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-information-security/SitePages/Whakangungu-Kaitiaki.aspx?web=1"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "To support our efforts, the IR Information Security Office is using a new online tool - KnowBe4. KnowBe4 is a global organisation, founded by the “world’s most famous hacker” – Kevin Mitnick. They provide an extensive range of cyber security training and awareness training modules such as - interactive web-based training, quiz’s, games, simulated phishing, and vishing attacks – to build a more secure organisation. Whakangungu Kaitiaki is IR’s new Information Security Awareness & Learning Programme designed to help support IR in its journey through information security and to uplift the awareness right across Inland Revenue. Research suggests that human error is involved in more than 90% of security breaches. Security Awareness and learning among IR whanau can reduce the risk of data breaches and cyber-attacks which can have a significant impact on the integrity of NZ’s Tax system. "@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#WhakangunguKaitiaki/InsideMan_en> , <http://example.com/InlandRevenueModel#WhakangunguKaitiaki/TheInsideMan_en> ;
        <http://example.com/NZ-IRD#Is-offered-by-supplier>
                <http://example.com/InlandRevenueModel#InformationSecurityOffice> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "https://irnz.sharepoint.com/sites/CORP-information-security/SitePages/Whakangungu-Kaitiaki.aspx?web=1"@en ;
        sem:guid          "202fd107-62e4-488a-aed5-2a611a846100" ;
        skos:broader      <http://example.com/InlandRevenueModel-current-#OnlineTrainingCourse> ;
        skos:definition   "'Whakangungu Kaitiaki' can be translated as 'guardian training' or 'guardian protection'. "@en ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#WhakangunguKaitiaki/GuardianProtection_en> , <http://example.com/InlandRevenueModel#WhakangunguKaitiaki/GuardianTraining_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#WhakangunguKaitiaki/WhakangunguKaitiaki_en> .

<http://example.com/InlandRevenueModel#WhakangunguKaitiaki/GuardianProtection_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "Guardian protection"@en .

