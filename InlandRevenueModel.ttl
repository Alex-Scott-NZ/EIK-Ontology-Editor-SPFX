<http://example.com/InlandRevenueModel#CycloneHale>
        rdf:type            <http://smartlogic.com/class#Adverse-event> ;
        <http://example.com/InlandRevenueModel#HasType>
                <http://example.com/InlandRevenueModel#AdverseEvent> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/Cleaned-Inland-Revenue-model#Wairoa> , <http://example.com/InlandRevenueModel#Wairarapa> , <http://example.com/InlandRevenueModel-current-#Coromandel> , <http://example.com/InlandRevenueModel-current-#GisborneRegion> , <http://example.com/InlandRevenueModel-current-#Northland> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2023-03-14"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/kc-adverse-events/Shared%20Documents/Natural_disaster_or_emergency_event_2016.docx"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>Cyclone Hale was in January 2023. It brought heavy rain and wind to regions across the North Island, with the Gisborne and Wairarapa regions in particular affected, and is likely to affect their income for the 2023 income year.<br/>The late deposit provision for 2022 has been approved, with an extension for all customers until 31 May 2023. Applications for early refunds from the income equalisation scheme will be allowed.<br/>Cabinet has also declared the adverse weather as an emergency event for the purposes of section 183ABA of the TAA which allows Inland Revenue to remit interest payable on late payments following the emergency event.  The emergency event declaration covers the Northland, Gisborne and Wairarapa Coromandel and Wairoa areas.<br/>There may also be farmers/growers from other regions who were affected by Cyclone Hale, we will take a sympathetic approach to customers from other regions who have also been affected. <br/><br/></p>"@en ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#CycloneHale/TropicalCycloneHale_en> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "https://irnz.sharepoint.com/sites/kc-adverse-events/SitePages/natural-disaster-or-emergency-event-tax-impacts.aspx?web=1"@en ;
        sem:guid            "7c13eafa-f9ba-4837-bd77-38a6067c730d" ;
        skos:broader        <http://smartlogic.com/term#47138497716934256857234> ;
        skos:editorialNote  "<p>Checked in Viva Topics but it wasn't there.<br/><br/></p>"@en ;
        skos:related        <http://example.com/InlandRevenueModel#CycloneGabrielle> , <http://example.com/InlandRevenueModel#UpperNorthIslandRainAndFlooding> ;
        skosxl:altLabel     <http://example.com/InlandRevenueModel#CycloneHale/CycloneHaleJanuary2021_en> ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#CycloneHale/CycloneHale_en> .

