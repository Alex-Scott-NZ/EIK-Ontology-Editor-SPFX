<http://example.com/Cleaned-Inland-Revenue-model#Feasibility-expenditure>
        rdf:type          <http://smartlogic.com/class#Payment> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerAttributes> ;
        <http://example.com/InlandRevenueModel#IsInterestOf>
                <http://example.com/InlandRevenueModel#Taxation-AnnualRatesFor2020E2809321-FeasibilityExpenditure-AndRemedialMatters-Bill> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://www.ird.govt.nz/updates/news-folder/feasibility-expenditure"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Feasibility expenditure generally refers to expenditure incurred by a business or organisation to determine the practicality and practicability of a new proposal. Most feasibility expenditure is non-deductible. Where it related to a project to create an asset that would be depreciable property, the expenditure is capitalised with a depreciation deduction on completion. However, where it is expenditure that has assisted in earning taxable income and occurred as an ordinary part of your business, it may be deductible."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "<p>OCTC content; </p><p>Revenue Forecasting content; PAS content</p>"@en ;
        sem:guid          "18ca4219-b2e3-4d9f-b3b3-55c81ba20b2e" ;
        skos:broader      <http://smartlogic.com/term#133464950737212625130954948425202> ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#Feasibility-expenditure/Feasibility-expenses_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#Feasibility-expenditure/Feasibility-expenditure_en> .

