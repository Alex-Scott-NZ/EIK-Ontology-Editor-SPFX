<http://example.com/Cleaned-Inland-Revenue-model#TaxableActivity>
        rdf:type            <http://example.com/NZ-IRD#Legally-defined-term> , <http://smartlogic.com/class#Function-classification> ;
        <http://example.com/Cleaned-Inland-Revenue-model#LegalDefinition>
                "<p>a) Any activity which is carried on continuously or regularly by any person, whether or not for a pecuniary profit, and involves or is intended to involve, in whole or in part, the supply of goods and services to any other person for a consideration; and includes any such activity carried on in the form of a business, trade, manufacture, profession, vocation, association, or club:<br/>b) Without limiting the generality of paragraph (a), the activities of any public authority or any local authority.<br/></p>"@en ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerActionsAndInteractions> ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "Kuputaka (IR START Glossary)"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfLegalDefinition>
                "GST Act"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "<p>An activity carried on continuously or regularly by a business, trade, manufacturer, professional, association or club. </p><p>It includes any activity that supplies, or intends to supply, goods and services to someone else for a consideration (money, compensation, reward) but not necessarily for profit. </p><div><p>A taxable activity is a continuous or regular activity undertaken by any person that supplies or intends to supply goods or services for money or other reward. This includes activities that do not make a profit.<br/>These things are not taxable activities: working for salary or wages; selling items as a hobby or recreation; selling the occasional domestic item; making GST-exempt supplies.<br/></p></div>"@en ;
        <http://example.com/NZ-IRD#Is-defined-by>
                <http://smartlogic.com/term#769477633007581059603718679399876> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Website glossary"@en ;
        sem:guid            "8c0567f7-f17d-4b16-87ee-82b7c6fb80c2" ;
        skos:broader        <http://smartlogic.com/term#4625266373525387044253> ;
        skos:definition     "For the purpose of RWT \"taxable activity\" includes activities relating to making exempt supplies i.e. all regular, on-going activities of any individual or organisation (commercial or non-profit) involving the supply of goods and services. It does not apply to wages or salary."@en ;
        skos:editorialNote  "<p><span style=\"color: black;\"><font face=\"Verdana\" size=\"2\">Taxable activities do not include: </font></span></p><p><font face=\"Times New Roman\" size=\"3\"><br/></font></p><ul style=\"direction: ltr;\"><li style=\"color: rgb(0, 0, 0);\"><p style=\"color: rgb(0, 0, 0);\"><span lang=\"EN-NZ\">Working for salary or wages;</span></p></li><li style=\"color: rgb(0, 0, 0);\"><p style=\"color: rgb(0, 0, 0);\"><span lang=\"EN-NZ\">Being a company director;</span></p></li><li style=\"color: rgb(0, 0, 0);\"><p style=\"color: rgb(0, 0, 0);\"><span lang=\"EN-NZ\">Hobbies or private recreational<br/>pursuits;</span></p></li><li style=\"color: rgb(0, 0, 0);\"><p style=\"color: rgb(0, 0, 0);\"><span lang=\"EN-NZ\">Selling the occasional domestic<br/>or private item; or</span></p></li><li style=\"color: rgb(0, 0, 0);\"><p style=\"color: rgb(0, 0, 0);\"><span lang=\"EN-NZ\">Making GST-exempt supplies. </span></p><p><font face=\"Times New Roman\" size=\"3\"><br/></font></p></li></ul>"@en ;
        skosxl:prefLabel    <http://example.com/Cleaned-Inland-Revenue-model#TaxableActivity/TaxableActivity_en> .

<http://example.com/Cleaned-Inland-Revenue-model#TaxableActivity/TaxableActivity_en>
