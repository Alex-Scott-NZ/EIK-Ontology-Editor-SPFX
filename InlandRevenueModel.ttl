                false ;
        <http://example.com/InlandRevenueModel#NotInNPT>
                <http://example.com/InlandRevenueModel#Post-implementationReview/StandardPIR_en> ;
        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#Post-implementationReview/PostIncidentReview_en> , <http://example.com/InlandRevenueModel#Post-implementationReview/PrescribedInvestorRate_en> ;
