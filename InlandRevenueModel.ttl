        sem:guid            "9a4f0141-bc3f-40bb-8e0d-2a0967cc05a5" ;
        skos:broader        <http://example.com/InlandRevenueModel#Qualification> ;
        skos:definition     "<p>An academic qualification is a formal credential awarded by an educational institution—such as a school, college, or university—after completing a structured program of study.<br>Purpose: To provide theoretical knowledge, conceptual understanding, and research skills in a subject or discipline.<br>Examples: High school diploma, Bachelor’s degree, Master’s degree, Doctorate.<br>Nature: Broad and knowledge-based, focusing on intellectual development rather than direct job-specific training.<br></p>"@en ;
        skos:editorialNote  "Had to differentiate between professional and academic qualifications in order to model eligibility for Fees free."@en ;
        skosxl:prefLabel    <http://example.com/InlandRevenueModel#AcademicQualification/AcademicQualification_en> .

