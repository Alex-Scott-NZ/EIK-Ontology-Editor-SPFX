<http://example.com/Cleaned-Inland-Revenue-model#NewZealandResident>
        rdf:type          <http://example.com/InlandRevenueModel#PartyAttribute0> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#IsAttributeOf>
                <http://example.com/InlandRevenueModel-current-#PrincipleCareGiver> ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#CustomerSegmentsAndRoles> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2026-03-26"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "General - START Help"@en ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Business Rules business terms"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "​A New Zealand tax resident is someone who meets any of these three conditions: They have lived in New Zealand for more than 183 days in any 12 month period; They have permanent place of abode in New Zealand; They are away from New Zealand in the service of the New Zealand government. This rule does not apply to a spouse, partner or children who accompany someone in NZ Government service. Normal residency rules still applies to them."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Business Rules business terms"@en ;
        sem:guid          "a9b92e47-aab1-4231-aa6f-aa3208e8e704" ;
        skos:broader      <http://smartlogic.com/term#144354077507207679107329112919122> ;
        skos:definition   "A person who is resident in New Zealand for tax purposes. New Zealand tax resident = you are taxed like a NZ resident, even if your visa status is temporary. If you are a tax resident New Zealand generally taxes your worldwide income, not just income earned in New Zealand. Tax residency is determined by Inland Revenue, not Immigration New Zealand, and it does not give you any right to live in the country."@en ;
        skos:related      <http://example.com/InlandRevenueModel#NewZealand-residentTrustee> , <http://example.com/InlandRevenueModel#NewZealandResident> , <http://example.com/InlandRevenueModel#WorldwideIncome> ;
        skosxl:altLabel   <http://example.com/Cleaned-Inland-Revenue-model#NewZealandResident/TaxResident_en> ;
        skosxl:prefLabel  <http://example.com/Cleaned-Inland-Revenue-model#NewZealandResident/NewZealandResident_en> .

<http://example.com/Cleaned-Inland-Revenue-model#NewZealandResident/NewZealandResident_en>
        rdf:type               skosxl:Label ;
        sem:rulebaseBehaviour  sem:RulebaseBehaviourExactPhrase ;
        skosxl:literalForm     "New Zealand tax resident"@en .

