<http://example.com/InlandRevenueModel#StudentLoan>
        rdf:type          <http://example.com/InlandRevenueModel#MetadataValue> , <http://example.com/InlandRevenueModel-current-#ANOClass> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "IR Glossary (START Help)"@en ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "Means any money advanced under the student loan scheme to a borrower. This includes: any interest charged in respect of money advanced to a borrower under the student loan scheme; and any administration fee payable, in accordance with a loan contract, by the borrower under that loan contract to the lender under that loan contract."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "IR Data Domains and Sub-Domains, 2020"@en ;
        sem:guid          "670e750f-341d-4333-85d5-e66c1f11f1c3" ;
        skos:broader      <http://example.com/InlandRevenueModel#_PreviousDomainsAndSub-Domains-> ;
        skos:historyNote  "<p>In original version this was a sub-domain under Obligation/Entitlement.<br/>No longer in use.<br/><br/></p>"@en ;
