<http://example.com/InlandRevenueModel#ExecutiveOfficeHolder>
        rdf:type          <http://smartlogic.com/class#Role> ;
        <http://example.com/Cleaned-Inland-Revenue-model#Maori>
                <http://example.com/InlandRevenueModel#ExecutiveOfficeHolder/NgaKaipupuriTungaWhakahaere_en> ;
