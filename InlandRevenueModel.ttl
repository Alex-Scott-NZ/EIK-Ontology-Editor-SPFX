<http://example.com/InlandRevenueModel#EnterprisePrioritiesAndPerformanceCommittee>
        rdf:type          <http://example.com/InlandRevenueModel-current-#IRBoardOrCommittee> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#EnterprisePrioritiesAndPerformanceCommittee/EPPC_en> ;
        <http://example.com/InlandRevenueModel#HasInterestIn>
                <http://example.com/InlandRevenueModel#BusinessDevelopment> , <http://smartlogic.com/term#184149025169191612011423> ;
        <http://example.com/InlandRevenueModel#Instance>
                true ;
        <http://example.com/InlandRevenueModel#IsDisplayedUnder>
                <http://example.com/InlandRevenueModel#GovernanceAndCommunities> ;
        <http://example.com/InlandRevenueModel#LastReviewedDate>
                "2022-06-10"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "<p> </p><p>Governance bodies register on Architecture SharePoint site<br> ​<a href=\"https://irnz.sharepoint.com/sites/kc-architecture/Lists/Authorities/AllItems.aspx?viewid=469db8e0%2D5812%2D40ef%2D937c%2D7beb9c2ec302\">Architecture - Register of Governance Bodies - All Items (sharepoint.com)</a></p><p> </p>"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Enterprise Priorities and Performance Committee governs IR’s overall performance and organisational health, so that we can achieve the strategic direction as set by the Strategic and Investment Board. The Committee provides direction to ensure IR is prioritising well, including helping with trade-off decisions, enabling IR to deliver for customers and government in the face of competing priorities. "@en ;
        <http://example.com/NZ-IRD#Does-activity>
                <http://example.com/IRD-test-model#Performance-measurement> , <http://example.com/InlandRevenueModel#Prioritisation> , <http://smartlogic.com/term#47765963176520709341237> ;
        <http://example.com/NZ-IRD#Evidence>
                <http://example.com/InlandRevenueModel#EnterprisePrioritiesAndPerformanceCommittee/Priorities-Performance_en> ;
        <http://example.com/NZ-IRD#Offers-product-service>
                <http://example.com/InlandRevenueModel#ExecutiveGovernanceSystem> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Diagram of the governance system and its members (PDF)"@en ;
        sem:guid          "d263d3db-411d-4ea9-ba9b-5ff29aaa4a71" ;
        skos:broader      <http://example.com/InlandRevenueModel#IRExecutiveGovernanceGroups> ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#RiskAndAssuranceCommittee> , <http://example.com/InlandRevenueModel#PlanningAndPrioritisationGroup> , <http://example.com/InlandRevenueModel#TechnicalDesignAuthority> , <http://smartlogic.com/term#55018593238622116958346> ;
        skosxl:altLabel   <http://example.com/InlandRevenueModel#EnterprisePrioritiesAndPerformanceCommittee/EnterprisePriorities-PerformanceCommittee_en> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#EnterprisePrioritiesAndPerformanceCommittee/EnterprisePrioritiesAndPerformanceCommittee_en> .

