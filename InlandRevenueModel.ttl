                "2022-03-18"^^xsd:date ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition>
                "https://irnz.sharepoint.com/sites/CORP-enterprise-data-and-analytics/SitePages/What-we-do.aspx"@en ;
        <http://example.com/InlandRevenueModel#usedAsIRTopic>
                true ;
        <http://example.com/InlandRevenueModel-current-#BusinessDefinition>
                "The Data Intelligence Platform (DIP) is made up of a series of SAS products allowing varying teams to investigate, analyse and publish reports, dashboards and datasets using either Refined Data or raw tables. (DIP) is an As A Service offering from SAS that is hosted in a SAS AWS tenancy."@en ;
        <http://example.com/NZ-IRD#Source-of-term>
                "Data Science content; PAS content"@en ;
        sem:guid          "e853a5d5-93c1-49dc-86ed-b1ae7f153421" ;
