        <http://example.com/InlandRevenueModel#NotNPT>
                <http://example.com/InlandRevenueModel#PostIncidentReview/Post-implementationReview_en> , <http://example.com/InlandRevenueModel#PostIncidentReview/PostImplementationReview_en> , <http://example.com/InlandRevenueModel#PostIncidentReview/PrescribedInvestorRate_en> ;
