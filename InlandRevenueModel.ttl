<http://example.com/InlandRevenueModel#AllowanceInLieuOfSuperannuation>
        rdf:type          <http://smartlogic.com/class#Entitlement> ;
        <http://example.com/IRD-test-model#Has-acronym>
                <http://example.com/InlandRevenueModel#AllowanceInLieuOfSuperannuation/LUSU_en> ;
        <http://example.com/InlandRevenueModel#Instance>
                false ;
        <http://example.com/InlandRevenueModel#SourceOfDefinition0>
                "Google AI"@en ;
        <http://example.com/NZ-IRD#Is-financial-object-of>
                <http://example.com/InlandRevenueModel#BenefitsAdministration> , <http://example.com/InlandRevenueModel#RemunerationAdministration> ;
        <http://example.com/NZ-IRD#Source-of-term>
                "P&C: Business Support Group content; P&C: Employment Relations content"@en ;
        sem:guid          "2aca9c6e-1b2c-4f1c-ae17-99ed65b23235" ;
        skos:broader      <http://example.com/InlandRevenueModel#EmployeeAllowance> ;
        skos:definition   "Allowances in lieu of superannuation generally refer to a payment from the Government Superannuation Fund (GSF) or other retirement savings schemes, allowing a contributor to receive a \"retiring allowance\" rather than waiting for their normal retirement age or for eligibility for New Zealand Superannuation (NZ Super). These allowances are typically options available to individuals who are members of the GSF, where they can receive a lump sum or a reduced but earlier stream of payments, sometimes by surrendering a portion of their future retiring allowance for an immediate increase. It's important to distinguish this from the social welfare payments from Work and Income or the NZ Super Fund, which are separate."@en ;
        skos:historyNote  "The GSF has been closed for some time."@en ;
        skos:related      <http://example.com/Cleaned-Inland-Revenue-model#ExceptionalCircumstance> , <http://example.com/InlandRevenueModel-current-#GovernmentSuperannuationFundAuthority> , <http://smartlogic.com/term#553061268819308499167396340189197> ;
        skosxl:prefLabel  <http://example.com/InlandRevenueModel#AllowanceInLieuOfSuperannuation/AllowanceInLieuOfSuperannuation_en> .

