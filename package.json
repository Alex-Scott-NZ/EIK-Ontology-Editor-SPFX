{
  "name": "eik-ontology-editor",
  "version": "0.6.4.1",
  "private": true,
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "main": "lib/index.js",
  "scripts": {
    "start": "gulp serve",
    "start:nobrowser": "gulp serve --nobrowser",
    "build": "gulp bundle",
    "clean": "gulp clean",
    "test": "gulp test",
    "package": "gulp bundle --ship && gulp package-solution --ship",
    "import-ttl": "npm --prefix tools run import:default",
    "gen:schema": "npm --prefix tools run gen:schema",
    "audit": "npm --prefix tools run audit",
    "roundtrip": "npm --prefix tools run export && npm --prefix tools run roundtrip"
  },
  "dependencies": {
    "@fluentui/react": "^8.106.4",
    "@microsoft/sp-component-base": "1.21.1",
    "@microsoft/sp-core-library": "1.21.1",
    "@microsoft/sp-lodash-subset": "1.21.1",
    "@microsoft/sp-office-ui-fabric-core": "1.21.1",
    "@microsoft/sp-property-pane": "1.21.1",
    "@microsoft/sp-webpart-base": "1.21.1",
    "@pnp/logging": "^4.16.0",
    "@pnp/sp": "^4.16.0",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "sql.js": "^1.13.0",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.21.1",
    "@microsoft/eslint-plugin-spfx": "1.21.1",
    "@microsoft/rush-stack-compiler-5.3": "0.1.0",
    "@microsoft/sp-build-web": "1.21.1",
    "@microsoft/sp-module-interfaces": "1.21.1",
    "@rushstack/eslint-config": "4.0.1",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/sql.js": "^1.4.9",
    "@types/webpack-env": "~1.15.2",
    "ajv": "^6.12.5",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.3.0",
    "gulp": "4.0.2",
    "typescript": "~5.3.3"
  }
}
