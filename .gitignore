# Build output
dist/
lib/
solution/
temp/
*.sppkg
# ...except the installable package, which IS shipped in the repo
!sharepoint/solution/
sharepoint/solution/*
!sharepoint/solution/*.sppkg

# Dependencies
node_modules/

# Generated SQLite database — rebuild with: npm run import-ttl
data/*.sqlite
# Regenerated Turtle export — rebuild with: npm --prefix tools run export
data/*.ttl
# Regenerated comparison data — rebuild with: npm --prefix tools run compare
data/compare-extract.txt

# Logs / OS
npm-debug.log*
*.log
.DS_Store
Thumbs.db

# Editors
.vscode/settings.json
.idea/

# Heft / SPFx caches
.heft/
.rush/
release/

# Generated by the gulp sass subtask, next to the source .scss
*.module.scss.ts
*.module.scss.d.ts
