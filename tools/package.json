{
  "name": "eik-ontology-tools",
  "version": "0.1.0.0",
  "private": true,
  "description": "Node-side conversion tools: Turtle <-> SQLite. Runs outside the SPFx bundle.",
  "scripts": {
    "gen:schema": "node gen-schema-ts.js",
    "import": "tsx import-ttl.ts",
    "import:default": "tsx import-ttl.ts ../InlandRevenueModel.ttl ../data/ontology.sqlite",
    "verify": "tsx verify-queries.ts",
    "audit": "tsx audit-coverage.ts",
    "compare": "tsx compare-extract.ts",
    "smoke": "tsx scratch-smoke.ts",
    "export": "tsx export-ttl.ts",
    "roundtrip": "tsx roundtrip-diff.ts"
  },
  "dependencies": {
    "eik-ontology-editor": "file:..",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.19.2",
    "typescript": "~5.3.3"
  }
}
